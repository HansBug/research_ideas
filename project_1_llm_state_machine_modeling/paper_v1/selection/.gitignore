# Ephemeral run-state (regenerated every run, not paper artifact)
progress.json
run_main.log
logs/*.err
logs/.gitkeep

# Override root .gitignore's [Ss]cripts exclusion (pip venv) — our scripts/ holds source
!scripts/
!scripts/**

# But still exclude bytecode caches
scripts/__pycache__/
scripts/**/__pycache__/

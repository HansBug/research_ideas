// Source adapted from the official Umple manual page:
// https://cruise.umple.org/umple/RequirementsExamples.html
// section "Drivers licence requirements for state machine generation".

req L01-Levels {
  The user can have no license, a G1 license, a G2 license or a G license.
}

req L02-G1Test {
  To get a G1, a test must be complete.
}

req L03-G2Test {
  To get a G2, the user must have a G1 and a test must be completed.
}

req L04-GTest {
  To get a G, the user must have a G2 and a test must be completed.
}

req L05-Expiry {
  Each type of license can expire.
}

req L06-NonRenewG1OrG2 {
  If a G1 or G2 expires then the license is lost.
}

req L07-RenewG {
  If a G expires it can be renewed.
}

req L08-Suspension {
  Each type of license can be suspended.
}

req L09-LicenseData {
  A license has a license number and an issued date.
}

req L10-HolderData {
  The system will keep the following information about the holder
  of a license: name, date of birth, address.
}

req L11-TestData {
  The system will keep track of the tests of each license holder
  or applicant, along with the score on each test.
}

// Direct-chain example adapted from the official Basic Garage Door Example:
// https://cruise.umple.org/umple/BasicStateMachines.html

namespace Reproduction.DirectGarageDoor;

class GarageDoor
{
  status {
    Open {
      buttonOrObstacle -> Closing;
    }

    Closing {
      buttonOrObstacle -> Opening;
      reachBottom -> Closed;
    }

    Closed {
      buttonOrObstacle -> Opening;
    }

    Opening {
      buttonOrObstacle -> HalfOpen;
      reachTop -> Open;
    }

    HalfOpen {
      buttonOrObstacle -> Opening;
    }
  }
}

            "Sbox": 8.0,
            "class_coefficient": 2.0,
            "ET": 10.0,
            "multiple_threats": 1
          },
          "name": "initial_long_range"
        },
        {
          "before_cycles": 0,
          "events": [
            "MissionTaskFSM.LongRangePenetration.ThreatDetected",
            "MissionTaskFSM.LongRangePenetration.TargetDetected"
          ],
          "expected_state": "MissionTaskFSM.ThreatDegreeEvaluation",
          "expected_vars": {
            "Sbox": 8.0,
            "class_coefficient": 2.0,
            "ET": 10.0,
            "multiple_threats": 1

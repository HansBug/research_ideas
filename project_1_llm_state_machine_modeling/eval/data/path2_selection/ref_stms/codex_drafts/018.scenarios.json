    {
      "name": "multiple_serious_threats_select_highest",
      "description": "覆盖 [E9][E10]：目标检测与威胁检测同周期出现时优先走威胁评估，多威胁且 E 高于 ET 时进入最高威胁快速规避。",
      "initial_state": null,
      "initial_vars": {
        "Sbox": 8.0,
        "class_coefficient": 2.0,
        "ET": 10.0,
        "multiple_threats": 1
      },
      "steps": [
        {
          "before_cycles": 1,
          "events": null,
          "expected_state": "MissionTaskFSM.LongRangePenetration",

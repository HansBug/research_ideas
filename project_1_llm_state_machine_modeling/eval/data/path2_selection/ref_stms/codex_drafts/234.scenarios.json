            "ManualUpSpringCommand"
          ],
          "expected_state": "ParkingLiftController.ManualInchingUp",
          "expected_vars": {
            "source_level": 1,
            "destination_level": 1,
            "level_difference": 0,
            "levels_remaining": 0

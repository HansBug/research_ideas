{
  "scenarios": [
    {
      "name": "manual_inching_spring_commands",
      "description": "覆盖 [E7][E8][E9]：从自动等待切到手动维护，HMI/teach pendant spring-action 上下点动均以慢速保持，释放按钮返回手动空闲。",
      "initial_state": null,
      "initial_vars": {},
      "steps": [

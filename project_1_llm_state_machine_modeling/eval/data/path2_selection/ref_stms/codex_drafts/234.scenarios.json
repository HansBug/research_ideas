          "expected_vars": {
            "source_level": 1,
            "destination_level": 1,
            "level_difference": 0,
            "levels_remaining": 0
          },
          "name": "default_auto_waiting"
        },
        {
          "before_cycles": 0,
          "events": [
            "SwitchToManual"
          ],
          "expected_state": "ParkingLiftController.ManualIdle",
          "expected_vars": {
            "source_level": 1,
            "destination_level": 1,
            "level_difference": 0,
            "levels_remaining": 0

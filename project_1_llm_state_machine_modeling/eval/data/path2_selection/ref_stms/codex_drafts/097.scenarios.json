{
  "scenarios": [
    {
      "name": "startup_and_search_entry",
      "description": "覆盖 [E3]-[E7]：默认进入 START_STATE，START_MISSION 后进入低空半椭圆 SEARCH 并触达双探测器 abstract action。",
      "initial_state": null,
      "initial_vars": {},
      "steps": [
        {
          "before_cycles": 0,
          "events": [],
          "expected_state": "SearchFollowCatchMissionController.START_STATE",
          "expected_vars": {
            "detection_count": 0,
            "frame_window": 0,
            "no_new_detection_frames": 0,
            "detection_seen_this_frame": 0
          },
          "name": "default_enters_start_state"
        },
        {
          "before_cycles": 0,
          "events": [
            "START_MISSION"
          ],
          "expected_state": "SearchFollowCatchMissionController.SEARCH",
          "expected_vars": {
            "detection_count": 0,
            "frame_window": 0,
            "no_new_detection_frames": 0,
            "detection_seen_this_frame": 0
          },
          "name": "operator_starts_search"
        }
      ]
    },
    {
      "name": "long_range_three_of_five_guard",
      "description": "覆盖 [E8]-[E9]：长距 3/5 帧阈值到达后一拍由 SEARCH 进入 FOLLOW_LONG_RANGE，并触达 5 m XY 快速接近命令。",
      "initial_state": "SearchFollowCatchMissionController.SEARCH",
      "initial_vars": {
        "detection_count": 0,
        "frame_window": 0,
        "no_new_detection_frames": 0,
        "detection_seen_this_frame": 0
      },
      "steps": [
        {
          "before_cycles": 0,
          "events": [
            "LongRangeDetectionFrame"
          ],
          "expected_state": "SearchFollowCatchMissionController.SEARCH",
          "expected_vars": {
            "detection_count": 1,
            "frame_window": 1
          },
          "name": "long_detection_1_of_1"
        },
        {
          "before_cycles": 0,
          "events": [
            "LongRangeMissFrame"
          ],
          "expected_state": "SearchFollowCatchMissionController.SEARCH",
          "expected_vars": {
            "detection_count": 1,
            "frame_window": 2
          },
          "name": "long_window_1_of_2"
        },
        {
          "before_cycles": 0,
          "events": [
            "LongRangeDetectionFrame"
          ],
          "expected_state": "SearchFollowCatchMissionController.SEARCH",
          "expected_vars": {
            "detection_count": 2,
            "frame_window": 3
          },
          "name": "long_detection_2_of_3"
        },
        {
          "before_cycles": 0,
          "events": [
            "LongRangeMissFrame"
          ],
          "expected_state": "SearchFollowCatchMissionController.SEARCH",
          "expected_vars": {
            "detection_count": 2,
            "frame_window": 4
          },
          "name": "below_long_threshold"
        },
        {
          "before_cycles": 0,
          "events": [
            "LongRangeDetectionFrame"
          ],
          "expected_state": "SearchFollowCatchMissionController.SEARCH",
          "expected_vars": {
            "detection_count": 3,
            "frame_window": 5
          },
          "name": "long_threshold_values_reached"
        },
        {
          "before_cycles": 0,
          "events": [],
          "expected_state": "SearchFollowCatchMissionController.FOLLOW_LONG_RANGE",
          "expected_vars": {
            "detection_count": 0,
            "frame_window": 0,
            "no_new_detection_frames": 0,
            "detection_seen_this_frame": 0
          },
          "name": "guard_enters_long_range_follow"
        }
      ]
    },
    {
      "name": "long_range_failed_window_resets",
      "description": "覆盖 [E8] 边界反例：只有 2/5 长距检测时不进入 FOLLOW_LONG_RANGE，并重置该 5 帧窗口。",
      "initial_state": "SearchFollowCatchMissionController.SEARCH",
      "initial_vars": {
        "detection_count": 2,
        "frame_window": 5,
        "no_new_detection_frames": 0,
        "detection_seen_this_frame": 0
      },
      "steps": [
        {
          "before_cycles": 0,
          "events": [],
          "expected_state": "SearchFollowCatchMissionController.SEARCH",
          "expected_vars": {
            "detection_count": 0,
            "frame_window": 0,
            "no_new_detection_frames": 0,
            "detection_seen_this_frame": 0
          },
          "name": "two_of_five_does_not_trigger"
        }
      ]
    },
    {
      "name": "long_range_new_detection_resets_loss_counter",
      "description": "覆盖 [E9] 与 [E15]：FOLLOW_LONG_RANGE 中连续空帧累计 no-new 计数，新的长距检测清零该计数并重新触达 5 m approach。",
      "initial_state": "SearchFollowCatchMissionController.FOLLOW_LONG_RANGE",
      "initial_vars": {
        "detection_count": 0,
        "frame_window": 0,
        "no_new_detection_frames": 0,
        "detection_seen_this_frame": 0
      },
      "steps": [
        {
          "before_cycles": 3,
          "events": null,
          "expected_state": "SearchFollowCatchMissionController.FOLLOW_LONG_RANGE",
          "expected_vars": {
            "no_new_detection_frames": 3,
            "detection_seen_this_frame": 0
          },
          "name": "three_empty_cycles_accumulate"
        },
        {
          "before_cycles": 0,
          "events": [
            "LongRangeDetectionFrame"
          ],
          "expected_state": "SearchFollowCatchMissionController.FOLLOW_LONG_RANGE",
          "expected_vars": {
            "no_new_detection_frames": 0,
            "detection_seen_this_frame": 0
          },
          "name": "new_long_detection_resets_loss_counter"
        }
      ]
    },
    {
      "name": "short_range_two_of_four_guard",

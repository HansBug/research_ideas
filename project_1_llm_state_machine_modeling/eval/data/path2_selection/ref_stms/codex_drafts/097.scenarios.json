    },
    {
      "name": "ball_catch_planned_trajectory_and_land",
      "description": "覆盖 [E12]-[E18]：短距跟随后 BALL_DETECTED 进入 CATCH_BALL，球出视野后继续 planned trajectory，SUCCESSFUL_CATCH 后 LAND。",
      "initial_state": "SearchFollowCatchMissionController.FOLLOW_SHORT_RANGE",
      "initial_vars": {
        "detection_count": 0,
        "frame_window": 0,
        "no_new_detection_frames": 0,
        "detection_seen_this_frame": 0
      },
      "steps": [
        {
          "before_cycles": 0,
          "events": [
            "BALL_DETECTED"
          ],
          "expected_state": "SearchFollowCatchMissionController.CATCH_BALL",
          "expected_vars": {
            "detection_count": 0,
            "frame_window": 0,
            "no_new_detection_frames": 0,
            "detection_seen_this_frame": 0
          },
          "name": "ball_detected_enters_catch"
        },
        {
          "before_cycles": 0,
          "events": [
            "BALL_DETECTED"
          ],
          "expected_state": "SearchFollowCatchMissionController.CATCH_BALL",
          "expected_vars": {
            "no_new_detection_frames": 0,
            "detection_seen_this_frame": 0
          },
          "name": "new_ball_detection_keeps_alignment"
        },
        {
          "before_cycles": 0,
          "events": [
            "BALL_LEAVES_CAMERA_FIELD_OF_VIEW"
          ],
          "expected_state": "SearchFollowCatchMissionController.PLANNED_TRAJECTORY",
          "expected_vars": {
            "no_new_detection_frames": 1,
            "detection_seen_this_frame": 0
          },
          "name": "ball_out_of_fov_continues_planned_trajectory"
        },
        {
          "before_cycles": 0,
          "events": [
            "SUCCESSFUL_CATCH"
          ],
          "expected_state": "SearchFollowCatchMissionController.LAND",
          "expected_vars": {
            "detection_count": 0,
            "frame_window": 0,
            "no_new_detection_frames": 0,
            "detection_seen_this_frame": 1
          },
          "name": "laser_successful_catch_lands"
        }
      ]
    },
    {
      "name": "detection_lost_from_follow_short",

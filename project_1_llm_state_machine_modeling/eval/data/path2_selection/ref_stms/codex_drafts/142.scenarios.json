        {
          "before_cycles": 0,
          "events": [],
          "expected_state": "CupFillingLine.VerticalAttach",
          "expected_vars": {
            "vertical_motion_mm": 50.0,
            "resume_code": 6
          },
          "name": "fifty_mm_boundary_reached"
        },
        {
          "before_cycles": 0,
          "events": [],
          "expected_state": "CupFillingLine.ReturnInitial",
          "expected_vars": {
            "vertical_motion_mm": 50.0,
            "resume_code": 7
          },
          "name": "rodless_cylinder_and_vacuum_return"

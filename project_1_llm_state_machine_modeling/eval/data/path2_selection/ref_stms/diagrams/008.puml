@startuml
hide empty description

skinparam state {
  BackgroundColor<<pseudo>> LightGray
  BackgroundColor<<composite>> LightBlue
  BorderColor<<pseudo>> Gray
  FontStyle<<pseudo>> italic
}

legend top left
|= Variable |= Type |= Initial Value |
| PL | float | 0.0 |
| Ppv | float | 0.0 |
| Pw | float | 0.0 |
| SoC | float | 0.25 |
| eng1_Pmax | float | 0.0 |
| eng2_Pmax | float | 0.0 |
| eng3_Pmax | float | 0.0 |
endlegend

state "LNGShipEMS" as lng_ship_ems <<composite>> {
    state "Select" as lng_ship_ems__select <<pseudo>> #line.dotted
    state "State1_1" as lng_ship_ems__state1_1
    state "State1_2" as lng_ship_ems__state1_2
    state "State2_1" as lng_ship_ems__state2_1
    state "State2_2" as lng_ship_ems__state2_2
    state "State2_3" as lng_ship_ems__state2_3
    state "State2_4" as lng_ship_ems__state2_4
    state "State2_5" as lng_ship_ems__state2_5
    state "State2_6" as lng_ship_ems__state2_6
    state "State2_7" as lng_ship_ems__state2_7
    state "State3_1" as lng_ship_ems__state3_1
    state "State3_2" as lng_ship_ems__state3_2
    state "State3_3" as lng_ship_ems__state3_3
    [*] --> lng_ship_ems__select
    lng_ship_ems__select --> lng_ship_ems__state3_1 : PL == 0.0 && SoC < 0.5
    lng_ship_ems__select --> lng_ship_ems__state3_2 : PL == 0.0 && SoC >= 0.5 && SoC < 0.95
    lng_ship_ems__select --> lng_ship_ems__state3_3 : PL == 0.0 && SoC >= 0.95
    lng_ship_ems__select --> lng_ship_ems__state1_1 : PL > 0.0 && Ppv + Pw >= PL && SoC < 0.95
    lng_ship_ems__select --> lng_ship_ems__state1_2 : PL > 0.0 && Ppv + Pw >= PL && SoC >= 0.95
    lng_ship_ems__select --> lng_ship_ems__state2_1 : PL > 0.0 && Ppv + Pw < PL && eng3_Pmax > PL - Ppv - Pw && SoC > 0.5
    lng_ship_ems__select --> lng_ship_ems__state2_2 : PL > 0.0 && Ppv + Pw < PL && eng3_Pmax > PL - Ppv - Pw && SoC < 0.5
    lng_ship_ems__select --> lng_ship_ems__state2_3 : PL > 0.0 && Ppv + Pw < PL && eng3_Pmax < PL - Ppv - Pw && eng1_Pmax + eng3_Pmax > PL - Ppv - Pw && SoC > 0.5
    lng_ship_ems__select --> lng_ship_ems__state2_4 : PL > 0.0 && Ppv + Pw < PL && eng3_Pmax < PL - Ppv - Pw && eng1_Pmax + eng3_Pmax > PL - Ppv - Pw && SoC < 0.5
    lng_ship_ems__select --> lng_ship_ems__state2_5 : PL > 0.0 && Ppv + Pw < PL && eng3_Pmax < PL - Ppv - Pw && eng1_Pmax + eng3_Pmax < PL - Ppv - Pw && eng1_Pmax + eng2_Pmax + eng3_Pmax > PL - Ppv - Pw && SoC > 0.5
    lng_ship_ems__select --> lng_ship_ems__state2_6 : PL > 0.0 && Ppv + Pw < PL && eng3_Pmax < PL - Ppv - Pw && eng1_Pmax + eng3_Pmax < PL - Ppv - Pw && eng1_Pmax + eng2_Pmax + eng3_Pmax > PL - Ppv - Pw && SoC < 0.5
    lng_ship_ems__select --> lng_ship_ems__state2_7 : PL > 0.0 && Ppv + Pw < PL && eng3_Pmax < PL - Ppv - Pw && eng1_Pmax + eng3_Pmax < PL - Ppv - Pw && eng1_Pmax + eng2_Pmax + eng3_Pmax < PL - Ppv - Pw
    lng_ship_ems__state1_1 --> lng_ship_ems__select
    lng_ship_ems__state1_2 --> lng_ship_ems__select
    lng_ship_ems__state2_1 --> lng_ship_ems__select
    lng_ship_ems__state2_2 --> lng_ship_ems__select
    lng_ship_ems__state2_3 --> lng_ship_ems__select
    lng_ship_ems__state2_4 --> lng_ship_ems__select
    lng_ship_ems__state2_5 --> lng_ship_ems__select
    lng_ship_ems__state2_6 --> lng_ship_ems__select
    lng_ship_ems__state2_7 --> lng_ship_ems__select
    lng_ship_ems__state3_1 --> lng_ship_ems__select
    lng_ship_ems__state3_2 --> lng_ship_ems__select
    lng_ship_ems__state3_3 --> lng_ship_ems__select
}
[*] --> lng_ship_ems
lng_ship_ems --> [*]
@enduml
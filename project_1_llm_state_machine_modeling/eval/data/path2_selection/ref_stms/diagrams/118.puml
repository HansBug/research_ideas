    state "SoftwareDeInit" as subsystem_lifecycle_supervisor__software_de_init
    subsystem_lifecycle_supervisor__offline --> subsystem_lifecycle_supervisor__error_operational : HighSeverityError
    subsystem_lifecycle_supervisor__offline --> subsystem_lifecycle_supervisor__error_operational : CriticalHardwareTemperatureLimit
    subsystem_lifecycle_supervisor__offline --> subsystem_lifecycle_supervisor__error_operational : JoystickOrRobotUnplugged

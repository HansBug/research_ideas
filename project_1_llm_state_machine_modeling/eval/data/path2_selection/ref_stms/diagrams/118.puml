    subsystem_lifecycle_supervisor__error_operational --> subsystem_lifecycle_supervisor__error_operational : JoystickOrRobotUnplugged
    subsystem_lifecycle_supervisor__post_operational --> subsystem_lifecycle_supervisor__error_operational : HighSeverityError

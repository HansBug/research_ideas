    note on link
    effect {
        configuration_selected = 0;
    }
    end note
    subsystem_lifecycle_supervisor__safe_operational --> subsystem_lifecycle_supervisor__operational : VerificationCompleted
    subsystem_lifecycle_supervisor__operational --> subsystem_lifecycle_supervisor__post_operational : StopSubsystem

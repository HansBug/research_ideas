    subsystem_lifecycle_supervisor__pre_operational --> subsystem_lifecycle_supervisor__error_operational : JoystickOrRobotUnplugged
    subsystem_lifecycle_supervisor__safe_operational --> subsystem_lifecycle_supervisor__error_operational : HighSeverityError
    subsystem_lifecycle_supervisor__safe_operational --> subsystem_lifecycle_supervisor__error_operational : CriticalHardwareTemperatureLimit
    subsystem_lifecycle_supervisor__safe_operational --> subsystem_lifecycle_supervisor__error_operational : JoystickOrRobotUnplugged

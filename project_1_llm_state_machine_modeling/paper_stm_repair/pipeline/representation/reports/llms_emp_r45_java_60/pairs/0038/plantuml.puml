@startuml
[*] --> TurnOn
state TurnOn {
state TurnOn {
[*] --> TurnOn
TurnOn --> fork1 : after 2s / minimum 2s
}
}

state fork1 {
[*] --> AutoFocus
[*] --> DetLight
}

state AutoFocus {
AutoFocus --> choice1 : after 2s / minimum 1s
}

state DetLight {
DetLight --> choice2 : after 1s / <<GaStep>>{prob=0.4}
}

fork1 --> choice3

choice3 --> ChargedFlash
state ChargedFlash {
ChargedFlash --> Junction3 : after 4s / minimum 2s
}

state Junction3 {
Junction3 --> Join2 : Charged=true
}

choice3 --> Junction3

choice2 --> Join2
state Join2 {
Join2 --> Fork2
}

Fork2 --> Junction2
Fork2 --> Flash

state Junction2 {
Junction2 --> TakePicture
}
Junction2 --> TakePicture
state TakePicture {
TakePicture --> WriteMemory
}

state WriteMemory {
WriteMemory --> Junction1 : after 3s / minimum 2s
}

state Junction1 {
Junction1 --> TurnOff
}

TurnOff --> [*]

Flash --> Terminate

state Terminate {
[*] --> Terminate
}

@enduml
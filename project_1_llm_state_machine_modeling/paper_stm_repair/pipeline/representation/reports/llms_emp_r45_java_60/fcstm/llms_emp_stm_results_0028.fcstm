    TakePicture -> WriteMemory;
    WriteMemory -> Junction1;
    Junction1 -> TurnOff;
    TurnOff -> [*];
    Join2 -> Fork2;
    Fork2 -> Junction2;
    Fork2 -> Flash;
    Flash -> Terminate;
}

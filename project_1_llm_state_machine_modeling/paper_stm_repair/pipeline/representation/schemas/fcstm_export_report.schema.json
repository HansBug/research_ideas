{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paper-stm-repair:r4-5:fcstm-export-report:v0",
  "title": "R4.5 FCSTM export report v0",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "items",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "r4_5.fcstm_export_report.v0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "required": [
        "examples",
        "converted",
        "partial",
        "blocked"
      ],
      "properties": {
        "examples": {
          "type": "integer",
          "minimum": 0
        },
        "converted": {
          "type": "integer",
          "minimum": 0
        },
        "partial": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "example_id",
          "seed_id",
          "upstream_r3_status",
          "upstream_r3_status_reason_code",
          "upstream_source_format",
          "upstream_conversion_source",
          "upstream_source_nl_path",
          "upstream_source_stm0_path",
          "upstream_source_meta_path",
          "status",
          "status_reason_code",
          "fcstm_path",
          "name_mapping_path",
          "lowering_inventory_path",
          "parse_inspect_report_path",
          "source_nl_path",
          "source_stm0_path",
          "source_meta_path",
          "canonical_output_path",
          "parse_status",
          "inspect_status",
          "blocked_transitions_count",
          "loss_count",
          "repair_contribution_allowed",
          "attribution"
        ],
        "properties": {
          "example_id": {
            "type": "string",
            "minLength": 1
          },
          "seed_id": {
            "type": "string",
            "minLength": 1
          },
          "upstream_r3_status": {
            "enum": [
              "converted",
              "partial",
              "blocked",
              "unsupported"
            ]
          },
          "upstream_r3_status_reason_code": {
            "type": "string",
            "pattern": "^R3\\."
          },
          "upstream_source_format": {
            "enum": [
              "plantuml",
              "umple",
              "ttool_xml"
            ]
          },
          "upstream_conversion_source": {
            "type": [
              "string",
              "null"
            ]
          },
          "upstream_source_nl_path": {
            "type": "string",
            "minLength": 1
          },
          "upstream_source_stm0_path": {
            "type": "string",
            "minLength": 1
          },
          "upstream_source_meta_path": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "converted",
              "partial",
              "blocked",
              "unsupported"
            ]
          },
          "status_reason_code": {
            "type": "string",
            "pattern": "^R45\\."
          },
          "fcstm_path": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "name_mapping_path": {
            "type": "string",
            "minLength": 1
          },
          "lowering_inventory_path": {
            "type": "string",
            "minLength": 1
          },
          "parse_inspect_report_path": {
            "type": "string",
            "minLength": 1
          },
          "parse_status": {
            "enum": [
              "ok",
              "error",
              "not_run"
            ]
          },
          "inspect_status": {
            "enum": [
              "ok",
              "error",
              "not_run"
            ]
          },
          "blocked_transitions_count": {
            "type": "integer",
            "minimum": 0
          },
          "loss_count": {
            "type": "integer",
            "minimum": 0
          },
          "repair_contribution_allowed": {
            "const": false
          },
          "attribution": {
            "const": "representation_lowering_not_repair"
          },
          "source_nl_path": {
            "type": "string",
            "minLength": 1
          },
          "source_stm0_path": {
            "type": "string",
            "minLength": 1
          },
          "source_meta_path": {
            "type": "string",
            "minLength": 1
          },
          "canonical_output_path": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

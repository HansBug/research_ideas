{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paper-stm-repair:r4:diagnostic-bundle:v0",
  "title": "R4 diagnostic bundle v0",
  "type": "object",
  "required": [
    "schema_version",
    "example_id",
    "r4_dry_run_decision",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "r4.diagnostic_bundle.v0"
    },
    "example_id": {
      "type": "string",
      "minLength": 1
    },
    "r4_dry_run_decision": {
      "enum": [
        "complete",
        "focused",
        "blocked",
        "supplementary"
      ]
    },
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "evidenceLocator": {
      "type": "object",
      "required": [
        "kind",
        "path",
        "description"
      ],
      "properties": {
        "kind": {
          "enum": [
            "nl",
            "stm0",
            "canonical",
            "r3_report",
            "r3_loss_ledger",
            "r3_summary",
            "source_meta",
            "rubric",
            "scenario",
            "pr_comment",
            "other"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "json_pointer": {
          "type": [
            "string",
            "null"
          ]
        },
        "line_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "diagnostic_id",
        "title",
        "source_stage",
        "severity",
        "repair_relevance",
        "better_stm_condition_link",
        "evidence_locator",
        "r3_reference",
        "rationale"
      ],
      "properties": {
        "diagnostic_id": {
          "type": "string",
          "pattern": "^R4\\.DIAG\\.[A-Za-z0-9_.-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_stage": {
          "enum": [
            "r3_conversion",
            "static_semantic",
            "design_rule",
            "scenario",
            "human_review",
            "unknown"
          ]
        },
        "severity": {
          "enum": [
            "blocking",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "repair_relevance": {
          "enum": [
            "must_fix",
            "should_fix",
            "monitor",
            "not_repair_target"
          ]
        },
        "better_stm_condition_link": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "no_new_blocking_diagnostics",
              "no_critical_regression_on_frozen_scenarios",
              "improves_at_least_one_preregistered_dimension",
              "no_nl_semantic_degradation",
              "conversion_gain_separated_from_repair_gain"
            ]
          }
        },
        "evidence_locator": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceLocator"
          }
        },
        "r3_reference": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "status",
            "status_reason_code",
            "loss_codes"
          ],
          "properties": {
            "status": {
              "enum": [
                "converted",
                "partial",
                "blocked",
                "unsupported"
              ]
            },
            "status_reason_code": {
              "type": "string"
            },
            "loss_codes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}

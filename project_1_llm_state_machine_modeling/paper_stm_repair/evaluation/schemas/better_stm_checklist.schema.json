{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paper-stm-repair:r4:better-stm-checklist:v0",
  "title": "R4 Better STM checklist v0",
  "type": "object",
  "required": [
    "schema_version",
    "example_id",
    "evaluation_context",
    "r4_dry_run_decision",
    "gain_attribution",
    "conversion_gain_counted_as_repair",
    "conditions",
    "can_claim_better_stm",
    "overall_decision",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "r4.better_stm_checklist.v0"
    },
    "example_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_context": {
      "enum": [
        "gate_dry_run",
        "repair_result"
      ]
    },
    "r4_dry_run_decision": {
      "enum": [
        "complete",
        "focused",
        "blocked",
        "supplementary"
      ]
    },
    "gain_attribution": {
      "enum": [
        "none",
        "conversion_normalization",
        "repair_loop",
        "human_completion",
        "unknown"
      ]
    },
    "conversion_gain_counted_as_repair": {
      "const": false
    },
    "conditions": {
      "type": "object",
      "required": [
        "no_new_blocking_diagnostics",
        "no_critical_regression_on_frozen_scenarios",
        "improves_at_least_one_preregistered_dimension",
        "no_nl_semantic_degradation",
        "conversion_gain_separated_from_repair_gain"
      ],
      "properties": {
        "no_new_blocking_diagnostics": {
          "type": "object",
          "required": [
            "status",
            "rationale",
            "evidence_locator"
          ],
          "properties": {
            "status": {
              "enum": [
                "pass",
                "fail",
                "not_applicable",
                "unknown"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidence_locator": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/evidenceLocator"
              },
              "minItems": 1
            },
            "missing_evidence_reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "no_critical_regression_on_frozen_scenarios": {
          "type": "object",
          "required": [
            "status",
            "rationale",
            "evidence_locator"
          ],
          "properties": {
            "status": {
              "enum": [
                "pass",
                "fail",
                "not_applicable",
                "unknown"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidence_locator": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/evidenceLocator"
              },
              "minItems": 1
            },
            "missing_evidence_reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "improves_at_least_one_preregistered_dimension": {
          "type": "object",
          "required": [
            "status",
            "rationale",
            "evidence_locator"
          ],
          "properties": {
            "status": {
              "enum": [
                "pass",
                "fail",
                "not_applicable",
                "unknown"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidence_locator": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/evidenceLocator"
              },
              "minItems": 1
            },
            "missing_evidence_reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "no_nl_semantic_degradation": {
          "type": "object",
          "required": [
            "status",
            "rationale",
            "evidence_locator"
          ],
          "properties": {
            "status": {
              "enum": [
                "pass",
                "fail",
                "not_applicable",
                "unknown"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidence_locator": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/evidenceLocator"
              },
              "minItems": 1
            },
            "missing_evidence_reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "conversion_gain_separated_from_repair_gain": {
          "type": "object",
          "required": [
            "status",
            "rationale",
            "evidence_locator"
          ],
          "properties": {
            "status": {
              "enum": [
                "pass",
                "fail",
                "not_applicable",
                "unknown"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidence_locator": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/evidenceLocator"
              },
              "minItems": 1
            },
            "missing_evidence_reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "can_claim_better_stm": {
      "type": "boolean"
    },
    "overall_decision": {
      "enum": [
        "better",
        "not_better",
        "not_evaluable",
        "blocked",
        "gate_dry_run_not_better",
        "limitation"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "evidenceLocator": {
      "type": "object",
      "required": [
        "kind",
        "path",
        "description"
      ],
      "properties": {
        "kind": {
          "enum": [
            "nl",
            "stm0",
            "canonical",
            "r3_report",
            "r3_loss_ledger",
            "r3_summary",
            "source_meta",
            "rubric",
            "scenario",
            "pr_comment",
            "other"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "json_pointer": {
          "type": [
            "string",
            "null"
          ]
        },
        "line_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evaluation_context": {
            "const": "gate_dry_run"
          }
        },
        "required": [
          "evaluation_context"
        ]
      },
      "then": {
        "properties": {
          "can_claim_better_stm": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "can_claim_better_stm": {
            "const": true
          }
        },
        "required": [
          "can_claim_better_stm"
        ]
      },
      "then": {
        "properties": {
          "overall_decision": {
            "const": "better"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "can_claim_better_stm": {
            "const": true
          }
        },
        "required": [
          "can_claim_better_stm"
        ]
      },
      "then": {
        "properties": {
          "evaluation_context": {
            "const": "repair_result"
          },
          "overall_decision": {
            "const": "better"
          },
          "conditions": {
            "properties": {
              "no_new_blocking_diagnostics": {
                "properties": {
                  "status": {
                    "const": "pass"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "no_critical_regression_on_frozen_scenarios": {
                "properties": {
                  "status": {
                    "const": "pass"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "improves_at_least_one_preregistered_dimension": {
                "properties": {
                  "status": {
                    "const": "pass"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "no_nl_semantic_degradation": {
                "properties": {
                  "status": {
                    "const": "pass"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "conversion_gain_separated_from_repair_gain": {
                "properties": {
                  "status": {
                    "const": "pass"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "no_new_blocking_diagnostics",
              "no_critical_regression_on_frozen_scenarios",
              "improves_at_least_one_preregistered_dimension",
              "no_nl_semantic_degradation",
              "conversion_gain_separated_from_repair_gain"
            ]
          }
        },
        "required": [
          "evaluation_context",
          "overall_decision",
          "conditions"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "overall_decision": {
            "const": "better"
          }
        },
        "required": [
          "overall_decision"
        ]
      },
      "then": {
        "properties": {
          "can_claim_better_stm": {
            "const": true
          }
        },
        "required": [
          "can_claim_better_stm"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "can_claim_better_stm": {
            "const": true
          }
        },
        "required": [
          "can_claim_better_stm"
        ]
      },
      "then": {
        "properties": {
          "gain_attribution": {
            "const": "repair_loop"
          }
        },
        "required": [
          "gain_attribution"
        ]
      }
    }
  ]
}

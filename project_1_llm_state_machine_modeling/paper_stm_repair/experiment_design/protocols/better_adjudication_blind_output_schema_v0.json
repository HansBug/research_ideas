{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper_stm_repair.r5_7_5.better_adjudication_blind_output_schema.v0",
  "title": "Better STM blind adjudication output schema v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "blind_case_id",
    "artifact_role",
    "judge_id",
    "headline_eligible",
    "repair_effectiveness_eligible",
    "real_repair_run_id",
    "scope_routing_status",
    "run_validity_status",
    "primary_verdict",
    "gate_results",
    "evidence_references",
    "rationale",
    "observed_anti_gaming_risk_flags",
    "forbidden_claims",
    "confidence",
    "human_escalation_required",
    "leakage_observation"
  ],
  "properties": {
    "schema_version": {
      "const": "r5_7_5.better_adjudication_blind_output.v0"
    },
    "blind_case_id": {
      "type": "string",
      "pattern": "^B[0-9]{2}$"
    },
    "artifact_role": {
      "const": "blind_adjudication_output"
    },
    "judge_id": {
      "type": "string",
      "minLength": 1
    },
    "headline_eligible": {
      "const": false
    },
    "repair_effectiveness_eligible": {
      "const": false
    },
    "real_repair_run_id": {
      "type": "null"
    },
    "scope_routing_status": {
      "enum": [
        "in_scope_t0_protocol_case",
        "caveat_t05",
        "out_of_headline_stress_t1",
        "out_of_scope"
      ]
    },
    "run_validity_status": {
      "enum": [
        "valid_blind_protocol_case",
        "candidate_schema_or_parse_invalid",
        "protocol_or_provenance_invalid",
        "stress_only_not_headline"
      ]
    },
    "primary_verdict": {
      "enum": [
        "better",
        "not_better",
        "partial",
        "unknown",
        "stmk_repair_failure",
        "protocol_or_provenance_invalid",
        "stress_t1"
      ]
    },
    "gate_results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "G0",
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6"
      ],
      "properties": {
        "G0": {
          "$ref": "#/$defs/gate_result"
        },
        "G1": {
          "$ref": "#/$defs/gate_result"
        },
        "G2": {
          "$ref": "#/$defs/gate_result"
        },
        "G3": {
          "$ref": "#/$defs/gate_result"
        },
        "G4": {
          "$ref": "#/$defs/gate_result"
        },
        "G5": {
          "$ref": "#/$defs/gate_result"
        },
        "G6": {
          "$ref": "#/$defs/gate_result"
        }
      }
    },
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "observed_anti_gaming_risk_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "forbidden_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "human_escalation_required": {
      "type": "boolean"
    },
    "leakage_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detected",
        "notes"
      ],
      "properties": {
        "detected": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "gate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "evidence_references"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "partial",
            "unknown",
            "caveat",
            "out_of_headline",
            "not_applicable",
            "not_evaluated"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper_stm_repair.r5_7_5.better_adjudication_output_schema.v0",
  "title": "Better STM adjudication output schema v0 for constructed STM_k protocol dry-run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "artifact_role",
    "constructed_for_protocol_dry_run",
    "not_real_repair_run_acknowledged",
    "headline_eligible",
    "repair_effectiveness_eligible",
    "protocol_coverage_claim_allowed",
    "real_repair_run_id",
    "scope_routing_status",
    "run_validity_status",
    "primary_expected_verdict",
    "gate_results",
    "target_closure",
    "no_regression",
    "anti_gaming_risk_flags",
    "evidence_keys",
    "forbidden_claims",
    "confidence",
    "human_escalation_required"
  ],
  "properties": {
    "schema_version": {
      "const": "r5_7_5.better_adjudication_output.v0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^C[0-9]{2}$"
    },
    "artifact_role": {
      "enum": [
        "constructed_stmk_protocol_dry_run",
        "real_repair_run_adjudication"
      ]
    },
    "constructed_for_protocol_dry_run": {
      "type": "boolean"
    },
    "not_real_repair_run_acknowledged": {
      "type": "boolean"
    },
    "headline_eligible": {
      "type": "boolean"
    },
    "repair_effectiveness_eligible": {
      "type": "boolean"
    },
    "protocol_coverage_claim_allowed": {
      "type": "boolean"
    },
    "real_repair_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope_routing_status": {
      "enum": [
        "in_scope_t0_protocol_case",
        "caveat_t05",
        "out_of_headline_stress_t1",
        "out_of_scope"
      ]
    },
    "run_validity_status": {
      "enum": [
        "valid_constructed_protocol_case",
        "candidate_schema_or_parse_invalid",
        "protocol_or_provenance_invalid",
        "stress_only_not_headline"
      ]
    },
    "primary_expected_verdict": {
      "enum": [
        "better",
        "not_better",
        "partial",
        "unknown",
        "stmk_repair_failure",
        "protocol_or_provenance_invalid",
        "stress_t1"
      ]
    },
    "gate_results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "G0",
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6"
      ],
      "properties": {
        "G0": {
          "$ref": "#/$defs/gate_result"
        },
        "G1": {
          "$ref": "#/$defs/gate_result"
        },
        "G2": {
          "$ref": "#/$defs/gate_result"
        },
        "G3": {
          "$ref": "#/$defs/gate_result"
        },
        "G4": {
          "$ref": "#/$defs/gate_result"
        },
        "G5": {
          "$ref": "#/$defs/gate_result"
        },
        "G6": {
          "$ref": "#/$defs/gate_result"
        }
      }
    },
    "target_closure": {
      "type": "object"
    },
    "no_regression": {
      "type": "object"
    },
    "anti_gaming_risk_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "evidence_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "forbidden_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "human_escalation_required": {
      "type": "boolean"
    },
    "secondary_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "gate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "evidence_keys"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "partial",
            "unknown",
            "caveat",
            "out_of_headline",
            "not_applicable",
            "not_evaluated"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "artifact_role"
        ],
        "properties": {
          "artifact_role": {
            "const": "constructed_stmk_protocol_dry_run"
          }
        }
      },
      "then": {
        "properties": {
          "constructed_for_protocol_dry_run": {
            "const": true
          },
          "not_real_repair_run_acknowledged": {
            "const": true
          },
          "headline_eligible": {
            "const": false
          },
          "repair_effectiveness_eligible": {
            "const": false
          },
          "real_repair_run_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "artifact_role"
        ],
        "properties": {
          "artifact_role": {
            "const": "real_repair_run_adjudication"
          }
        }
      },
      "then": {
        "properties": {
          "constructed_for_protocol_dry_run": {
            "const": false
          },
          "not_real_repair_run_acknowledged": {
            "const": false
          },
          "real_repair_run_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}

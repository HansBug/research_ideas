{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paper-stm-repair:r3:canonical-stm:v0",
  "title": "R3 canonical STM v0",
  "type": "object",
  "required": [
    "schema_version",
    "example_id",
    "seed_id",
    "source_format",
    "adapter",
    "status",
    "status_reason_code",
    "model",
    "diagnostics",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "r3.canonical_stm.v0"
    },
    "example_id": {
      "type": "string",
      "minLength": 1
    },
    "seed_id": {
      "type": "string",
      "minLength": 1
    },
    "source_format": {
      "enum": [
        "plantuml",
        "umple",
        "ttool_xml"
      ]
    },
    "adapter": {
      "enum": [
        "plantuml",
        "umple",
        "ttool_xml"
      ]
    },
    "status": {
      "enum": [
        "converted",
        "partial",
        "blocked",
        "unsupported"
      ]
    },
    "status_reason_code": {
      "enum": [
        "R3.STATUS.converted",
        "R3.STATUS.partial",
        "R3.STATUS.blocked",
        "R3.STATUS.unsupported"
      ]
    },
    "model": {
      "type": "object",
      "required": [
        "name",
        "states",
        "transitions",
        "variables",
        "initial_states",
        "final_states",
        "timing_level",
        "hierarchy_level"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        },
        "variables": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "initial_states": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "final_states": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timing_level": {
          "enum": [
            "none",
            "qualitative",
            "clock",
            "timed_constraints",
            "unknown"
          ]
        },
        "hierarchy_level": {
          "enum": [
            "flat",
            "hierarchical",
            "concurrent",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "conversion_source",
        "canonical_extraction_method",
        "structured_export_path",
        "fallback_used",
        "fallback_scope"
      ],
      "properties": {
        "conversion_source": {
          "enum": [
            "official_scxml",
            "official_xml",
            "no_canonical_conversion",
            "fallback_text_probe"
          ]
        },
        "canonical_extraction_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "structured_export_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "structured_export_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "fallback_used": {
          "type": "boolean"
        },
        "fallback_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_text_used_for_canonical": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "state": {
      "type": "object",
      "required": [
        "id",
        "label",
        "kind",
        "parent",
        "raw_ref",
        "attributes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "state",
            "initial",
            "final",
            "composite",
            "choice",
            "unknown"
          ]
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "attributes": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target",
        "event",
        "guard",
        "action",
        "label",
        "scope",
        "raw_ref",
        "attributes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "event": {
          "type": [
            "string",
            "null"
          ]
        },
        "guard": {
          "type": [
            "string",
            "null"
          ]
        },
        "action": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "attributes": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}

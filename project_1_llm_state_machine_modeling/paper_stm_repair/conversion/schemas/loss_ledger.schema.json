{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/paper_stm_repair/r3/loss_ledger.schema.json",
  "title": "R3 loss ledger row v0",
  "type": "object",
  "required": ["loss_id", "example_id", "source_ref", "canonical_ref", "loss_type", "severity", "rationale", "repair_contribution_allowed", "needs_manual_review", "loss_code"],
  "properties": {
    "loss_id": {"type": "string"},
    "example_id": {"type": "string"},
    "source_ref": {"type": ["string", "null"]},
    "canonical_ref": {"type": ["string", "null"]},
    "loss_type": {"enum": ["syntax", "structure", "hierarchy", "timing", "guard", "action", "variable", "semantic", "tooling", "manual_normalization"]},
    "severity": {"enum": ["info", "low", "medium", "high", "blocking"]},
    "rationale": {"type": "string"},
    "repair_contribution_allowed": {"const": false},
    "needs_manual_review": {"type": "boolean"},
    "loss_code": {"type": "string", "pattern": "^R3\\.LOSS\\.[a-z_]+\\.(info|low|medium|high|blocking)$"}
  },
  "additionalProperties": false
}

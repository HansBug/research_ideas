{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paper-stm-repair:r3.1:plantuml-recovery-report:v0",
  "title": "R3.1 PlantUML recovery report v0",
  "type": "object",
  "required": [
    "report_version", "run_id", "created_at", "repo_commit", "schema_version",
    "repo_commit_semantics", "generator_code_commit", "generator_worktree_dirty",
    "generator_git_status_porcelain", "artifact_commit_note", "generation_command",
    "conversion_contract", "temporary_probe_reference", "input_sources", "normalization_rules_path",
    "normalization_ledger_path", "normalization_ledger_sha256", "source_file_immutability",
    "raw_immutability", "summary", "semantic_preservation_audit_summary", "artifact_archive", "items"
  ],
  "properties": {
    "report_version": {"const": "r3.1.plantuml_recovery_report.v0"},
    "run_id": {"type": "string"},
    "created_at": {"type": "string"},
    "repo_commit": {"type": "string"},
    "repo_commit_semantics": {"type": "string"},
    "generator_code_commit": {"type": "string"},
    "generator_worktree_dirty": {"type": "boolean"},
    "generator_git_status_porcelain": {"type": "array", "items": {"type": "string"}},
    "artifact_commit_note": {"type": "string"},
    "generation_command": {"type": "string"},
    "schema_version": {"const": "r3.1.plantuml_recovery.v0"},
    "conversion_contract": {"type": "string"},
    "temporary_probe_reference": {"type": "object"},
    "input_sources": {"type": "array", "items": {"type": "string"}},
    "normalization_rules_path": {"type": "string"},
    "normalization_ledger_path": {"type": "string"},
    "normalization_ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_file_immutability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_pairs_path", "source_file_sha256_before", "source_file_sha256_after", "source_file_unchanged"],
        "properties": {
          "source_pairs_path": {"type": ["string", "null"]},
          "source_file_sha256_before": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "source_file_sha256_after": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "source_file_unchanged": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "raw_immutability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "seed_id", "pair_id", "raw_sha256_before", "raw_sha256_after", "raw_text_unchanged",
          "source_pairs_path", "source_line_sha256_before", "source_line_sha256_after", "source_line_unchanged",
          "source_file_sha256_before", "source_file_sha256_after", "source_file_unchanged"
        ],
        "properties": {
          "seed_id": {"type": "string"},
          "pair_id": {"type": "string"},
          "raw_sha256_before": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "raw_sha256_after": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "raw_text_unchanged": {"type": "boolean"},
          "source_pairs_path": {"type": ["string", "null"]},
          "source_line_sha256_before": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "source_line_sha256_after": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "source_line_unchanged": {"type": "boolean"},
          "source_file_sha256_before": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "source_file_sha256_after": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "source_file_unchanged": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "raw_total", "unique_nl_total", "converted_before", "failed_before",
        "technical_scxml_pass_all_rules", "low_risk_scxml_pass", "main_eligibility_included",
        "high_risk_scxml_pass", "failed_after", "by_seed", "by_seed_class", "by_issue_category", "by_llm",
        "llms_emp_cross_llm_gate", "profile_comparison"
      ],
      "properties": {
        "raw_total": {"type": "integer", "minimum": 0},
        "unique_nl_total": {"type": "integer", "minimum": 0},
        "converted_before": {"type": "integer", "minimum": 0},
        "failed_before": {"type": "integer", "minimum": 0},
        "technical_scxml_pass_all_rules": {"type": "integer", "minimum": 0},
        "low_risk_scxml_pass": {"type": "integer", "minimum": 0},
        "main_eligibility_included": {"type": "integer", "minimum": 0},
        "high_risk_scxml_pass": {"type": "integer", "minimum": 0},
        "failed_after": {"type": "integer", "minimum": 0},
        "by_seed": {"type": "object"},
        "by_seed_class": {"type": "object"},
        "by_issue_category": {"type": "object"},
        "by_llm": {"type": "object"},
        "llms_emp_cross_llm_gate": {
          "type": "object",
          "required": ["passed", "eligible_after_by_llm", "eligible_after_composition_by_llm", "eligible_after_values", "max_min_ratio", "rule"]
        },
        "profile_comparison": {"type": "object"}
      },
      "additionalProperties": false
    },
    "semantic_preservation_audit_summary": {
      "type": "object",
      "required": [
        "audit_version", "audited_total", "pass_total", "fail_total", "low_risk_fail_total",
        "main_eligibility_requires_pass", "by_status", "by_rule", "failed_pair_ids", "low_risk_failed_pair_ids"
      ],
      "properties": {
        "audit_version": {"const": "r3.1.plantuml_semantic_preservation.v0"},
        "audited_total": {"type": "integer", "minimum": 0},
        "pass_total": {"type": "integer", "minimum": 0},
        "fail_total": {"type": "integer", "minimum": 0},
        "low_risk_fail_total": {"type": "integer", "minimum": 0},
        "main_eligibility_requires_pass": {"type": "boolean"},
        "by_status": {"type": "object"},
        "by_rule": {"type": "object"},
        "failed_pair_ids": {"type": "array", "items": {"type": "string"}},
        "low_risk_failed_pair_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },

    "artifact_archive": {
      "type": "object",
      "required": ["policy", "archive_path", "archive_sha256_path", "manifest_path", "zip_member_path_semantics"],
      "properties": {
        "policy": {"type": "string"},
        "archive_path": {"type": "string"},
        "archive_sha256_path": {"type": "string"},
        "manifest_path": {"type": "string"},
        "zip_member_path_semantics": {"type": "string"}
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "seed_id", "seed_class", "pair_id", "row_index", "source_pairs_path", "source_line_sha256", "source_file_sha256",
          "raw_scxml_pass", "normalized_scxml_pass", "raw_canonical_parse_pass", "normalized_canonical_parse_pass",
          "raw_conversion_pass", "normalized_conversion_pass", "technical_scxml_pass_all_rules",
          "low_risk_scxml_pass", "main_eligibility_included", "recovery_bucket",
          "semantic_preservation_pass"
        ],
        "properties": {
          "seed_id": {"type": "string"},
          "seed_class": {"type": "string"},
          "pair_id": {"type": "string"},
          "row_index": {"type": "integer", "minimum": 0},
          "source_pairs_path": {"type": ["string", "null"]},
          "source_line_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "raw_scxml_pass": {"type": "boolean"},
          "normalized_scxml_pass": {"type": "boolean"},
          "raw_canonical_parse_pass": {"type": "boolean"},
          "normalized_canonical_parse_pass": {"type": "boolean"},
          "raw_conversion_pass": {"type": "boolean"},
          "normalized_conversion_pass": {"type": "boolean"},
          "technical_scxml_pass_all_rules": {"type": "boolean"},
          "low_risk_scxml_pass": {"type": "boolean"},
          "main_eligibility_included": {"type": "boolean"},
          "recovery_bucket": {"type": "string"},
          "semantic_preservation_pass": {"type": "boolean"},
          "semantic_preservation_audit": {"type": ["object", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}

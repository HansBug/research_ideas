{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paper-stm-repair:r3:conversion-report:v0",
  "title": "R3 selected examples conversion report v0",
  "type": "object",
  "required": ["report_version", "run_id", "items", "loss_ledger_sha256", "note"],
  "properties": {
    "report_version": {"const": "r3.selected_seed_examples_conversion_report.v0"},
    "run_id": {"type": "string"},
    "loss_ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "note": {"type": "string"},
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}}
  },
  "additionalProperties": false,
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "example_id", "seed_id", "source_format", "adapter", "status", "status_reason_code",
        "states_count", "transitions_count", "variables_count", "resolved_states_count", "resolved_transitions_count", "timing_level", "hierarchy_level",
        "losses_count", "blocking_reason", "source_sha256", "canonical_output_sha256", "canonical_output_path",
        "report_version", "run_id", "created_at", "conversion_command", "repo_commit", "input_version",
        "schema_version", "adapter_version", "tool_name", "tool_version", "tool_source_url",
        "tool_invocation_status", "source_locator", "raw_locator", "source_meta_path", "loss_ledger_path",
        "report_sha256", "manual_normalization", "manual_edit_allowed", "manual_edit_ledger_ref", "eligibility", "diagnostics"
      ],
      "properties": {
        "example_id": {"type": "string"},
        "seed_id": {"type": "string"},
        "source_format": {"enum": ["plantuml", "umple", "ttool_xml"]},
        "adapter": {"enum": ["plantuml", "umple", "ttool_xml"]},
        "status": {"enum": ["converted", "partial", "blocked", "unsupported"]},
        "status_reason_code": {"enum": ["R3.STATUS.converted", "R3.STATUS.partial", "R3.STATUS.blocked", "R3.STATUS.unsupported"]},
        "states_count": {"type": "integer", "minimum": 0},
        "transitions_count": {"type": "integer", "minimum": 0},
        "variables_count": {"type": "integer", "minimum": 0},
        "resolved_states_count": {"type": "integer", "minimum": 0},
        "resolved_transitions_count": {"type": "integer", "minimum": 0},
        "timing_level": {"enum": ["none", "qualitative", "clock", "timed_constraints", "unknown"]},
        "hierarchy_level": {"enum": ["flat", "hierarchical", "concurrent", "unknown"]},
        "losses_count": {"type": "integer", "minimum": 0},
        "blocking_reason": {"type": ["string", "null"]},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "canonical_output_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "canonical_output_path": {"type": ["string", "null"]},
        "report_version": {"const": "r3.conversion_report.v0"},
        "run_id": {"type": "string"},
        "created_at": {"type": "string"},
        "conversion_command": {"type": "string"},
        "repo_commit": {"type": "string"},
        "input_version": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_version": {"const": "r3.canonical_stm.v0"},
        "adapter_version": {"type": "string"},
        "tool_name": {"type": ["string", "null"]},
        "tool_version": {"type": ["string", "null"]},
        "tool_source_url": {"type": ["string", "null"]},
        "tool_invocation_status": {"type": ["string", "null"]},
        "source_locator": {"type": "string"},
        "raw_locator": {"type": ["string", "null"]},
        "source_meta_path": {"type": "string"},
        "loss_ledger_path": {"type": "string"},
        "report_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "manual_normalization": {"type": "boolean"},
        "manual_edit_allowed": {"const": false},
        "manual_edit_ledger_ref": {"type": ["string", "null"]},
        "eligibility": {"type": "string"},
        "diagnostics": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    }
  }
}

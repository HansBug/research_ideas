{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seed_resource_registry.schema.json",
  "title": "Seed resource registry entry",
  "type": "object",
  "required": [
    "schema_version",
    "seed_id",
    "source_work",
    "asset_summary",
    "pair_sets",
    "reference_sets",
    "extracted_summary",
    "downstream_selection",
    "recommended_role",
    "blockers",
    "legacy_audit_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "seed-resource-registry.v1"
    },
    "seed_id": {
      "type": "string"
    },
    "source_work": {
      "type": "object",
      "required": [
        "title",
        "year",
        "authors",
        "primary_url",
        "paper_url",
        "artifact_urls",
        "code_urls"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "year": {
          "type": [
            "integer",
            "string"
          ]
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "primary_url": {
          "type": "string"
        },
        "paper_url": {
          "type": "string"
        },
        "artifact_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "code_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "asset_summary": {
      "type": "object",
      "required": [
        "manifest_path",
        "first_source_status",
        "license_status",
        "redistribution_status",
        "version_pin"
      ],
      "properties": {
        "manifest_path": {
          "type": "string"
        },
        "first_source_status": {
          "enum": [
            "downloaded",
            "partially_downloaded",
            "metadata_only",
            "blocked",
            "not_applicable"
          ]
        },
        "license_status": {
          "enum": [
            "clear",
            "paper_only",
            "unknown",
            "missing",
            "restricted",
            "proprietary",
            "not_applicable"
          ]
        },
        "redistribution_status": {
          "enum": [
            "redistributable",
            "local_only",
            "metadata_only",
            "restricted",
            "unknown",
            "not_applicable"
          ]
        },
        "version_pin": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "pair_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pair_set_id",
          "nl_role",
          "stm0_role",
          "raw_pair_count",
          "eligible_pair_count",
          "canonical_case_count",
          "reference_pair_count",
          "generation_actor",
          "generation_model_or_method",
          "stm_family",
          "stm_time_level",
          "eligibility_state",
          "must_not_count_as_generated",
          "excluded_outputs",
          "extracted_pairs_path"
        ],
        "properties": {
          "pair_set_id": {
            "type": "string"
          },
          "nl_role": {
            "type": "string"
          },
          "nl_source_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stm0_role": {
            "type": "string"
          },
          "stm0_source_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "raw_pair_count": {
            "type": "integer"
          },
          "eligible_pair_count": {
            "type": "integer"
          },
          "canonical_case_count": {
            "type": "integer"
          },
          "reference_pair_count": {
            "type": "integer"
          },
          "generation_actor": {
            "enum": [
              "LLM",
              "traditional_tool",
              "human",
              "pipeline_rerun_only",
              "unknown"
            ]
          },
          "generation_model_or_method": {
            "type": "string"
          },
          "stm_family": {
            "type": "string"
          },
          "stm_time_level": {
            "enum": [
              "T0",
              "T1",
              "T2",
              "unknown"
            ]
          },
          "eligibility_state": {
            "enum": [
              "final_pool_ready",
              "conditional_final_pool",
              "pipeline_only",
              "reference_only",
              "paper_reconstructable",
              "related_only",
              "excluded"
            ]
          },
          "must_not_count_as_generated": {
            "type": "boolean"
          },
          "excluded_outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "extracted_pairs_path": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "reference_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reference_set_id",
          "reference_pair_count",
          "must_not_count_as_generated",
          "source_fields_or_paths",
          "notes"
        ],
        "properties": {
          "reference_set_id": {
            "type": "string"
          },
          "reference_pair_count": {
            "type": "integer"
          },
          "must_not_count_as_generated": {
            "type": "boolean"
          },
          "source_fields_or_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "extracted_summary": {
      "type": "object",
      "required": [
        "pairs_jsonl",
        "pairs_preview",
        "field_mapping",
        "validation_summary",
        "eligible_generated_pair_count",
        "trace_verified_pair_count"
      ],
      "properties": {
        "pairs_jsonl": {
          "type": "string"
        },
        "pairs_preview": {
          "type": "string"
        },
        "field_mapping": {
          "type": "string"
        },
        "validation_summary": {
          "type": "string"
        },
        "eligible_generated_pair_count": {
          "type": "integer"
        },
        "trace_verified_pair_count": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "downstream_selection": {
      "type": "object",
      "required": [
        "r2_smoke_recommendation",
        "source_coverage_class",
        "input_format_class",
        "conversion_pressure",
        "defect_risk_class",
        "selection_caveat"
      ],
      "properties": {
        "r2_smoke_recommendation": {
          "enum": [
            "prefer",
            "usable_with_caveat",
            "rerun_required",
            "do_not_use_as_seed",
            "reference_only"
          ]
        },
        "source_coverage_class": {
          "type": "string"
        },
        "input_format_class": {
          "type": "string"
        },
        "conversion_pressure": {
          "type": "string"
        },
        "defect_risk_class": {
          "type": "string"
        },
        "selection_caveat": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "recommended_role": {
      "enum": [
        "final_pool_ready",
        "conditional_final_pool",
        "pipeline_only",
        "reference_only",
        "paper_reconstructable",
        "related_only",
        "excluded"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "legacy_audit_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "reason_not_first_source"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "reason_not_first_source": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

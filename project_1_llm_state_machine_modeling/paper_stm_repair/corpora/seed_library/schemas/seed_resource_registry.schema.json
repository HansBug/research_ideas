{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seed_resource_registry.schema.json",
  "title": "Seed resource registry entry",
  "type": "object",
  "required": [
    "schema_version",
    "seed_id",
    "source_work",
    "asset_summary",
    "source_inventory",
    "data_construction",
    "quality_audit",
    "resource_profile",
    "pair_sets",
    "reference_sets",
    "extracted_summary",
    "downstream_selection",
    "recommended_role",
    "blockers",
    "legacy_audit_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "seed-resource-registry.v1"
    },
    "seed_id": {
      "type": "string"
    },
    "source_work": {
      "type": "object",
      "required": [
        "title",
        "year",
        "authors",
        "primary_url",
        "paper_url",
        "artifact_urls",
        "code_urls"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "year": {
          "type": [
            "integer",
            "string"
          ]
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "primary_url": {
          "type": "string"
        },
        "paper_url": {
          "type": "string"
        },
        "artifact_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "code_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "asset_summary": {
      "type": "object",
      "required": [
        "manifest_path",
        "first_source_status",
        "license_status",
        "redistribution_status",
        "version_pin"
      ],
      "properties": {
        "manifest_path": {
          "type": "string"
        },
        "first_source_status": {
          "enum": [
            "downloaded",
            "partially_downloaded",
            "metadata_only",
            "blocked",
            "not_applicable"
          ]
        },
        "license_status": {
          "enum": [
            "clear",
            "paper_only",
            "unknown",
            "missing",
            "restricted",
            "proprietary",
            "not_applicable",
            "paper_public_resource"
          ]
        },
        "redistribution_status": {
          "enum": [
            "redistributable",
            "local_only",
            "metadata_only",
            "restricted",
            "unknown",
            "not_applicable",
            "cite_original_work"
          ]
        },
        "version_pin": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "resource_profile": {
      "type": "object",
      "required": [
        "resource_category",
        "source_code_availability",
        "paper_uses_llm",
        "paper_llm_models",
        "paper_llm_availability_status",
        "paper_llm_availability_checked_at",
        "paper_llm_availability_evidence_urls",
        "code_reproducibility",
        "code_reproducibility_label",
        "code_reproducibility_evidence_paths",
        "resource_profile_notes"
      ],
      "properties": {
        "resource_category": {
          "enum": [
            "first_source_nl_stm",
            "nl_only",
            "nl_code_reproducible",
            "reference_only",
            "paper_reconstructable",
            "related_only",
            "excluded"
          ]
        },
        "source_code_availability": {
          "enum": [
            "available_pinned",
            "available_unpinned",
            "partial_or_snippet",
            "not_published",
            "blocked",
            "not_applicable",
            "unknown"
          ]
        },
        "paper_uses_llm": {
          "enum": [
            "yes",
            "no",
            "possible",
            "not_applicable",
            "unknown"
          ]
        },
        "paper_llm_models": {
          "type": "array",
          "items": {"type": "string"}
        },
        "paper_llm_availability_status": {
          "enum": [
            "available_same_model",
            "available_alias_or_successor",
            "api_discontinued",
            "proxy_or_compatible_endpoint_required",
            "local_weight_available",
            "local_weight_or_proxy_available",
            "mixed_available_and_retired",
            "not_applicable",
            "unknown"
          ]
        },
        "paper_llm_availability_checked_at": {"type": "string"},
        "paper_llm_availability_evidence_urls": {
          "type": "array",
          "items": {"type": "string"}
        },
        "code_reproducibility": {
          "enum": [
            "not_applicable",
            "not_attempted",
            "initial_generation_connectivity_ok_via_openai_compatible_proxy",
            "single_system_connectivity_ok_via_ollama_compatible_proxy",
            "blocked",
            "failed"
          ]
        },
        "code_reproducibility_label": {
          "enum": [
            "⚪不适用",
            "⚪未尝试",
            "🟢初始连通",
            "🟢单系统连通",
            "❓受阻",
            "🔴失败"
          ]
        },
        "code_reproducibility_evidence_paths": {
          "type": "array",
          "items": {"type": "string"}
        },
        "resource_profile_notes": {"type": "string"}
      },
      "additionalProperties": true
    },
    "pair_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pair_set_id",
          "nl_role",
          "stm0_role",
          "raw_pair_count",
          "eligible_pair_count",
          "canonical_case_count",
          "reference_pair_count",
          "generation_actor",
          "generation_model_or_method",
          "stm_family",
          "stm_time_level",
          "eligibility_state",
          "must_not_count_as_generated",
          "excluded_outputs",
          "extracted_pairs_path",
          "nl_count"
        ],
        "properties": {
          "pair_set_id": {
            "type": "string"
          },
          "nl_role": {
            "type": "string"
          },
          "nl_source_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stm0_role": {
            "type": "string"
          },
          "stm0_source_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "raw_pair_count": {
            "type": "integer"
          },
          "eligible_pair_count": {
            "type": "integer"
          },
          "canonical_case_count": {
            "type": "integer"
          },
          "reference_pair_count": {
            "type": "integer"
          },
          "generation_actor": {
            "enum": [
              "LLM",
              "traditional_tool",
              "human",
              "pipeline_rerun_only",
              "unknown"
            ]
          },
          "generation_model_or_method": {
            "type": "string"
          },
          "stm_family": {
            "type": "string"
          },
          "stm_time_level": {
            "enum": [
              "T0",
              "T1",
              "T2",
              "unknown"
            ]
          },
          "eligibility_state": {
            "enum": [
              "final_pool_ready",
              "conditional_final_pool",
              "pipeline_only",
              "reference_only",
              "paper_reconstructable",
              "related_only",
              "excluded"
            ]
          },
          "must_not_count_as_generated": {
            "type": "boolean"
          },
          "excluded_outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "extracted_pairs_path": {
            "type": "string"
          },
          "nl_count": {
            "type": "object",
            "description": "Raw/unique/NL-only count facts used by REGISTRY.md NL 数 and NL-only columns.",
            "additionalProperties": {
              "type": [
                "integer",
                "string",
                "number",
                "boolean"
              ]
            }
          }
        },
        "additionalProperties": true
      }
    },
    "reference_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reference_set_id",
          "reference_pair_count",
          "must_not_count_as_generated",
          "source_fields_or_paths",
          "notes"
        ],
        "properties": {
          "reference_set_id": {
            "type": "string"
          },
          "reference_pair_count": {
            "type": "integer"
          },
          "must_not_count_as_generated": {
            "type": "boolean"
          },
          "source_fields_or_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "extracted_summary": {
      "type": "object",
      "required": [
        "pairs_jsonl",
        "pairs_preview",
        "field_mapping",
        "validation_summary",
        "eligible_generated_pair_count",
        "trace_verified_pair_count"
      ],
      "properties": {
        "pairs_jsonl": {
          "type": "string"
        },
        "pairs_preview": {
          "type": "string"
        },
        "field_mapping": {
          "type": "string"
        },
        "validation_summary": {
          "type": "string"
        },
        "eligible_generated_pair_count": {
          "type": "integer"
        },
        "trace_verified_pair_count": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "downstream_selection": {
      "type": "object",
      "required": [
        "representative_sample_recommendation",
        "source_coverage_class",
        "input_format_class",
        "conversion_pressure",
        "defect_risk_class",
        "selection_caveat"
      ],
      "properties": {
        "representative_sample_recommendation": {
          "enum": [
            "prefer",
            "usable_with_caveat",
            "rerun_required",
            "do_not_use_as_seed",
            "reference_only"
          ]
        },
        "source_coverage_class": {
          "type": "string"
        },
        "input_format_class": {
          "type": "string"
        },
        "conversion_pressure": {
          "type": "string"
        },
        "defect_risk_class": {
          "type": "string"
        },
        "selection_caveat": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "recommended_role": {
      "enum": [
        "final_pool_ready",
        "conditional_final_pool",
        "pipeline_only",
        "reference_only",
        "paper_reconstructable",
        "related_only",
        "excluded"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "legacy_audit_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "reason_not_first_source"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "reason_not_first_source": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "source_inventory": {
      "type": "object",
      "required": [
        "raw_nl_count",
        "unique_nl_count",
        "nl_only_count",
        "nl_only_unique_count",
        "generated_pair_count",
        "eligible_generated_pair_count",
        "reference_pair_count",
        "canonical_case_count",
        "unique_generated_stm0_count",
        "one_to_many_shape",
        "count_status",
        "count_basis",
        "notes"
      ],
      "properties": {
        "raw_nl_count": {
          "type": [
            "integer",
            "string"
          ]
        },
        "unique_nl_count": {
          "type": [
            "integer",
            "string"
          ]
        },
        "nl_only_count": {
          "type": [
            "integer",
            "string"
          ]
        },
        "nl_only_unique_count": {
          "type": [
            "integer",
            "string"
          ]
        },
        "generated_pair_count": {
          "type": "integer"
        },
        "eligible_generated_pair_count": {
          "type": "integer"
        },
        "reference_pair_count": {
          "type": "integer"
        },
        "canonical_case_count": {
          "type": "integer"
        },
        "unique_generated_stm0_count": {
          "type": [
            "integer",
            "string"
          ],
          "description": "Unique real generated STM_0 texts only; excluded failure sentinel rows are counted via nl_only_count / validation_summary.excluded_pair_ids / notes, not here."
        },
        "one_to_many_shape": {
          "type": "string"
        },
        "count_status": {
          "enum": [
            "verified",
            "unknown",
            "paper_only",
            "not_applicable",
            "artifact_reviewed"
          ]
        },
        "count_basis": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "data_construction": {
      "type": "object",
      "required": [
        "paper_read_status",
        "paper_claim_summary",
        "artifact_source",
        "generation_or_construction_pipeline",
        "what_is_raw_nl",
        "what_is_stm0",
        "evidence_paths"
      ],
      "properties": {
        "paper_read_status": {
          "type": "string"
        },
        "paper_claim_summary": {
          "type": "string"
        },
        "artifact_source": {
          "type": "string"
        },
        "generation_or_construction_pipeline": {
          "type": "string"
        },
        "what_is_raw_nl": {
          "type": "string"
        },
        "what_is_stm0": {
          "type": "string"
        },
        "evidence_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "quality_audit": {
      "type": "object",
      "required": [
        "audit_status",
        "sample_size",
        "sampled_items",
        "quality_findings",
        "domain_fit_caveat",
        "evidence_paths"
      ],
      "properties": {
        "audit_status": {
          "type": "string"
        },
        "sample_size": {
          "type": [
            "integer",
            "string"
          ]
        },
        "sampled_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quality_findings": {
          "type": "string"
        },
        "domain_fit_caveat": {
          "type": "string"
        },
        "evidence_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

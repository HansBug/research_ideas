{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assets_manifest.schema.json",
  "title": "Seed first-source assets manifest",
  "type": "object",
  "required": [
    "schema_version",
    "seed_id",
    "source_work",
    "manifest_created_at",
    "first_source_policy",
    "assets",
    "derived_assets",
    "skipped_assets"
  ],
  "properties": {
    "schema_version": {
      "const": "seed-assets-manifest.v1"
    },
    "seed_id": {
      "type": "string"
    },
    "source_work": {
      "type": "object"
    },
    "manifest_created_at": {
      "type": "string"
    },
    "first_source_policy": {
      "type": "string"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "role",
          "source_url",
          "source_url_type",
          "download_status",
          "accessed_at",
          "local_path",
          "storage_mode",
          "license_status",
          "redistribution_status",
          "version_pin",
          "sha256",
          "bytes",
          "notes"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "source_url_type": {
            "enum": [
              "paper",
              "publisher",
              "official_dataset",
              "author_artifact",
              "author_repo",
              "data_availability",
              "release",
              "metadata_api",
              "other_first_source"
            ]
          },
          "download_status": {
            "enum": [
              "downloaded",
              "skipped",
              "blocked",
              "metadata_only",
              "local_only"
            ]
          },
          "accessed_at": {
            "type": "string"
          },
          "local_path": {
            "type": "string"
          },
          "storage_mode": {
            "enum": [
              "committed",
              "local_only",
              "metadata_only",
              "skipped"
            ]
          },
          "license_status": {
            "enum": [
              "clear",
              "paper_only",
              "unknown",
              "missing",
              "restricted",
              "proprietary",
              "not_applicable"
            ]
          },
          "redistribution_status": {
            "enum": [
              "redistributable",
              "local_only",
              "metadata_only",
              "restricted",
              "unknown",
              "not_applicable"
            ]
          },
          "version_pin": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "bytes": {
            "type": "integer"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "derived_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "derived_asset_id",
          "role",
          "local_path",
          "derived_from_asset_ids",
          "derivation_method",
          "notes"
        ],
        "properties": {
          "derived_asset_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "local_path": {
            "type": "string"
          },
          "derived_from_asset_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "derivation_method": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "skipped_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_url",
          "download_status",
          "reason"
        ],
        "properties": {
          "source_url": {
            "type": "string"
          },
          "download_status": {
            "enum": [
              "skipped",
              "blocked",
              "metadata_only",
              "local_only"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

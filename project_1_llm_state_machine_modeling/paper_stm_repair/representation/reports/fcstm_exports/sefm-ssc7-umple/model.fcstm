def int hasItems = 0;
def int isValidBarcode = 0;
def int isValidCode = 0;
def int isValidStaffCode = 0;
def int act_clear_all = 0;
def int act_print_bill = 0;
def int act_show_error = 0;
def int act_turn_light_off = 0;
def int act_update_bag_count = 0;

state sefm_ssc7_umple named "sefm-ssc7-umple" {
    [*] -> Ready;
    event cancel named "cancel";
    event continue_ named "continue";
    event enterCode named "enterCode";
    event failure named "failure";
    event pay named "pay";
    event requestCancel named "requestCancel";
    event scanBarcode named "scanBarcode";
    event success named "success";
    event timeout named "timeout";
    event timeoutTimeoutToReady named "timeoutTimeoutToReady";
    event weighBag named "weighBag";
    event weightMatch named "weightMatch";
    event weightMismatch named "weightMismatch";
    event weightReceived named "weightReceived";
    state Ready named "Ready";
    state WeighingItem named "WeighingItem";
    state WeighingBag named "WeighingBag";
    state SecurityCheck named "SecurityCheck";
    state Payment named "Payment";
    state Override named "Override";
    state Timeout named "Timeout";
    pseudo state ready_scan_barcode_is_valid_barcode_security_check_relay named "Ready scanBarcode [isValidBarcode] -> SecurityCheck";
    pseudo state ready_scan_barcode_is_valid_barcode_ready_relay named "Ready scanBarcode [!isValidBarcode] -> Ready";
    pseudo state ready_enter_code_is_valid_code_weighing_item_relay named "Ready enterCode [isValidCode] -> WeighingItem";
    pseudo state ready_enter_code_is_valid_code_ready_relay named "Ready enterCode [!isValidCode] -> Ready";
    pseudo state ready_pay_has_items_payment_relay named "Ready pay [hasItems] -> Payment";
    pseudo state override_enter_code_is_valid_staff_code_ready_relay named "Override enterCode [isValidStaffCode] -> Ready";
    pseudo state override_enter_code_is_valid_staff_code_override_relay named "Override enterCode [!isValidStaffCode] -> Override";
    Ready -> ready_scan_barcode_is_valid_barcode_security_check_relay : scanBarcode;
    ready_scan_barcode_is_valid_barcode_security_check_relay -> SecurityCheck : if [isValidBarcode > 0];
    Ready -> ready_scan_barcode_is_valid_barcode_ready_relay : scanBarcode;
    ready_scan_barcode_is_valid_barcode_ready_relay -> Ready : if [isValidBarcode == 0] effect { act_show_error = 1; };
    Ready -> ready_enter_code_is_valid_code_weighing_item_relay : enterCode;
    ready_enter_code_is_valid_code_weighing_item_relay -> WeighingItem : if [isValidCode > 0];
    Ready -> ready_enter_code_is_valid_code_ready_relay : enterCode;
    ready_enter_code_is_valid_code_ready_relay -> Ready : if [isValidCode == 0] effect { act_show_error = 1; };
    Ready -> WeighingBag : weighBag;
    Ready -> ready_pay_has_items_payment_relay : pay;
    ready_pay_has_items_payment_relay -> Payment : if [hasItems > 0];
    Ready -> Timeout : timeout;
    WeighingItem -> SecurityCheck : weightReceived;
    WeighingItem -> Ready : cancel;
    WeighingItem -> Override : requestCancel;
    WeighingBag -> Ready : weightReceived effect { act_update_bag_count = 1; };
    WeighingBag -> Ready : cancel;
    SecurityCheck -> Ready : weightMatch;
    SecurityCheck -> Override : weightMismatch;
    SecurityCheck -> Override : requestCancel;
    Payment -> Ready : success effect { act_print_bill = 1; };
    Payment -> Ready : failure effect { act_show_error = 1; };
    Payment -> Ready : cancel;
    Override -> override_enter_code_is_valid_staff_code_ready_relay : enterCode;
    override_enter_code_is_valid_staff_code_ready_relay -> Ready : if [isValidStaffCode > 0] effect { act_turn_light_off = 1; };
    Override -> override_enter_code_is_valid_staff_code_override_relay : enterCode;
    override_enter_code_is_valid_staff_code_override_relay -> Override : if [isValidStaffCode == 0] effect { act_show_error = 1; };
    Timeout -> Ready : continue_;
    Timeout -> Ready : timeoutTimeoutToReady effect { act_clear_all = 1; };
}

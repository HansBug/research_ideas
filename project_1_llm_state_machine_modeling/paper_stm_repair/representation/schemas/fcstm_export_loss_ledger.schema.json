{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paper-stm-repair:r4-5:fcstm-export-loss-ledger:v0",
  "title": "R4.5 FCSTM export loss ledger row v0",
  "type": "object",
  "required": ["schema_version", "example_id", "loss_id", "reason_code", "severity", "loss_type", "message", "canonical_ref", "affected_item_id", "repair_contribution_allowed", "attribution"],
  "properties": {
    "schema_version": {"const": "r4_5.fcstm_export_loss_ledger.v0"},
    "example_id": {"type": "string"},
    "loss_id": {"type": "string"},
    "reason_code": {"type": "string", "pattern": "^R45\\."},
    "severity": {"type": "string"},
    "loss_type": {"type": "string"},
    "message": {"type": "string"},
    "canonical_ref": {"type": ["string", "null"]},
    "affected_item_id": {"type": ["string", "null"]},
    "repair_contribution_allowed": {"const": false},
    "attribution": {"const": "representation_lowering_not_repair"},
    "extra": {"type": "object"}
  },
  "additionalProperties": false
}

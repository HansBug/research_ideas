{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paper-stm-repair:r4-5:lowering-inventory:v0",
  "title": "R4.5 lowering inventory v0",
  "oneOf": [
    {"$ref": "#/$defs/single"},
    {
      "type": "object",
      "required": ["schema_version", "items"],
      "properties": {
        "schema_version": {"const": "r4_5.lowering_inventory_bundle.v0"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/single"}}
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "single": {
      "type": "object",
      "required": ["schema_version", "example_id", "seed_id", "source_status", "counts", "events", "guards", "actions", "references", "initial_final", "timing", "hierarchy", "source_traceability", "blocked_supplementary"],
      "properties": {
        "schema_version": {"const": "r4_5.lowering_inventory.v0"},
        "example_id": {"type": "string"},
        "seed_id": {"type": "string"},
        "source_status": {"type": ["string", "null"]},
        "counts": {"type": "object"},
        "events": {"type": "array"},
        "guards": {"type": "array"},
        "actions": {"type": "array"},
        "references": {"type": "array"},
        "initial_final": {"type": "array"},
        "timing": {"type": "array"},
        "hierarchy": {"type": "array"},
        "source_traceability": {
          "type": "object",
          "required": [
            "example_id",
            "upstream_r3_status",
            "upstream_r3_status_reason_code",
            "upstream_source_format",
            "upstream_conversion_source",
            "upstream_source_nl_path",
            "upstream_source_stm0_path",
            "upstream_source_meta_path",
            "selected_example_dir",
            "source_nl_path",
            "source_stm0_path",
            "source_meta_path",
            "canonical_output_path",
            "canonical_output_sha256",
            "source_sha256",
            "raw_locator",
            "r3_1_normalization_replay_used",
            "repair_contribution_allowed",
            "attribution"
          ],
          "properties": {
            "example_id": {"type": "string"},
            "upstream_r3_status": {"type": ["string", "null"]},
            "upstream_r3_status_reason_code": {"type": ["string", "null"]},
            "upstream_source_format": {"type": ["string", "null"]},
            "upstream_conversion_source": {"type": ["string", "null"]},
            "upstream_source_nl_path": {"type": ["string", "null"]},
            "upstream_source_stm0_path": {"type": ["string", "null"]},
            "upstream_source_meta_path": {"type": ["string", "null"]},
            "selected_example_dir": {"type": "string"},
            "source_nl_path": {"type": "string"},
            "source_stm0_path": {"type": ["string", "null"]},
            "source_meta_path": {"type": "string"},
            "canonical_output_path": {"type": ["string", "null"]},
            "canonical_output_sha256": {"type": ["string", "null"]},
            "source_sha256": {"type": ["string", "null"]},
            "raw_locator": {"type": ["string", "null"]},
            "r3_1_normalization_replay_used": {"type": "boolean"},
            "repair_contribution_allowed": {"const": false},
            "attribution": {"const": "representation_lowering_not_repair"}
          },
          "additionalProperties": false
        },
        "blocked_supplementary": {"type": "array"}
      },
      "additionalProperties": false
    }
  }
}

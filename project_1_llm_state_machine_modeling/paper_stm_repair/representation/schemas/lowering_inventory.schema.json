{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paper-stm-repair:r4-5:lowering-inventory:v0",
  "title": "R4.5 lowering inventory v0",
  "oneOf": [
    {"$ref": "#/$defs/single"},
    {
      "type": "object",
      "required": ["schema_version", "items"],
      "properties": {
        "schema_version": {"const": "r4_5.lowering_inventory_bundle.v0"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/single"}}
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "single": {
      "type": "object",
      "required": ["schema_version", "example_id", "seed_id", "source_status", "counts", "events", "guards", "actions", "references", "initial_final", "timing", "hierarchy", "blocked_supplementary"],
      "properties": {
        "schema_version": {"const": "r4_5.lowering_inventory.v0"},
        "example_id": {"type": "string"},
        "seed_id": {"type": "string"},
        "source_status": {"type": ["string", "null"]},
        "counts": {"type": "object"},
        "events": {"type": "array"},
        "guards": {"type": "array"},
        "actions": {"type": "array"},
        "references": {"type": "array"},
        "initial_final": {"type": "array"},
        "timing": {"type": "array"},
        "hierarchy": {"type": "array"},
        "blocked_supplementary": {"type": "array"}
      },
      "additionalProperties": false
    }
  }
}

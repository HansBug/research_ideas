{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seed_sweep_report.schema.json",
  "title": "R5 seed library sweep report",
  "type": "object",
  "required": ["schema_version", "run_id", "meta", "summary", "entries"],
  "properties": {
    "schema_version": {"const": "r5.seed_sweep_report.v0"},
    "run_id": {"type": "string"},
    "meta": {
      "type": "object",
      "required": ["schema_version", "entry_dir_count", "registry_entry_count", "unregistered_entry_count", "excluded_non_entry_dirs", "repair_contribution_allowed"],
      "properties": {
        "schema_version": {"const": "r5.seed_sweep_report.v0"},
        "entry_dir_count": {"type": "integer"},
        "registry_entry_count": {"type": "integer"},
        "unregistered_entry_count": {"type": "integer"},
        "excluded_non_entry_dirs": {"type": "array", "items": {"type": "string"}},
        "repair_contribution_allowed": {"const": false}
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": ["entry_status_counts", "pair_status_counts", "asset_status_counts", "entries_total", "pair_records_total", "asset_records_total", "archives_total"],
      "properties": {
        "entry_status_counts": {"type": "object"},
        "pair_status_counts": {"type": "object"},
        "asset_status_counts": {"type": "object"},
        "entries_total": {"type": "integer"},
        "pair_records_total": {"type": "integer"},
        "asset_records_total": {"type": "integer"},
        "archives_total": {"type": "integer"}
      },
      "additionalProperties": true
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema_version", "entry_id", "primary_entry_status", "entry_statuses", "status_counts_by_pair", "repair_contribution_allowed"],
        "properties": {
          "schema_version": {"const": "r5.seed_sweep_entry_record.v0"},
          "entry_id": {"type": "string"},
          "primary_entry_status": {"enum": ["converted", "partial", "blocked", "not_applicable", "needs_generation", "missing_asset"]},
          "entry_statuses": {"type": "array", "items": {"enum": ["converted", "partial", "blocked", "not_applicable", "needs_generation", "missing_asset"]}},
          "status_counts_by_pair": {"type": "object"},
          "repair_contribution_allowed": {"const": false}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

   770	11 :: counter  < MAX_MESSAGES  ->
   771	12 sent_message=counter;
   772	13 sender_to_receiver!sent_message;
   773	14 counter++;
   774	15 ::counter  == MAX_MESSAGES  ->goto done;
   775	16 od;
   776	17 done: skip ;
   777	18}
   778	19
   779	20proctype Receiver( chan receiver_to_sender)  {
   780	21int expected_counter  = 0;
   781	22do
   782	23 ::expected_counter  < MAX_MESSAGES  ->
   783	24 receiver_to_sender?
   784	received_message;
   785	25 assert (received_message
   786	==sent_message);
   787	26 expected_counter++;
   788	27 ::expected_counter  == MAX_MESSAGES  ->
   789	break ;
   790	28od;
   791	29}
   792	30
   793	31init {
   794	32 run Sender(communication);

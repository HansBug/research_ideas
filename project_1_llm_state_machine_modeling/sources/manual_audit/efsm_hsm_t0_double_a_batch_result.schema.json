{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string"
          },
          "cluster_key": {
            "type": "string"
          },
          "scope_level": {
            "type": "string",
            "enum": [
              "整机",
              "子系统",
              "构件"
            ]
          },
          "complexity_bin": {
            "type": "string",
            "enum": [
              "小",
              "中",
              "大"
            ]
          },
          "evidence_compactness": {
            "type": "string",
            "enum": [
              "直述",
              "整合",
              "重构"
            ]
          },
          "hidden_time_risk": {
            "type": "string",
            "enum": [
              "低",
              "中",
              "高"
            ]
          },
          "pyfcstm_fit": {
            "type": "string",
            "enum": [
              "直接",
              "轻归一",
              "重归一"
            ]
          },
          "rationale": {
            "type": "string"
          }
        },
        "required": [
          "case_id",
          "cluster_key",
          "scope_level",
          "complexity_bin",
          "evidence_compactness",
          "hidden_time_risk",
          "pyfcstm_fit",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "results"
  ],
  "additionalProperties": false
}

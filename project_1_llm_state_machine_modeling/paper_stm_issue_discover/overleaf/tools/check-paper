#!/usr/bin/env python3
"""Single deterministic F1 gate; intentionally provider-free."""
from pathlib import Path
import os, re, shutil, subprocess, sys, tempfile, zipfile

ROOT = Path(__file__).resolve().parents[1]
os.environ.setdefault("SOURCE_DATE_EPOCH", "0")
def run(cmd, cwd=ROOT):
    print("$", " ".join(cmd))
    return subprocess.run(cmd, cwd=cwd, check=False).returncode

for name in ["validate-template-integrity", "validate-bilingual", "validate-content-boundary", "validate-format-policy", "validate-portability", "validate-review-artifact-manifest"]:
    if run([str(ROOT / "tools" / name)]): sys.exit(1)
if run(["make", "clean"]): sys.exit(1)
if run(["make", "en"]): sys.exit(1)
if run(["make", "zh"]): sys.exit(1)
if run([str(ROOT / "tools" / "validate-anonymity")]): sys.exit(1)
for pdf in [ROOT / "build/en/main.pdf", ROOT / "build/zh/main-zh.pdf"]:
    if not pdf.is_file() or pdf.stat().st_size == 0:
        print(f"CHECK FAIL: missing or empty {pdf}"); sys.exit(1)
    log = pdf.with_suffix(".log").read_text(encoding="utf-8", errors="ignore")
    if re.search(r"(?i)(undefined references?|undefined citations?|there were undefined)", log):
        print(f"CHECK FAIL: unresolved reference/citation in {pdf.name}"); sys.exit(1)
    if re.search(r"(?i)(LaTeX (?:Warning|Error)|Overfull \\hbox|Underfull \\hbox)", log):
        print(f"CHECK FAIL: compilation warning/error in {pdf.name}"); sys.exit(1)
with tempfile.TemporaryDirectory(prefix="f1-overleaf-roundtrip-") as td:
    source = Path(td) / "source"
    shutil.copytree(ROOT, source, ignore=shutil.ignore_patterns("build", ".git", "__pycache__", "*.pyc"))
    archive = Path(td) / "overleaf-source.zip"
    with zipfile.ZipFile(archive, "w", zipfile.ZIP_DEFLATED) as zf:
        for path in source.rglob("*"):
            if path.is_file(): zf.write(path, path.relative_to(source).as_posix())
    extracted = Path(td) / "extracted"
    extracted.mkdir()
    with zipfile.ZipFile(archive) as zf: zf.extractall(extracted)
    if run(["make", "clean"], extracted): sys.exit(1)
    if run(["make", "en"], extracted): sys.exit(1)
    if run(["make", "zh"], extracted): sys.exit(1)
    for name in ["build/en/main.pdf", "build/zh/main-zh.pdf"]:
        if not (extracted / name).is_file():
            print(f"CHECK FAIL: round-trip did not produce {name}"); sys.exit(1)
print("CHECK PASS: F1 template, bilingual, format, portability, clean English/Chinese build, and anonymity gates")

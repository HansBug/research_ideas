{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paper-stm-repair:r3.1:normalization-ledger-row:v0",
  "title": "R3.1 PlantUML normalization ledger row v0",
  "type": "object",
  "required": [
    "ledger_version",
    "run_id",
    "seed_id",
    "pair_id",
    "row_index",
    "change_index",
    "source_pairs_path",
    "source_locator",
    "source_line_sha256",
    "source_file_sha256",
    "raw_sha256",
    "normalized_sha256",
    "normalized_candidate_path",
    "rule_id",
    "line",
    "before",
    "after",
    "kind",
    "semantic_risk",
    "risk_tier",
    "main_eligibility_default",
    "rationale",
    "loss_type",
    "concurrency_degraded",
    "needs_manual_review",
    "technical_scxml_pass_all_rules",
    "low_risk_scxml_pass",
    "main_eligibility_included",
    "semantic_preservation_pass",
    "semantic_preservation_audit_status",
    "repair_contribution_allowed"
  ],
  "properties": {
    "ledger_version": {
      "const": "r3.1.normalization_ledger.v0"
    },
    "run_id": {
      "type": "string"
    },
    "seed_id": {
      "type": "string"
    },
    "pair_id": {
      "type": "string"
    },
    "row_index": {
      "type": "integer",
      "minimum": 0
    },
    "change_index": {
      "type": "integer",
      "minimum": 1
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "normalized_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "normalized_candidate_path": {
      "type": "string"
    },
    "technical_scxml_pass_all_rules": {
      "type": "boolean"
    },
    "low_risk_scxml_pass": {
      "type": "boolean"
    },
    "main_eligibility_included": {
      "type": "boolean"
    },
    "semantic_preservation_pass": {
      "type": "boolean"
    },
    "semantic_preservation_audit_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "rule_id": {
      "type": "string",
      "pattern": "^PUML\\.NORM\\.[A-Za-z0-9_]+$"
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "span": {
      "type": [
        "string",
        "null"
      ]
    },
    "before": {
      "type": "string"
    },
    "after": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "semantic_risk": {
      "type": "string"
    },
    "risk_tier": {
      "enum": [
        "low_risk",
        "high_risk"
      ]
    },
    "main_eligibility_default": {
      "type": "boolean"
    },
    "rationale": {
      "type": "string"
    },
    "loss_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "concurrency_degraded": {
      "type": "boolean"
    },
    "needs_manual_review": {
      "type": "boolean"
    },
    "repair_contribution_allowed": {
      "const": false
    },
    "source_pairs_path": {
      "type": "string"
    },
    "source_locator": {
      "type": "string"
    },
    "source_line_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_file_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="HumanDriving"/>
</state>
<state id="HumanDriving">
<transition event="Power Off" target="FinalState"/>
<state id="startHumanDriving">
<transition event="Power On" target="InitialState"/>
</state>
<state id="InitialState">
<transition event="Front Distance &gt; 10" target="Autonomous"/>
<transition event="Exit Autonomous" target="FinalState"/>
</state>
<state id="FinalState"/>
<state id="Autonomous">
<transition event="Human Steering Cmd or Brake Pressed" target="HumanDriving"/>
<state id="startAutonomous">
<transition event="Enter Autonomous" target="InitialState"/>
</state>
</state>
</state>
</scxml>

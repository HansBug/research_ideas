<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DoorShut"/>
</state>
<state id="DoorShut">
<state id="startDoorShut">
<transition target="DoorShutIdle"/>
</state>
<state id="DoorShutIdle">
<transition event="Cancel" target="DoorShutIdle"/>
<transition event="Door Opened" target="DoorOpen"/>
</state>
<state id="DoorOpen">
<state id="startDoorOpen">
<transition target="DoorOpenIdle"/>
</state>
<state id="DoorOpenIdle">
<transition event="Item Placed" target="DoorOpenWithItem"/>
</state>
<state id="DoorOpenWithItem">
<transition event="Item Removed" target="DoorOpenIdle"/>
<transition event="Door Closed [zero time set]" target="DoorShutWithItem"/>
<transition event="Cooking Time Entered" target="ReadytoCook"/>
</state>
<state id="DoorShutWithItem">
<state id="startDoorShutWithItem">
<transition target="DoorShutWithItemIdle"/>
</state>
<state id="DoorShutWithItemIdle">
<transition event="Door Opened" target="DoorOpenWithItem"/>
<transition event="Cooking Time Entered" target="ReadytoCook"/>
</state>
</state>
<state id="ReadytoCook">
<state id="startReadytoCook">
<transition target="ReadytoCookIdle"/>
</state>
<state id="ReadytoCookIdle">
<transition event="Cancel" target="DoorShutWithItem"/>
<transition event="Door Opened" target="DoorOpenWithItem"/>
<transition event="Start" target="Cooking"/>
</state>
<state id="Cooking">
<state id="startCooking">
<transition target="CookingIdle"/>
</state>
<state id="CookingIdle">
<transition event="Door Opened" target="DoorOpenWithItem"/>
<transition event="Timer Expired" target="DoorShutWithItem"/>
<transition event="Cancel" target="ReadytoCook"/>
</state>
</state>
</state>
</state>
</state>
</scxml>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "selected_smoke_report.schema.json",
  "title": "R5 selected smoke report",
  "type": "object",
  "required": ["schema_version", "run_id", "created_at", "repo_commit", "repair_contribution_allowed", "items", "summary"],
  "properties": {
    "schema_version": {"const": "r5.selected_smoke_report.v0"},
    "run_id": {"type": "string"},
    "created_at": {"type": "string"},
    "repo_commit": {"type": "string"},
    "repair_contribution_allowed": {"const": false},
    "items": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["schema_version", "example_id", "source", "upstream_r3", "upstream_r45", "checks", "status", "status_reason_code", "repair_contribution_allowed", "attribution"],
        "properties": {
          "schema_version": {"const": "r5.selected_smoke_record.v0"},
          "example_id": {"type": "string"},
          "source": {"type": "object"},
          "upstream_r3": {"type": "object"},
          "upstream_r45": {"type": "object"},
          "checks": {"type": "object"},
          "status": {"enum": ["pass", "partial", "blocked"]},
          "status_reason_code": {"type": "string"},
          "repair_contribution_allowed": {"const": false},
          "attribution": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "required": ["examples", "pass", "partial", "blocked"],
      "properties": {
        "examples": {"type": "integer"},
        "pass": {"type": "integer"},
        "partial": {"type": "integer"},
        "blocked": {"type": "integer"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}

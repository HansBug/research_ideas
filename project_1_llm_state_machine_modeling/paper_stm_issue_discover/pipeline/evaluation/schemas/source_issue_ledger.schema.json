{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-ideas.local/project_1/paper_stm_issue_discover/source_issue_ledger.schema.json",
  "title": "Source Issue Ledger v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ledger_id",
    "case_id",
    "source_model_id",
    "nl_reference",
    "source_artifact_reference",
    "ledger_scope",
    "issues",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "source_issue_ledger.v0"
    },
    "ledger_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "source_model_id": {
      "type": "string",
      "minLength": 1
    },
    "ledger_scope": {
      "enum": [
        "contract_fixture",
        "pilot_candidate",
        "formal_experiment_candidate"
      ]
    },
    "nl_reference": {
      "$ref": "#/$defs/artifact_reference"
    },
    "source_artifact_reference": {
      "$ref": "#/$defs/artifact_reference"
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_type",
        "reference",
        "summary"
      ],
      "properties": {
        "reference_type": {
          "enum": [
            "synthetic_inline",
            "repo_path",
            "archive_reference",
            "external_reference"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_element_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element_id",
        "element_type",
        "reference",
        "summary"
      ],
      "properties": {
        "element_id": {
          "type": "string",
          "minLength": 1
        },
        "element_type": {
          "enum": [
            "state",
            "transition",
            "event",
            "guard",
            "action",
            "effect",
            "variable",
            "hierarchy",
            "model",
            "unknown"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "base_evidence_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_type",
        "reference",
        "summary"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_type": {
          "type": "string"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nl_evidence_item": {
      "allOf": [
        {
          "$ref": "#/$defs/base_evidence_fields"
        },
        {
          "properties": {
            "evidence_type": {
              "enum": [
                "nl_requirement",
                "human_annotation",
                "other_reference"
              ]
            }
          }
        }
      ]
    },
    "source_stm_evidence_item": {
      "allOf": [
        {
          "$ref": "#/$defs/base_evidence_fields"
        },
        {
          "properties": {
            "evidence_type": {
              "enum": [
                "source_stm_fragment",
                "human_annotation",
                "other_reference"
              ]
            }
          }
        }
      ]
    },
    "behavior_evidence_item": {
      "allOf": [
        {
          "$ref": "#/$defs/base_evidence_fields"
        },
        {
          "properties": {
            "evidence_type": {
              "enum": [
                "inspect_diagnostic",
                "simulation_trace",
                "probe_result",
                "verification_counterexample",
                "source_internal_consistency_check",
                "conversion_report",
                "human_annotation",
                "other_reference"
              ]
            }
          }
        }
      ]
    },
    "attribution_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_level_claim_allowed",
        "conversion_or_lowering_related",
        "representation_related",
        "rationale"
      ],
      "properties": {
        "source_level_claim_allowed": {
          "type": "boolean"
        },
        "conversion_or_lowering_related": {
          "type": "boolean"
        },
        "representation_related": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "issue_level",
        "issue_family",
        "confirmation_status",
        "confirmation_evidence_path",
        "candidate_description",
        "source_element_refs",
        "nl_evidence",
        "source_stm_evidence",
        "behavior_evidence",
        "confirmation_rationale",
        "attribution_boundary",
        "rejection_reason",
        "downstream_repair_allowed",
        "required_future_trace",
        "reviewer_notes"
      ],
      "properties": {
        "issue_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z0-9_.-]+$"
        },
        "issue_level": {
          "enum": [
            "candidate",
            "confirmed",
            "rejected",
            "out_of_scope",
            "insufficient_evidence"
          ]
        },
        "issue_family": {
          "enum": [
            "guard_condition_mismatch",
            "expression_debt_or_folded_behavior",
            "raw_internal_inconsistency",
            "conversion_artifact",
            "timed_or_hybrid_out_of_scope",
            "insufficient_requirement_evidence",
            "other_v0"
          ]
        },
        "confirmation_status": {
          "enum": [
            "candidate_only",
            "confirmed",
            "rejected_conversion_artifact",
            "rejected_other",
            "out_of_scope",
            "insufficient_evidence"
          ]
        },
        "confirmation_evidence_path": {
          "enum": [
            "nl_grounded_behavioral_issue",
            "raw_internal_inconsistency",
            "not_applicable"
          ]
        },
        "candidate_description": {
          "type": "string",
          "minLength": 1
        },
        "source_element_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_element_ref"
          }
        },
        "nl_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nl_evidence_item"
          }
        },
        "source_stm_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_stm_evidence_item"
          }
        },
        "behavior_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/behavior_evidence_item"
          }
        },
        "confirmation_rationale": {
          "type": "string"
        },
        "attribution_boundary": {
          "$ref": "#/$defs/attribution_boundary"
        },
        "rejection_reason": {
          "type": "string"
        },
        "downstream_repair_allowed": {
          "type": "boolean"
        },
        "required_future_trace": {
          "type": "boolean"
        },
        "reviewer_notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "downstream_repair_allowed": {
                "const": true
              }
            },
            "required": [
              "downstream_repair_allowed"
            ]
          },
          "then": {
            "properties": {
              "confirmation_status": {
                "const": "confirmed"
              },
              "issue_level": {
                "const": "confirmed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confirmation_status": {
                "const": "confirmed"
              }
            },
            "required": [
              "confirmation_status"
            ]
          },
          "then": {
            "properties": {
              "issue_level": {
                "const": "confirmed"
              },
              "downstream_repair_allowed": {
                "const": true
              },
              "rejection_reason": {
                "const": ""
              },
              "source_element_refs": {
                "minItems": 1
              },
              "source_stm_evidence": {
                "minItems": 1
              },
              "behavior_evidence": {
                "minItems": 1
              },
              "confirmation_rationale": {
                "type": "string",
                "minLength": 1
              },
              "issue_family": {
                "not": {
                  "enum": [
                    "expression_debt_or_folded_behavior",
                    "conversion_artifact",
                    "timed_or_hybrid_out_of_scope",
                    "insufficient_requirement_evidence"
                  ]
                }
              },
              "attribution_boundary": {
                "properties": {
                  "source_level_claim_allowed": {
                    "const": true
                  },
                  "conversion_or_lowering_related": {
                    "const": false
                  },
                  "representation_related": {
                    "const": false
                  }
                },
                "required": [
                  "source_level_claim_allowed",
                  "conversion_or_lowering_related",
                  "representation_related"
                ]
              }
            },
            "anyOf": [
              {
                "properties": {
                  "confirmation_evidence_path": {
                    "const": "nl_grounded_behavioral_issue"
                  }
                }
              },
              {
                "properties": {
                  "confirmation_evidence_path": {
                    "const": "raw_internal_inconsistency"
                  }
                }
              }
            ]
          },
          "else": {
            "properties": {
              "downstream_repair_allowed": {
                "const": false
              },
              "confirmation_evidence_path": {
                "const": "not_applicable"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confirmation_evidence_path": {
                "const": "nl_grounded_behavioral_issue"
              }
            },
            "required": [
              "confirmation_evidence_path"
            ]
          },
          "then": {
            "properties": {
              "confirmation_status": {
                "const": "confirmed"
              },
              "nl_evidence": {
                "minItems": 1,
                "contains": {
                  "properties": {
                    "evidence_type": {
                      "const": "nl_requirement"
                    }
                  },
                  "required": [
                    "evidence_type"
                  ]
                }
              },
              "source_stm_evidence": {
                "minItems": 1,
                "contains": {
                  "properties": {
                    "evidence_type": {
                      "const": "source_stm_fragment"
                    }
                  },
                  "required": [
                    "evidence_type"
                  ]
                }
              },
              "behavior_evidence": {
                "minItems": 1,
                "contains": {
                  "properties": {
                    "evidence_type": {
                      "enum": [
                        "inspect_diagnostic",
                        "simulation_trace",
                        "probe_result",
                        "verification_counterexample"
                      ]
                    }
                  },
                  "required": [
                    "evidence_type"
                  ]
                }
              },
              "confirmation_rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confirmation_evidence_path": {
                "const": "raw_internal_inconsistency"
              }
            },
            "required": [
              "confirmation_evidence_path"
            ]
          },
          "then": {
            "properties": {
              "confirmation_status": {
                "const": "confirmed"
              },
              "issue_family": {
                "const": "raw_internal_inconsistency"
              },
              "source_element_refs": {
                "minItems": 2
              },
              "source_stm_evidence": {
                "minItems": 2
              },
              "behavior_evidence": {
                "minItems": 1,
                "contains": {
                  "properties": {
                    "evidence_type": {
                      "const": "source_internal_consistency_check"
                    }
                  },
                  "required": [
                    "evidence_type"
                  ]
                }
              },
              "confirmation_rationale": {
                "type": "string",
                "pattern": "(?i).*NL evidence.*not required.*"
              },
              "attribution_boundary": {
                "properties": {
                  "source_level_claim_allowed": {
                    "const": true
                  },
                  "conversion_or_lowering_related": {
                    "const": false
                  },
                  "representation_related": {
                    "const": false
                  }
                }
              },
              "nl_evidence": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confirmation_status": {
                "const": "rejected_conversion_artifact"
              }
            },
            "required": [
              "confirmation_status"
            ]
          },
          "then": {
            "properties": {
              "issue_level": {
                "const": "rejected"
              },
              "issue_family": {
                "const": "conversion_artifact"
              },
              "attribution_boundary": {
                "properties": {
                  "source_level_claim_allowed": {
                    "const": false
                  },
                  "conversion_or_lowering_related": {
                    "const": true
                  }
                },
                "required": [
                  "source_level_claim_allowed",
                  "conversion_or_lowering_related"
                ]
              },
              "rejection_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confirmation_status": {
                "const": "rejected_other"
              }
            },
            "required": [
              "confirmation_status"
            ]
          },
          "then": {
            "properties": {
              "issue_level": {
                "const": "rejected"
              },
              "rejection_reason": {
                "type": "string",
                "minLength": 1
              },
              "attribution_boundary": {
                "properties": {
                  "source_level_claim_allowed": {
                    "const": false
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confirmation_status": {
                "const": "candidate_only"
              }
            },
            "required": [
              "confirmation_status"
            ]
          },
          "then": {
            "properties": {
              "issue_level": {
                "const": "candidate"
              },
              "attribution_boundary": {
                "properties": {
                  "source_level_claim_allowed": {
                    "const": false
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confirmation_status": {
                "const": "out_of_scope"
              }
            },
            "required": [
              "confirmation_status"
            ]
          },
          "then": {
            "properties": {
              "issue_level": {
                "const": "out_of_scope"
              },
              "issue_family": {
                "const": "timed_or_hybrid_out_of_scope"
              },
              "rejection_reason": {
                "type": "string",
                "minLength": 1
              },
              "attribution_boundary": {
                "properties": {
                  "source_level_claim_allowed": {
                    "const": false
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confirmation_status": {
                "const": "insufficient_evidence"
              }
            },
            "required": [
              "confirmation_status"
            ]
          },
          "then": {
            "properties": {
              "issue_level": {
                "const": "insufficient_evidence"
              },
              "issue_family": {
                "const": "insufficient_requirement_evidence"
              },
              "rejection_reason": {
                "type": "string",
                "minLength": 1
              },
              "attribution_boundary": {
                "properties": {
                  "source_level_claim_allowed": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}

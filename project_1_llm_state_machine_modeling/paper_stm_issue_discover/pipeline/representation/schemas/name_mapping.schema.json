{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paper-stm-repair:r4-5:name-mapping:v0",
  "title": "R4.5 name mapping v0",
  "type": "object",
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"const": "r4_5.name_mapping.v0"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["raw_text", "canonical_ref", "emitted_identifier", "emitted_path", "object_type", "generated_reason", "named_text", "tool_function", "tool_parameters", "collision_group", "suffix_policy", "is_dsl_keyword_adjusted"],
        "properties": {
          "raw_text": {"type": "string"},
          "canonical_ref": {"type": ["string", "null"]},
          "emitted_identifier": {"type": "string", "minLength": 1},
          "emitted_path": {"type": "string", "minLength": 1},
          "object_type": {"type": "string", "minLength": 1},
          "generated_reason": {"type": "string", "minLength": 1},
          "named_text": {"type": ["string", "null"]},
          "tool_function": {"type": "string", "minLength": 1},
          "tool_parameters": {"type": "object"},
          "collision_group": {"type": ["string", "null"]},
          "suffix_policy": {"type": "string", "minLength": 1},
          "is_dsl_keyword_adjusted": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HansBug/research_ideas/paper1/experiment-dependent-gates.schema.json",
  "schema_version": "paper1.experiment-dependent-gates.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"const": "paper1.experiment-dependent-gates.v1"},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "nonempty_string_array": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "necessity_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["literature", "logic", "code_audit", "existing_artifacts"],
      "properties": {
        "literature": {"type": "string", "minLength": 1},
        "logic": {"type": "string", "minLength": 1},
        "code_audit": {"type": "string", "minLength": 1},
        "existing_artifacts": {"type": "string", "minLength": 1}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "necessity_proof", "hypothesis", "object", "control", "unit", "denominator", "metric", "affected_claims", "affected_rqs", "outline_locations", "forbidden_pre_experiment_claims", "temporary_writable_conclusion", "blocks_r1_ready", "blocks_paper_submission"],
      "properties": {
        "id": {"type": "string", "pattern": "^TODO-EXPERIMENT-[0-9]{2}$"},
        "necessity_proof": {"$ref": "#/$defs/necessity_proof"},
        "hypothesis": {"type": "string", "minLength": 1},
        "object": {"type": "string", "minLength": 1},
        "control": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "denominator": {"type": "string", "minLength": 1},
        "metric": {"type": "string", "minLength": 1},
        "affected_claims": {"$ref": "#/$defs/nonempty_string_array"},
        "affected_rqs": {"$ref": "#/$defs/nonempty_string_array"},
        "outline_locations": {"$ref": "#/$defs/nonempty_string_array"},
        "forbidden_pre_experiment_claims": {"$ref": "#/$defs/nonempty_string_array"},
        "temporary_writable_conclusion": {"type": "string", "minLength": 1},
        "blocks_r1_ready": {"type": "boolean"},
        "blocks_paper_submission": {"type": "boolean"}
      }
    }
  }
}

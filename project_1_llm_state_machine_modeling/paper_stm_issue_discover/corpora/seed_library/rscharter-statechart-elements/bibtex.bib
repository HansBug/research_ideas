	title = {Rscharter: {A} {Framework} for {Extracting} {Statechart} {Diagram} {Elements} from the {Requirements} {Specification}},
	shorttitle = {Rscharter},
	url = {https://papers.ssrn.com/abstract=4964857},
	doi = {10.2139/ssrn.4964857},
	abstract = {Context: The automated translation of design models from the requirements written in natural language (NL) textual format is tedious.  An NL is inherently ambiguous, whereas a formal language is unambiguous.Objective: In this paper, we propose a framework, Requirement Specification Charter (RSCharter), for translating NL textual specifications into formal First-Order Predicate Logic (FOPL) by identifying and representing them as state diagram elements.Method: The framework used a classical NLP rule-based baseline model for identifying the statechart diagram elements from the NL. Results: We found that the proposed approach generates FOPL and develops a state diagram with an average precision of 89\% and a recall of 87\%.Conclusion: Our results depend on the complexity levels of the evaluation datasets, the dependency parser accuracy, and the coverage of the FOPL conversion rules.},

init state("HighLevelDrivingModule.Autonomous.AutoInitial");
assume event("HighLevelDrivingModule.Autonomous.ExitAutonomous", 0) == true;
assume event("HighLevelDrivingModule.BrakePressed", *) == false;
assume event("HighLevelDrivingModule.HumanSteeringCommand", *) == false;
check reach <= 2: active("HighLevelDrivingModule.HumanDriving");

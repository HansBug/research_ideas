state HighLevelDrivingModule named "high-level driving module" {
    [*] -> PoweredOff;

    event Front_Distance_10 named "Front Distance > 10";

    state PoweredOff named "Powered Off";
    state HumanDriving named "Human Driving";

    state Autonomous named "Autonomous" {
        [*] -> AutoInitial;

        state AutoInitial named "Autonomous Initial";
        state AutoFinal named "Autonomous Final";

        AutoInitial -> AutoFinal : ExitAutonomous;
        AutoFinal -> [*];
    }

    PoweredOff -> HumanDriving : PowerOn;
    HumanDriving -> [*] : PowerOff;
    HumanDriving -> Autonomous : Front_Distance_10;
    !Autonomous -> HumanDriving : HumanSteeringCommand;
    !Autonomous -> HumanDriving : BrakePressed;
    Autonomous -> HumanDriving;
}

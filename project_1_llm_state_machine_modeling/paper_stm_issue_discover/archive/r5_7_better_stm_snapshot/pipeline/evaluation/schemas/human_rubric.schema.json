{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paper-stm-repair:r4:human-rubric:v0",
  "title": "R4 human rubric v0",
  "type": "object",
  "required": [
    "schema_version",
    "rubric_id",
    "human_for_evaluation_only",
    "used_by_repair_loop",
    "dimensions"
  ],
  "properties": {
    "schema_version": {
      "const": "r4.human_rubric.v0"
    },
    "rubric_id": {
      "type": "string",
      "minLength": 1
    },
    "human_for_evaluation_only": {
      "const": true
    },
    "used_by_repair_loop": {
      "const": false
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "dimension_id",
          "question",
          "allowed_values",
          "evidence_required"
        ],
        "properties": {
          "dimension_id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "allowed_values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

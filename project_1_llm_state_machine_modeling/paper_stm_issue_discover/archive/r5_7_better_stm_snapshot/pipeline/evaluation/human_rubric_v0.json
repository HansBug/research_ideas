{
  "schema_version": "r4.human_rubric.v0",
  "rubric_id": "r4.human_rubric.default_v0",
  "human_for_evaluation_only": true,
  "used_by_repair_loop": false,
  "dimensions": [
    {
      "dimension_id": "nl_fidelity",
      "question": "STM_k 是否覆盖 NL 中关键状态、事件、约束和禁止行为？",
      "allowed_values": [
        "improved",
        "unchanged",
        "degraded",
        "unknown"
      ],
      "evidence_required": true
    },
    {
      "dimension_id": "diagnostic_closure",
      "question": "预注册 diagnostics 是否关闭，是否引入新 blocking issue？",
      "allowed_values": [
        "closed",
        "partially_closed",
        "not_closed",
        "regressed",
        "unknown"
      ],
      "evidence_required": true
    },
    {
      "dimension_id": "regression_safety",
      "question": "冻结场景 / 回归是否不退化？",
      "allowed_values": [
        "pass",
        "fail",
        "unknown"
      ],
      "evidence_required": true
    },
    {
      "dimension_id": "semantic_drift",
      "question": "是否出现为过测试而删除或扭曲需求行为？",
      "allowed_values": [
        "low",
        "medium",
        "high",
        "unknown"
      ],
      "evidence_required": true
    },
    {
      "dimension_id": "traceability",
      "question": "裁决是否能追溯到 NL、STM、scenario、diagnostic 或人工 note？",
      "allowed_values": [
        "complete",
        "partial",
        "missing"
      ],
      "evidence_required": true
    }
  ]
}

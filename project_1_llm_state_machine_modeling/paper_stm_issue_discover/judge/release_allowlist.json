{
  "schema_version": "paper1.release-allowlist.v1",
  "package_name": "paper-stm-semantic-judge",
  "source_commit_requirement": "clean tracked Git tree",
  "entries": [
    {
      "source": "judge/pyproject.toml",
      "destination": "pyproject.toml",
      "purpose": "Installation metadata for the independent Semantic Judge."
    },
    {
      "source": "judge/README.md",
      "destination": "README.md",
      "purpose": "Standalone Judge installation and provider boundary documentation."
    },
    {
      "source": "judge/src/paper_stm_judge",
      "destination": "src/paper_stm_judge",
      "recursive": true,
      "allowed_suffixes": [".py", ".md"],
      "purpose": "Frozen issue #195 Judge implementation and packaged protocol snapshot."
    },
    {
      "source": "judge/tests",
      "destination": "tests",
      "recursive": true,
      "allowed_suffixes": [".py"],
      "purpose": "Provider-free standalone Judge release regression test."
    },
    {
      "source": "utils/__init__.py",
      "destination": "src/utils/__init__.py",
      "purpose": "Neutral utility package marker."
    },
    {
      "source": "utils/artifact_io.py",
      "destination": "src/utils/artifact_io.py",
      "purpose": "Neutral atomic artifact writer."
    },
    {
      "source": "utils/structured_runtime.py",
      "destination": "src/utils/structured_runtime.py",
      "purpose": "Shared structured runtime, retry, usage, and cost accounting."
    },
    {
      "source": "utils/agent",
      "destination": "src/utils/agent",
      "recursive": true,
      "allowed_suffixes": [".py"],
      "purpose": "Arm-neutral structured agent runtime."
    },
    {
      "source": "utils/llm",
      "destination": "src/utils/llm",
      "recursive": true,
      "allowed_suffixes": [".py"],
      "purpose": "Profile, usage, cache, and cost helpers required by the runtime."
    },
    {
      "source": "utils/stm_artifacts",
      "destination": "src/utils/stm_artifacts",
      "recursive": true,
      "allowed_suffixes": [".py"],
      "purpose": "Arm-neutral read-only STM artifact loader and native projection."
    }
  ],
  "excluded_categories": [
    "method",
    "evaluation",
    "ledger",
    "expected_answers",
    "baseline",
    "final_results",
    "runs",
    "archive",
    "legacy",
    "provider_cache",
    "credentials",
    "temporary_logs"
  ]
}

{
  "schema_version": "paper1.release-allowlist.v1",
  "package_name": "paper-stm-method",
  "source_commit_requirement": "clean tracked Git tree",
  "entries": [
    {
      "source": "method/pyproject.toml",
      "destination": "pyproject.toml",
      "purpose": "Installation metadata and pinned external dependencies."
    },
    {
      "source": "method/setup.py",
      "destination": "setup.py",
      "purpose": "Compatibility installation metadata for legacy build frontends."
    },
    {
      "source": "method/README.md",
      "destination": "README.md",
      "purpose": "Standalone method installation and usage documentation."
    },
    {
      "source": "method/NOTICE.md",
      "destination": "NOTICE.md",
      "purpose": "Third-party dependency and license notice."
    },
    {
      "source": "method/src/paper_stm_method/__init__.py",
      "destination": "src/paper_stm_method/__init__.py",
      "purpose": "Method package identity."
    },
    {
      "source": "method/src/paper_stm_method/cli.py",
      "destination": "src/paper_stm_method/cli.py",
      "purpose": "Public method command-line entrypoint."
    },
    {
      "source": "method/src/paper_stm_method/backends",
      "destination": "src/paper_stm_method/backends",
      "recursive": true,
      "allowed_suffixes": [".py"],
      "purpose": "Deterministic method backend implementations."
    },
    {
      "source": "method/src/paper_stm_method/compiler",
      "destination": "src/paper_stm_method/compiler",
      "recursive": true,
      "allowed_suffixes": [".py"],
      "purpose": "Typed predicate compilation and soundness assessment."
    },
    {
      "source": "method/src/paper_stm_method/evidence",
      "destination": "src/paper_stm_method/evidence",
      "recursive": true,
      "allowed_suffixes": [".py"],
      "purpose": "Method-owned execution receipts and evidence artifacts."
    },
    {
      "source": "method/src/paper_stm_method/inputs/__init__.py",
      "destination": "src/paper_stm_method/inputs/__init__.py",
      "purpose": "Method-facing neutral artifact-loader API."
    },
    {
      "source": "method/src/paper_stm_method/inputs/context.py",
      "destination": "src/paper_stm_method/inputs/context.py",
      "purpose": "Compatibility export for the neutral artifact context API."
    },
    {
      "source": "method/src/paper_stm_method/inputs/fcstm_native_projection.py",
      "destination": "src/paper_stm_method/inputs/fcstm_native_projection.py",
      "purpose": "Compatibility export for the neutral native projection API."
    },
    {
      "source": "method/src/paper_stm_method/inputs/loaders.py",
      "destination": "src/paper_stm_method/inputs/loaders.py",
      "purpose": "Compatibility export for the neutral artifact loader."
    },
    {
      "source": "method/src/paper_stm_method/inputs/models.py",
      "destination": "src/paper_stm_method/inputs/models.py",
      "purpose": "Compatibility export for neutral input models."
    },
    {
      "source": "method/src/paper_stm_method/inputs/provenance.py",
      "destination": "src/paper_stm_method/inputs/provenance.py",
      "purpose": "Compatibility export for neutral artifact provenance."
    },
    {
      "source": "method/src/paper_stm_method/orchestration",
      "destination": "src/paper_stm_method/orchestration",
      "recursive": true,
      "allowed_suffixes": [".py"],
      "purpose": "Method run contracts and orchestration."
    },
    {
      "source": "method/src/paper_stm_method/registry",
      "destination": "src/paper_stm_method/registry",
      "recursive": true,
      "allowed_suffixes": [".py"],
      "purpose": "Frozen predicate registry loading and validation."
    },
    {
      "source": "method/src/paper_stm_method/semantics",
      "destination": "src/paper_stm_method/semantics",
      "recursive": true,
      "allowed_suffixes": [".py"],
      "purpose": "Discovery, grounding, routing, binding, and adjudication semantics."
    },
    {
      "source": "method/src/paper_stm_method/resources",
      "destination": "src/paper_stm_method/resources",
      "recursive": true,
      "allowed_suffixes": [".py", ".json"],
      "purpose": "Byte-identical frozen method registry and source catalog resources."
    },
    {
      "source": "method/tests",
      "destination": "tests",
      "recursive": true,
      "allowed_suffixes": [".py", ".fcstm"],
      "purpose": "Provider-free synthetic release fixture and its installation regression test."
    },
    {
      "source": "utils/__init__.py",
      "destination": "src/utils/__init__.py",
      "purpose": "Neutral utility package marker."
    },
    {
      "source": "utils/artifact_io.py",
      "destination": "src/utils/artifact_io.py",
      "purpose": "Neutral atomic artifact writer."
    },
    {
      "source": "utils/structured_runtime.py",
      "destination": "src/utils/structured_runtime.py",
      "purpose": "Shared structured runtime, retry, usage, and cost accounting."
    },
    {
      "source": "utils/agent",
      "destination": "src/utils/agent",
      "recursive": true,
      "allowed_suffixes": [".py"],
      "purpose": "Arm-neutral structured agent runtime."
    },
    {
      "source": "utils/llm",
      "destination": "src/utils/llm",
      "recursive": true,
      "allowed_suffixes": [".py"],
      "purpose": "Profile, usage, cache, and cost helpers required by the runtime."
    },
    {
      "source": "utils/stm_artifacts",
      "destination": "src/utils/stm_artifacts",
      "recursive": true,
      "allowed_suffixes": [".py"],
      "purpose": "Arm-neutral read-only frozen STM artifact loader and native projection."
    }
  ],
  "excluded_categories": [
    "judge",
    "evaluation",
    "ledger",
    "expected_answers",
    "baseline",
    "final_results",
    "runs",
    "archive",
    "legacy",
    "provider_cache",
    "credentials",
    "temporary_logs"
  ]
}

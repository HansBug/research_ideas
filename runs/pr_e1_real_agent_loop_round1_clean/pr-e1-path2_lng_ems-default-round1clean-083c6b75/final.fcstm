def float PL = 0.0;
def float Ppv = 0.0;
def float Pw = 0.0;
def float SoC = 0.0;
def float eng3_Pmax = 0.0;
def float Pgmax = 0.0;
def float Pd1max = 0.0;
def float requestedGenPower = 0.0;
def float batteryPower = 0.0;
def float sparePower = 0.0;

state System {
    [*] -> RESChargeBattery;

    state RESChargeBattery;
    state RESSpare;
    state ZeroLoadChargeBattery;
    state ZeroLoadSpare;
    state RESBatterySupplyLoad;
    state RESLNGSupplyLoad;
    state RESLNGChargeMargin;
    state RESLNGDGSupplyLoad;
    state RESLNGDGChargeMargin;
    state RESAllThermalSupply;
    state RESAllThermalChargeMargin;
    state OverloadCompletion {
        enter {
            requestedGenPower = eng3_Pmax;
        }
    }

    RESChargeBattery -> RESSpare : if [Ppv + Pw >= PL && SoC >= 0.95];
    RESSpare -> RESChargeBattery : if [Ppv + Pw >= PL && SoC < 0.95];

    RESChargeBattery -> ZeroLoadChargeBattery : if [PL == 0 && SoC < 0.95];
    RESSpare -> ZeroLoadSpare : if [PL == 0 && SoC >= 0.95];

    ZeroLoadChargeBattery -> RESChargeBattery : if [PL > 0 && Ppv + Pw >= PL && SoC < 0.95];
    ZeroLoadSpare -> RESSpare : if [PL > 0 && Ppv + Pw >= PL && SoC >= 0.95];

    RESChargeBattery -> RESBatterySupplyLoad : if [Ppv + Pw < PL && SoC > 0.0];
    RESSpare -> RESBatterySupplyLoad : if [Ppv + Pw < PL && SoC > 0.0];

    RESBatterySupplyLoad -> RESLNGSupplyLoad : if [Ppv + Pw < PL && SoC <= 0.0];
    RESLNGSupplyLoad -> RESLNGChargeMargin : if [SoC < 0.95];
    RESLNGChargeMargin -> RESLNGDGSupplyLoad : if [PL > Ppv + Pw + eng3_Pmax];
    RESLNGDGSupplyLoad -> RESLNGDGChargeMargin : if [SoC < 0.95];
    RESLNGDGChargeMargin -> RESAllThermalSupply : if [PL > Ppv + Pw + eng3_Pmax + Pgmax / 5];
    RESAllThermalSupply -> RESAllThermalChargeMargin : if [SoC < 0.95];
    RESAllThermalChargeMargin -> OverloadCompletion : if [PL > Ppv + Pw + eng3_Pmax + Pgmax / 5 + Pd1max / 10];
}
  "nl_spans": [
    {
      "id": "NL-1",
      "text": "FSM state space combines floor states F1/F2/F3 and motion states MU2/MU3/MD1/MD2.",
      "class": "required_obligation",
      "rationale": "defines required model state inventory"
    },
    {
      "id": "NL-2",
      "text": "System starts from ideal state on floor 1, branches by requests, stops at requested floor, then checks next destination.",
      "class": "required_obligation",
      "rationale": "defines initial state and floor-state reactivity after arrival"
    },
    {
      "id": "NL-3",
      "text": "PS1/PS2/PS3 are floor-request inputs and S1/S2/S3 are arrival sensing inputs.",
      "class": "required_obligation",
      "rationale": "defines event/input vocabulary"
    },
    {
      "id": "NL-4",
      "text": "From F1, PS2 triggers MU2 and PS3 triggers MU3.",
      "class": "required_obligation",
      "rationale": "two required request transitions"
    },
    {
      "id": "NL-5",
      "text": "From F2, PS3 triggers MU3 and PS1 triggers MD1.",
      "class": "required_obligation",
      "rationale": "two required request transitions"
    },
    {
      "id": "NL-6",
      "text": "From F3, PS1 triggers MD1 and PS2 triggers MD2.",
      "class": "required_obligation",
      "rationale": "two required request transitions"
    },
    {
      "id": "NL-7",
      "text": "Arrival sensors complete MU2+S2->F2, MU3+S3->F3, MD1+S1->F1, MD2+S2->F2.",
      "class": "required_obligation",
      "rationale": "four required arrival transitions"
    },
    {
      "id": "NL-8",
      "text": "hbrg output distinguishes upward drive, downward drive, and stop conditions.",
      "class": "required_obligation",
      "rationale": "required output action abstraction"
    },
    {
      "id": "NL-9",
      "text": "Reset forces controller back to floor 1 regardless of outstanding request context.",
      "class": "required_obligation",
      "rationale": "critical global reset/fallback behavior"
    }
  ],

  "nl_spans": [
    {
      "id": "NL-1",
      "text": "The paper implements the single-wheel ABS hydraulic regulator as a three-state FSM coupled with a PID-based slip controller.",
      "class": "required_obligation",
      "rationale": "要求离散模型表达单轮ABS液压调节器的三态FSM监督器。"
    },
    {
      "id": "NL-2",
      "text": "Wheel speed and vehicle speed are used to compute the slip ratio, and the PID output drives the Stateflow supervisor instead of sending commands directly to the hydraulic valves.",
      "class": "required_obligation",
      "rationale": "要求把slip/PID输出视为监督器输入边界，不能把连续控制器直接硬编码成阀命令。"
    },
    {
      "id": "NL-3",
      "text": "The FSM contains the states increase, hold, and decrease, with state actions k1/k2/n.",
      "class": "required_obligation",
      "rationale": "要求状态集合和每个状态的执行器输出动作。"
    },
    {
      "id": "NL-4",
      "text": "The transition guards split the slip-error space into four bands.",
      "class": "required_obligation",
      "rationale": "要求四条带阈值方向的guard转移。"
    },
    {
      "id": "NL-5",
      "text": "The supervisor maps slip-error thresholds to inlet-valve, return-valve, and pump actions while continuous wheel-slip dynamics remain in the plant model.",
      "class": "required_obligation",
      "rationale": "要求动作输出边界和连续动力学out-of-scope声明。"
    }
  ],
  "external_input_ledger": [

{"type":"item.started","item":{"id":"item_79","type":"command_execution","command":"/bin/bash -lc \"PYTHONPATH=project_1_llm_state_machine_modeling python - <<'PY'\nfrom dataclasses import asdict\nimport json\nfrom pathlib import Path\nfrom method.schema import TestScenario, ScenarioStep, ScenarioSet, StageContext\nfrom method.stages.api import run_sd6_sim\n\nbase = Path('runs/codex_exec_skill/pr_m3_four_clean_20260608_133322/path1_abs/final_model.fcstm').read_text(encoding='utf-8')\nscenarios = [\n    TestScenario(\n        name='default_increase_then_hold_at_boundary',\n        initial_vars={'slp':0.01},\n        steps=[\n            ScenarioStep(events=[], expected_state='ABS.increase', expected_vars={'k1':1,'k2':0,'n':0}, name='default_enters_increase'),\n            ScenarioStep(events=[], expected_state='ABS.hold', expected_vars={'k1':0,'k2':0,'n':0}, name='increase_to_hold_boundary'),\n        ],\n    ),\n    TestScenario(\n        name='hold_to_increase_high_slp',\n        initial_state='ABS.hold', initial_vars={'slp':0.02, 'k1':0, 'k2':0, 'n':0},\n        steps=[ScenarioStep(events=[], expected_state='ABS.increase', expected_vars={'k1':1,'k2':0,'n':0}, name='hold_to_increase_high_slp')],\n    ),\n    TestScenario(\n        name='hold_to_decrease_negative_slp',\n        initial_state='ABS.hold', initial_vars={'slp':-0.02, 'k1':0, 'k2':0, 'n':0},\n        steps=[ScenarioStep(events=[], expected_state='ABS.decrease', expected_vars={'k1':0,'k2':1,'n':500}, name='hold_to_decrease_negative_slp')],\n    ),\n    TestScenario(\n        name='decrease_to_hold_boundary_slp',\n        initial_state='ABS.decrease', initial_vars={'slp':-0.01, 'k1':0, 'k2':1, 'n':500},\n        steps=[ScenarioStep(events=[], expected_state='ABS.hold', expected_vars={'k1':0,'k2':0,'n':0}, name='decrease_to_hold_boundary_slp')],\n    ),\n]\nss = ScenarioSet(scenario_set_id='dmr-scenarios', scenarios=scenarios, source_dsl_hash='manual')\nmutants = [\n    ('M-001', 'O-007', 'guard_boundary_flip', 'increase -> hold : if [slp <= 0.01];', 'increase -> hold : if [slp < 0.01];'),\n    ('M-002', 'O-008', 'wrong_transition_target', 'hold -> increase : if [slp > 0.01];', 'hold -> decrease : if [slp > 0.01];'),\n    ('M-003', 'O-009', 'wrong_transition_target', 'hold -> decrease : if [slp < -0.01];', 'hold -> increase : if [slp < -0.01];'),\n    ('M-004', 'O-010', 'guard_boundary_flip', 'decrease -> hold : if [slp >= -0.01];', 'decrease -> hold : if [slp > -0.01];'),\n    ('M-005', 'O-006', 'wrong_effect_value', 'state decrease { enter { k1 = 0; k2 = 1; n = 500; } }', 'state decrease { enter { k1 = 0; k2 = 1; n = 0; } }'),\n]\noriginal, _ = run_sd6_sim(base, ss, StageContext(nl='', current_dsl=base))\nrows=[]\nfor mid, oid, kind, old, new in mutants:\n    mutated = base.replace(old, new)\n    sim, _ = run_sd6_sim(mutated, ss, StageContext(nl='', current_dsl=mutated))\n    failed = not sim.ok\n    failed_scenarios = [r.name for r in sim.scenario_results if r.status \"'!= '\"'pass']\n    rows.append({'mutation_id': mid, 'obligation_id': oid, 'mutant': kind, 'original_pass': original.ok, 'mutated_fail': failed, 'caught': bool(original.ok and failed), 'failed_scenarios': failed_scenarios})\nprint(json.dumps({'original_ok': original.ok, 'mutations': rows}, ensure_ascii=False, indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

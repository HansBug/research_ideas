essage)\nif parse.ok:\n    sem, sm, build = run_sd3_semantic(dsl, context)\n    print('SD3', sem.ok, sm.status, sem.error_message)\n    if sem.ok:\n        design, dm = run_sd4_design(context, policy_profile='generated_candidate')\n        print('SD4', design.ok, dm.status)\n        print('blocking', [asdict(i) for i in design.blocking_items])\n        print('advisory', [asdict(i) for i in design.advisory_items])\n        scenarios = [\n            TestScenario(name='default_initial_increase_outputs', description='default_prefix: initial state enters increase and sets outputs', steps=[ScenarioStep(events=[], expected_state='ABS.increase', expected_vars={'k1':1,'k2':0,'n':0}, name='init')]),\n            TestScenario(name='increase_to_hold_low_slp', description='external_input_initial_vars: slp <= 0.01 drives increase -> hold', initial_vars={'slp':0.01}, steps=[ScenarioStep(events=[], expected_state='ABS.hold', expected_vars={'k1':0,'k2':0,'n':0}, name='low_slp')]),\n            TestScenario(name='hold_to_increase_high_slp', description='reachable_prefix surrogate: increase -> hold at slp=0.01 then high slp drives hold -> increase', initial_state='ABS.hold', initial_vars={'slp':0.02, 'k1':0, 'k2':0, 'n':0}, steps=[ScenarioStep(events=[], expected_state='ABS.increase', expected_vars={'k1':1,'k2':0,'n':0}, name='high_slp')]),\n            TestScenario(name='hold_to_decrease_negative_slp', description='reachable_prefix surrogate: increase -> hold at slp=0.01 then negative slp drives hold -> decrease', initial_state='ABS.hold', initial_vars={'slp':-0.02, 'k1':0, 'k2':0, 'n':0}, steps=[ScenarioStep(events=[], expected_state='ABS.decrease', expected_vars={'k1':0,'k2':1,'n':500}, name='negative_slp')]),\n            TestScenario(name='decrease_to_hold_boundary_slp', description='reachable_prefix surrogate: hold -> decrease at slp<-0.01 then boundary slp returns decrease -> hold', initial_state='ABS.decrease', initial_vars={'slp':-0.01, 'k1':0, 'k2':1, 'n':500}, steps=[ScenarioStep(events=[], expected_state='ABS.hold', expected_vars={'k1':0,'k2':0,'n':0}, name='boundary_return')]),\n        ]\n        cov, cm = run_sd5a_scenario_coverage(dsl, scenarios)\n        print('SD5A', cm.ok, cm.status, json.dumps(cov, default=str, ensure_ascii=False)[:1000])\n        ss, fm = freeze_scenario_set(scenarios, source_dsl_hash='sha256:'+hashlib.sha256(dsl.encode()).hexdigest(), source_inspect_hash='sha256:'+hashlib.sha256(repr(context.inspect_json or {}).encode()).hexdigest(), source_grounding_hash='sha256:'+hashlib.sha256(nl.encode()).hexdigest(), coverage_report=cov)\n        sim, simm = run_sd6_sim(dsl, ss, context)\n        print('SC5F', fm.ok, fm.status, ss.scenario_set_id)\n        print('SD6', sim.ok, simm.status, sim.n_scenarios, sim.n_scenarios_passed, 'weak', sim.oracle_weak)\n        print(json.dumps(asdict(sim), ensure_ascii=False, indent=2, default=str))\nPY\"","aggregated_output":"SD2 True StageStatus.OK None\nSD3 True StageStatus.OK None\nSD4 True StageStatus.OK\nblocking []\nadvisory [{'code': 'W_UNREFERENCED_VAR', 'pyfcstm_severity': 'warning', 'policy_action': 'advisory', 'instance_key': 'W_UNREFERENCED_VAR:var_name=k1', 'refs': {'var_name': 'k1', 'init_value': '0'}, 'message': \"Variable 'k1' does not affect any transition guard.\", 'suggested_fix_hints': [{'kind': 'delete', 'target': 'variable_definition', 'anchor_ref': 'refs.definition_delete_anchor', 'text_template': '', 'rationale': 'Remove the declaration-only variable because it has no DSL reads or writes.'}, {'kind': 'for_llm_guidance', 'summary': \"This variable does not participate in model decisions. It is dead from the DSL's guard-affect data-flow perspective.\", 'recommended_actions': [{'kind': 'remove_variable', 'target': 'variable_definition', 'rationale': 'Remove the variable and related writes if it was speculative scaffolding.'}, {'kind': 'connect_to_guard', 'target': 'guard_or_assignment', 'rationale': 'Add the missing data-flow path if the variable should affect
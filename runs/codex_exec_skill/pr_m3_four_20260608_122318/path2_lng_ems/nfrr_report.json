  "nl_spans": [
    {
      "id": "NL-1",
      "text": "EMS manages PVs, WECs, DGs, LNG, batteries, and ship loads; issuing cut-in/cut-out commands.",
      "class": "required_obligation",
      "rationale": "Defines controlled system boundary and command/output role."
    },
    {
      "id": "NL-2",
      "text": "It controls dispatch and dynamically switches states to maintain power balance.",
      "class": "required_obligation",
      "rationale": "Requires mode-selection state machine and balance-oriented outputs."
    },
    {
      "id": "NL-3",
      "text": "FSM reads PL, Ppv, Pw, SoC, and engine capacity bounds; returns generator power, battery charge/discharge, spare power.",
      "class": "required_obligation",
      "rationale": "Defines external inputs and outputs."
    },
    {
      "id": "NL-4",
      "text": "The twelve finite states are selected by logical transition conditions over demand, generation, capacity, and SoC.",
      "class": "required_obligation",
      "rationale": "Requires all 12 states and guard partition."
    },
    {
      "id": "NL-5",
      "text": "When Ppv+Pw covers PL, serve demand from RES and charge below SoC 0.95 or spare at/above 0.95.",
      "class": "required_obligation",
      "rationale": "RES-sufficient branches."
    },
    {
      "id": "NL-6",
      "text": "When Ppv+Pw is below PL, priority is RES, batteries when SoC suitable, LNG before diesel, DG1/DG2 last.",
      "class": "required_obligation",
      "rationale": "Thermal escalation and battery-discharge branches."
    },
    {
      "id": "NL-7",
      "text": "Low-SoC branches add Pgmax/5 and Pd1max/10 charging margins.",
      "class": "required_obligation",
      "rationale": "Quantitative output effects."
    },
    {
      "id": "NL-8",
      "text": "When PL=0, RES goes to battery charging or spare according to SoC thresholds.",
      "class": "required_obligation",
      "rationale": "Zero-load branches."
    },
    {
      "id": "NL-9",
      "text": "Overload completion state is illegal and should never occur in practice.",
      "class": "required_obligation",
      "rationale": "Abnormal/illegal state obligation."
    }
  ],

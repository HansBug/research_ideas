{"type":"item.started","item":{"id":"item_86","type":"command_execution","command":"/bin/bash -lc \"PYTHONPATH=project_1_llm_state_machine_modeling python - <<'PY'\nfrom pyfcstm.dsl import parse_with_grammar_entry\nfrom pyfcstm.model import parse_dsl_node_to_state_machine\nfrom pyfcstm.simulate import SimulationRuntime\nfrom pyfcstm.diagnostics.inspect import inspect_model\nfrom method.schema import TestScenario, ScenarioStep, StageContext\nfrom method.stages.api import run_sd6_sim, freeze_scenario_set\nimport hashlib\n\ndsl='''state R { [*] -> A; state A; state B; \"'! * -> B :: Back; B -> A :: Reset; }'\"'''\nast=parse_with_grammar_entry(dsl,'state_machine_dsl'); m=parse_dsl_node_to_state_machine(ast)\nprint('inspect events', [e for e in inspect_model(m).to_json().get('events',[])])\nprint('transitions', inspect_model(m).to_json().get('transitions'))\nrt=SimulationRuntime(m); rt.cycle(); print('state', rt.current_state.path)\nfor ev in ['Back','R.Back','R.A.Back','/Back','/A.Back','.Back','..Back','A.Back']:\n    try:\n        rt2=SimulationRuntime(m); rt2.cycle(); rt2.cycle(events=[ev]); print(ev, '->', rt2.current_state.path)\n    except Exception as e:\n        print(ev, type(e).__name__, str(e)[:200])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

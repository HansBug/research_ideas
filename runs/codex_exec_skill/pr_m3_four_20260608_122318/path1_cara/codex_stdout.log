{"type":"item.started","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -lc \"PYTHONPATH=project_1_llm_state_machine_modeling python - <<'PY'\nfrom method.schema import StageContext, TestScenario, ScenarioStep\nfrom method.stages.api import run_sd2_parse, run_sd3_semantic, run_sd6_sim, freeze_scenario_set\nimport hashlib\nfor placement, dsl in {\n'root_event': '''state Root { event Start; [*] -> Outer; state Outer { [*] -> Idle; state Idle; state Active; Idle -> Active :: Start; } }''',\n'outer_event': '''state Root { [*] -> Outer; state Outer { event Start; [*] -> Idle; state Idle; state Active; Idle -> Active :: Start; } }''',\n'idle_event': '''state Root { [*] -> Outer; state Outer { [*] -> Idle; state Idle { event Start; } state Active; Idle -> Active :: Start; } }''',\n'colon_outer_event': '''state Root { [*] -> Outer; state Outer { event Start; [*] -> Idle; state Idle; state Active; Idle -> Active : Start; } }''',\n}.items():\n    ctx=StageContext(nl='x')\n    p,_=run_sd2_parse(dsl,ctx)\n    s,_,_=run_sd3_semantic(dsl,ctx)\n    print('\\\\n', placement, 'parse', p.ok, 'sem', s.ok, s.error_message)\n    if s.ok:\n        ss,_=freeze_scenario_set([TestScenario(name='s',steps=[ScenarioStep(events=[],expected_state='Root.Outer.Idle'),ScenarioStep(events=['Start'],expected_state='Root.Outer.Active')])], source_dsl_hash='sha256:'+hashlib.sha256(dsl.encode()).hexdigest(), source_inspect_hash='sha256:x')\n        fb,_=run_sd6_sim(dsl, ss, ctx)\n        print('sim', fb.ok, fb.scenario_results[0].status, [(r.step_name,r.status,r.actual_state,r.runtime_error) for r in fb.scenario_results[0].step_results])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

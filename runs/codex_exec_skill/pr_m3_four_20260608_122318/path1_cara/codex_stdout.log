tocontrol', 'risk': 'Wait and AutocontrolInit also modeled from paper'},\n    {'obligation_id': 'O-003', 'label': 'matched_exact', 'field_score': 1.0, 'model_element_path': 'Wait -> Manual :: BuiltInSwitchSet; Manual.during', 'risk': 'built-in switch abstracted as event'},\n    {'obligation_id': 'O-004', 'label': 'matched_exact', 'field_score': 1.0, 'model_element_path': 'Autocontrol.enter/during', 'risk': 'continuous voltage abstracted as integer control_voltage'},\n    {'obligation_id': 'O-005', 'label': 'matched_abstract', 'field_score': 1.0, 'model_element_path': 'Autocontrol.during infusion_rate=(blood_pressure > target_bp)?1:2; log_written=1', 'risk': 'flow relation is ordinal high/low, not clinical formula'},\n    {'obligation_id': 'O-006', 'label': 'matched_exact', 'field_score': 1.0, 'model_element_path': 'ChangeSetpoint, InitiateAC, TerminateAC transitions', 'risk': 'error display/sound represented as error_message flag in fault state'},\n    {'obligation_id': 'O-007', 'label': 'matched_abstract', 'field_score': 1.0, 'model_element_path': 'Ask_StartAC.AwaitingStart + ask_exit_target routing to AutocontrolInit', 'risk': 'ask_exit_target is a pyfcstm exit-routing helper'},\n    {'obligation_id': 'O-008', 'label': 'matched_exact', 'field_score': 1.0, 'model_element_path': 'Autocontrol -> PumpFault :: PumpFault', 'risk': 'complication kinds collapsed into PumpFault event'},\n    {'obligation_id': 'O-009', 'label': 'matched_exact', 'field_score': 1.0, 'model_element_path': 'PumpFault.enter; Autocontrol -> PumpFault effect; PumpFault -> Manual :: FaultRemoved', 'risk': 'caregiver removal abstracted as FaultRemoved event'},\n    {'obligation_id': 'O-010', 'label': 'matched_exact', 'field_score': 1.0, 'model_element_path': '\"'! * -> Manual :: CA/CB/CP/CC_backManual'\"', 'risk': 'forced expansion is pyfcstm declaration-level semantics'},\n]\n\nscenario_provenance = [\n    {'scenario_id': 'S1_manual_default_flow_from_default', 'covered_obligation_ids': ['O-002', 'O
e sem True None\nsim True pass [('step_0', 'pass', 'Root.Outer.Idle', None), ('step_1', 'pass', 'Root.Outer.Active', None)]\n\n colon_outer_event parse True sem True None\nsim False error [('step_0', 'pass', 'Root.Outer.Idle', None), ('step_1', 'error', 'Root.Outer.Idle', \"SimulationRuntimeEventError: Cannot resolve event path 'Start': failed with both StateMachine.resolve_event and State.resolve_event. Last error: Event 'Start' not found in state 'Root.Outer.Idle' while resolving event reference 'Start'\")]\n","exit_code":0,"status":"completed"}}

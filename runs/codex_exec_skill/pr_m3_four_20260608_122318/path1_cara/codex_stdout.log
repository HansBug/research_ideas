{"type":"item.started","item":{"id":"item_78","type":"command_execution","command":"/bin/bash -lc \"PYTHONPATH=project_1_llm_state_machine_modeling python - <<'PY'\nfrom method.schema import StageContext, TestScenario, ScenarioStep\nfrom method.stages.api import run_sd2_parse, run_sd3_semantic, run_sd4_design, run_sd6_sim, freeze_scenario_set\nimport hashlib\ncases = {\n'parent_trans_child_event_ref': '''state R { [*] -> O; state O { [*] -> A; state A { event Start; } } state B; O -> B :: A.Start; B -> [*]; }''',\n'parent_trans_child_event_ref_parent_decl': '''state R { [*] -> O; state O { event Start; [*] -> A; state A; } state B; O -> B :: Start; B -> [*]; }''',\n'parent_trans_child_event_abs_ref': '''state R { [*] -> O; state O { [*] -> A; state A { event Start; } } state B; O -> B :: /O.A.Start; B -> [*]; }''',\n'parent_trans_parent_relative_ref': '''state R { [*] -> O; state O { [*] -> A; state A { event Start; } } state B; O -> B :: .A.Start; B -> [*]; }''',\n}\nfor name,dsl in cases.items():\n    ctx=StageContext(nl='Start exits O to B')\n    p,_=run_sd2_parse(dsl,ctx); s,_,_=run_sd3_semantic(dsl,ctx)\n    print('\\\\n',name,'parse',p.ok,'sem',s.ok,s.error_message)\n    if s.ok:\n        d,_=run_sd4_design(ctx,policy_profile='generated_candidate')\n        print('sd4',d.ok,'block',[(i.code,i.message) for i in d.blocking_items],'adv',[(i.code,i.message) for i in d.advisory_items])\n        for ev in ['Start','R.O.A.Start','O.A.Start','/O.A.Start','A.Start']:\n            ss,_=freeze_scenario_set([TestScenario(name='s',steps=[ScenarioStep(events=[],expected_state='R.O.A'),ScenarioStep(events=[ev],expected_state='R.B')])],source_dsl_hash='sha256:'+hashlib.sha256(dsl.encode()).hexdigest(),source_inspect_hash='x')\n            fb,_=run_sd6_sim(dsl,ss,ctx)\n            print('event',ev,'sim',fb.ok,[(r.status,r.actual_state,r.runtime_error) for r in fb.scenario_results[0].step_results])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

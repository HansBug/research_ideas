\n    'reviewer_queue_ready': True,\n}\n\n# Redaction / forbidden checks.\nforbidden = {\n    'schema_version': 'pr-m3-forbidden-call-check-v1',\n    'forbidden_runner_used': False,\n    'checked_for': ['method.loop.run_agent_loop(...)', 'PR-D representative runner', 'PR-E1 real-run runner', 'one-click full staged runner'],\n    'method': 'Manual command/tool transcript audit plus generated artifact review; only method.stages.api and schema dataclasses were imported for checks.',\n    'observations': [\n        'The prompt/run_manifest contain forbidden runner names as prohibition text only.',\n        'No code path invoked method.loop.run_agent_loop, method.pr_d_representative, method.pr_e1_real_runs, or full staged runners.',\n    ],\n    'disallowed_invocations_observed': [],\n}\n\n# Write JSON files first.\ndef dump_json(path: Path, value: Any) -> None:\n    path.write_text(json.dumps(value, ensure_ascii=False, indent=2, default=str) + '\\\\n', encoding='utf-8')\n\ndump_json(out_dir / 'actual_file_reads.json', {'schema_version': 'pr-m3-actual-file-reads-v1', 'case_key': case['case_key'], 'files': actual_reads, 'paper_pdf_read': False, 'paper_pdf_note': 'paper.pdf was detected and hashed by harness but not opened during this runner; paper_content.txt/STM.md/DESC.md supplied the grounding evidence.'})\ndump_json(out_dir / 'tool_stage_check_ledger.json', stage_ledger)\ndump_json(out_dir / 'repair_ledger.json', repair_ledger)\ndump_json(out_dir / 'nfrr_report.json', nfrr)\ndump_json(out_dir / 'forbidden_call_check.json', forbidden)\n\n# Markdown report.\nfinal_model_hash = hashlib.sha256(final_dsl.encode('utf-8')).hexdigest()\nchecks_summary = {\n    'SD-2': 'pass' if sd2_feedback.ok else 'fail',\n    'SD-3': 'pass' if sd3_feedback.ok else 'fail',\n    'SD-4': 'pass_no_blocking' if sd4_feedback and sd4_feedback.ok else 'fail',\n    'SD-5A': 'advisory_gap' if coverage.get('coverage_gap') else 'pass',\n    'SC-5F': 'pass' if sc5f_meta.ok else 'fail',\n    'SD-6': f\\\"pass {sd6_feedback.n_scenarios_passed}/{sd6_feedback.n_scenarios}\\\" if sd6_feedback.ok else 'fail',\n}\n\nprocess_rows = [\n    ('E0 skill discovery', '完成', '读取 skill 入口与 5 个指定指南，确认禁止一键 runner、允许 method.stages.api。'),\n    ('E1 evidence grounding', '完成', '从 NL 抽取 10 个 span/obligation，并读取 bibtex、STM、DESC、paper_content 关键行。'),\n    ('E2 initial modeling', '完成', '生成 pyfcstm DSL；布尔语义统一用 int 0/1；连续 BP/flow 离散为高低档。'),\n    ('E3 deterministic checks', '完成', '最终 SD-2/3/4 通过；SD-5A 为 mutation 覆盖 advisory；SD-6 8/8 pass。'),\n    ('E4 repair/waiver', '完成', '修复 leaf during before、Ask_StartAC 子模式退出、forced event 注入路径；advisory 以 waiver ledger 记录。'),\n    ('E5 NFRR', '完成', 'NFRR v3: FE/NGF/REC/SCB/BVS 高，GAS/DMR 因抽象和 mutation 部分覆盖为 2。'),\n    ('E6 final audit', '完成', '写入 final_model/report/metadata/ledgers，检查 forbidden call 与 secret redaction 风险。'),\n]\n\ndef md_table(headers: list[str], rows: list[tuple[Any, ...]]) -> str:\n    lines = ['| ' + ' | '.join(headers) + ' |', '| ' + ' | '.join(['---'] * len(headers)) + ' |']\n    for row in rows:\n        lines.append('| ' + ' | '.join(str(x).replace('\\\\n', '<br>') for x in row) + ' |')\n    return '\\\\n'.join(lines)\n\nreport = f\\\"\\\"\\\"# PR-M3 codex exec skill 实验报告：path1_cara\n\n## Run identity\n\n- case_key: \"'`{case['\"'case_key']}\"'`\n- case_id: `{case['\"'case_id']}\"'`\n- path: `{case['\"'path']}\"'`\n- output_dir: `{out_dir}`\n- status: `completed_valid_candidate`\n- provider config seen: `model_provider=airouter`（仅脱敏配置；未读取或写入 raw endpoint/API key）\n- final_model_sha256: `{final_model_hash}`\n\n## Input\n\n**NL 原文**\n\n```text\n{original_nl}\n```\n\n**NL 中文释义**\n\n```text\n{nl_zh}\n```\n\npaper_dir: `{case['\"'source_path']}\"'`\n\n## Actual Reads\n\n{md_table(['\"'类别', '路径', '用途'], [(f['kind'], f['path'], f['purpose']) for f in actual_reads])}\n\n说明：\"'`paper.pdf` 由 harness 检测并散列，但本 runner 未直接打开 PDF；实际 grounding 使用 `paper_content.txt`、`STM.md`、`DESC.md` 和 `bibtex.bib`。\n\n## Evidence Grounding\n\n{md_table(['\"'span', '来源', '位置', '证据摘要'], [(s['span_id'], s['path'], s.get('lines') or s.get('section'), s['summary']) for s in source_spans])}\n\n## Process Summary\n\n{md_table(['阶段', '结果', '摘要'], process_rows)}\n\n## Checks / Repair / NFRR Summary\n\n{md_table(['检查', '结果', '说明'], [(k, v, '详见 tool_stage_check_ledger.json') for k, v in checks_summary.items()])}\n\n{md_table(['维度', '分数', '主要证据/限制'], [\n    ('FE', 3, 'SD-2/3/4 pass；无 unwaived blocking'),\n    ('NGF', 3, '10 个 required obligations 无 critical/major contradiction'),\n    ('REC', 3, 'weighted_recall=1.0；均 exact/abstract matched'),\n    ('GAS', 2, 'BP 高则低流量与 release/action 均覆盖；连续控制公式仅离散化'),\n    ('SCB', 3, 'scope=full_NL_fragment；cuff handler 仅作为 CB_backManual provenance'),\n    ('AAT', 2, 'synthetic/helper/output-only ledger 完整，但未人工签核'),\n    ('BVS', 3, '8 个 obligation-anchored 场景均从默认前缀执行，SD-6 8/8 pass'),\n    ('DMR', 2, 'SD-5A mutation caught 10/12；wrong target/wrong effect 仍部分覆盖'),\n])}\n\nNFRR: \"'`tier_before_cap=T3`，cap=`IND_SINGLE_SELF_ASSESSMENT` + `NO_HUMAN_SIGNOFF`，final=`T2`，allowed_use=`reviewer_queue`。\n\n## Final FCSTM\n\n```fcstm\n{final_dsl.strip()}\n```\n\n## Quality Risks and Limitations\n\n- `ask_exit_target` 是 pyfcstm 可执行化 helper，用于表达 Ask_StartAC 子模式在 StartAC/TerminateAC 后退出到不同父级目标；它不是论文变量。\n- 血压、流量和控制电压被离散为整数档位，只验证“血压更高 -> 流量更低”的方向，不还原临床连续控制公式。\n- `PumpFault` 聚合 occlusion 等泵并发症；未区分 occlusion/impedance/back-EMF 等子监视器。\n- `alarm_signal`、`error_message`、`log_written`、`pump_control_released` 是输出/观测 flag，不是完整 UI、声响、日志文件系统。\n- SD-5A mutation coverage 仍有 advisory gap；该模型可进 reviewer queue，但不能称为 signed reference 或 final ground truth。\n\n## Reviewer Queue Decision\n\n可以进入 reviewer queue：`final_tier=T2`、`allowed_use=reviewer_queue`，但需要人工/独立 reviewer 复核 abstraction、scenario oracle 和 mutation gaps 后才能升级为 paper-grounded/signed reference。\n\"\"\"\n(out_dir / '\"'report.md').write_text(report, encoding='utf-8')\n\n# Run summary and metadata need report hash.\nreport_hash = hashlib.sha256(report.encode('utf-8')).hexdigest()\n\noutput_files = [\n    'final_model.fcstm', 'report.md', 'metadata.json', 'actual_file_reads.json',\n    'tool_stage_check_ledger.json', 'repair_ledger.json', 'nfrr_report.json',\n    'forbidden_call_check.json', 'run_summary.md', 'redaction_report.json',\n]\nmetadata = {\n    'schema_version': 'pr-m3-metadata-v1',\n    'case_key': case['case_key'],\n    'case_id': case['case_id'],\n    'path': case['path'],\n    'status': 'completed_valid_candidate',\n    'model_provider_config_seen': {'model_provider': 'airouter', 'source': 'redacted run_manifest/env; raw endpoint/key not read'},\n    'skill_entry_read': 'project_1_llm_state_machine_modeling/method/agent_loop_skill/SKILL.md',\n    'actual_file_reads': [f['path'] for f in actual_reads],\n    'output_files': output_files,\n    'forbidden_runner_used': False,\n    'checks': checks_summary,\n    'nfrr': {'final_tier': nfrr['final_tier'], 'allowed_use': nfrr['claim']['allowed_use'], 'scores': nfrr['scores'], 'cap_reasons': nfrr['cap_reasons'], 'reviewer_queue_ready': True},\n    'final_model_sha256': final_model_hash,\n    'report_sha256': report_hash,\n}\ndump_json(out_dir / 'metadata.json', metadata)\n\nrun_summary = f\\\"\\\"\\\"# Run Summary\n\n- output_dir: \"'`{out_dir}`\n- status: `completed_valid_candidate`\n- final_model: `{model_path}`\n- report: `{out_dir / '\"'report.md'}\"'`\n- metadata: `{out_dir / '\"'metadata.json'}\"'`\n- checks: SD-2 pass; SD-3 pass; SD-4 pass/no blocking; SD-5A advisory mutation gap; SD-6 pass 8/8\n- NFRR: final_tier=T2, allowed_use=reviewer_queue, calibration_status=uncalibrated_candidate_gate\n- main limitations: discretized BP/flow relation, synthetic `ask_exit_target`, aggregated `PumpFault`, no independent/human signoff, mutation coverage partial\n\"\"\"\n(out_dir / '\"'run_summary.md').write_text(run_summary, encoding='utf-8')\n\n# Redaction report scans generated files plus selected existing redacted context.\nsecret_patterns = {\n    'bearer_token': re.compile(r'Bearer\\\\s+[A-Za-z0-9._\\\\-]+'),\n    'openai_style_key': re.compile(r'\\\\bsk-[A-Za-z0-9]{16,}\\\\b'),\n    'raw_api_key_assignment': re.compile(r'(?i)(api[_-]?key|llm_api_key)\\\\s*[:=]\\\\s*(?\"'![\"'\"\\\\']?<REDACTED>)[\\\"\\\\']?[A-Za-z0-9_\\\\-]{16,}'),\n}\nscan_files = [out_dir / name for name in output_files if name \"'!= '\"'redaction_report.json'] + [out_dir / 'env.redacted.json', out_dir / 'command.redacted.txt', out_dir / 'run_manifest.json']\nfindings = []\nfor path in scan_files:\n    if not path.exists() or path.is_dir():\n        continue\n    text = path.read_text(encoding='utf-8', errors='replace')\n    for label, pattern in secret_patterns.items():\n        for match in pattern.finditer(text):\n            findings.append({'file': str(path), 'pattern': label, 'match_preview': match.group(0)[:24] + '...'})\nredaction_report = {\n    'schema_version': 'pr-m3-redaction-report-v1',\n    'status': 'pass' if not findings else 'fail',\n    'raw_secret_findings': findings,\n    'notes': ['Only redacted provider configuration is present in env.redacted.json/run_manifest.json.', 'No raw endpoint, raw API key, Bearer token, or .env secret was written by this runner.'],\n}\ndump_json(out_dir / 'redaction_report.json', redaction_report)\n\n# Update manifest without adding secrets.\nmanifest['status'] = 'completed'\nmanifest['ended_at'] = datetime.now(timezone.utc).isoformat()\ntry:\n    started = datetime.fromisoformat(str(manifest.get('started_at')).replace('Z', '+00:00'))\n    ended = datetime.fromisoformat(manifest['ended_at'])\n    manifest['duration_seconds'] = max(0.0, (ended - started).total_seconds())\nexcept Exception:\n    manifest['duration_seconds'] = None\nmanifest['exit_code'] = 0\nmanifest['invalid_run_reason'] = None\nmanifest['artifact_hashes'] = {name: hashlib.sha256((out_dir / name).read_bytes()).hexdigest() for name in output_files if (out_dir / name).exists()}\nmanifest['redaction_status'] = redaction_report['status']\ndump_json(manifest_path, manifest)\n\nprint(json.dumps({'status': metadata['status'], 'checks': checks_summary, 'nfrr': metadata['nfrr'], 'redaction': redaction_report['status']}, ensure_ascii=False, indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

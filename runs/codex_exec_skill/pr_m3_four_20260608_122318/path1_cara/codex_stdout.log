sure Monitor and stored in the shared buffer', requiredness='required')])\ncontext = StageContext(nl=nl, current_dsl=dsl, grounding_map=grounding)\npf, pm = run_sd2_parse(dsl, context)\nprint('SD2', pf.ok, pm.status, pf.error_message)\nsf, sm, build = run_sd3_semantic(dsl, context)\nprint('SD3', sf.ok, sm.status, sf.error_message, sf.diagnostics[:5])\nif sf.ok:\n    df, dm = run_sd4_design(context, policy_profile='generated_candidate')\n    print('SD4', df.ok, dm.status)\n    print('blocking')\n    for i in df.blocking_items:\n        print(i.code, i.instance_key, i.message, i.policy_action, i.rationale)\n    print('advisory')\n    for i in df.advisory_items[:50]:\n        print(i.code, i.instance_key, i.policy_action, i.rationale)\n    print('info')\n    for i in df.info_items[:20]:\n        print(i.code, i.instance_key)\n    print('summary', df.inspect_summary)\nPY\"","aggregated_output":"SD2 True StageStatus.OK None\nSD3 True StageStatus.OK None []\nSD4 True StageStatus.OK\nblocking\nadvisory\nW_DURING_CONST_ASSIGN W_DURING_CONST_ASSIGN:state_path=CARA.Mode_Control_Algorithm.Manual:var_name=control_voltage advisory \nW_DURING_CONST_ASSIGN W_DURING_CONST_ASSIGN:state_path=CARA.Mode_Control_Algorithm.Autocontrol:var_name=log_written advisory \nW_HIGH_VAR_TO_LEAF_RATIO W_HIGH_VAR_TO_LEAF_RATIO:6bdfeb02219f advisory \nW_UNREFERENCED_VAR W_UNREFERENCED_VAR:var_name=CA_mode advisory \nW_UNREFERENCED_VAR W_UNREFERENCED_VAR:var_name=shared_bp_buffer advisory \nW_UNREFERENCED_VAR W_UNREFERENCED_VAR:var_name=blood_pressure advisory \nW_UNREFERENCED_VAR W_UNREFERENCED_VAR:var_name=target_bp advisory \nW_UNREFERENCED_VAR W_UNREFERENCED_VAR:var_name=default_flow_rate advisory \nW_UNREFERENCED_VAR W_UNREFERENCED_VAR:var_name=pump_speed_source advisory \nW_UNREFERENCED_VAR W_UNREFERENCED_VAR:var_name=control_voltage advisory \nW_UNREFERENCED_VAR W_UNREFERENCED_VAR:var_name=infusion_rate advisory \nW_UNREFERENCED_VAR W_UNREFERENCED_VAR:var_name=log_written advisory \nW_UNREFEREN
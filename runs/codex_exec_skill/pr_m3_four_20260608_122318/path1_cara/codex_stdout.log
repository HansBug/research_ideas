nd uses default pump flow',\n            steps=[\n                ScenarioStep(events=[], expected_state='CARA.Mode_Control_Algorithm.Wait', expected_vars={'CA_mode': 0}, name='boot_wait'),\n                ScenarioStep(events=['BuiltInSwitchSet'], expected_state='CARA.Mode_Control_Algorithm.Manual', expected_vars={'CA_mode': 0, 'pump_speed_source': 0}, name='manual_entered'),\n                ScenarioStep(events=[], expected_state='CARA.Mode_Control_Algorithm.Manual', expected_vars={'infusion_rate': 1, 'control_voltage': 0}, name='manual_during_default_flow'),\n            ],\n        ),\n        TestScenario(\n            name='S2_start_autocontrol_and_high_bp_low_flow',\n            description='external_input_initial_vars: high blood_pressure above target leads to lower flow in Autocontrol',\n            initial_vars={'blood_pressure': 100},\n            steps=[\n                ScenarioStep(events=[], expected_state='CARA.Mode_Control_Algorithm.Wait', expected_vars={'shared_bp_buffer': 100}, name='boot_samples_bp'),\n                ScenarioStep(events=['BuiltInSwitchSet'], expected_state='CARA.Mode_Control_Algorithm.Manual', name='manual'),\n                ScenarioStep(events=['InitiateAC'], expected_state='CARA.Mode_Control_Algorithm.Ask_StartAC.AwaitingStart', expected_vars={'CA_mode': 1}, name='ask_start_ac'),\n                ScenarioStep(events=['ChangeSetpoint'], expected_state='CARA.Mode_Control_Algorithm.Ask_StartAC.AwaitingStart', expected_vars={'target_bp': 81}, name='setpoint_changed'),\n                ScenarioStep(events=['StartAC'], expected_state='CARA.Mode_Control_Algorithm.AutocontrolInit', expected_vars={'CA_mode': 2, 'software_control': 1}, name='start_ac'),\n                ScenarioStep(events=['AutoReady'], expected_state='CARA.Mode_Control_Algorithm.Autocontrol', expected_vars={'CA_mode': 3, 'pump_speed_source': 1}, name='auto_ready'),\n                ScenarioStep(events=['ControlTick'], expected_state='CARA.Mode_Control_Algorithm.Autocontrol', expected_vars={'infusion_rate': 1, 'control_voltage': 1, 'log_written': 1}, name='high_bp_low_flow_tick'),\n            ],\n        ),\n        TestScenario(\n            name='S3_autocontrol_fault_releases_control_and_caregiver_restores_manual',\n            description='default_prefix: pump fault under software control alarms, releases control, then fault removal returns Manual',\n            steps=[\n                ScenarioStep(events=[], expected_state='CARA.Mode_Control_Algorithm.Wait', name='boot'),\n                ScenarioStep(events=['BuiltInSwitchSet'], expected_state='CARA.Mode_Control_Algorithm.Manual', name='manual'),\n                ScenarioStep(events=['InitiateAC'], expected_state='CARA.Mode_Control_Algorithm.Ask_StartAC.AwaitingStart', name='ask_start'),\n                ScenarioStep(events=['StartAC'], expected_state='CARA.Mode_Control_Algorithm.AutocontrolInit', name='start_ac'),\n                ScenarioStep(events=['AutoReady'], expected_state='CARA.Mode_Control_Algorithm.Autocontrol', expected_vars={'software_control': 1}, name='autocontrol'),\n                ScenarioStep(events=['PumpFault'], expected_state='CARA.Mode_Control_Algorithm.PumpFault', expected_vars={'alarm_signal': 1, 'error_message': 1, 'software_control': 0, 'pump_control_released': 1}, name='fault_alarm_release'),\n                ScenarioStep(events=['FaultRemoved'], expected_state='CARA.Mode_Control_Algorithm.Manual', expected_vars={'CA_mode': 0, 'software_control': 0, 'pump_control_released': 0}, name='fault_removed_manual'),\n            ],\n        ),\n        prefix_to_auto('S4a_CA_backManual_forces_manual', '.CA_backManual'),\n        prefix_to_auto('S4b_CB_backManual_forces_manual', '.CB_backManual'),\n        prefix_to_auto('S4c_CP_backManual_forces_manual', '.CP_backManual'),\n        prefix_to_auto('S4d_CC_backManual_forces_manual', '.CC_backManual'),\n        TestScenario(\n            name='S5_terminate_from_ask_start_returns_manual',\n            description='default_prefix: caregiver terminates algorithmic control during Ask_StartAC and returns Manual',\n            steps=[\n                ScenarioStep(events=[], expected_state='CARA.Mode_Control_Algorithm.Wait', name='boot'),\n                ScenarioStep(events=['BuiltInSwitchSet'], expected_state='CARA.Mode_Control_Algorithm.Manual', name='manual'),\n                ScenarioStep(events=['InitiateAC'], expected_state='CARA.Mode_Control_Algorithm.Ask_StartAC.AwaitingStart', expected_vars={'CA_mode': 1}, name='ask_start'),\n                ScenarioStep(events=['TerminateAC'], expected_state='CARA.Mode_Control_Algorithm.Manual', expected_vars={'CA_mode': 0, 'software_control': 0}, name='terminate_to_manual'),\n            ],\n        ),\n    ]\n\nscenarios = make_scenarios()\ncoverage, sd5a_meta = run_sd5a_scenario_coverage(final_dsl, scenarios)\nscenario_set, sc5f_meta = freeze_scenario_set(\n    scenarios,\n    source_dsl_hash='sha256:' + hashlib.sha256(final_dsl.encode('utf-8')).hexdigest(),\n    source_inspect_hash='sha256:' + hashlib.sha256(json.dumps(ctx.inspect_json or {}, sort_keys=True, default=str).encode('utf-8')).hexdigest(),\n    source_grounding_hash='sha256:' + hashlib.sha256(json.dumps(source_spans, sort_keys=True, ensure_ascii=False).encode('utf-8')).hexdigest(),\n    coverage_report=coverage,\n)\nsd6_feedback, sd6_meta = run_sd6_sim(final_dsl, scenario_set, ctx)\n\n# Compact feedback helper.\ndef meta_dict(meta: Any) -> dict[str, Any]:\n    return asdict(meta) if meta is not None else {'ran': False, 'ok': False, 'status': 'not_run'}\n\ndef item_dict(item: Any) -> dict[str, Any]:\n    d = asdict(item)\n    return {k: v for k, v in d.items() if k in {'code', 'severity', 'message', 'instance_key', 'policy_action', 'rationale', 'refs', 'budget_remaining'}}\n\nsd4_advisories = [item_dict(i) for i in (sd4_feedback.advisory_items if sd4_feedback else [])]\nsd4_infos = [item_dict(i) for i in (sd4_feedback.info_items if sd4_feedback else [])]\nsd4_blocking = [item_dict(i) for i in (sd4_feedback.blocking_items if sd4_feedback else [])]\n\nscenario_results = asdict(sd6_feedback)\n\nstage_ledger = {\n    'schema_version': 'pr-m3-tool-stage-check-ledger-v1',\n    'case_key': case['case_key'],\n    'final_model_sha256': hashlib.sha256(final_dsl.encode('utf-8')).hexdigest(),\n    'stages': [\n        {'stage': 'SD-2', 'attempt': 'final_candidate', 'command': 'run_sd2_parse(final_model, StageContext)', 'ok': sd2_feedback.ok, 'meta': meta_dict(sd2_meta), 'diagnostics': sd2_feedback.diagnostics, 'impact': 'blocking if fail'},\n        {'stage': 'SD-3', 'attempt': 'final_candidate', 'command': 'run_sd3_semantic(final_model, StageContext)', 'ok': sd3_feedback.ok, 'meta': meta_dict(sd3_meta), 'diagnostics': sd3_feedback.diagnostics, 'impact': 'blocking if fail'},\n        {'stage': 'SD-4', 'attempt': 'final_candidate', 'command': 'run_sd4_design(context, policy_profile=\\\"generated_candidate\\\")', 'ok': bool(sd4_feedback and sd4_feedback.ok), 'meta': meta_dict(sd4_meta), 'blocking_items': sd4_blocking, 'advisory_items': sd4_advisories, 'info_items': sd4_infos, 'impact': 'no unwaived blocking; advisories tracked in waiver/risk ledger'},\n        {'stage': 'SD-5A', 'attempt': 'final_scenario_set', 'command': 'run_sd5a_scenario_coverage(final_model, scenarios)', 'ok': sd5a_meta.ok, 'meta': meta_dict(sd5a_meta), 'coverage': coverage, 'impact': 'advisory mutation-coverage gap; affects DMR not FE'},\n        {'stage': 'SC-5F', 'attempt': 'final_scenario_set', 'command': 'freeze_scenario_set(scenarios, hashes, coverage_report)', 'ok': sc5f_meta.ok, 'meta': meta_dict(sc5f_meta), 'scenario_set_id': scenario_set.scenario_set_id, 'scenario_count': len(scenario_set.scenarios), 'impact': 'oracle frozen before final SD-6'},\n        {'stage': 'SD-6', 'attempt': 'final_scenario_set', 'command': 'run_sd6_sim(final_model, frozen_scenario_set, StageContext)', 'ok': sd6_feedback.ok, 'meta': meta_dict(sd6_meta), 'n_scenarios': sd6_feedback.n_scenarios, 'n_scenarios_passed': sd6_feedback.n_scenarios_passed, 'scenario_results': scenario_results, 'impact': 'blocking if fail; final run passed all frozen scenarios'},\n    ],\n    'historical_attempts': [\n        {'attempt': 'v0_initial', 'result': 'SD-2 pass, SD-3 fail', 'diagnostic': 'E_DURING_ASPECT_INVALID: leaf state Manual/Autocontrol used during before aspect', 'repair': 'changed leaf-state during before blocks to plain during blocks'},\n        {'attempt': 'v1_semantic_design_ok', 'result': 'SD-2/3/4 pass, SD-6 failed 3/4', 'diagnostic': 'SimulationRuntimeEventError: StartAC event not resolvable from Ask_StartAC.AwaitingStart', 'repair': 'modeled Ask_StartAC exit via AwaitingStart -> [*] :: StartAC and parent guarded exit target'},\n        {'attempt': 'v1_scenario_path', 'result': 'SD-6 failed cross-component backManual scenario only', 'diagnostic': 'bare CB_backManual event is chain-scoped forced transition event', 'repair': 'scenario uses parent-relative .CB_backManual/.CA_backManual/.CP_backManual/.CC_backManual event injection'},\n    ],\n}\n\nrepair_ledger = {\n    'schema_version': 'pr-m3-repair-ledger-v1',\n    'case_key': case['case_key'],\n    'fix_log_style': 'FixRequestBatch/SL-9/SL-10-equivalent local ledger; no provider call used',\n    'entries': [\n        {\n            'repair_id': 'R-001',\n            'source_stage': 'SD-3',\n            'fix_request_batch': [{'request_id': 'FR-001', 'diagnostic': 'E_DURING_ASPECT_INVALID', 'hard_block': True, 'waiver_allowed': False, 'local_check_required': ['SD-2', 'SD-3']}],\n            'sl9_decisions': [{'request_id': 'FR-001', 'decision': 'accept', 'reason': 'pyfcstm semantic rule allows aspect-qualified during only where supported; leaf states can use plain during for periodic actions'}],\n            'candidate_diff': 'Manual and Autocontrol leaf states: during before {...} -> during {...}; removed no-op log_written self-assignment.',\n            'local_check_evidence': {'SD-2': 'pass', 'SD-3': 'pass after repair'},\n            'sl10_review': {'decision': 'pass', 'basis': 'The repair is grammar/semantic preserving: it changes scheduling aspect syntax without changing NL obligations for manual/autocontrol periodic outputs.'},\n            'next_action': 'return_to_SD2',\n        },\n        {\n            'repair_id': 'R-002',\n            'source_stage': 'SD-6',\n            'fix_request_batch': [{'request_id': 'FR-002', 'diagnostic': 'SimulationRuntimeEventError on StartAC', 'hard_block': True, 'waiver_allowed': False, 'local_check_required': ['SD-2', 'SD-3', 'SD-4', 'SD-6']}],\n            'sl9_decisions': [{'request_id': 'FR-002', 'decision': 'accept', 'reason': 'The paper requires Ask_StartAC submode and StartAC enters AutocontrolInit; pyfcstm executes this reliably through submode exit plus parent guarded transition.'}],\n            'candidate_diff': 'Ask_StartAC now has AwaitingStart -> [*] :: StartAC effect { ask_exit_target = 1; } and AwaitingStart -> [*] :: TerminateAC effect { ask_exit_target = 0; }; parent transitions route to AutocontrolInit or Manual by ask_exit_target.',\n            'local_check_evidence': {'SD-2': 'pass', 'SD-3': 'pass', 'SD-4': 'pass with no blocking', 'SD-6': 'StartAC and TerminateAC scenarios pass'},\n            'sl10_review': {'decision': 'pass', 'basis': 'The helper variable is a portable pyfcstm exit-routing abstraction for nested state exits; it is declared in AAT/NFRR as synthetic and does not introduce CARA-specific lexical special-case logic.'},\n            'next_action': 'return_to_SD2',\n        },\n        {\n            'repair_id': 'R-003',\n            'source_stage': 'SD-6 scenario execution',\n            'fix_request_batch': [{'request_id': 'FR-003', 'diagnostic': 'SimulationRuntimeEventError on bare CB_backManual scenario event', 'hard_block': True, 'waiver_allowed': False, 'local_check_required': ['SD-6']}],\n            'sl9_decisions': [{'request_id': 'FR-003', 'decision': 'accept_scenario_repair', 'reason': 'forced transitions expose chain-scoped events; scenario must inject parent-relative .CB_backManual from the current leaf state.'}],\n            'candidate_diff': 'No model DSL semantic change. Scenario event names changed from bare CB_backManual to parent-relative .CB_backManual and the same pattern for CA/CP/CC.',\n            'local_check_evidence': {'SD-6': 'all four cross-component backManual scenarios pass from default-prefix reachability witness'},\n            'sl10_review': {'decision': 'pass', 'basis': 'This fixes the test harness event path, not the model semantics. It is portable to chain-scoped forced transitions and documented in scenario provenance.'},\n            'next_action': 'final_audit',\n        },\n    ],\n    'waivers': [\n        {'warning_id': 'W_UNREFERENCED_VAR:*', 'waiver_type': 'output_or_observability_variable', 'accepted': True, 'evidence': 'NL/P-1/P-2/P-4: CA_mode, buffer, control voltage, infusion_rate, log/alarm/message/release are outputs or mode-memory variables, not guard controls.', 'risk': 'Variables may look unused to SD-4 because NFRR scenarios assert them rather than model guards consuming them.'},\n        {'warning_id': 'W_VARIABLE_WRITTEN_NEVER_READ_AND_NOT_NL_OUTPUT:*', 'waiver_type': 'output_only', 'accepted': True, 'evidence': 'NL explicitly mentions shared buffer, pump speed source/control voltage, log files, alarms/messages and software release.', 'risk': 'Some outputs are abstract flags rather than full UI/logging subsystems.'},\n        {'warning_id': 'W_DURING_CONST_ASSIGN:*', 'waiver_type': 'accepted_abstraction', 'accepted': True, 'evidence': 'Manual mode continuously leaves control_voltage=0; Autocontrol continuously records log_written=1 while controlling.', 'risk': 'Periodic constant assignment is intentional but may overstate logging frequency.'},\n        {'warning_id': 'W_HIGH_VAR_TO_LEAF_RATIO', 'waiver_type': 'accepted_abstraction', 'accepted': True, 'evidence': 'NL has dense variable participation: CA_mode, setpoint, blood pressure, flow, control voltage, alarms, logs and release flags.', 'risk': 'Model is EFSM-heavy relative to the number of named states.'},\n    ],\n}\n\nnl_spans = [\n    {'id': 'NL-1', 'text': 'CARA coordinates Caregiver Interface, Blood Pressure Monitor, Algorithm, Pump Monitors around an infusion pump; sensor readings are stored in a shared buffer.', 'class': 'required_obligation', 'rationale': 'component boundary and shared buffer action affect model variables/actions'},\n    {'id': 'NL-2', 'text': 'The pump has manual and autocontrol modes.', 'class': 'required_obligation', 'rationale': 'core mode states'},\n    {'id': 'NL-3', 'text': 'Manual mode uses built-in switch and caregiver default flow rate directly on the pump.', 'class': 'required_obligation', 'rationale': 'manual transition and output action'},\n    {'id': 'NL-4', 'text': 'Autocontrol mode pump speed is set by control voltage from an external source.', 'class': 'required_obligation', 'rationale': 'autocontrol output action'},\n    {'id': 'NL-5', 'text': 'Algorithm controls infusion rate, records logs, and higher blood pressure produces lower flow rate.', 'class': 'required_obligation', 'rationale': 'rate/log/action relation'},\n    {'id': 'NL-6', 'text': 'Caregiver Interface modifies target blood pressure, initiates or terminates algorithmic control, and displays/sounds error messages.', 'class': 'required_obligation', 'rationale': 'events/actions for setpoint, start/terminate and error outputs'},\n    {'id': 'NL-7', 'text': 'Mode_Control_Algorithm has manual/autocontrol-related states plus Ask_StartAC; setpoint can change in Ask_StartAC and StartAC enters AutocontrolInit.', 'class': 'required_obligation', 'rationale': 'hierarchy and transition obligations'},\n    {'id': 'NL-8', 'text': 'During normal autocontrol, CARA controls flow only while no pump-operation complications exist.', 'class': 'required_obligation', 'rationale': 'normal control state and fault exit'},\n    {'id': 'NL-9', 'text': 'Pump fault such as occlusion activates alarm signals; caregiver removes the fault; when CARA was controlling the pump software releases control.', 'class': 'required_obligation', 'rationale': 'critical fault/release/recovery chain'},\n    {'id': 'NL-10', 'text': 'CA_backManual or any of CB_backManual, CP_backManual, CC_backManual causes CA_mode to become Manual.', 'class': 'required_obligation', 'rationale': 'critical cross-component forced fallback'},\n]\n\nobligations = [\n    {'obligation_id': 'O-001', 'nl_span_id': 'NL-1', 'type': 'action/output', 'criticality': 'major', 'requiredness': 'required', 'evidence_text': 'sensor readings are stored in a shared buffer', 'required_fields': ['shared_bp_buffer update from blood_pressure'], 'scope_status': 'in_scope'},\n    {'obligation_id': 'O-002', 'nl_span_id': 'NL-2', 'type': 'state', 'criticality': 'major', 'requiredness': 'required', 'evidence_text': 'manual and autocontrol modes', 'required_fields': ['Manual', 'Autocontrol'], 'scope_status': 'in_scope'},\n    {'obligation_id': 'O-003', 'nl_span_id': 'NL-3', 'type': 'transition/action', 'criticality': 'major', 'requiredness': 'required', 'evidence_text': 'built-in switch/default flow in manual mode', 'required_fields': ['BuiltInSwitchSet -> Manual', 'infusion_rate=default_flow_rate', 'control_voltage=0'], 'scope_status': 'in_scope'},\n    {'obligation_id': 'O-004', 'nl_span_id': 'NL-4', 'type': 'action/output', 'criticality': 'major', 'requiredness': 'required', 'evidence_text': 'autocontrol pump speed set by control voltage', 'required_fields': ['pump_speed_source=1', 'control_voltage=infusion_rate'], 'scope_status': 'in_scope'},\n    {'obligation_id': 'O-005', 'nl_span_id': 'NL-5', 'type': 'guard/action', 'criticality': 'major', 'requiredness': 'required', 'evidence_text': 'higher blood pressure, lower flow rate; log files', 'required_fields': ['blood_pressure > target_bp lowers infusion_rate', 'log_written=1'], 'scope_status'
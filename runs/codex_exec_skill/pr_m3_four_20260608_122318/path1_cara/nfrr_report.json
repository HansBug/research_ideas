  "nl_spans": [
    {
      "id": "NL-1",
      "text": "CARA coordinates Caregiver Interface, Blood Pressure Monitor, Algorithm, Pump Monitors around an infusion pump; sensor readings are stored in a shared buffer.",
      "class": "required_obligation",
      "rationale": "component boundary and shared buffer action affect model variables/actions"
    },
    {
      "id": "NL-2",
      "text": "The pump has manual and autocontrol modes.",
      "class": "required_obligation",
      "rationale": "core mode states"
    },
    {
      "id": "NL-3",
      "text": "Manual mode uses built-in switch and caregiver default flow rate directly on the pump.",
      "class": "required_obligation",
      "rationale": "manual transition and output action"
    },
    {
      "id": "NL-4",
      "text": "Autocontrol mode pump speed is set by control voltage from an external source.",
      "class": "required_obligation",
      "rationale": "autocontrol output action"
    },
    {
      "id": "NL-5",
      "text": "Algorithm controls infusion rate, records logs, and higher blood pressure produces lower flow rate.",
      "class": "required_obligation",
      "rationale": "rate/log/action relation"
    },
    {
      "id": "NL-6",
      "text": "Caregiver Interface modifies target blood pressure, initiates or terminates algorithmic control, and displays/sounds error messages.",
      "class": "required_obligation",
      "rationale": "events/actions for setpoint, start/terminate and error outputs"
    },
    {
      "id": "NL-7",
      "text": "Mode_Control_Algorithm has manual/autocontrol-related states plus Ask_StartAC; setpoint can change in Ask_StartAC and StartAC enters AutocontrolInit.",
      "class": "required_obligation",
      "rationale": "hierarchy and transition obligations"
    },
    {
      "id": "NL-8",
      "text": "During normal autocontrol, CARA controls flow only while no pump-operation complications exist.",
      "class": "required_obligation",
      "rationale": "normal control state and fault exit"
    },
    {
      "id": "NL-9",
      "text": "Pump fault such as occlusion activates alarm signals; caregiver removes the fault; when CARA was controlling the pump software releases control.",
      "class": "required_obligation",
      "rationale": "critical fault/release/recovery chain"
    },
    {
      "id": "NL-10",
      "text": "CA_backManual or any of CB_backManual, CP_backManual, CC_backManual causes CA_mode to become Manual.",
      "class": "required_obligation",
      "rationale": "critical cross-component forced fallback"
    }
  ],

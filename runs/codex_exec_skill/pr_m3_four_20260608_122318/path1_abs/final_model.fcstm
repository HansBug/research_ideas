def int k1 = 0;
def int k2 = 0;
def int n = 0;
def float slp = 0.0;

state ABSBrakeSupervisor {
    [*] -> increase;

    state increase {
        during { k1 = 1; k2 = 0; n = 0; }
    }

    state hold {
        during { k1 = 0; k2 = 0; n = 0; }
    }

    state decrease {
        during { k1 = 0; k2 = 1; n = 500; }
    }

    increase -> hold : if [slp <= 0.01];
    hold -> increase : if [slp > 0.01];
    hold -> decrease : if [slp < -0.01];
    decrease -> hold : if [slp >= -0.01];
}

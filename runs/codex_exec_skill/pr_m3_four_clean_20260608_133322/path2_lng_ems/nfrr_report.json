  "nl_spans": [
    {
      "id": "NL-1",
      "text": "EMS manages PVs, WECs, DGs, LNG, batteries, loads, and cut-in/cut-out commands.",
      "class": "required_obligation",
      "rationale": "Defines controller boundary and output command role."
    },
    {
      "id": "NL-2",
      "text": "It controls dispatch during changing periods and dynamically switches states to maintain balance.",
      "class": "required_obligation",
      "rationale": "Requires mode selection/retention and resampling abstraction."
    },
    {
      "id": "NL-3",
      "text": "FSM reads PL, Ppv, Pw, SoC, engine capacity bounds and returns generator/battery/spare powers.",
      "class": "required_obligation",
      "rationale": "Defines external inputs and outputs."
    },
    {
      "id": "NL-4",
      "text": "The twelve finite states are selected by logical conditions over demand, generation, capacity and SoC.",
      "class": "required_obligation",
      "rationale": "Requires 12-state logical guard table."
    },
    {
      "id": "NL-5",
      "text": "When Ppv + Pw covers PL, RES serves load and charges below 0.95 or spare at least 0.95.",
      "class": "required_obligation",
      "rationale": "States 1_1 and 1_2."
    },
    {
      "id": "NL-6",
      "text": "Below PL, dispatch follows RES, batteries when suitable, LNG before DGs, DG1/DG2 last.",
      "class": "required_obligation",
      "rationale": "Priority chain states 2_1 to 2_6."
    },
    {
      "id": "NL-7",
      "text": "Low-SoC branches add Pgmax/5 and Pd1max/10 charging margins.",
      "class": "required_obligation",
      "rationale": "Action/output obligations in states 2_2, 2_4 and 2_6."
    },
    {
      "id": "NL-8",
      "text": "When PL = 0, RES goes to battery charging or spare by SoC thresholds.",
      "class": "required_obligation",
      "rationale": "States 3_1 to 3_3."
    },
    {
      "id": "NL-9",
      "text": "Overload completion is illegal; all thermal units active and battery covers lack, should never occur.",
      "class": "required_obligation",
      "rationale": "Critical abnormal state 2_7 and illegal flag."
    }
  ],

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Inactive"/>
</state>
<state id="Inactive">
<transition event="Session Start" target="Ready_for_Input"/>
<transition target="end"/>
</state>
<state id="Ready_for_Input">
<transition event="Text Input" target="Detecting_Language"/>
</state>
<state id="Detecting_Language">
<transition event="Language Detected" target="Translating_Text"/>
</state>
<state id="Translating_Text">
<transition event="Translation Complete" target="Displaying_Translated_Text"/>
</state>
<state id="Displaying_Translated_Text">
<transition event="More Input" target="Ready_for_Input"/>
<transition event="Session End" target="Inactive"/>
</state>
<state id="end"/>
</scxml>

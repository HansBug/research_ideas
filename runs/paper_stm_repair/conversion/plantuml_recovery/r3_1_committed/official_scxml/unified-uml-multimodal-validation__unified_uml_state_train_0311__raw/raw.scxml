<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="MonitoringContacts"/>
</state>
<state id="MonitoringContacts">
<transition event="Contact inactive" target="DetectingInactivity"/>
<transition event="Continue monitoring" target="MonitoringContacts"/>
</state>
<state id="DetectingInactivity">
<transition event="Generate notification" target="GeneratingNotification"/>
</state>
<state id="GeneratingNotification">
<transition event="Prepare and send" target="SendingNotification"/>
</state>
<state id="SendingNotification">
<transition event="Notification sent" target="end"/>
</state>
<state id="end"/>
</scxml>

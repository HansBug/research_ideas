<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Dashboard"/>
</state>
<state id="Dashboard">
<transition event="Click on Project List" target="ViewProjects"/>
<transition event="Click on Calendar View" target="ViewCalendar"/>
<transition event="Logout" target="end"/>
</state>
<state id="ViewProjects">
<transition event="Click Back" target="Dashboard"/>
<transition event="Click on Project Link" target="ViewProjectDetails"/>
</state>
<state id="ViewCalendar">
<transition event="Click Back" target="Dashboard"/>
</state>
<state id="end"/>
<state id="ViewProjectDetails">
<transition event="Click Back" target="Dashboard"/>
<transition event="Click on Task List" target="ViewTasks"/>
</state>
<state id="ViewTasks">
<transition event="Click Back" target="Dashboard"/>
<transition event="Click on Task Link" target="ViewTaskDetails"/>
</state>
<state id="ViewTaskDetails">
<transition event="Click Back" target="Dashboard"/>
</state>
</scxml>

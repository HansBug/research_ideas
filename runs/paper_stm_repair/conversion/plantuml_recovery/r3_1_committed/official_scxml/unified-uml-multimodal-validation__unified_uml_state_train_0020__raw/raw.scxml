<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectImage"/>
<transition event="User views all tags" target="ViewTags"/>
<transition event="User searches by name/tag" target="SearchImages"/>
</state>
<state id="SelectImage">
<transition event="User selects an image" target="IdentifyDuplicates"/>
</state>
<state id="IdentifyDuplicates">
<transition event="System identifies duplicates" target="TagDuplicates"/>
<transition event="No duplicates found" target="end"/>
</state>
<state id="TagDuplicates">
<transition event="System tags duplicates" target="UpdateTags"/>
<transition event="Tagging completes" target="end"/>
</state>
<state id="UpdateTags">
<transition event="Tags updated, process completes" target="end"/>
<transition event="New tags applied" target="TagDuplicates"/>
</state>
<state id="end"/>
<state id="ViewTags">
<transition event="Return to initial state" target="end"/>
</state>
<state id="SearchImages">
<transition event="Search completes" target="end"/>
</state>
</scxml>

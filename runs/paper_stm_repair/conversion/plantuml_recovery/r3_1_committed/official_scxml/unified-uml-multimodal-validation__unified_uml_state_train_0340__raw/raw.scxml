<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="TaskList"/>
</state>
<state id="TaskList">
<transition event="Exit" target="end"/>
<transition event="Add New Task" target="AddTask"/>
<transition event="View Tasks" target="ViewTasks"/>
<transition event="Delete Task" target="DeleteTask"/>
<transition event="Sort by Title" target="SortByTitle"/>
<transition event="Sort by Date" target="SortByDate"/>
<transition event="Sort by Priority" target="SortByPriority"/>
</state>
<state id="end"/>
<state id="AddTask">
<transition event="Task Added" target="TaskList"/>
</state>
<state id="ViewTasks">
<transition event="View Complete" target="TaskList"/>
</state>
<state id="DeleteTask">
<transition event="Task Deleted" target="TaskList"/>
</state>
<state id="SortByTitle">
<transition event="Sorting Complete" target="TaskList"/>
</state>
<state id="SortByDate">
<transition event="Sorting Complete" target="TaskList"/>
</state>
<state id="SortByPriority">
<transition event="Sorting Complete" target="TaskList"/>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Logged_Out"/>
</state>
<state id="Logged_Out">
<transition event="Login" target="Logging_In"/>
</state>
<state id="Logging_In">
<transition event="Successful Login" target="Profile_Management"/>
</state>
<state id="Profile_Management">
<transition event="Logout" target="end"/>
<transition event="Receive Notification" target="Viewing_Notifications"/>
<transition event="Edit Profile" target="Editing_Profile"/>
<transition event="Access Profile Without Login" target="Logging_In"/>
</state>
<state id="end"/>
<state id="Viewing_Notifications">
<transition event="Return to Profile" target="Profile_Management"/>
</state>
<state id="Editing_Profile">
<transition event="Save Changes" target="Profile_Management"/>
</state>
</scxml>

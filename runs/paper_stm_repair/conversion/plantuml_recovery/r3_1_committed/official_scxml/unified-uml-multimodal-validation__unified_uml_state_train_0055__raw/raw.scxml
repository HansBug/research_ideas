<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="User interaction" target="CollectUserPreferences"/>
</state>
<state id="CollectUserPreferences">
<transition event="Data collected" target="AnalyzeData"/>
</state>
<state id="AnalyzeData">
<transition event="Analysis complete" target="GenerateRecommendations"/>
</state>
<state id="GenerateRecommendations">
<transition event="Recommendations ready" target="DisplayRecommendations"/>
</state>
<state id="DisplayRecommendations">
<transition event="Recommendations displayed" target="end"/>
</state>
<state id="end"/>
</scxml>

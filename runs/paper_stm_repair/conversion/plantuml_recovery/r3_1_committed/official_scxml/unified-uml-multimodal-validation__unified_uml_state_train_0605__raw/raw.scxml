<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="Add Recipe" target="AddRecipe"/>
<transition event="Search Recipe" target="SearchRecipe"/>
<transition event="Sort Recipes" target="SortRecipes"/>
<transition event="Filter Recipes" target="FilterRecipes"/>
</state>
<state id="AddRecipe">
<transition event="Recipe added successfully" target="RecipeAdded"/>
</state>
<state id="SearchRecipe">
<transition event="Recipe found" target="RecipeFound"/>
</state>
<state id="SortRecipes">
<transition event="Recipes sorted" target="RecipesSorted"/>
</state>
<state id="FilterRecipes">
<transition event="Recipes filtered" target="RecipesFiltered"/>
</state>
<state id="RecipeAdded">
<transition event="Add another recipe" target="AddRecipe"/>
<transition event="Return to main state" target="InitialState"/>
</state>
<state id="RecipeFound">
<transition event="Search again" target="SearchRecipe"/>
<transition event="Return to main state" target="InitialState"/>
</state>
<state id="RecipesSorted">
<transition event="Sort again" target="SortRecipes"/>
<transition event="Return to main state" target="InitialState"/>
</state>
<state id="RecipesFiltered">
<transition event="Filter again" target="FilterRecipes"/>
<transition event="Return to main state" target="InitialState"/>
</state>
<state id="FinalState"/>
<state id="end">
<transition target="FinalState"/>
</state>
</scxml>

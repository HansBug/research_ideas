<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition target="DisplayContacts"/>
</state>
<state id="DisplayContacts">
<transition event="Sort" target="SortContacts"/>
<transition event="Search" target="SearchContacts"/>
<transition event="Delete" target="DeleteContacts"/>
<transition event="Exit" target="Exit"/>
</state>
<state id="SortContacts">
<transition event="Return" target="DisplayContacts"/>
</state>
<state id="SearchContacts">
<transition event="Return" target="DisplayContacts"/>
</state>
<state id="DeleteContacts">
<transition event="Return" target="DisplayContacts"/>
</state>
<state id="Exit">
<transition event="Terminate" target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition event="Display dashboard" target="DisplayDashboard"/>
<transition event="Access templates" target="AccessTemplates"/>
<transition event="Access documentation" target="AccessDocumentation"/>
<transition event="Access support" target="AccessSupport"/>
</state>
<state id="DisplayDashboard">
<transition event="Exit" target="end"/>
<transition event="Update dashboard" target="UpdateDashboard"/>
</state>
<state id="end"/>
<state id="AccessTemplates">
<transition event="Exit" target="end"/>
<transition event="Customize templates" target="CustomizeTemplates"/>
</state>
<state id="AccessDocumentation">
<transition event="Exit" target="end"/>
<transition event="View documentation" target="ViewDocumentation"/>
</state>
<state id="AccessSupport">
<transition event="Exit" target="end"/>
<transition event="View support" target="ViewSupport"/>
</state>
<state id="UpdateDashboard">
<transition event="Return to display" target="DisplayDashboard"/>
</state>
<state id="CustomizeTemplates">
<transition event="Return to access" target="AccessTemplates"/>
</state>
<state id="ViewDocumentation">
<transition event="Return to access" target="AccessDocumentation"/>
</state>
<state id="ViewSupport">
<transition event="Return to access" target="AccessSupport"/>
</state>
</scxml>

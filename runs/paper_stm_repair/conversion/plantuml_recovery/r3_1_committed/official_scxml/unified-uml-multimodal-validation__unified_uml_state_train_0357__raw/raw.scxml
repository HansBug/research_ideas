<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition event="View categories" target="ViewingCategories"/>
</state>
<state id="ViewingCategories">
<transition event="Add custom category" target="AddingCustomCategory"/>
<transition event="Edit category" target="EditingCustomCategory"/>
<transition event="Delete category" target="DeletingCustomCategory"/>
<transition event="Add bulk categories" target="BulkAdding"/>
<transition event="Sort categories" target="SortingCategories"/>
<transition event="Save categories" target="SavingCategories"/>
<transition event="View as table" target="ViewingInTable"/>
<transition event="Access saved list" target="AccessingSavedList"/>
</state>
<state id="AddingCustomCategory">
<transition event="Save and exit" target="end"/>
</state>
<state id="end"/>
<state id="EditingCustomCategory">
<transition event="Save and exit" target="end"/>
</state>
<state id="DeletingCustomCategory">
<transition event="Confirm and exit" target="end"/>
</state>
<state id="BulkAdding">
<transition event="Save and exit" target="end"/>
</state>
<state id="SortingCategories">
<transition event="Apply sort" target="end"/>
</state>
<state id="SavingCategories">
<transition event="Save to file" target="end"/>
</state>
<state id="ViewingInTable">
<transition event="Close table" target="end"/>
</state>
<state id="AccessingSavedList">
<transition event="Close list" target="end"/>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="EmailListDisplayed"/>
</state>
<state id="EmailListDisplayed">
<transition event="exit application" target="end"/>
<transition event="sort emails" target="EmailsSortedByCriteria"/>
<transition event="delete email" target="EmailDeleted"/>
<transition event="mark email as unread" target="EmailMarkedAsUnread"/>
</state>
<state id="end"/>
<state id="EmailsSortedByCriteria">
<transition event="return to list" target="EmailListDisplayed"/>
</state>
<state id="EmailDeleted">
<transition event="return to list" target="EmailListDisplayed"/>
</state>
<state id="EmailMarkedAsUnread">
<transition event="return to list" target="EmailListDisplayed"/>
</state>
</scxml>

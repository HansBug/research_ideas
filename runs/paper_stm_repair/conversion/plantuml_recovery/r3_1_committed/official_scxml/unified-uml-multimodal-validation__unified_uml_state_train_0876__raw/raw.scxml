<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InputInterestsPreferences"/>
</state>
<state id="InputInterestsPreferences">
<transition target="ExploreProducts"/>
</state>
<state id="ExploreProducts">
<transition target="AnalyzePastPurchases"/>
</state>
<state id="AnalyzePastPurchases">
<transition target="GenerateRecommendations"/>
</state>
<state id="GenerateRecommendations">
<transition target="DisplayRecommendations"/>
</state>
<state id="DisplayRecommendations">
<transition target="TrackPurchases"/>
</state>
<state id="TrackPurchases">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

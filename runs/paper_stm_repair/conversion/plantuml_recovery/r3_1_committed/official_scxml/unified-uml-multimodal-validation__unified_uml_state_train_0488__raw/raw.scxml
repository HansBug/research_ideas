<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="OrderCreated"/>
</state>
<state id="OrderCreated">
<transition event="start processing" target="OrderProcessing"/>
</state>
<state id="OrderProcessing">
<transition event="all items completed" target="OrderCompleted"/>
<transition event="any item canceled" target="OrderCanceled"/>
<transition event="system error" target="OrderError"/>
</state>
<state id="OrderCompleted">
<transition event="finalize" target="end"/>
</state>
<state id="OrderCanceled">
<transition event="finalize" target="end"/>
</state>
<state id="OrderError">
<transition event="finalize" target="end"/>
</state>
<state id="end"/>
</scxml>

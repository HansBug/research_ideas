<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InputPreferences"/>
</state>
<state id="InputPreferences">
<transition event="system processes preferences" target="ProcessingPreferences"/>
</state>
<state id="ProcessingPreferences">
<transition event="recommendations generated" target="DisplayRecommendations"/>
</state>
<state id="DisplayRecommendations">
<transition event="user interacts with recommendations" target="UserInteraction"/>
</state>
<state id="UserInteraction">
<transition event="session ends" target="end"/>
</state>
<state id="end"/>
</scxml>

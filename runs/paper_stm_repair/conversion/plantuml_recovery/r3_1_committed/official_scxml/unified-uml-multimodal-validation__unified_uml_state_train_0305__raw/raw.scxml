<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="Login" target="Login"/>
</state>
<state id="Login">
<transition event="Successful Login" target="ProfileSelection"/>
</state>
<state id="ProfileSelection">
<transition event="Select Profile" target="ProfileContext"/>
</state>
<state id="ProfileContext">
<transition event="Switch Profile" target="ProfileSelection"/>
<transition event="Logout" target="Logout"/>
</state>
<state id="Logout">
<transition event="Logout" target="end"/>
</state>
<state id="end"/>
</scxml>

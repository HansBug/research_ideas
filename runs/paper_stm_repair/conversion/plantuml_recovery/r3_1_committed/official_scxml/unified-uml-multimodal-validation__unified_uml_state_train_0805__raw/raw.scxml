<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Initial_State"/>
</state>
<state id="Initial_State">
<transition event="Create New Document" target="Document_Creation"/>
<transition event="Search Documents" target="Search_Documents"/>
<transition event="Export Document" target="Export_Document"/>
<transition event="Add Custom Tags/Metadata" target="Add_Metadata"/>
<transition event="Organize Documents" target="Organize_Documents"/>
<transition event="Manage Settings" target="Manage_Settings"/>
<transition event="Create Custom Reports" target="Generate_Report"/>
<transition event="Logout" target="Logout"/>
</state>
<state id="Document_Creation">
<transition event="Add Text/Images/Media" target="Add_Content"/>
</state>
<state id="Search_Documents">
<transition event="View Search Results" target="View_Search_Results"/>
</state>
<state id="Export_Document">
<transition event="Select Export Format" target="Export_Format_Selection"/>
</state>
<state id="Add_Metadata">
<transition event="Manage Metadata" target="Metadata_Management"/>
</state>
<state id="Organize_Documents">
<transition event="Organize by Category/Tag/Metadata" target="Organize_By_Metadata"/>
</state>
<state id="Manage_Settings">
<transition event="Configure System Settings" target="System_Settings"/>
</state>
<state id="Generate_Report">
<transition event="Generate Custom Report" target="Report_Generation"/>
</state>
<state id="Logout">
<transition event="Logout" target="end"/>
</state>
<state id="Add_Content">
<transition event="Save Document" target="Save_Document"/>
</state>
<state id="Save_Document">
<transition event="Return to Initial State" target="Initial_State"/>
</state>
<state id="View_Search_Results">
<transition event="Return to Initial State" target="Initial_State"/>
</state>
<state id="Export_Format_Selection">
<transition event="Export Complete" target="Export_Complete"/>
</state>
<state id="Export_Complete">
<transition event="Return to Initial State" target="Initial_State"/>
</state>
<state id="Metadata_Management">
<transition event="Return to Initial State" target="Initial_State"/>
</state>
<state id="Organize_By_Metadata">
<transition event="Return to Initial State" target="Initial_State"/>
</state>
<state id="System_Settings">
<transition event="Return to Initial State" target="Initial_State"/>
</state>
<state id="Report_Generation">
<transition event="View Report" target="View_Report"/>
</state>
<state id="View_Report">
<transition event="Return to Initial State" target="Initial_State"/>
</state>
<state id="end"/>
</scxml>

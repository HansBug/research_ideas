<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectTaskManagementMethod"/>
</state>
<state id="SelectTaskManagementMethod">
<transition target="ManageTasks"/>
<transition target="ViewTaskStatusAndProgress"/>
<transition target="AddNotesOrComments"/>
<transition target="SetRemindersAndNotifications"/>
<transition target="SaveSettings"/>
<transition target="end"/>
</state>
<state id="ManageTasks">
<transition target="ViewTaskStatusAndProgress"/>
<transition target="AddNotesOrComments"/>
<transition target="SetRemindersAndNotifications"/>
<transition target="SaveSettings"/>
<transition target="end"/>
</state>
<state id="ViewTaskStatusAndProgress">
<transition target="ManageTasks"/>
<transition target="SaveSettings"/>
<transition target="end"/>
</state>
<state id="AddNotesOrComments">
<transition target="ManageTasks"/>
<transition target="SaveSettings"/>
<transition target="end"/>
</state>
<state id="SetRemindersAndNotifications">
<transition target="ManageTasks"/>
<transition target="SaveSettings"/>
<transition target="end"/>
</state>
<state id="SaveSettings">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

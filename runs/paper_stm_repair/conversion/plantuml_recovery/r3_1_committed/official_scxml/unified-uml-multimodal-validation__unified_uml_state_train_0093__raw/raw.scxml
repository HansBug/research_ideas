<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InputReadingPreferences"/>
</state>
<state id="InputReadingPreferences">
<transition target="TrackReadingHistory"/>
<transition target="GenerateRecommendations"/>
</state>
<state id="TrackReadingHistory">
<transition target="InputReadingPreferences"/>
<transition target="GenerateRecommendations"/>
</state>
<state id="GenerateRecommendations">
<transition target="ViewRecommendations"/>
</state>
<state id="ViewRecommendations">
<transition target="end"/>
<transition target="InputReadingPreferences"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="AccessProfilePage"/>
</state>
<state id="AccessProfilePage">
<transition event="&quot;View Activities&quot;" target="ViewingActivities"/>
<transition event="&quot;View Completed Tasks&quot;" target="ViewingCompletedTasks"/>
<transition event="&quot;View Timeline&quot;" target="ViewingTimeline"/>
<transition event="&quot;View Friends&quot;" target="ViewingFriends"/>
<transition event="&quot;Customize Profile&quot;" target="CustomizingProfile"/>
<transition event="&quot;Exit&quot;" target="end"/>
</state>
<state id="ViewingActivities">
<transition event="&quot;Return to Profile&quot;" target="AccessProfilePage"/>
<transition event="&quot;Add Activity&quot;" target="AddingActivities"/>
</state>
<state id="ViewingCompletedTasks">
<transition event="&quot;Return to Profile&quot;" target="AccessProfilePage"/>
<transition event="&quot;Add Task&quot;" target="AddingTasks"/>
</state>
<state id="ViewingTimeline">
<transition event="&quot;Return to Profile&quot;" target="AccessProfilePage"/>
<transition event="&quot;Add Event&quot;" target="AddingEvents"/>
</state>
<state id="ViewingFriends">
<transition event="&quot;Return to Profile&quot;" target="AccessProfilePage"/>
<transition event="&quot;Add Friend&quot;" target="AddingFriends"/>
</state>
<state id="CustomizingProfile">
<transition event="&quot;Return to Profile&quot;" target="AccessProfilePage"/>
</state>
<state id="AddingActivities">
<transition event="&quot;Return to Activities&quot;" target="ViewingActivities"/>
</state>
<state id="AddingTasks">
<transition event="&quot;Return to Tasks&quot;" target="ViewingCompletedTasks"/>
</state>
<state id="AddingEvents">
<transition event="&quot;Return to Timeline&quot;" target="ViewingTimeline"/>
</state>
<state id="AddingFriends">
<transition event="&quot;Return to Friends&quot;" target="ViewingFriends"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InputCriteria"/>
</state>
<state id="InputCriteria">
<transition event="Process Criteria" target="ContentSuggestion"/>
<transition event="User Exits" target="end"/>
</state>
<state id="ContentSuggestion">
<transition event="Display Suggestions" target="ReviewSuggestions"/>
</state>
<state id="ReviewSuggestions">
<transition event="User Selects Content" target="SelectContent"/>
<transition event="User Exits" target="end"/>
</state>
<state id="SelectContent">
<transition event="Save Selected Content" target="SaveContent"/>
</state>
<state id="SaveContent">
<transition event="End Process" target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="Search" target="SearchingState"/>
<transition event="View All Purchases" target="ViewingPurchaseList"/>
</state>
<state id="SearchingState">
<transition event="Search Results" target="ViewingPurchaseList"/>
</state>
<state id="ViewingPurchaseList">
<transition event="Select Purchase" target="ViewingPurchaseDetails"/>
<transition event="End" target="end"/>
</state>
<state id="ViewingPurchaseDetails">
<transition event="Back to List" target="ViewingPurchaseList"/>
<transition event="End" target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="CreateTask"/>
</state>
<state id="CreateTask">
<transition target="AssignTask"/>
</state>
<state id="AssignTask">
<transition target="InProgress"/>
<transition target="Overdue"/>
</state>
<state id="InProgress">
<transition target="Completed"/>
<transition target="AssignTask"/>
</state>
<state id="Completed">
<transition target="ArchiveTask"/>
</state>
<state id="ArchiveTask">
<transition target="end"/>
</state>
<state id="Overdue">
<transition target="ArchiveTask"/>
</state>
<state id="end"/>
</scxml>

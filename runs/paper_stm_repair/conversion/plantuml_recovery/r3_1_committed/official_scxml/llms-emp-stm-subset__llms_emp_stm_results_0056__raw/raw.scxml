<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SearchState"/>
</state>
<state id="FormationAdjustment">
<transition event="Adjustment Complete" target="SearchState"/>
</state>
<state id="AttackState">
<transition event="Attack Complete [Decrease UAV Count]" target="SearchState"/>
</state>
<state id="end"/>
<state id="SearchState">
<transition event="Intercepted" target="FormationAdjustment"/>
<transition event="Task Assignment Received" target="AttackState"/>
<transition event="Mission Complete" target="end"/>
<state id="startSearchState">
<transition target="Area1"/>
</state>
<state id="Area1">
<transition target="Area2"/>
</state>
<state id="Area2">
<transition target="Area3"/>
</state>
<state id="Area3">
<transition target="Area1"/>
</state>
</state>
</scxml>

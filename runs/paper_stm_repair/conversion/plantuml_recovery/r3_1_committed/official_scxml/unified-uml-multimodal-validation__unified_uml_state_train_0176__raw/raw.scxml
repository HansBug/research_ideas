<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UserCreatesTask"/>
</state>
<state id="UserCreatesTask">
<transition event="Assign to self/others" target="TaskAssigned"/>
<transition event="Cancel" target="end"/>
</state>
<state id="TaskAssigned">
<transition event="Track progress" target="TaskManagement"/>
<transition event="Cancel" target="end"/>
</state>
<state id="TaskManagement">
<transition event="Due soon suggestions" target="TaskDueSoon"/>
<transition event="Cancel" target="end"/>
</state>
<state id="TaskDueSoon">
<transition event="Complete or延遲" target="end"/>
<transition event="Cancel" target="end"/>
</state>
<state id="end"/>
</scxml>

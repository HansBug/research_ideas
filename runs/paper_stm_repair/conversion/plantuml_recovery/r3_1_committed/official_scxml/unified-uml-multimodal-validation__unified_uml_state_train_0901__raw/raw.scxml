<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="OrderCreated"/>
</state>
<state id="OrderCreated">
<transition event="Ship Order" target="Shipped"/>
<transition event="Cancel Order" target="Cancelled"/>
<transition event="Add Task/Reminder" target="TasksReminders"/>
<transition event="Assign Status to Multiple Orders" target="BulkStatusAssignment"/>
</state>
<state id="Shipped">
<transition event="Deliver Order" target="Delivered"/>
<transition event="Cancel Order" target="Cancelled"/>
<transition event="Add Task/Reminder" target="TasksReminders"/>
</state>
<state id="Cancelled">
<transition event="Order Cancelled" target="end"/>
</state>
<state id="TasksReminders">
<transition event="Return to Order" target="OrderCreated"/>
<transition event="Return to Shipped" target="Shipped"/>
<transition event="Return to Cancelled" target="Cancelled"/>
</state>
<state id="Delivered">
<transition event="Order Completed" target="end"/>
</state>
<state id="end"/>
<state id="BulkStatusAssignment">
<transition event="Return to Order List" target="OrderCreated"/>
</state>
</scxml>

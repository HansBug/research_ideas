<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectingDocuments"/>
</state>
<state id="SelectingDocuments">
<transition event="Documents Selected" target="RetrievingDocumentContent"/>
</state>
<state id="RetrievingDocumentContent">
<transition event="Content Retrieved" target="DisplayingContentSummary"/>
</state>
<state id="DisplayingContentSummary">
<transition event="Summary Displayed" target="ReviewingContent"/>
</state>
<state id="ReviewingContent">
<transition event="Exit Quick Review" target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Ready"/>
</state>
<state id="Ready">
<transition event="Enter search query" target="SearchQueryEntered"/>
</state>
<state id="SearchQueryEntered">
<transition event="Process search" target="SearchResultsDisplayed"/>
</state>
<state id="SearchResultsDisplayed">
<transition event="Apply filter" target="FilterApplied"/>
<transition event="Navigate pages" target="PaginationNavigation"/>
<transition event="Refine search" target="SearchRefinement"/>
<transition event="Exit" target="end"/>
</state>
<state id="FilterApplied">
<transition event="Update results" target="SearchResultsDisplayed"/>
</state>
<state id="PaginationNavigation">
<transition event="Update results" target="SearchResultsDisplayed"/>
</state>
<state id="SearchRefinement">
<transition event="Update query" target="SearchQueryEntered"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="MainMenu"/>
</state>
<state id="MainMenu">
<transition event="Select Mood Match" target="MoodSelection"/>
</state>
<state id="MoodSelection">
<transition event="Select Mood" target="PlaylistSuggestion"/>
</state>
<state id="PlaylistSuggestion">
<transition event="Edit Playlist" target="PlaylistSuggestion"/>
<transition event="Finalize Playlist" target="FinalPlaylist"/>
</state>
<state id="FinalPlaylist">
<transition event="Return to Main Menu" target="MainMenu"/>
<transition event="Exit" target="end"/>
</state>
<state id="end"/>
</scxml>

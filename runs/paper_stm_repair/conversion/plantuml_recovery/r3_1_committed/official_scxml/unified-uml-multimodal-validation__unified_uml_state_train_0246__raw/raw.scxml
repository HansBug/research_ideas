<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UploadingTemplates"/>
</state>
<state id="UploadingTemplates">
<transition event="access template" target="AccessingModifyingTemplates"/>
</state>
<state id="AccessingModifyingTemplates">
<transition event="create template" target="CreatingNewTemplates"/>
</state>
<state id="CreatingNewTemplates">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DeviceSelection"/>
</state>
<state id="DeviceSelection">
<transition target="LiveFeedDisplay"/>
</state>
<state id="LiveFeedDisplay">
<transition target="DeviceControl"/>
<transition target="SettingsManagement"/>
<transition target="NotificationAlert"/>
<transition target="end"/>
</state>
<state id="DeviceControl">
<transition target="LiveFeedDisplay"/>
<transition target="end"/>
</state>
<state id="SettingsManagement">
<transition target="LiveFeedDisplay"/>
</state>
<state id="NotificationAlert">
<transition target="DeviceControl"/>
</state>
<state id="end"/>
</scxml>

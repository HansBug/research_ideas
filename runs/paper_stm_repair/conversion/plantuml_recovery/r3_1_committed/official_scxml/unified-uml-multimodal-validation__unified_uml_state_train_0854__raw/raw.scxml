<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="CreateNewAppointment"/>
</state>
<state id="CreateNewAppointment">
<transition target="SelectMultipleDatesTimes"/>
</state>
<state id="SelectMultipleDatesTimes">
<transition target="SelectTimeSlot"/>
</state>
<state id="SelectTimeSlot">
<transition target="DisplayAppointments"/>
</state>
<state id="DisplayAppointments">
<transition target="FilterAppointments"/>
<transition target="end"/>
</state>
<state id="FilterAppointments">
<transition target="DisplayAppointments"/>
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

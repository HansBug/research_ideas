<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SearchingProducts"/>
</state>
<state id="SearchingProducts">
<transition event="Perform Search" target="ViewingResults"/>
</state>
<state id="ViewingResults">
<transition event="Filter Results" target="FilteringResults"/>
<transition event="Select Product" target="SelectingProduct"/>
</state>
<state id="FilteringResults">
<transition event="Apply Filters" target="ViewingResults"/>
<transition event="Select Product" target="SelectingProduct"/>
</state>
<state id="SelectingProduct">
<transition event="View Details" target="ViewingProductDetails"/>
<transition event="Return to Results" target="ViewingResults"/>
</state>
<state id="ViewingProductDetails">
<transition event="Return to Selection" target="SelectingProduct"/>
<transition event="End Interaction" target="end"/>
</state>
<state id="end"/>
</scxml>

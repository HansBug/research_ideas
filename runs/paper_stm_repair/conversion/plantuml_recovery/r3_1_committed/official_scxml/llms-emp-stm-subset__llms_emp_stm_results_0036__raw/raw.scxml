<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="Mission Started" target="TargetSearch"/>
</state>
<state id="TargetSearch">
<transition event="Interception Detected" target="FormationAdjustment"/>
<transition event="Task Assignment Received" target="Attack"/>
<transition event="Mission Accomplished" target="MissionComplete"/>
</state>
<state id="FormationAdjustment">
<transition event="Formation Adjusted" target="TargetSearch"/>
</state>
<state id="Attack">
<transition event="Attack Complete / UAV Count Decreased" target="TargetSearch"/>
</state>
<state id="MissionComplete"/>
</scxml>

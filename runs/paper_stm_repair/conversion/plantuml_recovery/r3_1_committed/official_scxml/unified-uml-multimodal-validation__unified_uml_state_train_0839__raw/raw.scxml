<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="CreateProfile"/>
</state>
<state id="CreateProfile">
<transition event="Profile Created" target="ActiveProfile"/>
</state>
<state id="ActiveProfile">
<transition event="Share Profile" target="ShareProfile"/>
<transition event="Manage Profile" target="ManageProfile"/>
<transition event="Receive Recommendations" target="ReceiveRecommendations"/>
</state>
<state id="ShareProfile">
<transition event="Return to Active" target="ActiveProfile"/>
</state>
<state id="ManageProfile">
<transition event="Return to Active" target="ActiveProfile"/>
</state>
<state id="ReceiveRecommendations">
<transition event="Experience Personalized" target="end"/>
</state>
<state id="end"/>
</scxml>

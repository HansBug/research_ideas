<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="activate" target="ActiveState"/>
<transition event="activation failed" target="FailedState"/>
</state>
<state id="ActiveState">
<transition event="deactivate" target="InactiveState"/>
<transition event="error" target="FailedState"/>
</state>
<state id="FailedState">
<transition event="resolve and restart" target="end"/>
</state>
<state id="InactiveState">
<transition event="reactivate" target="ActiveState"/>
</state>
<state id="end"/>
</scxml>

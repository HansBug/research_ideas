<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Main_Menu"/>
</state>
<state id="Main_Menu">
<transition target="Add_Location"/>
<transition target="Edit_Location"/>
<transition target="Delete_Location"/>
<transition target="Assign_Users"/>
<transition target="Exit"/>
</state>
<state id="Add_Location">
<transition target="Main_Menu"/>
</state>
<state id="Edit_Location">
<transition target="Main_Menu"/>
</state>
<state id="Delete_Location">
<transition target="Main_Menu"/>
</state>
<state id="Assign_Users">
<transition target="Main_Menu"/>
</state>
<state id="Exit">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

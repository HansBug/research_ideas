<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="Initialize" target="SubscriptionInitialized"/>
</state>
<state id="SubscriptionInitialized">
<transition event="Set Current Price" target="CurrentPricing"/>
</state>
<state id="CurrentPricing">
<transition event="Request Adjustment" target="AdjustmentRequested"/>
</state>
<state id="AdjustmentRequested">
<transition event="Update Price" target="PriceUpdated"/>
</state>
<state id="PriceUpdated">
<transition event="Final State" target="end"/>
<transition event="Continue" target="CurrentPricing"/>
</state>
<state id="end"/>
</scxml>

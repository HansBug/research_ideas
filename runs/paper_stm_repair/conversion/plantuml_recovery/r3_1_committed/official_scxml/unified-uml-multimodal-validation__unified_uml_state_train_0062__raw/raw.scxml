<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="&quot;Start&quot;" target="UserLoggedOut"/>
</state>
<state id="UserLoggedOut">
<transition event="&quot;Login&quot;" target="UserLoggedIn"/>
<transition event="&quot;Quit&quot;" target="end"/>
</state>
<state id="UserLoggedIn">
<transition event="&quot;Search&quot;" target="SearchResultsDisplayed"/>
<transition event="&quot;Logout&quot;" target="UserLoggedOut"/>
<transition event="&quot;Quit&quot;" target="end"/>
<transition event="&quot;Quit&quot;" target="end"/>
</state>
<state id="SearchResultsDisplayed">
<transition event="&quot;Save Result&quot;" target="SavedResultsDisplayed"/>
<transition event="&quot;Quit&quot;" target="end"/>
</state>
<state id="SavedResultsDisplayed">
<transition event="&quot;Delete Result&quot;" target="SavedResultsDisplayed"/>
<transition event="&quot;Clear All&quot;" target="SavedResultsDisplayed"/>
<transition event="&quot;View Result&quot;" target="UserLoggedIn"/>
<transition event="&quot;Quit&quot;" target="end"/>
</state>
<state id="end"/>
</scxml>

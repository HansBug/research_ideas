<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="IdleState"/>
</state>
<state id="IdleState">
<transition event="Start Data Entry" target="DataEntryState"/>
</state>
<state id="DataEntryState">
<transition event="Data Entry Completed" target="DataManagementState"/>
</state>
<state id="DataManagementState">
<transition event="Export/Import Requested" target="DataExportImportState"/>
<transition event="System Shutdown" target="end"/>
</state>
<state id="DataExportImportState">
<transition event="Export/Import Completed" target="ReportingState"/>
</state>
<state id="ReportingState">
<transition event="Report Generated" target="DataValidationState"/>
</state>
<state id="DataValidationState">
<transition event="Validation Completed" target="IdleState"/>
<transition event="Data Inconsistency Detected" target="ErrorHandlingState"/>
</state>
<state id="ErrorHandlingState">
<transition event="Data Correction Required" target="DataEntryState"/>
<transition event="Error Resolved" target="IdleState"/>
</state>
<state id="end"/>
</scxml>

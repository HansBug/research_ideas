<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DoorShut"/>
</state>
<state id="DoorShut">
<transition event="Door Opened" target="DoorOpen"/>
<state id="startDoorShut">
<transition target="DoorShut"/>
</state>
<state id="DoorOpen">
<transition event="Place Item Inside" target="DoorOpenWithItem"/>
<transition event="Close Door" target="DoorShut"/>
<state id="DoorOpenWithItem">
<transition event="Remove Item" target="DoorOpen"/>
<transition event="Close Door with Zero Time" target="DoorShutWithItem"/>
<transition event="Enter Cooking Time" target="ReadytoCook"/>
<state id="DoorShutWithItem">
<transition event="Open Door" target="DoorOpenWithItem"/>
<transition event="Enter Cooking Time" target="ReadytoCook"/>
</state>
<state id="ReadytoCook">
<transition event="Cancel" target="DoorShutWithItem"/>
<transition event="Open Door" target="DoorOpenWithItem"/>
<transition event="Start" target="Cooking"/>
<state id="Cooking">
<transition event="Open Door" target="DoorOpenWithItem"/>
<transition event="Timer Expired" target="DoorShutWithItem"/>
<transition event="Cancel" target="ReadytoCook"/>
</state>
</state>
</state>
</state>
</state>
</scxml>

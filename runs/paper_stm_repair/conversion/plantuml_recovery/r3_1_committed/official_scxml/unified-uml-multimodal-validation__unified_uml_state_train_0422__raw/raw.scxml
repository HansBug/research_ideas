<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DisplayTaskList"/>
</state>
<state id="DisplayTaskList">
<transition event="Add New Task" target="AddTask"/>
<transition event="Update Task" target="UpdateTask"/>
<transition event="Search/Filter Task" target="SearchFilterTask"/>
<transition event="Sort Task" target="SortTask"/>
<transition event="View Task Details" target="ViewTaskDetails"/>
<transition event="Exit" target="end"/>
</state>
<state id="AddTask">
<transition event="Return to List" target="DisplayTaskList"/>
</state>
<state id="UpdateTask">
<transition event="Return to List" target="DisplayTaskList"/>
</state>
<state id="SearchFilterTask">
<transition event="Return to List" target="DisplayTaskList"/>
</state>
<state id="SortTask">
<transition event="Return to List" target="DisplayTaskList"/>
</state>
<state id="ViewTaskDetails">
<transition event="Return to List" target="DisplayTaskList"/>
</state>
<state id="end"/>
</scxml>

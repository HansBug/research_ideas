<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UserInputState"/>
</state>
<state id="UserInputState">
<transition target="DataAnalysisState"/>
</state>
<state id="DataAnalysisState">
<transition target="MealPlanGenerationState"/>
</state>
<state id="MealPlanGenerationState">
<transition target="IntegrationOfferState"/>
</state>
<state id="IntegrationOfferState">
<transition target="IntegrationCompletionState"/>
</state>
<state id="IntegrationCompletionState">
<transition target="MealPlanProvidedState"/>
</state>
<state id="MealPlanProvidedState">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

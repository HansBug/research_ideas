<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InputGoalsSkillsInterests"/>
</state>
<state id="InputGoalsSkillsInterests">
<transition target="GenerateLearningPlan"/>
</state>
<state id="GenerateLearningPlan">
<transition target="ViewLearningPlan"/>
</state>
<state id="ViewLearningPlan">

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="State_c7332c"/>
<state id="start">
<transition target="ViewingFavorites"/>
</state>
<state id="ViewingFavorites">
<transition event="Search" target="Searching"/>
<transition event="Add New" target="AddingNewEntries"/>
<transition event="Share" target="SharingFavorites"/>
</state>
<state id="Searching">
<transition event="Display Results" target="SearchingResults"/>
</state>
<state id="AddingNewEntries">
<transition event="Save" target="ViewingFavorites"/>
<transition event="Cancel" target="ViewingFavorites"/>
</state>
<state id="SharingFavorites">
<transition event="Return" target="ViewingFavorites"/>
</state>
<state id="SearchingResults">
<transition event="Return" target="ViewingFavorites"/>
<transition event="Add to Favorites" target="AddingNewEntries"/>
</state>
<state id="end">
<transition target="State_c7332c"/>
</state>
</scxml>

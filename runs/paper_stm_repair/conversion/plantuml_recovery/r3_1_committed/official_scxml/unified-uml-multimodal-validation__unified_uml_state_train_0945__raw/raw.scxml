<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectDietaryPreferences"/>
<transition target="RetrieveSavedMealPlan"/>
</state>
<state id="SelectDietaryPreferences">
<transition target="SelectAvailableIngredients"/>
</state>
<state id="SelectAvailableIngredients">
<transition target="SuggestMealIdeas"/>
</state>
<state id="SuggestMealIdeas">
<transition target="GenerateMealPlan"/>
<transition target="RetrieveSavedMealPlan"/>
</state>
<state id="GenerateMealPlan">
<transition target="ProvideInstructions"/>
</state>
<state id="ProvideInstructions">
<transition target="SaveMealPlan"/>
</state>
<state id="SaveMealPlan">
<transition target="end"/>
</state>
<state id="end"/>
<state id="RetrieveSavedMealPlan">
<transition target="GenerateMealPlan"/>
</state>
</scxml>

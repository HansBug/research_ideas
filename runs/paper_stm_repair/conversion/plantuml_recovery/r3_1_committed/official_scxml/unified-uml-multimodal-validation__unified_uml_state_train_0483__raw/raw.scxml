<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="TaskSubmitted"/>
</state>
<state id="TaskSubmitted">
<transition target="MatchingTask"/>
</state>
<state id="MatchingTask">
<transition target="AssignTask"/>
</state>
<state id="AssignTask">
<transition target="DisplayTaskDetails"/>
</state>
<state id="DisplayTaskDetails">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

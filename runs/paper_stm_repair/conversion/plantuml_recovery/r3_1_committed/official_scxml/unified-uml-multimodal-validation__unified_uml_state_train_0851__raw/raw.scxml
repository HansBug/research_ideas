<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UserRequest"/>
</state>
<state id="UserRequest">
<transition event="Add custom widget" target="AddCustomWidget"/>
</state>
<state id="AddCustomWidget">
<transition event="Customize layout" target="CustomizeLayout"/>
</state>
<state id="CustomizeLayout">
<transition event="Select data" target="SelectData"/>
</state>
<state id="SelectData">
<transition event="Create custom dashboard" target="CreateCustomDashboard"/>
</state>
<state id="CreateCustomDashboard">
<transition event="Save &amp; export" target="SaveExport"/>
</state>
<state id="SaveExport">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="Access contact info" target="AccessContactInformation"/>
</state>
<state id="AccessContactInformation">
<transition event="View history" target="ViewConversationHistory"/>
</state>
<state id="ViewConversationHistory">
<transition event="Search contacts" target="FindSpecificContacts"/>
</state>
<state id="FindSpecificContacts">
<transition event="View all" target="ViewEntireHistory"/>
</state>
<state id="ViewEntireHistory">
<transition event="Manage" target="ManageContacts"/>
</state>
<state id="ManageContacts">
<transition event="Handle messages" target="HandleDifferentMessages"/>
</state>
<state id="HandleDifferentMessages">
<transition event="Summarize" target="ProvideConversationSummary"/>
</state>
<state id="ProvideConversationSummary">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

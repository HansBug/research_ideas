<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="add term" target="OneTermAdded"/>
</state>
<state id="OneTermAdded">
<transition event="add term" target="TwoTermsAdded"/>
<transition event="perform search" target="end"/>
</state>
<state id="TwoTermsAdded">
<transition event="add term" target="ThreeTermsAdded"/>
<transition event="perform search" target="end"/>
</state>
<state id="end"/>
<state id="ThreeTermsAdded">
<transition event="perform search" target="end"/>
<transition target="end"/>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="IdleState"/>
</state>
<state id="IdleState">
<transition event="createVersion" target="CreatingVersionState"/>
<transition target="end"/>
</state>
<state id="CreatingVersionState">
<transition event="versionCreated" target="VersionCreatedState"/>
</state>
<state id="VersionCreatedState">
<transition event="addComment" target="AddingCommentState"/>
<transition event="shareVersion" target="SharingVersionState"/>
</state>
<state id="AddingCommentState">
<transition event="commentAdded" target="CommentAddedState"/>
</state>
<state id="CommentAddedState">
<transition event="done" target="IdleState"/>
</state>
<state id="SharingVersionState">
<transition event="versionShared" target="VersionSharedState"/>
</state>
<state id="VersionSharedState">
<transition event="done" target="IdleState"/>
</state>
<state id="end"/>
</scxml>

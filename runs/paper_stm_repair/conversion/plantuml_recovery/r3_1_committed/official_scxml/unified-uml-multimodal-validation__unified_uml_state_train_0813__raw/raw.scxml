<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ProfileManagement"/>
</state>
<state id="ProfileManagement">
<transition target="PrivacySettings"/>
</state>
<state id="PrivacySettings">
<transition target="DataTracking"/>
</state>
<state id="DataTracking">
<transition target="AlertsNotifications"/>
</state>
<state id="AlertsNotifications">
<transition target="DataUsage"/>
</state>
<state id="DataUsage">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectPaymentOption"/>
</state>
<state id="SelectPaymentOption">
<transition event="Payment option selected" target="EnterPaymentDetails"/>
<transition event="Cancel payment" target="end"/>
</state>
<state id="EnterPaymentDetails">
<transition event="Payment details entered" target="ProcessPayment"/>
<transition event="Change payment method" target="SelectPaymentOption"/>
</state>
<state id="ProcessPayment">
<transition event="Payment processed successfully" target="PaymentSuccess"/>
<transition event="Payment processing failed" target="PaymentFailure"/>
</state>
<state id="PaymentSuccess">
<transition event="Payment completed" target="end"/>
</state>
<state id="PaymentFailure">
<transition event="Retry payment" target="EnterPaymentDetails"/>
<transition event="Cancel payment" target="end"/>
</state>
<state id="end"/>
</scxml>

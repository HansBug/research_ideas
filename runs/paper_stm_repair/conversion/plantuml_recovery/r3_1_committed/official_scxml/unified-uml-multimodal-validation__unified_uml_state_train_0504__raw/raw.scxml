<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DefaultEnabled"/>
</state>
<state id="DefaultEnabled">
<transition event="Enable Smart Notifications" target="NotificationsEnabled"/>
</state>
<state id="NotificationsEnabled">
<transition event="Customize Notifications" target="ConfigurePreferences"/>
<transition event="Notifications Disabled" target="end"/>
</state>
<state id="ConfigurePreferences">
<transition event="Choose Push/Message" target="DeliveryMethod"/>
</state>
<state id="DeliveryMethod">
<transition event="Notifications Delivered" target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="TurnOn"/>
</state>
<state id="choice3">
<transition target="ChargedFlash"/>
<transition target="Junction3"/>
</state>
<state id="Flash">
<transition target="Terminate"/>
</state>
<state id="end"/>
<state id="TurnOn">
<state id="TurnOn">
<transition event="after 2s / minimum 2s" target="fork1"/>
<state id="startTurnOn">
<transition target="TurnOn"/>
</state>
<state id="fork1">
<transition target="choice3"/>
<state id="startfork1">
<transition target="AutoFocus"/>
<transition target="DetLight"/>
</state>
<state id="AutoFocus">
<transition event="after 2s / minimum 1s" target="choice1"/>
<state id="choice1"/>
</state>
<state id="DetLight">
<transition event="after 1s / «GaStep»{prob=0.4}" target="choice2"/>
<state id="choice2">
<transition target="Join2"/>
</state>
</state>
</state>
</state>
</state>
<state id="ChargedFlash">
<transition event="after 4s / minimum 2s" target="Junction3"/>
<state id="Junction3">
<transition event="Charged=true" target="Join2"/>
<state id="Join2">
<transition target="Fork2"/>
<state id="Fork2">
<transition target="Junction2"/>
<transition target="Flash"/>
</state>
</state>
</state>
</state>
<state id="Junction2">
<transition target="TakePicture"/>
<transition target="TakePicture"/>
<state id="TakePicture">
<transition target="WriteMemory"/>
<state id="WriteMemory">
<transition event="after 3s / minimum 2s" target="Junction1"/>
<state id="Junction1">
<transition target="TurnOff"/>
<state id="TurnOff">
<transition target="end"/>
</state>
</state>
</state>
</state>
</state>
<state id="Terminate">
<state id="startTerminate">
<transition target="Terminate"/>
</state>
</state>
</scxml>

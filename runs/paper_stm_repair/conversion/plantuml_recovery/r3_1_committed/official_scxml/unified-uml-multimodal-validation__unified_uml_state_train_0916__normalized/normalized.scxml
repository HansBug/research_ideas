<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="Idle_State_62e7c6">
<transition event="System Shutdown" target="end"/>
<transition event="User creates new appointment/event" target="Event_Created_7f71a9"/>
</state>
<state id="Event_Created_7f71a9">
<transition event="System analyzes user's schedule and preferences" target="Analyzing_Schedule_and_Preferences_190681"/>
</state>
<state id="Analyzing_Schedule_and_Preferences_190681">
<transition event="System suggests reminders based on analysis" target="Suggesting_Reminders_0131ba"/>
</state>
<state id="Suggesting_Reminders_0131ba">
<transition event="User accepts suggested reminders" target="Setting_Reminders_e8f341"/>
<transition event="User declines suggested reminders" target="Idle_State_62e7c6"/>
</state>
<state id="Setting_Reminders_e8f341">
<transition event="Reminders set and system returns to idle" target="end"/>
</state>
<state id="start">
<transition target="Idle_State_62e7c6"/>
</state>
<state id="end"/>
</scxml>

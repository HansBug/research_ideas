<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="HumanDriving"/>
</state>
<state id="HumanDriving">
<transition event="Power On" target="Autonomous"/>
<transition event="Front Distance &gt; 10" target="Autonomous"/>
<transition event="Power Off" target="AutonomousFinal"/>
</state>
<state id="Autonomous">
<transition event="Front Distance &lt;= 10" target="AutonomousIdle"/>
</state>
<state id="AutonomousIdle">
<transition event="Front Distance &gt; 10" target="AutonomousActive"/>
</state>
<state id="AutonomousActive">
<transition event="Human Steering Cmd" target="HumanDriving"/>
<transition event="Brake Pressed" target="HumanDriving"/>
</state>
<state id="AutonomousFinal"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Browsing_Menu"/>
</state>
<state id="Browsing_Menu">
<transition target="Selecting_Items"/>
</state>
<state id="Selecting_Items">
<transition target="Adding_to_Cart"/>
</state>
<state id="Adding_to_Cart">
<transition target="Proceeding_to_Checkout"/>
</state>
<state id="Proceeding_to_Checkout">
<transition target="Order_in_Progress"/>
</state>
<state id="Order_in_Progress">
<transition target="Order_Delivered"/>
</state>
<state id="Order_Delivered">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

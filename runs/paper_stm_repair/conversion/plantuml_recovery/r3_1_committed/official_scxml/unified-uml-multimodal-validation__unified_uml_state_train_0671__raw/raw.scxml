<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="Add/Edit/Remove client" target="ClientManagement"/>
<transition event="Add/Edit/Cancel booking" target="BookingManagement"/>
<transition event="Generate reports" target="ReportGeneration"/>
<transition event="Integrate with external systems" target="Integration"/>
<transition event="Customize features" target="Customization"/>
<transition target="end"/>
</state>
<state id="ClientManagement">
<transition event="Proceed to booking" target="BookingManagement"/>
<transition event="Send reminders" target="ReminderNotification"/>
<transition target="end"/>
</state>
<state id="BookingManagement">
<transition event="Send reminders" target="ReminderNotification"/>
<transition event="Process payment" target="Integration"/>
<transition event="Update reports" target="ReportGeneration"/>
<transition target="end"/>
</state>
<state id="ReportGeneration">
<transition event="Return to main" target="Idle"/>
<transition target="end"/>
</state>
<state id="Integration">
<transition event="Return to main" target="Idle"/>
<transition target="end"/>
</state>
<state id="Customization">
<transition event="Return to main" target="Idle"/>
<transition target="end"/>
</state>
<state id="ReminderNotification">
<transition event="Return to main" target="Idle"/>
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

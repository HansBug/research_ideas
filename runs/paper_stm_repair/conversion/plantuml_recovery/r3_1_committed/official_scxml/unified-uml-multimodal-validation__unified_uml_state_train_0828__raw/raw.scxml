<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="NotLoggedIn"/>
</state>
<state id="NotLoggedIn">
<transition event="Attempt Login" target="Login"/>
</state>
<state id="Login">
<transition event="Login Failed" target="NotLoggedIn"/>
<transition event="Login Successful" target="ProfileDisplayed"/>
</state>
<state id="ProfileDisplayed">
<transition event="Edit Profile" target="EditingProfile"/>
<transition event="Add Contacts" target="AddingContacts"/>
<transition event="Logout" target="NotLoggedIn"/>
</state>
<state id="EditingProfile">
<transition event="Save Changes" target="ProfileDisplayed"/>
</state>
<state id="AddingContacts">
<transition event="Add Contact" target="ProfileDisplayed"/>
</state>
</scxml>

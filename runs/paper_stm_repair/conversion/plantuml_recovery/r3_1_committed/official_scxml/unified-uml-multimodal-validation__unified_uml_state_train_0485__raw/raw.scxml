<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ViewAddresses"/>
</state>
<state id="ViewAddresses">
<transition event="on Add" target="AddAddress"/>
<transition event="on Edit" target="EditAddress"/>
<transition event="on Delete" target="DeleteAddress"/>
<transition event="on Exit" target="end"/>
</state>
<state id="AddAddress">
<transition event="after adding" target="ViewAddresses"/>
</state>
<state id="EditAddress">
<transition event="after editing" target="ViewAddresses"/>
</state>
<state id="DeleteAddress">
<transition event="after deleting" target="ViewAddresses"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Order_Placed"/>
</state>
<state id="Order_Placed">
<transition target="Order_Processing"/>
</state>
<state id="Order_Processing">
<transition target="Order_Completed"/>
<transition target="Order_Cancelled"/>
</state>
<state id="Order_Completed">
<transition target="end"/>
</state>
<state id="Order_Cancelled">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

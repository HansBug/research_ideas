<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DoorShut"/>
</state>
<state id="DoorShut">
<state id="startDoorShut">
<transition target="State1"/>
</state>
<state id="State1">
<transition event="Open Door" target="State2"/>
<transition event="Cancel" target="State1"/>
<transition event="Place Item" target="DoorOpenWithItem"/>
<transition event="Close Door/Zero Time" target="DoorShutWithItem"/>
<transition event="Enter Time" target="ReadytoCook"/>
<transition event="Open Door" target="DoorOpenWithItem"/>
<transition event="Enter Time" target="ReadytoCook"/>
<transition event="Start" target="Cooking"/>
<transition event="Open Door" target="DoorOpenWithItem"/>
<transition event="Cancel/Update Time" target="DoorShutWithItem"/>
<transition event="Open Door/Stop Timer" target="DoorOpenWithItem"/>
<transition event="Timer Expired" target="DoorShutWithItem"/>
<transition event="Cancel" target="ReadytoCook"/>
</state>
<state id="State2">
<transition event="Close Door" target="DoorOpen"/>
</state>
<state id="DoorOpen">
<state id="startDoorOpen">
<transition target="State1"/>
</state>
<state id="DoorOpenWithItem">
<transition event="Remove Item" target="State1"/>
<state id="startDoorOpenWithItem">
<transition target="State1"/>
</state>
<state id="DoorShutWithItem">
<state id="startDoorShutWithItem">
<transition target="State1"/>
</state>
</state>
<state id="ReadytoCook">
<state id="startReadytoCook">
<transition target="State1"/>
</state>
<state id="Cooking">
<state id="startCooking">
<transition target="State1"/>
</state>
</state>
</state>
</state>
</state>
</state>
</scxml>

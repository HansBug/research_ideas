<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="TrackOrders"/>
<transition target="ViewOrderHistory"/>
</state>
<state id="TrackOrders">
<transition event="Exit" target="end"/>
<transition event="View History" target="ViewOrderHistory"/>
</state>
<state id="ViewOrderHistory">
<transition event="Exit" target="end"/>
<transition event="Track Orders" target="TrackOrders"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialSetup"/>
</state>
<state id="InitialSetup">
<transition event="Select VR template" target="CustomizationPhase"/>
</state>
<state id="CustomizationPhase">
<transition event="Save VR experience" target="CustomizationPhase"/>
<transition event="Add custom content" target="ContentUploadPhase"/>
</state>
<state id="ContentUploadPhase">
<transition event="Save VR experience" target="ContentUploadPhase"/>
<transition event="Share VR experience" target="SharingPhase"/>
</state>
<state id="SharingPhase">
<transition event="Complete sharing" target="PostSharingPhase"/>
</state>
<state id="PostSharingPhase">
<transition event="End process" target="end"/>
<transition event="Return to customization" target="CustomizationPhase"/>
</state>
<state id="end"/>
</scxml>

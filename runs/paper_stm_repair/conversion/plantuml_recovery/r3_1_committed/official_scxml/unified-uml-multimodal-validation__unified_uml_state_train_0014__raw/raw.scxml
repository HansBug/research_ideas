<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition event="User initiates workflow setup" target="CustomWorkflowSetup"/>
</state>
<state id="CustomWorkflowSetup">
<transition event="Analyzing user preferences" target="PreferencesAnalysis"/>
</state>
<state id="PreferencesAnalysis">
<transition event="Suggesting workflows" target="WorkflowSuggestion"/>
</state>
<state id="WorkflowSuggestion">
<transition event="User starts managing tasks" target="TaskManagement"/>
</state>
<state id="TaskManagement">
<transition event="User exits" target="end"/>
<transition event="Add task" target="TaskAddition"/>
<transition event="Edit task" target="TaskEdit"/>
<transition event="Delete task" target="TaskDelete"/>
<transition event="Adjust workflow" target="WorkflowAdjustment"/>
</state>
<state id="end"/>
<state id="TaskAddition">
<transition event="Return" target="TaskManagement"/>
</state>
<state id="TaskEdit">
<transition event="Return" target="TaskManagement"/>
</state>
<state id="TaskDelete">
<transition event="Return" target="TaskManagement"/>
</state>
<state id="WorkflowAdjustment">
<transition event="Return" target="TaskManagement"/>
</state>
</scxml>

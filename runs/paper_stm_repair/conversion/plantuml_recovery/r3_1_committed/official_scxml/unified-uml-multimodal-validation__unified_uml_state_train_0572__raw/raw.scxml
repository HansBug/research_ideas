<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="MainLoginPage"/>
</state>
<state id="MainLoginPage">
<transition event="Successful Main Login" target="MainApplication"/>
<transition event="Access Domain Management" target="DomainManagementLogin"/>
</state>
<state id="MainApplication">
<transition event="Logout" target="Logout"/>
</state>
<state id="DomainManagementLogin">
<transition event="Successful Domain Login" target="DomainManagementSystem"/>
<transition event="Return to Main Login" target="MainLoginPage"/>
</state>
<state id="DomainManagementSystem">
<transition event="Logout" target="Logout"/>
</state>
<state id="Logout">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

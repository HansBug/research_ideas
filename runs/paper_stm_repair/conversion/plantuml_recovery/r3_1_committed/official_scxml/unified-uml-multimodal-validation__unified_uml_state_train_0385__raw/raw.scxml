<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InputTopics"/>
</state>
<state id="InputTopics">
<transition target="ProcessTopicsAndSuggestions"/>
</state>
<state id="ProcessTopicsAndSuggestions">
<transition target="DisplaySuggestions"/>
</state>
<state id="DisplaySuggestions">
<transition event="Click on suggestion" target="DisplayContent"/>
<transition event="Exit" target="end"/>
</state>
<state id="DisplayContent">
<transition event="Back to suggestions" target="DisplaySuggestions"/>
<transition event="Exit" target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="CheckConnectivity"/>
</state>
<state id="CheckConnectivity">
<transition event="No GPS/Cellular" target="VehicleOffline"/>
<transition event="GPS Available" target="GPSOnlyMode"/>
<transition event="Both Available" target="GPSAndCellularMode"/>
</state>
<state id="VehicleOffline">
<transition event="GPS Available" target="GPSOnlyMode"/>
<transition event="Both Available" target="GPSAndCellularMode"/>
<transition event="Stop Tracking" target="end"/>
</state>
<state id="GPSOnlyMode">
<transition event="Cellular Available" target="GPSAndCellularMode"/>
<transition event="GPS Lost" target="VehicleOffline"/>
<transition event="Stop Tracking" target="end"/>
</state>
<state id="GPSAndCellularMode">
<transition event="Cellular Lost" target="GPSOnlyMode"/>
<transition event="Both Lost" target="VehicleOffline"/>
<transition event="Stop Tracking" target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="NoAssignment"/>
</state>
<state id="NoAssignment">
<transition event="User assigns group" target="ManualAssignment"/>
<transition event="System auto-assigns" target="AutomaticAssignment"/>
</state>
<state id="ManualAssignment">
<transition event="Delete assignment" target="end"/>
<transition event="Continue tracking" target="Tracking"/>
</state>
<state id="AutomaticAssignment">
<transition event="Delete assignment" target="end"/>
<transition event="Continue tracking" target="Tracking"/>
</state>
<state id="end"/>
<state id="Tracking">
<transition event="Complete" target="end"/>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UserInteraction"/>
</state>
<state id="UserInteraction">
<transition target="GeneratingMealPlan"/>
</state>
<state id="GeneratingMealPlan">
<transition target="DisplayingMealPlan"/>
</state>
<state id="DisplayingMealPlan">
<transition target="ExploringOptions"/>
</state>
<state id="ExploringOptions">
<transition target="CreatingGroceryList"/>
<transition target="ProvidingMealTips"/>
<transition target="FinalizingMealPlan"/>
</state>
<state id="CreatingGroceryList">
<transition target="ViewingGroceryList"/>
</state>
<state id="ProvidingMealTips">
<transition target="ViewingMealTips"/>
</state>
<state id="ViewingGroceryList">
<transition target="ExploringOptions"/>
</state>
<state id="ViewingMealTips">
<transition target="ExploringOptions"/>
</state>
<state id="FinalizingMealPlan">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="StartTaskAssignment"/>
</state>
<state id="StartTaskAssignment">
<transition event="Assign Task" target="AssignTask"/>
<transition target="end"/>
</state>
<state id="AssignTask">
<transition event="Set Details" target="SetTaskDetails"/>
<transition target="end"/>
</state>
<state id="SetTaskDetails">
<transition event="View Tasks" target="ViewTasks"/>
<transition event="Save Template" target="SaveTemplate"/>
</state>
<state id="ViewTasks">
<transition event="Manage Tasks" target="ManageTasks"/>
<transition target="end"/>
</state>
<state id="SaveTemplate">
<transition target="end"/>
</state>
<state id="end"/>
<state id="ManageTasks">
<transition event="Update Status" target="UpdateStatus"/>
<transition event="Add Notes" target="AddNotes"/>
<transition event="Set Reminders" target="SetReminders"/>
<transition target="end"/>
</state>
<state id="UpdateStatus">
<transition target="end"/>
</state>
<state id="AddNotes">
<transition target="end"/>
</state>
<state id="SetReminders">
<transition target="end"/>
</state>
</scxml>

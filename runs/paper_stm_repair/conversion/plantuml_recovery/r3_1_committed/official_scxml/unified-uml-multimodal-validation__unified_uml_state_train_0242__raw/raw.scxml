<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="LoggedIn"/>
</state>
<state id="LoggedIn">
<transition event="Browse Products" target="BrowsingProducts"/>
<transition event="Search Products" target="SearchingProducts"/>
<transition event="View Recommendations" target="ViewingRecommendations"/>
</state>
<state id="BrowsingProducts">
<transition event="Continue Browsing" target="BrowsingProducts"/>
<transition event="Search" target="SearchingProducts"/>
</state>
<state id="SearchingProducts">
<transition event="Refine Search" target="SearchingProducts"/>
<transition event="View Recommendations" target="ViewingRecommendations"/>
</state>
<state id="ViewingRecommendations">
<transition event="Search Again" target="SearchingProducts"/>
<transition event="Leave Platform" target="end"/>
</state>
<state id="end"/>
</scxml>

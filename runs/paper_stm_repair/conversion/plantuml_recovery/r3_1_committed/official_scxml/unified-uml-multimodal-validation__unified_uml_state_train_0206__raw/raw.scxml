<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DisplayingAllEmails"/>
</state>
<state id="DisplayingAllEmails">
<transition event="Search" target="SearchingEmails"/>
<transition event="Sort" target="SortingEmails"/>
<transition event="Filter" target="FilteringEmails"/>
<transition target="end"/>
</state>
<state id="SearchingEmails">
<transition event="Return" target="DisplayingAllEmails"/>
</state>
<state id="SortingEmails">
<transition event="Return" target="DisplayingAllEmails"/>
</state>
<state id="FilteringEmails">
<transition event="Return" target="DisplayingAllEmails"/>
</state>
<state id="end"/>
</scxml>

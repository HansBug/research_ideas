<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="CreateTask"/>
<transition target="ViewTaskList"/>
</state>
<state id="CreateTask">
<transition event="Save" target="TaskCreated"/>
<transition event="Cancel" target="end"/>
</state>
<state id="ViewTaskList">
<transition event="Edit" target="EditTask"/>
<transition event="Delete" target="DeleteTask"/>
<transition event="Filter" target="FilterTask"/>
<transition event="Sort" target="SortTask"/>
<transition event="Search" target="SearchTask"/>
<transition event="Close" target="end"/>
</state>
<state id="TaskCreated">
<transition event="OK" target="end"/>
</state>
<state id="end"/>
<state id="EditTask">
<transition event="Save" target="TaskUpdated"/>
<transition event="Cancel" target="ViewTaskList"/>
</state>
<state id="DeleteTask">
<transition event="Confirm" target="TaskDeleted"/>
<transition event="Cancel" target="ViewTaskList"/>
</state>
<state id="FilterTask">
<transition event="Apply" target="FilteredView"/>
<transition event="Cancel" target="ViewTaskList"/>
</state>
<state id="SortTask">
<transition event="Apply" target="SortedView"/>
<transition event="Cancel" target="ViewTaskList"/>
</state>
<state id="SearchTask">
<transition event="Apply" target="SearchResults"/>
<transition event="Cancel" target="ViewTaskList"/>
</state>
<state id="TaskUpdated">
<transition event="OK" target="end"/>
</state>
<state id="TaskDeleted">
<transition event="OK" target="end"/>
</state>
<state id="FilteredView">
<transition event="Close" target="ViewTaskList"/>
</state>
<state id="SortedView">
<transition event="Close" target="ViewTaskList"/>
</state>
<state id="SearchResults">
<transition event="Close" target="ViewTaskList"/>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="Start working on project" target="WorkingOnProject"/>
<transition event="Save progress" target="SaveProgress"/>
<transition event="Revert to previous state" target="RevertState"/>
</state>
<state id="WorkingOnProject">
<transition event="Save progress" target="SaveProgress"/>
</state>
<state id="SaveProgress">
<transition event="Save complete" target="WorkingOnProject"/>
<transition event="Save complete" target="InitialState"/>
</state>
<state id="RevertState">
<transition event="Revert complete" target="InitialState"/>
</state>
<state id="end">
<transition target="InitialState"/>
</state>
</scxml>

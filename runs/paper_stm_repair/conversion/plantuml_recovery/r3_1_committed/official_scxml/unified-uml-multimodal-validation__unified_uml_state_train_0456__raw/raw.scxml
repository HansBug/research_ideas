<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="StartSearch"/>
</state>
<state id="StartSearch">
<transition event="Apply multiple filters" target="ApplyFilters"/>
</state>
<state id="ApplyFilters">
<transition event="Sort by multiple criteria" target="SortResults"/>
</state>
<state id="SortResults">
<transition event="Display in table format" target="DisplayResults"/>
</state>
<state id="DisplayResults">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition target="DisplaySuggestedProducts"/>
</state>
<state id="DisplaySuggestedProducts">
<transition target="FilterProducts"/>
</state>
<state id="FilterProducts">
<transition target="SaveProducts"/>
</state>
<state id="SaveProducts">
<transition target="ViewProducts"/>
</state>
<state id="ViewProducts">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

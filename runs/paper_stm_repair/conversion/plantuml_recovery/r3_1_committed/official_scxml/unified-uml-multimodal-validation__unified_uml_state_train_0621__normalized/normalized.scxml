<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="Initial_State_e146ff">
<transition event="User starts browsing" target="Browsing_Products_a46f7a"/>
<transition event="User starts searching" target="Searching_Products_943f9b"/>
</state>
<state id="Browsing_Products_a46f7a">
<transition event="Process browsing history" target="Generating_Recommendations_1b6233"/>
<transition event="Continue browsing" target="Browsing_Products_a46f7a"/>
<transition event="Switch to searching" target="Searching_Products_943f9b"/>
</state>
<state id="Searching_Products_943f9b">
<transition event="Process search query" target="Generating_Recommendations_1b6233"/>
<transition event="Refine search" target="Searching_Products_943f9b"/>
<transition event="Switch to browsing" target="Browsing_Products_a46f7a"/>
</state>
<state id="Generating_Recommendations_1b6233">
<transition event="Generate personalized suggestions" target="Displaying_Recommendations_e3a65b"/>
</state>
<state id="Displaying_Recommendations_e3a65b">
<transition event="User stops interaction" target="Final_State_3474cc"/>
<transition event="User continues browsing" target="Browsing_Products_a46f7a"/>
<transition event="User continues searching" target="Searching_Products_943f9b"/>
</state>
<state id="Final_State_3474cc">
<transition target="end"/>
</state>
<state id="start">
<transition target="Initial_State_e146ff"/>
</state>
<state id="end"/>
</scxml>

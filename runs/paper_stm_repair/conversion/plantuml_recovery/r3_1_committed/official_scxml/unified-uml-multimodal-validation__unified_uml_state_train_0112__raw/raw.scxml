<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition target="SearchBooks"/>
</state>
<state id="SearchBooks">
<transition target="ViewBooksList"/>
<transition target="FilterList"/>
</state>
<state id="ViewBooksList">
<transition target="DetailsPage"/>
<transition target="AddBook"/>
<transition target="DownloadCSV"/>
<transition target="MarkAsRead"/>
<transition target="MarkAsUnread"/>
</state>
<state id="DetailsPage"/>
<state id="AddBook">
<transition target="EditBook"/>
</state>
<state id="EditBook">
<transition target="UpdateBook"/>
</state>
<state id="UpdateBook"/>
<state id="FilterList">
<transition target="ViewBooksList"/>
</state>
<state id="DownloadCSV">
<transition target="end"/>
</state>
<state id="end"/>
<state id="MarkAsRead">
<transition target="end"/>
</state>
<state id="MarkAsUnread">
<transition target="end"/>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="AddingRecipe"/>
<transition target="EditingRecipe"/>
<transition target="DeletingRecipe"/>
<transition target="ViewingRecipes"/>
<transition target="SearchingRecipes"/>
</state>
<state id="AddingRecipe">
<transition target="end"/>
</state>
<state id="end"/>
<state id="EditingRecipe">
<transition target="end"/>
</state>
<state id="DeletingRecipe">
<transition target="end"/>
</state>
<state id="ViewingRecipes">
<transition target="end"/>
</state>
<state id="SearchingRecipes">
<transition target="end"/>
</state>
</scxml>

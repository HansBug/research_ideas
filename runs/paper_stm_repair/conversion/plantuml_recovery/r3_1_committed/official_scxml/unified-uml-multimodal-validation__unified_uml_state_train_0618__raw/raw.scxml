<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="Create Task" target="TaskCreation"/>
</state>
<state id="TaskCreation">
<transition event="Assign Task" target="TaskAssignment"/>
<transition event="Cancel" target="end"/>
</state>
<state id="TaskAssignment">
<transition event="Update Status" target="TaskStatusUpdate"/>
<transition event="Cancel" target="end"/>
</state>
<state id="TaskStatusUpdate">
<transition event="Generate Report" target="ReportGeneration"/>
<transition event="Cancel" target="end"/>
</state>
<state id="ReportGeneration">
<transition event="View/Update Tasks" target="TaskManagement"/>
<transition event="Cancel" target="end"/>
</state>
<state id="TaskManagement">
<transition event="End" target="end"/>
<transition event="Cancel" target="end"/>
</state>
<state id="end"/>
</scxml>

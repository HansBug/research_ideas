<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="Power On" target="HumanDriving"/>
<transition event="Power Off" target="FinalState"/>
</state>
<state id="FinalState"/>
<state id="HumanDriving">
<transition event="front_distance &gt; 10" target="Autonomous"/>
</state>
<state id="Autonomous">
<transition event="Human Steering Cmd / Brake Pressed / [*]" target="HumanDriving"/>
<state id="Navigating">
<transition event="Park Request" target="Parking"/>
</state>
<state id="Parking">
<transition event="Parking Complete" target="Navigating"/>
</state>
<state id="startAutonomous">
<transition target="Navigating"/>
</state>
</state>
</scxml>

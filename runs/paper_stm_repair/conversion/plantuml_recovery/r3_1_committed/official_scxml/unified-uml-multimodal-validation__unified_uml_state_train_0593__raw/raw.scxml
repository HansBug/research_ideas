<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="CreateTask"/>
<transition target="EditTask"/>
<transition target="DeleteTask"/>
<transition target="ViewTaskDetails"/>
<transition target="TrackProgress"/>
<transition target="SetMilestones"/>
<transition target="TrackTime"/>
<transition target="Collaborate"/>
<transition target="AssignTasks"/>
<transition target="ViewTeamTasks"/>
<transition target="end"/>
</state>
<state id="CreateTask">
<transition target="TaskCreated"/>
</state>
<state id="TaskCreated">
<transition target="EditTask"/>
<transition target="DeleteTask"/>
<transition target="ViewTaskDetails"/>
<transition target="end"/>
</state>
<state id="EditTask">
<transition target="TaskEdited"/>
</state>
<state id="DeleteTask">
<transition target="TaskDeleted"/>
</state>
<state id="ViewTaskDetails">
<transition target="end"/>
</state>
<state id="end"/>
<state id="TaskEdited">
<transition target="ViewTaskDetails"/>
<transition target="end"/>
</state>
<state id="TaskDeleted">
<transition target="end"/>
</state>
<state id="TrackProgress">
<transition target="end"/>
</state>
<state id="SetMilestones">
<transition target="end"/>
</state>
<state id="TrackTime">
<transition target="end"/>
</state>
<state id="Collaborate">
<transition target="end"/>
</state>
<state id="AssignTasks">
<transition target="end"/>
</state>
<state id="ViewTeamTasks">
<transition target="end"/>
</state>
</scxml>

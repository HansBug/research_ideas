<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="Create New Task Assignment" target="CreatingTaskAssignment"/>
<transition event="Edit Task Assignment" target="EditingTaskAssignment"/>
<transition event="Delete Task Assignment" target="DeletingTaskAssignment"/>
<transition event="View Task Assignment" target="ViewingTaskAssignment"/>
<transition event="Filter Tasks" target="FilteringTasks"/>
<transition event="Sort Tasks" target="SortingTasks"/>
<transition event="Assign Tasks" target="AssigningTasks"/>
<transition event="View History" target="ViewingHistory"/>
</state>
<state id="CreatingTaskAssignment">
<transition event="Task Assignment Complete" target="end"/>
</state>
<state id="EditingTaskAssignment">
<transition event="Edit Details Complete" target="Idle"/>
</state>
<state id="DeletingTaskAssignment">
<transition event="Deletion Complete" target="Idle"/>
</state>
<state id="ViewingTaskAssignment">
<transition event="View Complete" target="Idle"/>
</state>
<state id="FilteringTasks">
<transition event="Sort Tasks" target="SortingTasks"/>
<transition event="Filter Complete" target="Idle"/>
</state>
<state id="SortingTasks">
<transition event="Sorting Complete" target="Idle"/>
</state>
<state id="AssigningTasks">
<transition event="Task Assignment Complete" target="end"/>
</state>
<state id="ViewingHistory">
<transition event="History View Complete" target="Idle"/>
</state>
<state id="end"/>
</scxml>

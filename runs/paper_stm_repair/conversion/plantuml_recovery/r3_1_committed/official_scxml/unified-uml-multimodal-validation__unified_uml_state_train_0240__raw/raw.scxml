<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SearchInput"/>
</state>
<state id="SearchInput">
<transition event="Submit Search" target="ProcessingQuery"/>
</state>
<state id="ProcessingQuery">
<transition event="Results Retrieved" target="DisplayResults"/>
</state>
<state id="DisplayResults">
<transition event="Filter Results" target="ProcessingQuery"/>
<transition event="View Summary" target="ReviewSummary"/>
</state>
<state id="ReviewSummary">
<transition event="Modify Search" target="SearchInput"/>
<transition event="Exit" target="end"/>
</state>
<state id="end"/>
</scxml>

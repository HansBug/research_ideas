<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ProjectTypeSelection"/>
</state>
<state id="ProjectTypeSelection">
<transition target="TagSelection"/>
</state>
<state id="TagSelection">
<transition target="TagAssignment"/>
</state>
<state id="TagAssignment">
<transition target="TagDisplay"/>
</state>
<state id="TagDisplay">
<transition target="TagManagement"/>
<transition target="TagSearch"/>
<transition target="end"/>
</state>
<state id="TagManagement">
<transition target="TagDisplay"/>
<transition target="end"/>
</state>
<state id="TagSearch">
<transition target="TagDisplay"/>
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

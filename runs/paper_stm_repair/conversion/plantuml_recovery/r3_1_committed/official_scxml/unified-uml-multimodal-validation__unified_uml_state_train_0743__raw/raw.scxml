<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="MessageComposition"/>
</state>
<state id="MessageComposition">
<transition event="Validate recipients" target="RecipientValidation"/>
</state>
<state id="RecipientValidation">
<transition event="Schedule message" target="MessageScheduling"/>
</state>
<state id="MessageScheduling">
<transition event="Send message" target="MessageSending"/>
</state>
<state id="MessageSending">
<transition event="Monitor status" target="StatusMonitoring"/>
</state>
<state id="StatusMonitoring">
<transition event="Complete" target="end"/>
</state>
<state id="end"/>
</scxml>

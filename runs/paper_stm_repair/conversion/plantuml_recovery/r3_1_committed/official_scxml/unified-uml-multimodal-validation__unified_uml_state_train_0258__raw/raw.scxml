<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="Create Group" target="CreatingGroup"/>
<transition target="end"/>
</state>
<state id="CreatingGroup">
<transition event="After Creation" target="ManagingMembers"/>
<transition event="Assign Permissions" target="AssigningPermissions"/>
</state>
<state id="ManagingMembers">
<transition event="Assign Permissions" target="AssigningPermissions"/>
<transition event="Track Changes" target="TrackingChanges"/>
</state>
<state id="AssigningPermissions">
<transition event="Track Changes" target="TrackingChanges"/>
<transition event="Return" target="Idle"/>
</state>
<state id="TrackingChanges">
<transition event="Return" target="Idle"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SystemIdle"/>
</state>
<state id="SystemIdle">
<transition event="Create New Component" target="CreatingComponent"/>
<transition event="Query Database" target="QueryingDatabase"/>
<transition event="Generate Report" target="GeneratingReport"/>
<transition target="end"/>
</state>
<state id="CreatingComponent">
<transition event="Component Saved" target="SystemIdle"/>
</state>
<state id="QueryingDatabase">
<transition event="Data Retrieved" target="DisplayingResults"/>
</state>
<state id="DisplayingResults">
<transition event="Close Display" target="SystemIdle"/>
<transition event="Update Component" target="UpdatingComponent"/>
</state>
<state id="UpdatingComponent">
<transition event="Component Updated" target="SystemIdle"/>
</state>
<state id="GeneratingReport">
<transition event="Report Generated" target="SystemIdle"/>
</state>
<state id="end"/>
</scxml>

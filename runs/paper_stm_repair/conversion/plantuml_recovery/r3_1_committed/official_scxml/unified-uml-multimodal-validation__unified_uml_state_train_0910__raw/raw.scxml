<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Access_Weather_Forecast"/>
</state>
<state id="Access_Weather_Forecast">
<transition event="Display current weather" target="View_Current_Conditions"/>
<transition event="Display weather map" target="View_Weather_Map"/>
</state>
<state id="View_Current_Conditions">
<transition event="Show alerts" target="Check_Alerts"/>
<transition event="Exit" target="end"/>
</state>
<state id="Check_Alerts">
<transition event="Display weather map" target="View_Weather_Map"/>
</state>
<state id="View_Weather_Map">
<transition event="Exit" target="end"/>
<transition event="Show current conditions" target="View_Current_Conditions"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InputHealthData"/>
</state>
<state id="InputHealthData">
<transition target="AnalyzingHealthData"/>
</state>
<state id="AnalyzingHealthData">
<transition target="GeneratingInsights"/>
</state>
<state id="GeneratingInsights">
<transition target="ProvidingInsights"/>
</state>
<state id="ProvidingInsights">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

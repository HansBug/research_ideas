<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="AccountRequest"/>
</state>
<state id="AccountRequest">
<transition event="Request Account" target="AwaitingApproval"/>
</state>
<state id="AwaitingApproval">
<transition event="Admin Approves" target="Approved"/>
<transition event="Admin Denies" target="Denied"/>
</state>
<state id="Approved">
<transition event="Login" target="AccessGranted"/>
</state>
<state id="Denied">
<transition event="Access Denied" target="end"/>
</state>
<state id="AccessGranted">
<transition event="Access Granted" target="end"/>
</state>
<state id="end"/>
</scxml>

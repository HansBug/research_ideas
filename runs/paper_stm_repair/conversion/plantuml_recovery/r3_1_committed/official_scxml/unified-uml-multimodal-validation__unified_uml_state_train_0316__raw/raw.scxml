<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="User requests system change" target="ProcessingRequest"/>
<transition event="User logs out" target="Logout"/>
</state>
<state id="ProcessingRequest">
<transition event="System change processed" target="Idle"/>
<transition event="Issue detected" target="SendingNotification"/>
</state>
<state id="SendingNotification">
<transition event="Notification sent" target="Idle"/>
</state>
<state id="Logout">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

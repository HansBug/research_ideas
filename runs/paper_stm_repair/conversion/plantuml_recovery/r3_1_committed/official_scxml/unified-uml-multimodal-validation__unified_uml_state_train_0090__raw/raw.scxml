<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="MonitoringInventory"/>
</state>
<state id="MonitoringInventory">
<transition event="on low stock detected" target="DetectingLowLevels"/>
<transition event="on new data" target="UpdatingDashboards"/>
<transition event="on integration needed" target="IntegratingSystems"/>
</state>
<state id="DetectingLowLevels">
<transition event="send alert" target="SendingAlerts"/>
</state>
<state id="SendingAlerts">
<transition target="end"/>
</state>
<state id="UpdatingDashboards">
<transition target="end"/>
</state>
<state id="IntegratingSystems">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

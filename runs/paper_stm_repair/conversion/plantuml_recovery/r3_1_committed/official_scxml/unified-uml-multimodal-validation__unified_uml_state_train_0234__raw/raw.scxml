<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Login"/>
</state>
<state id="Login">
<transition target="Dashboard"/>
</state>
<state id="Dashboard">
<transition target="BrowseFeed"/>
<transition target="ManageProfiles"/>
<transition target="ViewInteractions"/>
</state>
<state id="BrowseFeed">
<transition target="DiscoverNewAccounts"/>
<transition target="EngageWithFriends"/>
</state>
<state id="DiscoverNewAccounts">
<transition target="FollowAccounts"/>
</state>
<state id="EngageWithFriends">
<transition target="ShareContent"/>
<transition target="ViewInteractions"/>
</state>
<state id="FollowAccounts">
<transition target="end"/>
</state>
<state id="ShareContent">
<transition target="end"/>
</state>
<state id="ViewInteractions">
<transition target="AnalyzeEngagement"/>
<transition target="end"/>
</state>
<state id="ManageProfiles">
<transition target="AddProfile"/>
<transition target="RemoveProfile"/>
</state>
<state id="AddProfile">
<transition target="end"/>
</state>
<state id="RemoveProfile">
<transition target="end"/>
</state>
<state id="AnalyzeEngagement">
<transition target="AdjustContentStrategy"/>
</state>
<state id="AdjustContentStrategy">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

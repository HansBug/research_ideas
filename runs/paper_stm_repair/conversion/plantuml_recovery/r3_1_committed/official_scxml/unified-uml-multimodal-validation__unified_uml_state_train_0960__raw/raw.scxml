<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectingSectionsAndSubsections"/>
</state>
<state id="SelectingSectionsAndSubsections">
<transition event="selecting sections" target="CustomizingReportElements"/>
</state>
<state id="CustomizingReportElements">
<transition event="customizing elements" target="ViewingReport"/>
</state>
<state id="ViewingReport">
<transition event="viewing report" target="SavingReport"/>
</state>
<state id="SavingReport">
<transition event="saving report" target="end"/>
</state>
<state id="end"/>
</scxml>

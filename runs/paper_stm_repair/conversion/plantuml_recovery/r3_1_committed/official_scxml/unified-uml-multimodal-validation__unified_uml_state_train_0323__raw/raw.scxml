<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="View List" target="ViewList"/>
</state>
<state id="ViewList">
<transition event="Add New Item" target="AddNewItem"/>
<transition event="Search by Keyword" target="Search"/>
<transition event="Filter by Date/Author/Tags" target="Filter"/>
<transition event="Share List" target="Share"/>
<transition event="View History" target="ViewHistory"/>
</state>
<state id="AddNewItem">
<transition event="Add Item" target="end"/>
</state>
<state id="Search">
<transition event="Search Results" target="end"/>
</state>
<state id="Filter">
<transition event="Filtered Results" target="end"/>
</state>
<state id="Share">
<transition event="Share Complete" target="end"/>
</state>
<state id="ViewHistory">
<transition event="View History" target="end"/>
</state>
<state id="end">
<transition target="start"/>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="WaitingForInput"/>
</state>
<state id="WaitingForInput">
<transition event="User starts typing" target="DetectingInput"/>
</state>
<state id="DetectingInput">
<transition event="Input detected" target="SuggestingSolutions"/>
</state>
<state id="SuggestingSolutions">
<transition event="User selects suggestion" target="ProvidingSolution"/>
</state>
<state id="ProvidingSolution">
<transition event="Solution provided" target="end"/>
</state>
<state id="end"/>
</scxml>

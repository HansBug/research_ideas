<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="Start" target="Start"/>
</state>
<state id="Start">
<transition event="Create Category" target="CreateCategory"/>
</state>
<state id="CreateCategory">
<transition event="Manage Categories" target="ManageCategories"/>
</state>
<state id="ManageCategories">
<transition event="Search Assets" target="SearchAssets"/>
<transition event="Add/Remove Categories" target="AddRemoveCategories"/>
</state>
<state id="SearchAssets">
<transition event="View Asset" target="ViewAsset"/>
<transition target="end"/>
</state>
<state id="ViewAsset">
<transition event="Share Asset" target="ShareAsset"/>
<transition target="end"/>
</state>
<state id="ShareAsset">
<transition event="Receive Notifications" target="ReceiveNotifications"/>
<transition target="end"/>
</state>
<state id="ReceiveNotifications">
<transition target="end"/>
<transition event="Dismiss Notification" target="DismissNotification"/>
</state>
<state id="end"/>
<state id="AddRemoveCategories">
<transition target="ManageCategories"/>
</state>
<state id="DismissNotification">
<transition target="end"/>
</state>
</scxml>

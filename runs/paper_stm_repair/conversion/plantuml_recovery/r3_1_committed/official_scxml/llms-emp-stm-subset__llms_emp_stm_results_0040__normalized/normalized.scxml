<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="Power On" target="HumanDriving"/>
</state>
<state id="HumanDriving">
<transition event="front_distance &gt; 10" target="Autonomous"/>
<transition event="Power Off" target="end"/>
</state>
<state id="end"/>
<state id="Autonomous">
<transition event="human_steering_cmd || brake_pressed || in (AutoFinal)" target="HumanDriving"/>
<state id="startAutonomous">
<transition event="Enter Autonomous Mode" target="AutoInitial"/>
</state>
<state id="AutoInitial">
<transition event="Auto Process Complete" target="AutoFinal"/>
</state>
<state id="AutoFinal"/>
</state>
</scxml>

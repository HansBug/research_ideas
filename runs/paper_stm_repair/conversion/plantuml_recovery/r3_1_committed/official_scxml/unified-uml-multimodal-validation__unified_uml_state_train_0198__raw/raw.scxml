<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start_Trip_Planning"/>
</state>
<state id="Start_Trip_Planning">
<transition event="Input travel dates, times, preferences" target="Input_Preferences"/>
</state>
<state id="Input_Preferences">
<transition event="Fetch flight, train, hotel info" target="Fetch_Data"/>
</state>
<state id="Fetch_Data">
<transition event="Combine data to create itinerary" target="Generate_Itinerary"/>
</state>
<state id="Generate_Itinerary">
<transition event="Save the itinerary" target="Save_Itinerary"/>
<transition event="Modify preferences" target="Modify_Preferences"/>
</state>
<state id="Save_Itinerary">
<transition event="Access saved itinerary" target="Access_Itinerary"/>
<transition event="Re-generate itinerary" target="Generate_Itinerary"/>
</state>
<state id="Access_Itinerary">
<transition event="End trip planning" target="end"/>
</state>
<state id="end"/>
<state id="Modify_Preferences">
<transition event="Re-input preferences" target="Input_Preferences"/>
</state>
</scxml>

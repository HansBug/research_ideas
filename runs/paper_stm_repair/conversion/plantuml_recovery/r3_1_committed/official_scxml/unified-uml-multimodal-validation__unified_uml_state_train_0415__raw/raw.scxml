<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UserSetup"/>
</state>
<state id="UserSetup">
<transition target="NotificationProcessing"/>
<transition target="end"/>
</state>
<state id="NotificationProcessing">
<transition event="if conditions met" target="NotificationDisplay"/>
<transition event="if conditions not met" target="NotificationDelayed"/>
<transition target="end"/>
</state>
<state id="NotificationDisplay">
<transition target="DashboardView"/>
<transition target="end"/>
</state>
<state id="NotificationDelayed">
<transition target="DashboardView"/>
<transition target="end"/>
</state>
<state id="DashboardView">
<transition target="end"/>
<transition event="reconfiguration" target="UserSetup"/>
</state>
<state id="end"/>
</scxml>

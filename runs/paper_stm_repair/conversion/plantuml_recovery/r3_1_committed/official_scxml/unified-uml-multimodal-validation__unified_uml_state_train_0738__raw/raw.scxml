<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InStock"/>
</state>
<state id="InStock">
<transition event="Mark as Available" target="Available"/>
<transition target="end"/>
</state>
<state id="Available">
<transition event="Sold to Customer" target="Sold"/>
</state>
<state id="Sold">
<transition event="All Items Sold" target="OutOfStock"/>
</state>
<state id="OutOfStock">
<transition event="Reorder and Restock" target="Restocked"/>
</state>
<state id="Restocked">
<transition event="Return to Stock" target="InStock"/>
</state>
<state id="end"/>
</scxml>

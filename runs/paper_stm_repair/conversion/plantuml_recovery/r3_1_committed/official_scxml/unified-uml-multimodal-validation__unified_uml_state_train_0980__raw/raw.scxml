<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="IdleState"/>
</state>
<state id="IdleState">
<transition event="User initiates time tracking" target="AccessingTimeTracking"/>
</state>
<state id="AccessingTimeTracking">
<transition event="Start tracking" target="TrackingTime"/>
<transition event="View time info" target="DisplayingTimeInformation"/>
<transition event="View statistics" target="ViewingStatistics"/>
<transition event="Search tasks" target="SearchingTasks"/>
<transition event="Exit" target="end"/>
</state>
<state id="TrackingTime">
<transition event="Stop tracking" target="AccessingTimeTracking"/>
</state>
<state id="DisplayingTimeInformation">
<transition event="Return to tracking" target="AccessingTimeTracking"/>
</state>
<state id="ViewingStatistics">
<transition event="Return to tracking" target="AccessingTimeTracking"/>
</state>
<state id="SearchingTasks">
<transition event="View task details" target="ViewingTaskDetails"/>
</state>
<state id="ViewingTaskDetails">
<transition event="Return to tracking" target="AccessingTimeTracking"/>
</state>
<state id="end"/>
</scxml>

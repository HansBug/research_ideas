<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UploadImages"/>
</state>
<state id="UploadImages">
<transition target="CategorizeImages"/>
</state>
<state id="CategorizeImages">
<transition target="GenerateImageList"/>
</state>
<state id="GenerateImageList">
<transition target="SearchImages"/>
</state>
<state id="SearchImages">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

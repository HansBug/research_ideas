<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Login"/>
</state>
<state id="Login">
<transition event="Logout" target="end"/>
<transition event="Successful login" target="Dashboard"/>
<transition event="Invalid credentials" target="Login"/>
</state>
<state id="end"/>
<state id="Dashboard">
<transition event="Add new task" target="AddTask"/>
<transition event="View all tasks" target="ViewAllTasks"/>
<transition event="View tasks by user" target="ViewUserTasks"/>
<transition event="Add new user" target="AddUser"/>
<transition event="Search for task" target="SearchTask"/>
</state>
<state id="AddTask">
<transition event="Task added" target="Dashboard"/>
<transition event="Invalid input" target="AddTask"/>
<transition event="Logout" target="end"/>
</state>
<state id="ViewAllTasks">
<transition event="Back" target="Dashboard"/>
<transition event="Logout" target="end"/>
</state>
<state id="ViewUserTasks">
<transition event="Back" target="Dashboard"/>
<transition event="Logout" target="end"/>
</state>
<state id="AddUser">
<transition event="User added" target="Dashboard"/>
<transition event="Invalid input" target="AddUser"/>
<transition event="Logout" target="end"/>
</state>
<state id="SearchTask">
<transition event="Back" target="Dashboard"/>
<transition event="No results" target="SearchTask"/>
<transition event="Logout" target="end"/>
</state>
</scxml>

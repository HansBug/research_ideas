<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="View Scores" target="ViewScores"/>
<transition event="Setup Alerts" target="AlertsSetup"/>
</state>
<state id="ViewScores">
<transition event="Select Game" target="SelectGame"/>
</state>
<state id="SelectGame">
<transition event="Edit Score" target="EditScore"/>
<transition event="Add Score" target="AddScore"/>
<transition event="View Detailed Info" target="DetailedInfo"/>
</state>
<state id="EditScore">
<transition event="Save and Return" target="ViewScores"/>
<transition event="View Details" target="DetailedInfo"/>
</state>
<state id="AddScore">
<transition event="Save and Return" target="ViewScores"/>
<transition event="View Details" target="DetailedInfo"/>
</state>
<state id="DetailedInfo">
<transition event="Back to View" target="ViewScores"/>
</state>
<state id="AlertsSetup">
<transition event="Notifications" target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="Add new bill" target="AddingBill"/>
</state>
<state id="AddingBill">
<transition event="Save bill" target="end"/>
<transition event="View outstanding bills" target="ViewingBills"/>
<transition event="Set automatic payment" target="SettingAutoPayment"/>
</state>
<state id="end"/>
<state id="ViewingBills">
<transition event="Close view" target="end"/>
<transition event="Set automatic payment" target="SettingAutoPayment"/>
<transition event="Bill due" target="ReceivingNotification"/>
</state>
<state id="SettingAutoPayment">
<transition event="Enable auto payment" target="end"/>
<transition event="View bills" target="ViewingBills"/>
</state>
<state id="ReceivingNotification">
<transition event="Dismiss notification" target="end"/>
<transition event="View bills" target="ViewingBills"/>
<transition event="View payment history" target="ViewingHistory"/>
</state>
<state id="ViewingHistory">
<transition event="Close history" target="end"/>
<transition event="Edit payment" target="EditingPayment"/>
</state>
<state id="EditingPayment">
<transition event="Cancel payment" target="end"/>
<transition event="View bills" target="ViewingBills"/>
</state>
</scxml>

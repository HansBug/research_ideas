<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DisplayProductList"/>
</state>
<state id="DisplayProductList">
<transition event="User selects filter" target="FilterOptions"/>
<transition event="User views recommendations" target="ViewRecommendations"/>
<transition event="User views reviews" target="ViewReviews"/>
<transition event="Exit" target="end"/>
</state>
<state id="FilterOptions">
<transition event="User applies filter" target="ApplyFilter"/>
</state>
<state id="ApplyFilter">
<transition event="Filter applied" target="DisplayFilteredProducts"/>
</state>
<state id="DisplayFilteredProducts">
<transition event="User clicks product" target="ViewProductDetails"/>
</state>
<state id="ViewProductDetails">
<transition event="User adds to list" target="AddToShoppingList"/>
</state>
<state id="AddToShoppingList">
<transition event="Return to list" target="DisplayProductList"/>
</state>
<state id="ViewRecommendations">
<transition event="Recommendations displayed" target="DisplayRecommendations"/>
</state>
<state id="DisplayRecommendations">
<transition event="User clicks product" target="ViewProductDetails"/>
<transition event="User selects filter" target="FilterOptions"/>
</state>
<state id="ViewReviews">
<transition event="Reviews displayed" target="DisplayReviews"/>
</state>
<state id="DisplayReviews">
<transition event="User filters reviews" target="FilterReviews"/>
</state>
<state id="FilterReviews">
<transition event="Reviews filtered" target="DisplayFilteredReviews"/>
</state>
<state id="DisplayFilteredReviews">
<transition event="Return to list" target="DisplayProductList"/>
</state>
<state id="end"/>
</scxml>

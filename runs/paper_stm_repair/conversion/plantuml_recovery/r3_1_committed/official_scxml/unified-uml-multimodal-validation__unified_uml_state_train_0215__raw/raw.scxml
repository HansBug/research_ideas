<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="StartBooking"/>
</state>
<state id="StartBooking">
<transition event="User selects travel mode and destination" target="SelectTravelMode"/>
</state>
<state id="SelectTravelMode">
<transition event="User inputs travel dates and preferred mode" target="InputTravelDates"/>
</state>
<state id="InputTravelDates">
<transition event="System generates available options" target="GenerateOptions"/>
</state>
<state id="GenerateOptions">
<transition event="User selects preferred option" target="SelectOption"/>
</state>
<state id="SelectOption">
<transition event="User reviews options" target="ReviewOptions"/>
</state>
<state id="ReviewOptions">
<transition event="User submits booking info" target="SubmitBooking"/>
</state>
<state id="SubmitBooking">
<transition event="System checks availability" target="CheckAvailability"/>
</state>
<state id="CheckAvailability">
<transition event="System confirms booking" target="ConfirmBooking"/>
</state>
<state id="ConfirmBooking">
<transition event="System sends email" target="SendConfirmation"/>
</state>
<state id="SendConfirmation">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

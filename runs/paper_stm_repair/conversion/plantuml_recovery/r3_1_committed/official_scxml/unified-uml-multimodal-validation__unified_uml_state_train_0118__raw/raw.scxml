<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="end">
<transition target="OrderDelivered"/>
<transition target="OrderDeleted"/>
</state>
<state id="InitialState">
<state id="startInitialState">
<transition target="CreateOrder"/>
</state>
<state id="CreateOrder">
<transition event="&quot;Create Order&quot;" target="OrderCreated"/>
<transition event="&quot;Edit Order&quot;" target="OrderEdited"/>
<transition event="&quot;Delete Order&quot;" target="OrderDeleted"/>
<state id="OrderCreated">
<transition event="&quot;Track Order&quot;" target="OrderTracking"/>
<transition event="&quot;Process Payment&quot;" target="PaymentProcessing"/>
<transition event="&quot;Mark as Delivered&quot;" target="OrderDelivered"/>
<state id="OrderTracking">
<transition event="&quot;Process Payment&quot;" target="PaymentProcessing"/>
<transition event="&quot;Mark as Delivered&quot;" target="OrderDelivered"/>
</state>
<state id="PaymentProcessing">
<transition event="&quot;Payment Completed&quot;" target="OrderDelivered"/>
</state>
<state id="OrderDelivered">
<transition event="&quot;Final State&quot;" target="endOrderDelivered"/>
<state id="endOrderDelivered"/>
</state>
</state>
<state id="OrderEdited">
<transition event="&quot;Save Changes&quot;" target="OrderCreated"/>
<transition event="&quot;Delete Order&quot;" target="OrderDeleted"/>
</state>
<state id="OrderDeleted">
<transition event="&quot;Final State&quot;" target="endOrderDeleted"/>
<state id="endOrderDeleted"/>
</state>
</state>
</state>
</scxml>

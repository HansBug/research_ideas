<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="StartSearch"/>
</state>
<state id="StartSearch">
<transition event="search" target="ShowSearchResults"/>
</state>
<state id="ShowSearchResults">
<transition event="filter" target="FilterResults"/>
<transition event="view history" target="ViewPurchaseHistory"/>
</state>
<state id="FilterResults">
<transition event="back to results" target="ShowSearchResults"/>
<transition event="exit" target="end"/>
</state>
<state id="ViewPurchaseHistory">
<transition event="back to results" target="ShowSearchResults"/>
<transition event="exit" target="end"/>
</state>
<state id="end"/>
</scxml>

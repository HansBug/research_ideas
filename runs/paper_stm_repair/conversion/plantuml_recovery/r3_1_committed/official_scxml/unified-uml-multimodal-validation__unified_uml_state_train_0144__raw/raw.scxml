<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition target="OrderPlaced"/>
</state>
<state id="OrderPlaced">
<transition target="OrderProcessing"/>
<transition target="OrderCanceled"/>
</state>
<state id="OrderProcessing">
<transition target="OrderCompleted"/>
<transition target="OrderCanceled"/>
</state>
<state id="OrderCompleted">
<transition target="end"/>
</state>
<state id="OrderCanceled">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

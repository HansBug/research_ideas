<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="IdleState"/>
</state>
<state id="IdleState">
<transition event="User logs an expense" target="LoggingExpenseState"/>
<transition event="User views expenses" target="ViewingExpensesState"/>
</state>
<state id="LoggingExpenseState">
<transition event="System generates receipt" target="GeneratingReceiptState"/>
</state>
<state id="GeneratingReceiptState">
<transition event="System sends receipt via email" target="SendingEmailState"/>
</state>
<state id="SendingEmailState">
<transition event="System returns to initial state" target="end"/>
</state>
<state id="end"/>
<state id="ViewingExpensesState">
<transition event="User edits expense" target="EditingExpenseState"/>
<transition event="User deletes expense" target="DeletingExpenseState"/>
<transition event="User searches expenses" target="SearchingExpensesState"/>
<transition event="User filters expenses" target="FilteringExpensesState"/>
<transition event="User views history" target="ViewingHistoryState"/>
</state>
<state id="EditingExpenseState">
<transition event="System returns to initial state" target="end"/>
</state>
<state id="DeletingExpenseState">
<transition event="System returns to initial state" target="end"/>
</state>
<state id="SearchingExpensesState">
<transition event="System returns to initial state" target="end"/>
</state>
<state id="FilteringExpensesState">
<transition event="System returns to initial state" target="end"/>
</state>
<state id="ViewingHistoryState">
<transition event="System returns to initial state" target="end"/>
</state>
</scxml>

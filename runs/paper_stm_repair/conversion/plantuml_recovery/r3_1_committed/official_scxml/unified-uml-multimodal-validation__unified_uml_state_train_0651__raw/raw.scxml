<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="NotLoggedIn"/>
</state>
<state id="NotLoggedIn">
<transition event="Login" target="LoginSuccess"/>
<transition event="Forgot Password" target="PasswordReset"/>
<transition event="Logout" target="end"/>
</state>
<state id="LoginSuccess">
<transition event="Success" target="LoggedIn"/>
</state>
<state id="PasswordReset">
<transition event="Reset Password" target="NotLoggedIn"/>
</state>
<state id="LoggedIn">
<transition event="Logout" target="NotLoggedIn"/>
<transition event="Search/View/Manage Orders" target="OrderManagement"/>
</state>
<state id="OrderManagement">
<transition event="Return" target="LoggedIn"/>
</state>
<state id="end"/>
</scxml>

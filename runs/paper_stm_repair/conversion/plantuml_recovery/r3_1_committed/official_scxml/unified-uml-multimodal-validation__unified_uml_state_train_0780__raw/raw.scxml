<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UserInput"/>
</state>
<state id="UserInput">
<transition event="User submits search" target="DataCollection"/>
</state>
<state id="DataCollection">
<transition event="Data collected" target="DataAnalysis"/>
</state>
<state id="DataAnalysis">
<transition event="Analysis complete" target="ResultPresentation"/>
</state>
<state id="ResultPresentation">
<transition event="Results displayed" target="end"/>
</state>
<state id="end"/>
</scxml>

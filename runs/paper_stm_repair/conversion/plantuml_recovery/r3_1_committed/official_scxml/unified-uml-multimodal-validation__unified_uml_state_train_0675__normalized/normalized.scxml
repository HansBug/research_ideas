<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="State_c7332c"/>
<state id="start">
<transition target="MainMenu"/>
<transition target="Sidebar"/>
</state>
<state id="MainMenu">
<transition event="Access Subject Explorer" target="SearchInterface"/>
</state>
<state id="Sidebar">
<transition event="Access Subject Explorer" target="SearchInterface"/>
</state>
<state id="SearchInterface">
<transition event="Perform Search" target="ViewResults"/>
<transition event="Return to Main Menu" target="MainMenu"/>
<transition event="Return to Sidebar" target="Sidebar"/>
</state>
<state id="ViewResults">
<transition event="View Item Details" target="ViewItemDetails"/>
<transition event="Add to Library" target="AddToLibrary"/>
<transition event="Return to Search Interface" target="SearchInterface"/>
<transition event="Logout" target="end"/>
</state>
<state id="ViewItemDetails">
<transition event="Return to Results" target="ViewResults"/>
<transition event="Logout" target="end"/>
</state>
<state id="AddToLibrary">
<transition event="Return to Results" target="ViewResults"/>
<transition event="Logout" target="end"/>
</state>
<state id="end">
<transition event="Logout" target="State_c7332c"/>
</state>
</scxml>

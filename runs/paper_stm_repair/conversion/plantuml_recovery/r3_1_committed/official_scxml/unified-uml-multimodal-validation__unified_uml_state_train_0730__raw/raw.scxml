<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="CreateTask"/>
</state>
<state id="CreateTask">
<transition target="AssignTask"/>
</state>
<state id="AssignTask">
<transition target="TrackProgress"/>
</state>
<state id="TrackProgress">
<transition event="Reassignment Needed" target="AssignTask"/>
<transition target="CompleteTask"/>
</state>
<state id="CompleteTask">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="startInMotion" version="1.0">
<state id="DoorsClosing">
<transition event="Closed/SendDeparted" target="InMotion"/>
</state>
<state id="Stopping"/>
<state id="InMotion">
<transition event="Arrived/Stop, SendArrived" target="Stopping"/>
<transition event="Obstacle Detected" target="EmergencyStopping"/>
<state id="startInMotion">
<transition event="Entry/Accelerate" target="Accelerating"/>
</state>
<state id="Accelerating">
<transition event="Reached Cruising/Cruise" target="Cruising"/>
<transition event="Approached/Decelerate" target="Approaching"/>
</state>
<state id="Cruising">
<transition event="Approached/Decelerate" target="Approaching"/>
</state>
<state id="Approaching">
<state id="DuringApproaching">
<transition event="Send" target="Approaching"/>
</state>
</state>
</state>
<state id="EmergencyStopping">
<state id="Entry"/>
<state id="DuringEmergencyStopping"/>
</state>
</scxml>

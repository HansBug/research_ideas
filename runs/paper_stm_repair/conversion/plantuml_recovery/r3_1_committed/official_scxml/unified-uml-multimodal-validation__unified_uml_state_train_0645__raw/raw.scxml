<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="StartCreatingStoryline"/>
</state>
<state id="StartCreatingStoryline">
<transition event="Start creating storyline" target="CreatingStoryline"/>
</state>
<state id="CreatingStoryline">
<transition event="Edit storyline" target="EditingStoryline"/>
<transition event="Save storyline" target="SavingStoryline"/>
<transition event="Share storyline" target="SharingStoryline"/>
<transition event="Compare storylines" target="ComparingStorylines"/>
<transition event="Access storyline" target="AccessingStoryline"/>
<transition event="Exit" target="end"/>
</state>
<state id="EditingStoryline">
<transition event="Save changes" target="SavingStoryline"/>
<transition event="Share edited storyline" target="SharingStoryline"/>
<transition event="Compare edited storyline" target="ComparingStorylines"/>
<transition event="Access edited storyline" target="AccessingStoryline"/>
<transition event="Exit" target="end"/>
</state>
<state id="SavingStoryline">
<transition event="Access saved storyline" target="AccessingStoryline"/>
<transition event="Share saved storyline" target="SharingStoryline"/>
<transition event="Compare saved storyline" target="ComparingStorylines"/>
<transition event="Exit" target="end"/>
</state>
<state id="SharingStoryline">
<transition event="Access shared storyline" target="AccessingStoryline"/>
<transition event="Compare shared storyline" target="ComparingStorylines"/>
<transition event="Exit" target="end"/>
</state>
<state id="ComparingStorylines">
<transition event="Access compared storyline" target="AccessingStoryline"/>
<transition event="Exit" target="end"/>
</state>
<state id="AccessingStoryline">
<transition event="Exit" target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InputTravelPreferences"/>
</state>
<state id="InputTravelPreferences">
<transition target="AnalyzePreferences"/>
</state>
<state id="AnalyzePreferences">
<transition target="GenerateRecommendations"/>
</state>
<state id="GenerateRecommendations">
<transition target="DisplayRecommendations"/>
</state>
<state id="DisplayRecommendations">
<transition target="SaveRecommendations"/>
<transition target="ViewSavedRecommendations"/>
</state>
<state id="SaveRecommendations">
<transition target="end"/>
</state>
<state id="ViewSavedRecommendations">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Ready"/>
</state>
<state id="Ready">
<transition event="User selects languages" target="LanguageSelection"/>
</state>
<state id="LanguageSelection">
<transition event="User inputs/ selects text" target="TextInput"/>
</state>
<state id="TextInput">
<transition event="System starts translation" target="TranslationProcessing"/>
</state>
<state id="TranslationProcessing">
<transition event="Translation completed" target="TextDisplay"/>
</state>
<state id="TextDisplay">
<transition event="Display translation to user" target="TranslationComplete"/>
</state>
<state id="TranslationComplete">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

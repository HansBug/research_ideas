<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="View Content" target="ViewingContent"/>
</state>
<state id="ViewingContent">
<transition event="Switch Content Type" target="SwitchingContentTypes"/>
</state>
<state id="SwitchingContentTypes">
<transition event="Access Specific Section" target="AccessingSpecificSection"/>
</state>
<state id="AccessingSpecificSection">
<transition event="Save Changes" target="SavingChanges"/>
</state>
<state id="SavingChanges">
<transition target="FinalState"/>
</state>
<state id="FinalState">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="Not_Logged_In_caa089">
<transition event="Login" target="Logging_In_5e2767"/>
</state>
<state id="Logging_In_5e2767">
<transition event="Successful Login" target="Logged_In_a30ad4"/>
</state>
<state id="Logged_In_a30ad4">
<transition event="Start Logging" target="Logging_Activities_ffe621"/>
<transition event="View Dashboard" target="Viewing_Dashboard_6e9314"/>
</state>
<state id="Logging_Activities_ffe621">
<transition event="Continue Logging" target="Logging_Activities_ffe621"/>
<transition event="Stop Logging" target="Viewing_Dashboard_6e9314"/>
</state>
<state id="Viewing_Dashboard_6e9314">
<transition event="Resume Logging" target="Logging_Activities_ffe621"/>
<transition event="Logout" target="Logging_Out_2c816e"/>
</state>
<state id="Logging_Out_2c816e">
<transition event="Logout Complete" target="end"/>
</state>
<state id="start">
<transition target="Not_Logged_In_caa089"/>
</state>
<state id="end"/>
</scxml>

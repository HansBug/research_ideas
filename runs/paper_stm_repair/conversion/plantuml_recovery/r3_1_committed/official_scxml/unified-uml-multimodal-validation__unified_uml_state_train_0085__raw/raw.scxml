<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ProfileOverview"/>
</state>
<state id="ProfileOverview">
<transition target="ProfileSettings"/>
<transition target="ProfileActions"/>
<transition target="ViewProfile"/>
<transition target="end"/>
</state>
<state id="ProfileSettings">
<transition target="AddProfile"/>
<transition target="EditProfile"/>
<transition target="DeleteProfile"/>
<transition target="ProfileOverview"/>
</state>
<state id="ProfileActions">
<transition target="ViewProfile"/>
<transition target="end"/>
</state>
<state id="ViewProfile">
<transition target="ProfileOverview"/>
<transition target="end"/>
</state>
<state id="AddProfile">
<transition target="ProfileOverview"/>
</state>
<state id="EditProfile">
<transition target="ProfileOverview"/>
</state>
<state id="DeleteProfile">
<transition target="ProfileOverview"/>
</state>
<state id="end"/>
</scxml>

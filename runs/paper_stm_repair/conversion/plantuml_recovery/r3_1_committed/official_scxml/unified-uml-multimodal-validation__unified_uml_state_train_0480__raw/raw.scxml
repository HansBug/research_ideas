<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UserEntersSearchQuery"/>
</state>
<state id="UserEntersSearchQuery">
<transition target="ApplicationSuggestsRelatedTerms"/>
</state>
<state id="ApplicationSuggestsRelatedTerms">
<transition target="UserSelectsSuggestedTerm"/>
</state>
<state id="UserSelectsSuggestedTerm">
<transition target="UserSavesFavoriteTerms"/>
<transition target="ApplicationDisplaysRelatedInformation"/>
</state>
<state id="UserSavesFavoriteTerms">
<transition target="end"/>
</state>
<state id="ApplicationDisplaysRelatedInformation">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="User Initiates Change" target="ColorSchemeSelection"/>
<transition event="No Change" target="end"/>
</state>
<state id="ColorSchemeSelection">
<transition event="Scheme Selected" target="ColorSchemeApplication"/>
<transition event="Cancel Change" target="end"/>
</state>
<state id="ColorSchemeApplication">
<transition event="Scheme Applied" target="end"/>
<transition event="Scheme Applied" target="end"/>
</state>
<state id="end"/>
</scxml>

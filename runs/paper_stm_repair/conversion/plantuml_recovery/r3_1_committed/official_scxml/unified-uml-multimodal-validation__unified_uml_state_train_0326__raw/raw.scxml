<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="User exits the application" target="end"/>
<transition event="User clicks &quot;Quick Search&quot; button" target="WaitingForInput"/>
</state>
<state id="end"/>
<state id="WaitingForInput">
<transition event="User enters keyword/phrase and clicks &quot;Quick Search&quot;" target="PerformingSearch"/>
</state>
<state id="PerformingSearch">
<transition event="Search results found" target="DisplayingResults"/>
<transition event="No matching documents found" target="NoResultsFound"/>
</state>
<state id="DisplayingResults">
<transition event="User selects a document to view" target="InitialState"/>
<transition event="User chooses to exit" target="end"/>
</state>
<state id="NoResultsFound">
<transition event="User clicks to perform new search" target="InitialState"/>
<transition event="User chooses to exit" target="end"/>
</state>
</scxml>

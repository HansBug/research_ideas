<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="TaskSubmission"/>
</state>
<state id="TaskSubmission">
<transition target="PermissionCheck"/>
</state>
<state id="PermissionCheck">
<transition target="TaskAssignment"/>
</state>
<state id="TaskAssignment">
<transition target="TaskCompletion"/>
</state>
<state id="TaskCompletion">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

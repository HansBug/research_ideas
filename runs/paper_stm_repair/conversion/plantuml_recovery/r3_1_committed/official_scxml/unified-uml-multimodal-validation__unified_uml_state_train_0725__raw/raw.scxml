<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DisplayOrderHistory"/>
</state>
<state id="DisplayOrderHistory">
<transition event="Search by Order Number, Date, or Status" target="SearchOrders"/>
<transition event="Filter by Date Range, Customer Name, or Status" target="FilterOrders"/>
</state>
<state id="SearchOrders">
<transition event="Display Order Details" target="DisplayOrderDetails"/>
</state>
<state id="FilterOrders">
<transition event="Display Order Details" target="DisplayOrderDetails"/>
</state>
<state id="DisplayOrderDetails">
<transition event="View Status History" target="ViewStatusHistory"/>
<transition event="Return to Initial State" target="end"/>
</state>
<state id="ViewStatusHistory">
<transition event="Return to Initial State" target="end"/>
</state>
<state id="end"/>
</scxml>

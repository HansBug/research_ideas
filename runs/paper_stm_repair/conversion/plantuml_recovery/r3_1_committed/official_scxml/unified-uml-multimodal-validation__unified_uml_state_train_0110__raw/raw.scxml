<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="&quot;Create Playlist&quot;" target="CreatingPlaylist"/>
<transition event="&quot;Search for Songs/Artists&quot;" target="SearchingLibrary"/>
</state>
<state id="CreatingPlaylist">
<transition event="&quot;Add Songs/Artists/Genres&quot;" target="AddingSongsArtistsGenres"/>
</state>
<state id="SearchingLibrary">
<transition event="&quot;Add to Playlist&quot;" target="AddingSongsArtistsGenres"/>
<transition event="&quot;Exit System&quot;" target="end"/>
</state>
<state id="AddingSongsArtistsGenres">
<transition event="&quot;Save Playlist&quot;" target="SavingPlaylist"/>
</state>
<state id="SavingPlaylist">
<transition event="&quot;Manage Playlist&quot;" target="ManagingPlaylist"/>
</state>
<state id="ManagingPlaylist">
<transition event="&quot;Exit System&quot;" target="end"/>
<transition event="&quot;Share Playlist&quot;" target="SharingPlaylist"/>
<transition event="&quot;Continue Managing&quot;" target="ManagingPlaylist"/>
</state>
<state id="end"/>
<state id="SharingPlaylist">
<transition event="&quot;Return to Manage&quot;" target="ManagingPlaylist"/>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="TaskListEmpty"/>
</state>
<state id="TaskListEmpty">
<transition event="View Task List" target="TaskListView"/>
</state>
<state id="TaskListView">
<transition event="Exit" target="end"/>
<transition event="Add New Task" target="AddTaskState"/>
<transition event="Edit Task" target="EditTaskState"/>
<transition event="Delete Task" target="DeleteTaskState"/>
<transition event="View Task Details" target="ViewTaskState"/>
<transition event="Search Tasks" target="SearchTaskState"/>
<transition event="Filter Tasks" target="FilterTaskState"/>
<transition event="Assign Task" target="AssignTaskState"/>
</state>
<state id="end"/>
<state id="AddTaskState">
<transition event="Return" target="TaskListView"/>
</state>
<state id="EditTaskState">
<transition event="Return" target="TaskListView"/>
</state>
<state id="DeleteTaskState">
<transition event="Return" target="TaskListView"/>
</state>
<state id="ViewTaskState">
<transition event="Return" target="TaskListView"/>
</state>
<state id="SearchTaskState">
<transition event="Return" target="TaskListView"/>
</state>
<state id="FilterTaskState">
<transition event="Return" target="TaskListView"/>
</state>
<state id="AssignTaskState">
<transition event="Return" target="TaskListView"/>
</state>
</scxml>

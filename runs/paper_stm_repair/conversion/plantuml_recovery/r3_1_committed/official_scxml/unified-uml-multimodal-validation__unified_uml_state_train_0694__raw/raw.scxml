<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="TaskCreated"/>
</state>
<state id="TaskCreated">
<transition target="TaskAssignment"/>
</state>
<state id="TaskAssignment">
<transition target="TaskPrioritization"/>
</state>
<state id="TaskPrioritization">
<transition target="TaskAssigned"/>
</state>
<state id="TaskAssigned">
<transition target="TaskInProgress"/>
</state>
<state id="TaskInProgress">
<transition target="TaskCompleted"/>
<transition target="TaskOverdue"/>
</state>
<state id="TaskCompleted">
<transition target="end"/>
</state>
<state id="TaskOverdue">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectProduct"/>
</state>
<state id="SelectProduct">
<transition target="InputCustomText"/>
</state>
<state id="InputCustomText">
<transition target="ValidateCustomText"/>
</state>
<state id="ValidateCustomText">
<transition target="CustomTextAdded"/>
<transition target="InputCustomText"/>
</state>
<state id="CustomTextAdded">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

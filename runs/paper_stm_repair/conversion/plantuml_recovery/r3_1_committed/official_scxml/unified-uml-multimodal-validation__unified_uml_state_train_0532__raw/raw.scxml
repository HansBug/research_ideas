<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="BrowsingProducts"/>
</state>
<state id="BrowsingProducts">
<transition event="Finds product of interest" target="ViewingProductDetails"/>
</state>
<state id="ViewingProductDetails">
<transition event="System suggests price adjustment" target="ReceivingPriceAdjustmentSuggestions"/>
</state>
<state id="ReceivingPriceAdjustmentSuggestions">
<transition event="User chooses to apply adjustment" target="ApplyingPriceAdjustment"/>
</state>
<state id="ApplyingPriceAdjustment">
<transition event="Adjustment applied" target="CompletingPurchase"/>
</state>
<state id="CompletingPurchase">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

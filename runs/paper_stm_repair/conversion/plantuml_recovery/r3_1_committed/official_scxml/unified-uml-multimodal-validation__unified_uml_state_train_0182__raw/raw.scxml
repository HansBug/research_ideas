<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition event="Assign Task" target="TaskAssignment"/>
</state>
<state id="TaskAssignment">
<transition event="Track Progress" target="TaskTracking"/>
</state>
<state id="TaskTracking">
<transition event="Receive Reminder" target="Reminder"/>
</state>
<state id="Reminder">
<transition event="Complete Task" target="TaskCompletion"/>
</state>
<state id="TaskCompletion">
<transition event="View Summary" target="Summary"/>
</state>
<state id="Summary">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

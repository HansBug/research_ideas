<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UploadingFiles"/>
<transition target="ManagingFiles"/>
</state>
<state id="UploadingFiles">
<transition target="FilesUploaded"/>
</state>
<state id="ManagingFiles">
<transition target="FilesManaged"/>
</state>
<state id="FilesUploaded">
<transition target="end"/>
</state>
<state id="end"/>
<state id="FilesManaged">
<transition target="end"/>
</state>
</scxml>

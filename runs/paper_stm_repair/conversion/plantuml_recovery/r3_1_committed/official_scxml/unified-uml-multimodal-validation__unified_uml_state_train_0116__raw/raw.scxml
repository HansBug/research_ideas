<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="User provides input" target="ParsingInput"/>
<transition event="User requests calendar view" target="ViewingCalendar"/>
<transition event="Exit feature" target="end"/>
</state>
<state id="ParsingInput">
<transition event="NLP parses input" target="DeterminingRequestType"/>
</state>
<state id="DeterminingRequestType">
<transition event="If meeting request" target="SchedulingMeeting"/>
<transition event="If task request" target="AddingTask"/>
</state>
<state id="SchedulingMeeting">
<transition event="Schedule meeting" target="SettingReminders"/>
</state>
<state id="AddingTask">
<transition event="Add relevant tasks" target="CreatingTasks"/>
</state>
<state id="SettingReminders">
<transition event="Return to idle" target="Idle"/>
</state>
<state id="CreatingTasks">
<transition event="Return to idle" target="Idle"/>
</state>
<state id="ViewingCalendar">
<transition event="Return to idle" target="Idle"/>
</state>
<state id="end"/>
</scxml>

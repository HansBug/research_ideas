<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Search_Initiated"/>
</state>
<state id="Search_Initiated">
<transition event="Choose Quick Search" target="Quick_Search"/>
<transition event="Choose Custom Search" target="Custom_Search"/>
</state>
<state id="Quick_Search">
<transition event="Perform Quick Search" target="Results_Displayed"/>
</state>
<state id="Custom_Search">
<transition event="Perform Custom Search" target="Results_Displayed"/>
</state>
<state id="Results_Displayed">
<transition event="Refine Search" target="Search_Initiated"/>
<transition event="View Search History" target="Search_History"/>
<transition event="Exit" target="end"/>
</state>
<state id="Search_History">
<transition event="Initiate New Search" target="Search_Initiated"/>
<transition event="Exit" target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ViewProfile"/>
<transition target="UpdateProfile"/>
<transition target="ManageContactInfo"/>
<transition target="SetReminder"/>
</state>
<state id="ViewProfile">
<transition event="Update Profile" target="UpdateProfile"/>
<transition event="Manage Contact Info" target="ManageContactInfo"/>
<transition event="Set Reminder" target="SetReminder"/>
<transition event="Exit" target="end"/>
</state>
<state id="UpdateProfile">
<transition event="View Profile" target="ViewProfile"/>
<transition event="Manage Contact Info" target="ManageContactInfo"/>
<transition event="Set Reminder" target="SetReminder"/>
<transition event="Exit" target="end"/>
</state>
<state id="ManageContactInfo">
<transition event="View Profile" target="ViewProfile"/>
<transition event="Update Profile" target="UpdateProfile"/>
<transition event="Set Reminder" target="SetReminder"/>
<transition event="Exit" target="end"/>
</state>
<state id="SetReminder">
<transition event="View Profile" target="ViewProfile"/>
<transition event="Update Profile" target="UpdateProfile"/>
<transition event="Manage Contact Info" target="ManageContactInfo"/>
<transition event="Exit" target="end"/>
</state>
<state id="end"/>
</scxml>

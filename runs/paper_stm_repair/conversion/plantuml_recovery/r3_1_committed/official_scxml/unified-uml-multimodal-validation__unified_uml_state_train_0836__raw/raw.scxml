<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="MainApplicationWindow"/>
</state>
<state id="MainApplicationWindow">
<transition event="View Tasks" target="ViewingTasks"/>
<transition event="Add New Task" target="AddingTask"/>
</state>
<state id="ViewingTasks">
<transition event="Mark Task Completed" target="MarkingTaskAsCompleted"/>
<transition event="Add New Task" target="AddingTask"/>
<transition event="Return to Main Window" target="MainApplicationWindow"/>
<transition event="Exit System" target="end"/>
</state>
<state id="AddingTask">
<transition event="Task Added" target="ViewingTasks"/>
<transition event="Return to Main Window" target="MainApplicationWindow"/>
<transition event="Exit System" target="end"/>
</state>
<state id="MarkingTaskAsCompleted">
<transition event="Task Marked Completed" target="ViewingTasks"/>
<transition event="Exit System" target="end"/>
</state>
<state id="end"/>
</scxml>

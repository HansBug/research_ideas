<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="OrderCreated"/>
</state>
<state id="OrderCreated">
<transition event="Order placed" target="OrderProcessing"/>
<transition event="Order canceled" target="OrderCanceled"/>
</state>
<state id="OrderProcessing">
<transition event="Order processed" target="OrderFulfillment"/>
<transition event="Order on hold" target="OrderOnHold"/>
<transition event="Order canceled" target="OrderCanceled"/>
</state>
<state id="OrderCanceled">
<transition event="Order canceled" target="OrderHistory"/>
</state>
<state id="OrderFulfillment">
<transition event="Order fulfilled" target="OrderCompleted"/>
</state>
<state id="OrderOnHold">
<transition event="Order resumed" target="OrderProcessing"/>
<transition event="Order canceled" target="OrderCanceled"/>
</state>
<state id="OrderCompleted">
<transition event="Order completed" target="OrderHistory"/>
</state>
<state id="OrderHistory">
<transition event="Order history viewed" target="end"/>
</state>
<state id="end"/>
</scxml>

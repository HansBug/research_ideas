<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Login"/>
</state>
<state id="Login">
<transition target="SearchProducts"/>
</state>
<state id="SearchProducts">
<transition target="AnalyzeBehavior"/>
</state>
<state id="AnalyzeBehavior">
<transition target="GenerateRecommendations"/>
</state>
<state id="GenerateRecommendations">
<transition target="SaveHistoryPreferences"/>
<transition target="ShareRecommendations"/>
</state>
<state id="SaveHistoryPreferences">
<transition target="end"/>
</state>
<state id="ShareRecommendations">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

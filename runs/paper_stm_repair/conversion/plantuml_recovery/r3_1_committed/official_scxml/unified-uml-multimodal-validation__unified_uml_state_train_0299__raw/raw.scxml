<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="User uploads file" target="FileUpload"/>
</state>
<state id="FileUpload">
<transition event="Configure access levels" target="AccessLevelConfiguration"/>
</state>
<state id="AccessLevelConfiguration">
<transition event="Share file with conditions" target="Sharing"/>
</state>
<state id="Sharing">
<transition event="Access granted based on conditions" target="AccessGranted"/>
<transition event="Access revoked/conditions not met" target="AccessRevoked"/>
</state>
<state id="AccessGranted">
<transition event="Access active" target="end"/>
</state>
<state id="AccessRevoked">
<transition event="Access denied" target="end"/>
</state>
<state id="end"/>
</scxml>

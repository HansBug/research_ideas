<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="PumpControl"/>
</state>
<state id="PumpControl">
<state id="startPumpControl">
<transition target="PumpState"/>
</state>
<state id="PumpState">
<transition event="[Water Flow Detected]" target="WaterState"/>
<transition event="[Methane Flow Detected]" target="MethaneState"/>
</state>
<state id="WaterState">
<transition event="[Water Flow Completed]" target="PumpState"/>
</state>
<state id="MethaneState">
<transition event="[Methane Flow Completed]" target="PumpState"/>
</state>
</state>
</scxml>

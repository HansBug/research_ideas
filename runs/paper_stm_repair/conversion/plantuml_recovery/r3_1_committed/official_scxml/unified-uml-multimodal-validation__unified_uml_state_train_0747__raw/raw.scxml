<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition target="ManualDataInput"/>
<transition target="DeviceDataCollection"/>
</state>
<state id="ManualDataInput">
<transition target="DataProcessing"/>
</state>
<state id="DeviceDataCollection">
<transition target="DataProcessing"/>
</state>
<state id="DataProcessing">
<transition target="DataStorage"/>
</state>
<state id="DataStorage">
<transition target="DataViewing"/>
</state>
<state id="DataViewing">
<transition target="RecommendationGeneration"/>
<transition target="end"/>
</state>
<state id="RecommendationGeneration">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

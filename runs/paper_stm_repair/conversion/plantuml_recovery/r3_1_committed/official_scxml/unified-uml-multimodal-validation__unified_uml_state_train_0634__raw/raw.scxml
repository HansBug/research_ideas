<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Login"/>
</state>
<state id="Login">
<transition event="Logout" target="end"/>
<transition event="Login Success" target="LoggedIn"/>
</state>
<state id="end"/>
<state id="LoggedIn">
<transition event="View Orders" target="ViewingOrders"/>
<transition event="Add Order" target="AddingOrder"/>
<transition event="Edit Order" target="EditingOrder"/>
<transition event="Delete Order" target="DeletingOrder"/>
</state>
<state id="ViewingOrders">
<transition event="Return" target="LoggedIn"/>
</state>
<state id="AddingOrder">
<transition event="Order Created" target="OrderStatus"/>
</state>
<state id="EditingOrder">
<transition event="Order Updated" target="OrderStatus"/>
</state>
<state id="DeletingOrder">
<transition event="Return" target="LoggedIn"/>
</state>
<state id="OrderStatus">
<transition event="Status Update (Pending -&gt; In Transit)" target="OrderStatus"/>
<transition event="Status Update (In Transit -&gt; Delivered)" target="OrderStatus"/>
<transition event="Order Completed" target="end"/>
</state>
</scxml>

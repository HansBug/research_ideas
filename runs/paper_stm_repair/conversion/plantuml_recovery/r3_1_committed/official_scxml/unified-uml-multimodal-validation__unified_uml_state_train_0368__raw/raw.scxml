<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="define schedule" target="ScheduleDefinition"/>
<transition event="manage schedule" target="ScheduleManagement"/>
</state>
<state id="ScheduleDefinition">
<transition event="schedule defined" target="ScheduleManagement"/>
</state>
<state id="ScheduleManagement">
<transition event="generate report" target="ReportGeneration"/>
<transition event="notify change" target="Notification"/>
<transition event="access report" target="ReportAccess"/>
</state>
<state id="ReportGeneration">
<transition event="report generated" target="ReportDelivery"/>
</state>
<state id="Notification">
<transition event="update schedule" target="ScheduleManagement"/>
<transition event="notification sent" target="end"/>
</state>
<state id="ReportAccess">
<transition event="report accessed" target="end"/>
</state>
<state id="ReportDelivery">
<transition event="report delivered" target="end"/>
</state>
<state id="end"/>
</scxml>

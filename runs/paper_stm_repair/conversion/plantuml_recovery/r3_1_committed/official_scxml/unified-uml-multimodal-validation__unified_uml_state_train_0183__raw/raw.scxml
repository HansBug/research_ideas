<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ViewingProjectInformation"/>
</state>
<state id="ViewingProjectInformation">
<transition target="end"/>
<transition target="FilteringProjectData"/>
<transition target="AssigningTasks"/>
</state>
<state id="end"/>
<state id="FilteringProjectData">
<transition target="end"/>
<transition target="AssigningTasks"/>
<transition target="ViewingProjectInformation"/>
</state>
<state id="AssigningTasks">
<transition target="end"/>
<transition target="SettingReminders"/>
<transition target="ViewingProjectInformation"/>
</state>
<state id="SettingReminders">
<transition target="end"/>
<transition target="ViewingProjectInformation"/>
</state>
</scxml>

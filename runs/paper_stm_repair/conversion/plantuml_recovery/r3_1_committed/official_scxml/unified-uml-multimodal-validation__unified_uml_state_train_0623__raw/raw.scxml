<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="AddingRecurringEvent"/>
</state>
<state id="AddingRecurringEvent">
<transition target="CustomizingRecurringEvent"/>
</state>
<state id="CustomizingRecurringEvent">
<transition target="ViewingRecurringEvent"/>
</state>
<state id="ViewingRecurringEvent">
<transition target="AddingRecurringEvent"/>
<transition target="CustomizingRecurringEvent"/>
<transition target="RemovingRecurringEvent"/>
<transition target="end"/>
</state>
<state id="RemovingRecurringEvent">
<transition target="AddingRecurringEvent"/>
</state>
<state id="end"/>
</scxml>

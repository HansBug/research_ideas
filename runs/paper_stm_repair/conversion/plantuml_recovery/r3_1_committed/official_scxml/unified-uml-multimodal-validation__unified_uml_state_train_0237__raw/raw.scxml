<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="User Request" target="Processing"/>
<transition event="Scheduled Reminder" target="Reminder"/>
<transition event="System Shutdown" target="end"/>
</state>
<state id="Processing">
<transition event="Suggestions Ready" target="ProvidingSuggestions"/>
</state>
<state id="ProvidingSuggestions">
<transition event="Done" target="Idle"/>
</state>
<state id="Reminder">
<transition event="Done" target="Idle"/>
</state>
<state id="end"/>
</scxml>

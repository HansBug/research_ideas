<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectTemplateOrNewGarden"/>
</state>
<state id="SelectTemplateOrNewGarden">
<transition event="Select template" target="TemplateSelection"/>
<transition event="Create new garden" target="NewGardenCreation"/>
</state>
<state id="TemplateSelection">
<transition event="Customize template" target="GardenCustomization"/>
<transition event="View template" target="GardenView"/>
</state>
<state id="NewGardenCreation">
<transition event="Customize new garden" target="GardenCustomization"/>
<transition event="View new garden" target="GardenView"/>
</state>
<state id="GardenCustomization">
<transition event="Save garden" target="GardenSaved"/>
<transition event="View customized garden" target="GardenView"/>
<transition event="Edit garden" target="GardenCustomization"/>
</state>
<state id="GardenView">
<transition event="Share garden" target="Sharing"/>
<transition event="Exit" target="end"/>
</state>
<state id="GardenSaved">
<transition event="Exit" target="end"/>
</state>
<state id="Sharing">
<transition event="Garden shared" target="Shared"/>
</state>
<state id="end"/>
<state id="Shared">
<transition event="Exit" target="end"/>
</state>
</scxml>

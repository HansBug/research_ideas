<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="on image upload" target="ProcessingImage"/>
</state>
<state id="ProcessingImage">
<transition event="after processing" target="DisplayingSavingImage"/>
</state>
<state id="DisplayingSavingImage">
<transition event="after display/save" target="end"/>
</state>
<state id="end"/>
</scxml>

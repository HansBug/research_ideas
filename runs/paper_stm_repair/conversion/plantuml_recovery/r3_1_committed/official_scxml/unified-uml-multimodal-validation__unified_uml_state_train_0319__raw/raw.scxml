<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="Display Version List" target="VersionList"/>
</state>
<state id="VersionList">
<transition event="Create New Version" target="CreateVersion"/>
<transition event="Load Version" target="LoadVersion"/>
<transition target="end"/>
</state>
<state id="CreateVersion">
<transition event="Version Created" target="VersionCreated"/>
</state>
<state id="VersionCreated">
<transition event="Save Version" target="VersionSaved"/>
<transition event="Discard Version" target="VersionList"/>
</state>
<state id="VersionSaved">
<transition event="Return to Version List" target="VersionList"/>
</state>
<state id="LoadVersion">
<transition event="Version Loaded" target="VersionLoaded"/>
</state>
<state id="VersionLoaded">
<transition event="Revert Version" target="VersionReverted"/>
<transition event="Save Changes" target="VersionSaved"/>
</state>
<state id="VersionReverted">
<transition event="Return to Version List" target="VersionList"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="Add New Contact" target="addContact"/>
<transition event="View Contacts" target="viewContacts"/>
<transition event="Search Contacts" target="searchContacts"/>
<transition event="Exit System" target="finalState"/>
</state>
<state id="addContact">
<transition event="Save and Return" target="InitialState"/>
</state>
<state id="viewContacts">
<transition event="Edit Contact" target="editContact"/>
<transition event="Delete Contact" target="deleteContact"/>
<transition event="Return to Menu" target="InitialState"/>
</state>
<state id="searchContacts">
<transition event="Search Completed" target="searchResults"/>
<transition event="No Results Found" target="noResults"/>
</state>
<state id="editContact">
<transition event="Save Changes" target="InitialState"/>
</state>
<state id="deleteContact">
<transition event="Delete Contact" target="InitialState"/>
</state>
<state id="searchResults">
<transition event="Edit Contact" target="editContact"/>
<transition event="Delete Contact" target="deleteContact"/>
<transition event="Return to Menu" target="InitialState"/>
</state>
<state id="noResults">
<transition event="Return to Menu" target="InitialState"/>
</state>
<state id="finalState"/>
</scxml>

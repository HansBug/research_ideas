<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SetupInventoryRule"/>
</state>
<state id="SetupInventoryRule">
<transition target="TrackInventory"/>
</state>
<state id="TrackInventory">
<transition event="Continue Tracking" target="TrackInventory"/>
<transition event="Inventory Low" target="AlertAndReorder"/>
</state>
<state id="AlertAndReorder">
<transition target="ReplenishInventory"/>
</state>
<state id="ReplenishInventory">
<transition event="Replenished" target="TrackInventory"/>
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

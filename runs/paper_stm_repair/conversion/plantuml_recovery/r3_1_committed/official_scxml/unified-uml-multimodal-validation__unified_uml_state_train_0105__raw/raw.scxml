<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="Start sharing" target="SelectMedia"/>
</state>
<state id="SelectMedia">
<transition event="Click Share" target="UploadMedia"/>
</state>
<state id="UploadMedia">
<transition event="Media uploaded" target="ChooseSharingOptions"/>
</state>
<state id="ChooseSharingOptions">
<transition event="Sharing options chosen" target="GenerateLink"/>
</state>
<state id="GenerateLink">
<transition event="Link generated" target="end"/>
</state>
<state id="end"/>
</scxml>

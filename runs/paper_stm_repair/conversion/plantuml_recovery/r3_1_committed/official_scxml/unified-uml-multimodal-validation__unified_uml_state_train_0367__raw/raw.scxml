<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="CreatingTask"/>
</state>
<state id="CreatingTask">
<transition event="After creating task" target="AssigningTask"/>
</state>
<state id="AssigningTask">
<transition event="After assigning task" target="TrackingProgress"/>
</state>
<state id="TrackingProgress">
<transition event="To view/edit" target="ViewingEditAssignments"/>
</state>
<state id="ViewingEditAssignments">
<transition event="To delete/update" target="DeletingUpdatingTask"/>
</state>
<state id="DeletingUpdatingTask">
<transition event="After deletion/update" target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ViewRealTimeData"/>
</state>
<state id="ViewRealTimeData">
<transition event="User sets targets" target="SetEnergyTargets"/>
</state>
<state id="SetEnergyTargets">
<transition event="System starts tracking" target="TrackEnergyUsage"/>
</state>
<state id="TrackEnergyUsage">
<transition event="Usage meets target" target="AlertUser"/>
<transition event="User views history" target="ViewHistoricalData"/>
</state>
<state id="AlertUser">
<transition event="User views history" target="ViewHistoricalData"/>
<transition event="User generates report" target="GenerateReports"/>
</state>
<state id="ViewHistoricalData">
<transition event="User generates report" target="GenerateReports"/>
<transition event="Data is shared" target="ShareData"/>
</state>
<state id="GenerateReports">
<transition event="Data is shared" target="ShareData"/>
<transition event="System shuts down" target="end"/>
</state>
<state id="ShareData">
<transition event="System shuts down" target="end"/>
</state>
<state id="end"/>
</scxml>

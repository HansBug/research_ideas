<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DisplayingItems"/>
</state>
<state id="DisplayingItems">
<transition event="User selects to sort by type" target="SortingByType"/>
<transition event="User exits without sorting" target="end"/>
</state>
<state id="SortingByType">
<transition event="User selects specific items within type" target="SelectingSpecificItems"/>
</state>
<state id="SelectingSpecificItems">
<transition event="Items are sorted and displayed" target="DisplayingSortedItems"/>
</state>
<state id="DisplayingSortedItems">
<transition event="User exits sorting" target="end"/>
</state>
<state id="end"/>
</scxml>

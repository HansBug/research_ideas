<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Login"/>
</state>
<state id="Login">
<transition target="NewTaskCreationForm"/>
</state>
<state id="NewTaskCreationForm">
<transition target="TaskListView"/>
</state>
<state id="TaskListView">
<transition target="CalendarView"/>
</state>
<state id="CalendarView">
<transition target="AssignRoleOrTeam"/>
</state>
<state id="AssignRoleOrTeam">
<transition target="SaveTask"/>
</state>
<state id="SaveTask">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

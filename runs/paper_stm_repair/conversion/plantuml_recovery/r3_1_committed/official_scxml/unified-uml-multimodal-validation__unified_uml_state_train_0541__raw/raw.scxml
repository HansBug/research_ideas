<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InputHobbies"/>
</state>
<state id="InputHobbies">
<transition target="GenerateRecommendations"/>
</state>
<state id="GenerateRecommendations">
<transition target="ViewRecommendations"/>
</state>
<state id="ViewRecommendations">
<transition target="AddRecommendations"/>
<transition target="SearchRecommendations"/>
<transition target="end"/>
</state>
<state id="AddRecommendations">
<transition target="ViewRecommendations"/>
</state>
<state id="SearchRecommendations">
<transition target="ViewRecommendations"/>
</state>
<state id="end"/>
</scxml>

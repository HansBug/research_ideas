<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="AddingExpense"/>
</state>
<state id="AddingExpense">
<transition event="View Breakdown" target="ViewingBreakdown"/>
<transition event="Set Recurring" target="SettingRecurring"/>
<transition event="Exit" target="end"/>
</state>
<state id="ViewingBreakdown">
<transition event="Export Data" target="ExportingData"/>
<transition event="Filter" target="FilteringExpenses"/>
<transition event="Exit" target="end"/>
</state>
<state id="SettingRecurring">
<transition event="View Breakdown" target="ViewingBreakdown"/>
<transition event="Exit" target="end"/>
</state>
<state id="end"/>
<state id="ExportingData">
<transition event="Exit" target="end"/>
</state>
<state id="FilteringExpenses">
<transition event="View Breakdown" target="ViewingBreakdown"/>
<transition event="Exit" target="end"/>
</state>
<state id="ViewingFinancialHealth">
<transition event="Exit" target="end"/>
</state>
</scxml>

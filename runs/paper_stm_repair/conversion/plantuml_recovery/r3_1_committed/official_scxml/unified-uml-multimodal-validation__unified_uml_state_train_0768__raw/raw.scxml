<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Login"/>
</state>
<state id="Login">
<transition event="Access granted" target="ProfileHub"/>
</state>
<state id="ProfileHub">
<transition event="Logout" target="end"/>
<transition event="Select profile" target="ViewProfile"/>
<transition event="Open settings" target="ManageSettings"/>
<transition event="Delete profile" target="DeleteProfile"/>
<transition event="Search" target="SearchProfiles"/>
<transition event="View activity" target="ViewActivity"/>
</state>
<state id="end"/>
<state id="ViewProfile">
<transition event="Back" target="ProfileHub"/>
</state>
<state id="ManageSettings">
<transition event="Save" target="ProfileHub"/>
<transition event="Logout" target="end"/>
</state>
<state id="DeleteProfile">
<transition event="Success" target="ProfileHub"/>
</state>
<state id="SearchProfiles">
<transition event="Profile found" target="ViewProfile"/>
<transition event="No results" target="ProfileHub"/>
</state>
<state id="ViewActivity">
<transition event="Back" target="ProfileHub"/>
</state>
</scxml>

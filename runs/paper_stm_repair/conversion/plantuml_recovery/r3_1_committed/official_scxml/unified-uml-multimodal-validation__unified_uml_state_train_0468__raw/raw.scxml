<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="Start Search" target="SearchingContent"/>
<transition event="Start Manage" target="ManagingContent"/>
</state>
<state id="SearchingContent">
<transition event="Content Found" target="ViewingContent"/>
<transition event="Refine Search" target="SearchingContent"/>
<transition event="Exit Search" target="end"/>
</state>
<state id="ViewingContent">
<transition event="Continue Managing" target="ManagingContent"/>
<transition event="Exit View" target="end"/>
</state>
<state id="end"/>
<state id="ManagingContent">
<transition event="Add New" target="AddingContent"/>
<transition event="Edit Existing" target="EditingContent"/>
<transition event="Remove Content" target="RemovingContent"/>
<transition event="View Current" target="ViewingContent"/>
</state>
<state id="AddingContent">
<transition event="Content Added" target="ManagingContent"/>
</state>
<state id="EditingContent">
<transition event="Content Updated" target="ManagingContent"/>
</state>
<state id="RemovingContent">
<transition event="Content Removed" target="ManagingContent"/>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="TaskInput"/>
</state>
<state id="TaskInput">
<transition event="Input Task Description" target="EvaluateAvailabilityAndWorkload"/>
</state>
<state id="EvaluateAvailabilityAndWorkload">
<transition event="Evaluate Availability and Workload" target="GenerateSuggestedAssignments"/>
</state>
<state id="GenerateSuggestedAssignments">
<transition event="Assign Task" target="TaskAssignment"/>
<transition event="Modify Task" target="ModifyTask"/>
<transition event="Cancel Task" target="CancelTask"/>
</state>
<state id="TaskAssignment">
<transition event="Task Assigned" target="TaskAssigned"/>
</state>
<state id="ModifyTask">
<transition event="Modify Task" target="GenerateSuggestedAssignments"/>
</state>
<state id="CancelTask">
<transition event="Cancel Task" target="TaskCanceled"/>
</state>
<state id="TaskAssigned">
<transition event="Monitor for Changes" target="MonitorForChanges"/>
</state>
<state id="TaskCanceled">
<transition event="Task Canceled" target="end"/>
</state>
<state id="MonitorForChanges">
<transition event="Event Triggers Re-evaluation" target="EvaluateAvailabilityAndWorkload"/>
<transition event="Task Completion" target="end"/>
</state>
<state id="end"/>
</scxml>

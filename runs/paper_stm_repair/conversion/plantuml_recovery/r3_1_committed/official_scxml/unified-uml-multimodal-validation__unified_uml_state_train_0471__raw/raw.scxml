<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle_State"/>
</state>
<state id="Idle_State">
<transition event="User selects location" target="Retrieving_Weather_Data"/>
<transition target="end"/>
</state>
<state id="Retrieving_Weather_Data">
<transition event="Data retrieved" target="Displaying_Weather_Data"/>
<transition event="Data retrieval fails" target="Error_State"/>
</state>
<state id="Displaying_Weather_Data">
<transition event="User saves forecast" target="Saving_Forecast"/>
<transition event="User returns to map" target="Idle_State"/>
</state>
<state id="Saving_Forecast">
<transition event="Forecast saved" target="end"/>
</state>
<state id="end"/>
<state id="Error_State">
<transition event="Error handled" target="Idle_State"/>
</state>
</scxml>

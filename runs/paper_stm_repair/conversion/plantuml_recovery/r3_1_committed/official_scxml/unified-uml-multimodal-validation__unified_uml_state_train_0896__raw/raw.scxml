<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="IdleState"/>
</state>
<state id="IdleState">
<transition event="Create New Project" target="ProjectCreation"/>
<transition event="Export Existing Tasks" target="ExportingTasks"/>
</state>
<state id="ProjectCreation">
<transition event="Assign Tasks" target="TaskAssignment"/>
</state>
<state id="TaskAssignment">
<transition event="Start Task Execution" target="TaskExecution"/>
</state>
<state id="TaskExecution">
<transition event="Complete Task" target="TaskCompletion"/>
<transition event="Continue Execution" target="TaskExecution"/>
</state>
<state id="TaskCompletion">
<transition event="Export Tasks" target="ExportingTasks"/>
</state>
<state id="ExportingTasks">
<transition event="Finish" target="end"/>
</state>
<state id="end"/>
</scxml>

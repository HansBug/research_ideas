<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Monitoring"/>
<transition target="end"/>
</state>
<state id="Monitoring">
<transition event="Arm System" target="Armed"/>
<transition event="Disarm System" target="Disarmed"/>
<transition event="Set Geofencing" target="Geofencing"/>
<transition event="View Live Footage" target="LiveView"/>
<transition event="Integrate Devices" target="Integration"/>
</state>
<state id="Armed">
<transition event="Motion Detected" target="Notification"/>
<transition event="Disarm" target="Disarmed"/>
</state>
<state id="Disarmed">
<transition event="Arm" target="Armed"/>
</state>
<state id="Geofencing">
<transition event="Boundary Breached" target="Notification"/>
</state>
<state id="LiveView">
<transition event="Exit Live View" target="Monitoring"/>
</state>
<state id="Integration">
<transition event="Complete Integration" target="end"/>
</state>
<state id="Notification">
<transition event="Clear Notification" target="end"/>
</state>
<state id="end"/>
</scxml>

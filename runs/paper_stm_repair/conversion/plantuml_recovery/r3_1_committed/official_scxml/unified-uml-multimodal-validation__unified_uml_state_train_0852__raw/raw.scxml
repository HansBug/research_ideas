<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UploadingImage"/>
</state>
<state id="UploadingImage">
<transition target="SelectingCaption"/>
</state>
<state id="SelectingCaption">
<transition event="Add Description?" target="AddingDescription"/>
<transition event="No Description" target="end"/>
</state>
<state id="AddingDescription">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="RequestPricingPlan"/>
</state>
<state id="RequestPricingPlan">
<transition event="User requests plan with student discount and bundle" target="CreatePricingPlan"/>
</state>
<state id="CreatePricingPlan">
<transition event="Apply 10% discount" target="ApplyStudentDiscount"/>
</state>
<state id="ApplyStudentDiscount">
<transition event="Create bundle with service and online course" target="CreateBundle"/>
</state>
<state id="CreateBundle">
<transition event="Set monthly cost to $450" target="SetMonthlyCost"/>
</state>
<state id="SetMonthlyCost">
<transition event="Plan created and available" target="end"/>
</state>
<state id="end"/>
</scxml>

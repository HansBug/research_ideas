<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="TaskCreated"/>
</state>
<state id="TaskCreated">
<transition event="Schedule Task" target="TaskScheduled"/>
</state>
<state id="TaskScheduled">
<transition event="Start Task" target="TaskRunning"/>
</state>
<state id="TaskRunning">
<transition event="Complete Task" target="TaskCompleted"/>
<transition event="Overdue" target="TaskOverdue"/>
</state>
<state id="TaskCompleted">
<transition target="end"/>
</state>
<state id="TaskOverdue">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

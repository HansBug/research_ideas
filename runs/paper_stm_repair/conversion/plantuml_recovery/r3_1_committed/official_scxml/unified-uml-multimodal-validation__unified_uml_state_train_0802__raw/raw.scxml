<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="Add New Expense" target="AddingExpense"/>
</state>
<state id="AddingExpense">
<transition event="Sort Expenses" target="SortingExpenses"/>
<transition event="Search for Expense" target="SearchingExpenses"/>
</state>
<state id="SortingExpenses">
<transition event="View Summary" target="ViewingSummary"/>
</state>
<state id="SearchingExpenses">
<transition event="View Summary" target="ViewingSummary"/>
</state>
<state id="ViewingSummary">
<transition event="End Process" target="end"/>
<transition event="Continue Viewing" target="ViewingSummary"/>
</state>
<state id="end"/>
</scxml>

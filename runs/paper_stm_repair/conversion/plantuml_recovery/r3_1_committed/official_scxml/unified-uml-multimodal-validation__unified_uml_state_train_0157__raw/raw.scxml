<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ContentCreated"/>
</state>
<state id="ContentCreated">
<transition event="Save" target="VersionSaved"/>
</state>
<state id="VersionSaved">
<transition event="Edit" target="ContentEdited"/>
<transition event="Revert" target="RevertedVersion"/>
<transition event="Finish" target="end"/>
</state>
<state id="ContentEdited">
<transition event="Save" target="VersionSaved"/>
</state>
<state id="RevertedVersion">
<transition event="Save" target="VersionSaved"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InputSchedule"/>
</state>
<state id="InputSchedule">
<transition target="SetReminders"/>
</state>
<state id="SetReminders">
<transition target="SynchronizeData"/>
</state>
<state id="SynchronizeData">
<transition target="ReceiveRecommendations"/>
</state>
<state id="ReceiveRecommendations">
<transition target="AccessMobile"/>
<transition target="AccessWeb"/>
</state>
<state id="AccessMobile">
<transition target="end"/>
</state>
<state id="AccessWeb">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="View Calendar" target="ViewingCalendar"/>
<transition event="Add Event" target="AddingEvent"/>
</state>
<state id="ViewingCalendar">
<transition event="Add Event" target="AddingEvent"/>
<transition event="Edit Event" target="EditingEvent"/>
<transition event="Set Reminder" target="SettingReminder"/>
<transition event="Export Data" target="ExportingData"/>
<transition event="Exit" target="end"/>
</state>
<state id="AddingEvent">
<transition event="Event Added" target="ViewingCalendar"/>
</state>
<state id="EditingEvent">
<transition event="Event Edited" target="ViewingCalendar"/>
</state>
<state id="SettingReminder">
<transition event="Reminder Set" target="ViewingCalendar"/>
</state>
<state id="ExportingData">
<transition event="Data Exported" target="end"/>
</state>
<state id="end"/>
</scxml>

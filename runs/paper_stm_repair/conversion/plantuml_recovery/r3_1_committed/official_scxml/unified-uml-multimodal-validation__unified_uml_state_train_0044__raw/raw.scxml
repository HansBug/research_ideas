<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="Start" target="UploadImage"/>
</state>
<state id="UploadImage">
<transition event="Resize" target="ResizeImage"/>
</state>
<state id="ResizeImage">
<transition event="Position" target="PositionImage"/>
</state>
<state id="PositionImage">
<transition event="Display" target="DisplayImage"/>
</state>
<state id="DisplayImage">
<transition event="Finish" target="end"/>
</state>
<state id="end"/>
</scxml>

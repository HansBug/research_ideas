<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SystemReady"/>
</state>
<state id="SystemReady">
<transition event="User saves metadata" target="SavingMetadata"/>
<transition event="User retrieves metadata" target="RetrievingMetadata"/>
<transition event="System handles multiple users/items" target="HandlingMultipleUsers"/>
<transition event="Error occurs" target="ErrorHandling"/>
<transition event="System provides feedback" target="Feedback"/>
<transition event="System shuts down" target="SystemShutdown"/>
</state>
<state id="SavingMetadata">
<transition event="Metadata saved successfully" target="SystemReady"/>
<transition event="Error during saving" target="ErrorHandling"/>
</state>
<state id="RetrievingMetadata">
<transition event="Metadata retrieved successfully" target="SystemReady"/>
<transition event="Error during retrieval" target="ErrorHandling"/>
</state>
<state id="HandlingMultipleUsers">
<transition event="Multiple users/items handled" target="SystemReady"/>
<transition event="Error during handling" target="ErrorHandling"/>
</state>
<state id="ErrorHandling">
<transition event="Error resolved" target="SystemReady"/>
</state>
<state id="Feedback">
<transition event="Feedback acknowledged" target="SystemReady"/>
<transition event="Error during feedback" target="ErrorHandling"/>
</state>
<state id="SystemShutdown">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="Upload_Initiated_2f3d32">
<transition event="User initiates file upload" target="File_Size_Check_fc1d4a"/>
</state>
<state id="File_Size_Check_fc1d4a">
<transition event="File size &lt;= 5MB" target="File_Upload_in_Progress_063524"/>
<transition event="File size &gt; 5MB" target="Prompt_for_Smaller_File_a75ee3"/>
</state>
<state id="File_Upload_in_Progress_063524">
<transition event="Upload completes successfully" target="File_Uploaded_54da68"/>
</state>
<state id="File_Uploaded_54da68">
<transition event="User views details and downloads file" target="end"/>
</state>
<state id="Prompt_for_Smaller_File_a75ee3">
<transition event="User chooses to upload smaller file" target="Upload_Initiated_2f3d32"/>
<transition event="User cancels upload" target="end"/>
</state>
<state id="start">
<transition target="Upload_Initiated_2f3d32"/>
</state>
<state id="end"/>
</scxml>

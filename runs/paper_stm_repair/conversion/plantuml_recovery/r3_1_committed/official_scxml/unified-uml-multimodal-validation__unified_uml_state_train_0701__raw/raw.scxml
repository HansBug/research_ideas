<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="Add Recipe" target="AddRecipe"/>
<transition event="View Recipe" target="ViewRecipe"/>
<transition event="Search Recipe" target="SearchRecipe"/>
</state>
<state id="AddRecipe">
<transition event="Recipe Added" target="end"/>
</state>
<state id="end"/>
<state id="ViewRecipe">
<transition event="Return" target="end"/>
<transition event="Share Recipe" target="ShareRecipe"/>
</state>
<state id="ShareRecipe">
<transition event="Sharing Complete" target="end"/>
</state>
<state id="SearchRecipe">
<transition event="Return" target="end"/>
<transition event="Select Recipe" target="ViewRecipe"/>
</state>
</scxml>

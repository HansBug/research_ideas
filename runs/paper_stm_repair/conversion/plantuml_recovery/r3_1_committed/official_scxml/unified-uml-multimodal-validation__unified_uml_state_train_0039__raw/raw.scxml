<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="CreateNewItem"/>
</state>
<state id="CreateNewItem">
<transition event="Add Item" target="AddItemToProject"/>
</state>
<state id="AddItemToProject">
<transition event="Display List" target="DisplayListView"/>
</state>
<state id="DisplayListView">
<transition event="Filter" target="FilterItems"/>
<transition event="Sort" target="SortItems"/>
<transition event="Select" target="SelectItems"/>
</state>
<state id="FilterItems"/>
<state id="SortItems"/>
<state id="SelectItems">
<transition event="Save" target="SaveItems"/>
</state>
<state id="SaveItems">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="AccessingMedicalRecords"/>
</state>
<state id="AccessingMedicalRecords">
<transition target="GeneratingReports"/>
</state>
<state id="GeneratingReports">
<transition target="GeneratingReports"/>
<transition target="ReceivingAlerts"/>
</state>
<state id="ReceivingAlerts">
<transition target="ReceivingAlerts"/>
<transition target="MakingInformedDecisions"/>
</state>
<state id="MakingInformedDecisions">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

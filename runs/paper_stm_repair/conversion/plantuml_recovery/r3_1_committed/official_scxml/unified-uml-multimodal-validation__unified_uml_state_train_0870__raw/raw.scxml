<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DefaultMenu"/>
</state>
<state id="DefaultMenu">
<transition event="Exit" target="end"/>
<transition event="Create Custom Menu" target="CreatingCustomMenu"/>
<transition event="Manage Custom Menu" target="EditingCustomMenu"/>
</state>
<state id="end"/>
<state id="CreatingCustomMenu">
<transition event="Edit Custom Menu" target="EditingCustomMenu"/>
</state>
<state id="EditingCustomMenu">
<transition event="Save and Exit" target="end"/>
</state>
</scxml>

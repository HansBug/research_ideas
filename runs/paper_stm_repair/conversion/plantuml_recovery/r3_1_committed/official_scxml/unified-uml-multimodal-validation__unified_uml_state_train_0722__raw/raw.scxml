<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="FontSelectionMenu"/>
</state>
<state id="FontSelectionMenu">
<transition event="View Current Font" target="CurrentFontDisplay"/>
<transition event="Select New Font" target="FontSwitching"/>
</state>
<state id="CurrentFontDisplay">
<transition event="Return to Menu" target="FontSelectionMenu"/>
<transition event="Finish" target="end"/>
</state>
<state id="FontSwitching">
<transition event="Font Updated" target="CurrentFontDisplay"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
<transition target="FinalState"/>
</state>
<state id="InitialState"/>
<state id="initialState">
<transition event="Select Desktop UI" target="DesktopUI"/>
<transition event="Select Mobile UI" target="MobileUI"/>
<transition event="Select Web UI" target="WebUI"/>
</state>
<state id="DesktopUI">
<transition event="Switch to Mobile UI" target="MobileUI"/>
<transition event="Switch to Web UI" target="WebUI"/>
<transition event="Exit" target="end"/>
</state>
<state id="MobileUI">
<transition event="Switch to Desktop UI" target="DesktopUI"/>
<transition event="Switch to Web UI" target="WebUI"/>
<transition event="Exit" target="end"/>
</state>
<state id="WebUI">
<transition event="Switch to Desktop UI" target="DesktopUI"/>
<transition event="Switch to Mobile UI" target="MobileUI"/>
<transition event="Exit" target="end"/>
</state>
<state id="end"/>
<state id="FinalState"/>
</scxml>

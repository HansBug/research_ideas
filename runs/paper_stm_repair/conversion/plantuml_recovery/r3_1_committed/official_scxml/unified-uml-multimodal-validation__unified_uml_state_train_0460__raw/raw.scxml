<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Initial_State"/>
</state>
<state id="Initial_State">
<transition event="Enter System" target="Viewing_Tasks_Projects"/>
</state>
<state id="Viewing_Tasks_Projects">
<transition event="Add New Task/Project" target="Adding_Task_Project"/>
<transition event="Search" target="Searching_Tasks_Projects"/>
<transition event="Navigate" target="Viewing_Tasks_Projects"/>
<transition event="Exit System" target="end"/>
</state>
<state id="Adding_Task_Project">
<transition event="Return to View" target="Viewing_Tasks_Projects"/>
</state>
<state id="Searching_Tasks_Projects">
<transition event="Return to View" target="Viewing_Tasks_Projects"/>
</state>
<state id="end"/>
</scxml>

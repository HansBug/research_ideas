<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="PreferencesInitialized"/>
</state>
<state id="PreferencesInitialized">
<transition target="PreferencesInput"/>
</state>
<state id="PreferencesInput">
<transition target="RecommendationsGenerated"/>
</state>
<state id="RecommendationsGenerated">
<transition target="end"/>
<transition target="PreferencesInput"/>
<transition target="RecommendationsGenerated"/>
<transition target="PreferencesSaved"/>
</state>
<state id="end"/>
<state id="PreferencesSaved">
<transition target="end"/>
<transition target="RecommendationsGenerated"/>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="StartPayment"/>
</state>
<state id="StartPayment">
<transition event="Select payment method" target="SelectPaymentMethod"/>
</state>
<state id="SelectPaymentMethod">
<transition event="Enter payment details" target="EnterPaymentDetails"/>
</state>
<state id="EnterPaymentDetails">
<transition event="Process payment" target="ProcessPayment"/>
</state>
<state id="ProcessPayment">
<transition event="Check payment status" target="PaymentStatus"/>
</state>
<state id="PaymentStatus">
<transition event="Payment completed" target="end"/>
<transition event="Payment failed" target="end"/>
</state>
<state id="end"/>
</scxml>

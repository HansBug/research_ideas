<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="AlertConfigurationDisabled"/>
</state>
<state id="AlertConfigurationDisabled">
<transition event="enable feature" target="AlertConfigurationEnabled"/>
</state>
<state id="AlertConfigurationEnabled">
<transition event="start monitoring" target="MonitoringThresholds"/>
<transition event="feature disabled" target="end"/>
</state>
<state id="MonitoringThresholds">
<transition event="threshold met" target="AlertTriggered"/>
<transition event="update configuration" target="AlertConfigurationUpdated"/>
<transition event="disable alert" target="AlertDisabled"/>
</state>
<state id="AlertTriggered">
<transition event="alert acknowledged" target="AlertAcknowledged"/>
</state>
<state id="AlertAcknowledged">
<transition event="resume monitoring" target="MonitoringThresholds"/>
</state>
<state id="AlertConfigurationUpdated">
<transition event="apply changes" target="MonitoringThresholds"/>
</state>
<state id="AlertDisabled">
<transition event="re-enable monitoring" target="MonitoringThresholds"/>
</state>
<state id="end"/>
</scxml>

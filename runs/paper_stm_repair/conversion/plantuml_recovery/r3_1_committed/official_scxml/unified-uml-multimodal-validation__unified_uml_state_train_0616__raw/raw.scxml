<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition event="User attempts to login" target="Login"/>
</state>
<state id="Login">
<transition event="Login successful" target="Home"/>
<transition event="Login failed" target="Login"/>
</state>
<state id="Home">
<transition event="User selects to add new contact" target="AddContact"/>
<transition event="User selects to view contacts" target="ViewContacts"/>
<transition event="User selects to filter contacts" target="FilterContacts"/>
<transition event="User selects to share contacts" target="ShareContacts"/>
<transition event="User selects to export contacts" target="ExportContacts"/>
<transition event="User selects to set reminder" target="SetReminder"/>
<transition event="User selects to logout" target="Logout"/>
</state>
<state id="AddContact">
<transition event="Contact added successfully" target="Home"/>
<transition event="Error adding contact" target="AddContact"/>
</state>
<state id="ViewContacts">
<transition event="View contacts completed" target="Home"/>
</state>
<state id="FilterContacts">
<transition event="Filter applied" target="Home"/>
</state>
<state id="ShareContacts">
<transition event="Contacts shared" target="Home"/>
</state>
<state id="ExportContacts">
<transition event="Export completed" target="Home"/>
</state>
<state id="SetReminder">
<transition event="Reminder set" target="Home"/>
</state>
<state id="Logout">
<transition event="Logout successful" target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="CreateProject"/>
</state>
<state id="CreateProject">
<transition event="when new project is created" target="AssignTasks"/>
</state>
<state id="AssignTasks">
<transition event="when tasks are assigned" target="ScheduleTasks"/>
</state>
<state id="ScheduleTasks">
<transition event="when tasks are scheduled" target="OptimizeSchedule"/>
</state>
<state id="OptimizeSchedule">
<transition event="when schedule is optimized" target="GenerateReport"/>
</state>
<state id="GenerateReport">
<transition event="when report is generated" target="end"/>
</state>
<state id="end"/>
</scxml>

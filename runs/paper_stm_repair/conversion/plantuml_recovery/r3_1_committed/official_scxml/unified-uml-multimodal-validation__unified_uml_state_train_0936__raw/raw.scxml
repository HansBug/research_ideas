<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="StartNavigation"/>
</state>
<state id="StartNavigation">
<transition event="User requests navigation" target="DisplayVisitedPlaces"/>
</state>
<state id="DisplayVisitedPlaces">
<transition event="System provides suggestions" target="ShowSuggestions"/>
</state>
<state id="ShowSuggestions">
<transition event="User navigates or exits" target="end"/>
</state>
<state id="end"/>
</scxml>

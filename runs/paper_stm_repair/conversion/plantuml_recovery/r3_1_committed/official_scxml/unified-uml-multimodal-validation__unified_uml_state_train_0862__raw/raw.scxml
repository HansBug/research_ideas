<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="AccessingTaskManager"/>
</state>
<state id="AccessingTaskManager">
<transition event="Access Task Manager" target="ManagingTasks"/>
</state>
<state id="ManagingTasks">
<transition event="Assign Team Members" target="AssigningTeamMembers"/>
<transition event="View Team Availability" target="ViewingAvailability"/>
<transition event="Create Custom Reports" target="CreatingReports"/>
<transition event="Exit Task Manager" target="end"/>
</state>
<state id="AssigningTeamMembers">
<transition event="Return to Task Management" target="ManagingTasks"/>
</state>
<state id="ViewingAvailability">
<transition event="Return to Task Management" target="ManagingTasks"/>
</state>
<state id="CreatingReports">
<transition event="Return to Task Management" target="ManagingTasks"/>
</state>
<state id="end"/>
</scxml>

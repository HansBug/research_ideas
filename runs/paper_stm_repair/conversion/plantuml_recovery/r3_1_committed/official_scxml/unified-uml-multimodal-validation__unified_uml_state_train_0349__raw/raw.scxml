<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SetupAutomation"/>
</state>
<state id="SetupAutomation">
<transition target="WaitingForTrigger"/>
</state>
<state id="WaitingForTrigger">
<transition event="trigger occurs" target="ExecutingTask"/>
</state>
<state id="ExecutingTask">
<transition event="automation completed" target="end"/>
<transition event="continue" target="WaitingForTrigger"/>
</state>
<state id="end"/>
</scxml>

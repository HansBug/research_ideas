<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="MainMenu"/>
</state>
<state id="MainMenu">
<transition event="Select Quick Search" target="QuickSearch"/>
<transition event="Select Menu Tree" target="MenuTree"/>
<transition event="Select Search" target="SearchField"/>
<transition event="Exit" target="end"/>
</state>
<state id="QuickSearch">
<transition event="Back to Menu" target="MainMenu"/>
<transition event="Exit" target="end"/>
</state>
<state id="MenuTree">
<transition event="Back to Menu" target="MainMenu"/>
<transition event="Exit" target="end"/>
</state>
<state id="SearchField">
<transition event="Back to Menu" target="MainMenu"/>
<transition event="Exit" target="end"/>
</state>
<state id="end"/>
</scxml>

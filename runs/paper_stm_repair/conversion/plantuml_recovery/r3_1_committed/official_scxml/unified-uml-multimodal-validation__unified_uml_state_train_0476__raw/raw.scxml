<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="AccessProfile"/>
</state>
<state id="AccessProfile">
<transition target="ViewProjectsOrTasks"/>
</state>
<state id="ViewProjectsOrTasks">
<transition target="EditUpdateTasks"/>
<transition target="FilterSortProjects"/>
<transition target="GenerateReports"/>
</state>
<state id="EditUpdateTasks">
<transition target="ViewProjectsOrTasks"/>
</state>
<state id="FilterSortProjects">
<transition target="ViewProjectsOrTasks"/>
</state>
<state id="GenerateReports">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="IdleState"/>
</state>
<state id="IdleState">
<transition event="User interacts" target="TaskManagementState"/>
</state>
<state id="TaskManagementState">
<transition event="Tasks suggested" target="TaskSuggestionState"/>
</state>
<state id="TaskSuggestionState">
<transition event="View personalized" target="PersonalizedViewState"/>
</state>
<state id="PersonalizedViewState">
<transition event="Integrate with apps" target="IntegrationState"/>
<transition event="Final state" target="end"/>
</state>
<state id="IntegrationState">
<transition event="Continue managing" target="TaskManagementState"/>
<transition event="More suggestions" target="TaskSuggestionState"/>
</state>
<state id="end"/>
</scxml>

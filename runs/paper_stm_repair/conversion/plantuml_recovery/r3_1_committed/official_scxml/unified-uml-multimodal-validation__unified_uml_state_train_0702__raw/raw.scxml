<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition event="User initiates segment creation" target="Creating_Customer_Segment"/>
</state>
<state id="Creating_Customer_Segment">
<transition event="System analyzes customer data" target="Analyzing_Data"/>
</state>
<state id="Analyzing_Data">
<transition event="Segment is created" target="Segment_Created"/>
</state>
<state id="Segment_Created">
<transition event="Process completes" target="end"/>
</state>
<state id="end"/>
</scxml>

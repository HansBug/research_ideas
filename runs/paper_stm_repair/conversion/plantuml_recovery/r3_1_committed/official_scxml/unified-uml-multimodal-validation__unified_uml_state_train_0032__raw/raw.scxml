<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="CreateProject"/>
</state>
<state id="CreateProject">
<transition target="AddTasks"/>
</state>
<state id="AddTasks">
<transition target="AssignTasks"/>
</state>
<state id="AssignTasks">
<transition target="TrackProgress"/>
</state>
<state id="TrackProgress">
<transition target="ViewTimeline"/>
<transition target="SearchTasks"/>
<transition target="FilterTasks"/>
<transition target="RescheduleTasks"/>
</state>
<state id="ViewTimeline">
<transition target="end"/>
</state>
<state id="SearchTasks">
<transition target="FilterTasks"/>
</state>
<state id="FilterTasks">
<transition target="ViewRelevantTasks"/>
</state>
<state id="RescheduleTasks">
<transition target="UpdateTimeline"/>
</state>
<state id="end"/>
<state id="ViewRelevantTasks">
<transition target="end"/>
</state>
<state id="UpdateTimeline">
<transition target="end"/>
</state>
</scxml>

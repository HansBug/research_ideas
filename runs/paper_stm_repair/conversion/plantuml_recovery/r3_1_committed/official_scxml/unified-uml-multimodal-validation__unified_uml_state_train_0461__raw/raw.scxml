<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="Upload Images" target="ImageUpload"/>
</state>
<state id="ImageUpload">
<transition event="Cancel Upload" target="Idle"/>
<transition event="Process Images" target="ImageProcessing"/>
</state>
<state id="ImageProcessing">
<transition event="Keywords Found" target="KeywordDetection"/>
<transition event="No Keywords" target="OutputGeneration"/>
<transition event="Processing Failed" target="ErrorHandling"/>
</state>
<state id="KeywordDetection">
<transition event="No Keywords" target="OutputGeneration"/>
<transition event="Keywords Found" target="KeywordExtraction"/>
</state>
<state id="OutputGeneration">
<transition event="Done" target="end"/>
</state>
<state id="ErrorHandling">
<transition event="Error Resolved" target="end"/>
</state>
<state id="KeywordExtraction">
<transition event="Extracted" target="OutputGeneration"/>
</state>
<state id="end"/>
</scxml>

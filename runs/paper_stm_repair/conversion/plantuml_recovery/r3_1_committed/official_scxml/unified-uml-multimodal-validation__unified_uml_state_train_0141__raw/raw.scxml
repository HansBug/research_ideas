<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DisplayPurchaseHistory"/>
</state>
<state id="DisplayPurchaseHistory">
<transition target="end"/>
<transition target="SearchResults"/>
<transition target="FilterApplied"/>
</state>
<state id="end"/>
<state id="SearchResults">
<transition target="DisplayPurchaseHistory"/>
<transition target="FilterApplied"/>
</state>
<state id="FilterApplied">
<transition target="DisplayPurchaseHistory"/>
<transition target="SearchResults"/>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InputIncomeExpenses"/>
</state>
<state id="InputIncomeExpenses">
<transition target="CategorizeExpenses"/>
</state>
<state id="CategorizeExpenses">
<transition target="ViewBudgetBreakdown"/>
</state>
<state id="ViewBudgetBreakdown">
<transition target="SetGoalsAlerts"/>
</state>
<state id="SetGoalsAlerts">
<transition target="MonitorSpending"/>
</state>
<state id="MonitorSpending">
<transition target="SendWarningNotification"/>
<transition target="SendAlertNotification"/>
</state>
<state id="SendWarningNotification">
<transition target="TransferFunds"/>
</state>
<state id="SendAlertNotification">
<transition target="TransferFunds"/>
</state>
<state id="TransferFunds">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

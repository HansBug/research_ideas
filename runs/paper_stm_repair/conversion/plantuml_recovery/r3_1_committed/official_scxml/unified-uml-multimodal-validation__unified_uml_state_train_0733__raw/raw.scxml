<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition target="MenuCreation"/>
</state>
<state id="MenuCreation">
<transition target="MenuManagement"/>
<transition target="MenuLayoutViewing"/>
</state>
<state id="MenuManagement">
<transition target="MenuLayoutViewing"/>
<transition target="MenuSaved"/>
</state>
<state id="MenuLayoutViewing">
<transition target="MenuManagement"/>
<transition target="MenuSaved"/>
</state>
<state id="MenuSaved">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

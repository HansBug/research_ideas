<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="EnteringQuery"/>
</state>
<state id="EnteringQuery">
<transition event="Submit Query" target="ProcessingQuery"/>
</state>
<state id="ProcessingQuery">
<transition event="Results Ready" target="DisplayingResults"/>
</state>
<state id="DisplayingResults">
<transition event="Exit" target="end"/>
<transition event="Filter Results" target="FilteringResults"/>
<transition event="Save Query" target="SavingQuery"/>
</state>
<state id="end"/>
<state id="FilteringResults">
<transition event="Apply Filters" target="DisplayingResults"/>
</state>
<state id="SavingQuery">
<transition event="Exit" target="end"/>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="NoSortingApplied"/>
</state>
<state id="NoSortingApplied">
<transition event="Select single criterion" target="SingleCriterionSelected"/>
<transition event="Apply no sorting" target="ResultsDisplayed"/>
</state>
<state id="SingleCriterionSelected">
<transition event="Select additional criterion" target="MultipleCriteriaSelected"/>
</state>
<state id="MultipleCriteriaSelected">
<transition event="Apply sorting" target="ResultsDisplayed"/>
</state>
<state id="ResultsDisplayed">
<transition event="Reset sorting" target="end"/>
</state>
<state id="end"/>
</scxml>

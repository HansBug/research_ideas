<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="MonitoringData"/>
</state>
<state id="MonitoringData">
<transition event="Data Change Detected" target="AnalyzingData"/>
</state>
<state id="AnalyzingData">
<transition event="Significant Event Determined" target="SendingNotification"/>
</state>
<state id="SendingNotification">
<transition event="Notification Sent" target="end"/>
</state>
<state id="end"/>
</scxml>

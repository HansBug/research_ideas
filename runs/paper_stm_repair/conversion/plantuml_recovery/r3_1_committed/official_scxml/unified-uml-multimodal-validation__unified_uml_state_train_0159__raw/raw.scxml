<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ViewBookshelf"/>
</state>
<state id="ViewBookshelf">
<transition event="Search" target="SearchBooks"/>
<transition event="Add" target="AddBook"/>
<transition event="Edit" target="EditBook"/>
<transition event="Delete" target="DeleteBook"/>
<transition event="Share" target="ShareBookshelf"/>
<transition target="end"/>
</state>
<state id="SearchBooks">
<transition event="Filter" target="FilterBooks"/>
</state>
<state id="AddBook">
<transition event="Return" target="ViewBookshelf"/>
</state>
<state id="EditBook">
<transition event="Return" target="ViewBookshelf"/>
</state>
<state id="DeleteBook">
<transition event="Return" target="ViewBookshelf"/>
</state>
<state id="ShareBookshelf">
<transition event="Return" target="ViewBookshelf"/>
</state>
<state id="FilterBooks">
<transition event="Return" target="ViewBookshelf"/>
</state>
<state id="end"/>
</scxml>

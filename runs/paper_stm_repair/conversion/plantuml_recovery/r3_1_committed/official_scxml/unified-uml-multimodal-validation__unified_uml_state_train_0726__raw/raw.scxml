<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="Create Data" target="DataCreation"/>
<transition event="Edit Data" target="DataEditing"/>
<transition event="Delete Data" target="DataDeletion"/>
<transition event="Exit" target="end"/>
</state>
<state id="DataCreation">
<transition event="Validate" target="DataValidation"/>
</state>
<state id="DataEditing">
<transition event="Validate" target="DataValidation"/>
</state>
<state id="DataDeletion">
<transition event="Validate" target="DataValidation"/>
</state>
<state id="DataValidation">
<transition event="Synchronize" target="DataSynchronization"/>
<transition event="Validation Failed" target="Idle"/>
</state>
<state id="DataSynchronization">
<transition event="Synchronization Complete" target="Idle"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DefaultUI"/>
</state>
<state id="DefaultUI">
<transition event="Customize Layout" target="LayoutCustomization"/>
<transition event="Customize Color Scheme" target="ColorSchemeCustomization"/>
<transition event="Customize Font Style" target="FontStyleCustomization"/>
<transition event="Add Custom Icons" target="IconCustomization"/>
</state>
<state id="LayoutCustomization">
<transition target="CustomizedUI"/>
</state>
<state id="ColorSchemeCustomization">
<transition target="CustomizedUI"/>
</state>
<state id="FontStyleCustomization">
<transition target="CustomizedUI"/>
</state>
<state id="IconCustomization">
<transition target="CustomizedUI"/>
</state>
<state id="CustomizedUI">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

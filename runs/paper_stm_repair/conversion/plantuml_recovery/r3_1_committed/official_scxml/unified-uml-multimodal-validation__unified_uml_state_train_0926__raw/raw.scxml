<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition target="CheckContentAvailability"/>
</state>
<state id="CheckContentAvailability">
<transition event="Content is available" target="ContentAvailable"/>
<transition event="Content is not available" target="ContentNotAvailable"/>
</state>
<state id="ContentAvailable">
<transition target="DisplayLatestContent"/>
</state>
<state id="ContentNotAvailable">
<transition target="ShowNotAvailableMessage"/>
</state>
<state id="DisplayLatestContent">
<transition event="End" target="end"/>
</state>
<state id="ShowNotAvailableMessage">
<transition event="End" target="end"/>
</state>
<state id="end"/>
</scxml>

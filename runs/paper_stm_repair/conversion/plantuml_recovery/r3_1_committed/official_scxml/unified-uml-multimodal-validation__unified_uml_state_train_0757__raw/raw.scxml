<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitiateSearch"/>
</state>
<state id="InitiateSearch">
<transition target="AggregateResults"/>
</state>
<state id="AggregateResults">
<transition target="DisplayResults"/>
</state>
<state id="DisplayResults">
<transition target="end"/>
<transition target="SaveFilterResults"/>
<transition target="RequestRecommendations"/>
<transition target="RealTimeUpdates"/>
</state>
<state id="end"/>
<state id="SaveFilterResults">
<transition target="DisplayResults"/>
</state>
<state id="RequestRecommendations">
<transition target="GenerateRecommendations"/>
</state>
<state id="GenerateRecommendations">
<transition target="DisplayResults"/>
</state>
<state id="RealTimeUpdates">
<transition target="DisplayResults"/>
</state>
</scxml>

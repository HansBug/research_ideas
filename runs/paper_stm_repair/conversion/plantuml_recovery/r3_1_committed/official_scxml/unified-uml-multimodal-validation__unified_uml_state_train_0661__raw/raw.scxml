<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="TaskList"/>
</state>
<state id="TaskList">
<transition target="end"/>
<transition target="InProgress"/>
</state>
<state id="end"/>
<state id="InProgress">
<transition target="Completed"/>
</state>
<state id="Completed">
<transition target="end"/>
</state>
</scxml>

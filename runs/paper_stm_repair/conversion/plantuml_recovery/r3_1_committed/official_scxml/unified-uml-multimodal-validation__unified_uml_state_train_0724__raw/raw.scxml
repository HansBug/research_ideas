<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ViewingInventory"/>
</state>
<state id="ViewingInventory">
<transition event="Analyze Sales Data" target="AnalyzingSalesData"/>
<transition event="Track Production/Deliveries" target="TrackingProduction"/>
<transition event="Exit System" target="end"/>
</state>
<state id="AnalyzingSalesData">
<transition event="Identify Trends/Patterns" target="TriggeringAlerts"/>
</state>
<state id="TrackingProduction">
<transition event="Check Deliveries" target="TriggeringAlerts"/>
</state>
<state id="TriggeringAlerts">
<transition event="Inventory Low" target="HandlingLowInventory"/>
<transition event="No Issues" target="end"/>
</state>
<state id="HandlingLowInventory">
<transition event="Reorder Needed" target="ReorderingInventory"/>
<transition event="Inventory Adequate" target="end"/>
</state>
<state id="end"/>
<state id="ReorderingInventory">
<transition event="Contact Suppliers" target="ResolvingIssues"/>
<transition event="Reorder Completed" target="end"/>
</state>
<state id="ResolvingIssues">
<transition event="Issue Resolved" target="end"/>
</state>
</scxml>

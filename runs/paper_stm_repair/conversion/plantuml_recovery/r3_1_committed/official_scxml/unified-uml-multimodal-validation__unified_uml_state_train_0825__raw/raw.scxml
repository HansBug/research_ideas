<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ProjectInProgress"/>
</state>
<state id="ProjectInProgress">
<transition event="Project Completed" target="end"/>
<transition event="Set Completion Date" target="ProjectInProgress"/>
</state>
<state id="end"/>
</scxml>

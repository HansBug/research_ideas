<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ViewingTasks"/>
<transition target="AddingNewTask"/>
<transition target="SearchingForTask"/>
<transition target="Exiting"/>
</state>
<state id="ViewingTasks">
<transition target="AddingNewTask"/>
<transition target="SearchingForTask"/>
<transition target="Exiting"/>
</state>
<state id="AddingNewTask">
<transition target="end"/>
<transition target="end"/>
</state>
<state id="SearchingForTask">
<transition target="end"/>
<transition target="end"/>
</state>
<state id="Exiting">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

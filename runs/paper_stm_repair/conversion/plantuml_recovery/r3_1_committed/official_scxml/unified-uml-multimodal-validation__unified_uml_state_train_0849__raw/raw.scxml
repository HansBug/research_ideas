<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition event="User initiates workspace creation" target="CreateWorkspace"/>
</state>
<state id="CreateWorkspace">
<transition event="Workspace created, organize tasks" target="OrganizeTasks"/>
<transition event="Share workspace with others" target="ShareWorkspace"/>
<transition event="Begin collaboration" target="Collaborate"/>
</state>
<state id="OrganizeTasks">
<transition event="Tasks organized, track progress" target="TrackProgress"/>
<transition event="Organizing tasks completed, exit" target="end"/>
</state>
<state id="ShareWorkspace">
<transition event="Workspace shared, collaborate" target="Collaborate"/>
<transition event="Sharing completed, exit" target="end"/>
</state>
<state id="Collaborate">
<transition event="Continue organizing tasks" target="OrganizeTasks"/>
<transition event="Track progress during collaboration" target="TrackProgress"/>
<transition event="Collaboration completed, exit" target="end"/>
</state>
<state id="TrackProgress">
<transition event="Progress tracked, exit system" target="end"/>
</state>
<state id="end"/>
</scxml>

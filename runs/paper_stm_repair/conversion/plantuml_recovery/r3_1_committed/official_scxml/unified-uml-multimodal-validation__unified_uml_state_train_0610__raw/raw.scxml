<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="AddItems"/>
</state>
<state id="AddItems">
<transition target="OrganizeItems"/>
</state>
<state id="OrganizeItems">
<transition target="SearchItems"/>
</state>
<state id="SearchItems">
<transition target="ViewWardrobe"/>
</state>
<state id="ViewWardrobe">
<transition target="EditItems"/>
</state>
<state id="EditItems">
<transition target="ExportData"/>
</state>
<state id="ExportData">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

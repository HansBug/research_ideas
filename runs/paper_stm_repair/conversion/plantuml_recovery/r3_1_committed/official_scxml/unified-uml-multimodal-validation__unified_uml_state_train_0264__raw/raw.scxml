<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ReadyForFeedback"/>
</state>
<state id="ReadyForFeedback">
<transition event="User provides feedback" target="ProcessingFeedback"/>
</state>
<state id="ProcessingFeedback">
<transition event="System processes feedback" target="VerifyingData"/>
</state>
<state id="VerifyingData">
<transition event="Verification successful" target="end"/>
<transition event="Verification failed" target="ErrorHandling"/>
</state>
<state id="end"/>
<state id="ErrorHandling">
<transition event="Error resolved" target="ReadyForFeedback"/>
</state>
</scxml>

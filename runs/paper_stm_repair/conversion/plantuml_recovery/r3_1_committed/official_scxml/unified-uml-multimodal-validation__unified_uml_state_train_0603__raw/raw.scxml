<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectHotelLocation"/>
</state>
<state id="SelectHotelLocation">
<transition event="User inputs attraction preferences" target="InputAttractionPreferences"/>
</state>
<state id="InputAttractionPreferences">
<transition event="System calculates shortest route" target="CalculateOptimalRoute"/>
</state>
<state id="CalculateOptimalRoute">
<transition event="Show route options to user" target="DisplayRouteOptions"/>
</state>
<state id="DisplayRouteOptions">
<transition event="User selects route for day trip" target="PlanDayTrip"/>
</state>
<state id="PlanDayTrip">
<transition event="End of planning process" target="end"/>
</state>
<state id="end"/>
</scxml>

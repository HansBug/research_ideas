<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="VersionA"/>
</state>
<state id="VersionA">
<transition event="Switch" target="VersionB"/>
<transition event="Test" target="Testing"/>
</state>
<state id="VersionB">
<transition event="Switch" target="VersionA"/>
<transition event="Test" target="Testing"/>
</state>
<state id="Testing">
<transition event="Back" target="VersionA"/>
<transition event="Back" target="VersionB"/>
<transition event="Done" target="end"/>
</state>
<state id="end"/>
</scxml>

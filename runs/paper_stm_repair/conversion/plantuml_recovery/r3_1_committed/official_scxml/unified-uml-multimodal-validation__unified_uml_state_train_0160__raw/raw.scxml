<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="IdleState"/>
</state>
<state id="IdleState">
<transition event="Item Movement Request" target="ProcessingRulesState"/>
<transition target="end"/>
</state>
<state id="ProcessingRulesState">
<transition event="Rules Evaluation" target="ItemMovedState"/>
<transition event="Rules Evaluation" target="ItemNotMovedState"/>
</state>
<state id="ItemMovedState">
<transition event="Movement Completed" target="IdleState"/>
</state>
<state id="ItemNotMovedState">
<transition event="Movement Denied" target="IdleState"/>
</state>
<state id="end"/>
</scxml>

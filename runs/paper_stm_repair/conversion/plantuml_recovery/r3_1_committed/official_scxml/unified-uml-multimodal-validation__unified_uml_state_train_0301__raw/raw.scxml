<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Initial_State"/>
</state>
<state id="Initial_State">
<transition target="View_Tasks"/>
<transition target="Set_Reminders"/>
<transition target="Search_Tasks"/>
<transition target="Get_Suggestions"/>
<transition target="Access_Resources"/>
</state>
<state id="View_Tasks">
<transition target="Continue_Using"/>
<transition target="Exit"/>
</state>
<state id="Set_Reminders">
<transition target="Continue_Using"/>
<transition target="Exit"/>
</state>
<state id="Search_Tasks">
<transition target="Continue_Using"/>
<transition target="Exit"/>
</state>
<state id="Get_Suggestions">
<transition target="Continue_Using"/>
<transition target="Exit"/>
</state>
<state id="Access_Resources">
<transition target="Continue_Using"/>
<transition target="Exit"/>
</state>
<state id="Continue_Using">
<transition target="Initial_State"/>
</state>
<state id="Exit">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

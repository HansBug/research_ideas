<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Login"/>
</state>
<state id="Login">
<transition event="Logout" target="end"/>
<transition event="Success" target="MainMenu"/>
</state>
<state id="end"/>
<state id="MainMenu">
<transition event="Add Item" target="AddItem"/>
<transition event="Edit Item" target="EditItem"/>
<transition event="Delete Item" target="DeleteItem"/>
<transition event="Search" target="SearchItem"/>
<transition event="View All" target="ViewWardrobe"/>
<transition event="Add Note" target="AddNote"/>
<transition event="Share" target="ShareWardrobe"/>
</state>
<state id="AddItem">
<transition event="Done" target="MainMenu"/>
</state>
<state id="EditItem">
<transition event="Done" target="MainMenu"/>
</state>
<state id="DeleteItem">
<transition event="Done" target="MainMenu"/>
</state>
<state id="SearchItem">
<transition event="Display" target="ViewResults"/>
</state>
<state id="ViewWardrobe">
<transition event="Back" target="MainMenu"/>
</state>
<state id="AddNote">
<transition event="Done" target="MainMenu"/>
</state>
<state id="ShareWardrobe">
<transition event="Done" target="MainMenu"/>
</state>
<state id="ViewResults">
<transition event="Back" target="MainMenu"/>
</state>
</scxml>

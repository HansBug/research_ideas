<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Login"/>
</state>
<state id="Login">
<transition event="Exit" target="end"/>
<transition event="Login Success" target="Bookshelf"/>
<transition event="Login Failure" target="Login"/>
</state>
<state id="end"/>
<state id="Bookshelf">
<transition event="Logout" target="Login"/>
<transition event="View Books" target="Bookshelf"/>
<transition event="Add Book" target="Bookshelf"/>
<transition event="Edit Book" target="Bookshelf"/>
<transition event="Delete Book" target="Bookshelf"/>
<transition event="Search Books" target="Bookshelf"/>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="TaskCreated"/>
</state>
<state id="TaskCreated">
<transition event="Start Work" target="InProgress"/>
<transition event="Pause" target="OnHold"/>
</state>
<state id="InProgress">
<transition event="Pause" target="OnHold"/>
<transition event="Deadline Near" target="DeadlineApproaching"/>
<transition event="Finish" target="Completed"/>
<transition event="Miss Deadline" target="Overdue"/>
</state>
<state id="OnHold">
<transition event="Resume" target="InProgress"/>
<transition event="Finish" target="Completed"/>
<transition event="Miss Deadline" target="Overdue"/>
</state>
<state id="DeadlineApproaching">
<transition event="Finish" target="Completed"/>
<transition event="Miss Deadline" target="Overdue"/>
</state>
<state id="Completed">
<transition event="Done" target="end"/>
</state>
<state id="Overdue">
<transition event="Overdue" target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ControlSmartHomeDevices"/>
</state>
<state id="ControlSmartHomeDevices">
<transition target="end"/>
<transition target="CreateCustomScene"/>
<transition target="SetUpCustomRoutines"/>
<transition target="ViewDashboard"/>
<transition target="ReceiveNotifications"/>
</state>
<state id="end"/>
<state id="CreateCustomScene">
<transition target="SetReminders"/>
</state>
<state id="SetReminders">
<transition target="ControlSmartHomeDevices"/>
</state>
<state id="SetUpCustomRoutines">
<transition target="AutomateTasks"/>
</state>
<state id="AutomateTasks">
<transition target="ControlSmartHomeDevices"/>
</state>
<state id="ViewDashboard">
<transition target="DisplayDeviceStatus"/>
</state>
<state id="DisplayDeviceStatus">
<transition target="ControlSmartHomeDevices"/>
</state>
<state id="ReceiveNotifications">
<transition target="UpdateDeviceStatus"/>
</state>
<state id="UpdateDeviceStatus">
<transition target="ControlSmartHomeDevices"/>
</state>
</scxml>

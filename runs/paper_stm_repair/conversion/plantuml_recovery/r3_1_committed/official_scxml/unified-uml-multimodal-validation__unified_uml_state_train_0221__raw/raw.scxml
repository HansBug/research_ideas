<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="CreateNewTask"/>
</state>
<state id="CreateNewTask">
<transition target="AnalyzeTaskRequirements"/>
</state>
<state id="AnalyzeTaskRequirements">
<transition target="AssignTask"/>
</state>
<state id="AssignTask">
<transition target="ViewAssignedTask"/>
</state>
<state id="ViewAssignedTask">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

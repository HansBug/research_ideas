<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Initial"/>
</state>
<state id="Initial">
<transition event="Reminder Set" target="Reminder"/>
<transition event="Task Created" target="Pending"/>
</state>
<state id="Reminder">
<transition event="Due Date Approached" target="Due"/>
</state>
<state id="Due">
<transition event="Task Completed" target="end"/>
</state>
<state id="end"/>
<state id="Pending">
<transition event="Reminder Time Reached" target="Reminder"/>
<transition event="Due Date Reached" target="Due"/>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="AccessingProfile"/>
</state>
<state id="AccessingProfile">
<transition event="View Profile" target="ViewingProfile"/>
<transition event="Edit Profile" target="EditingProfile"/>
</state>
<state id="ViewingProfile">
<transition event="Edit Profile" target="EditingProfile"/>
</state>
<state id="EditingProfile">
<transition event="Save Changes" target="ProfileUpdated"/>
<transition event="Discard Changes" target="DiscardedChanges"/>
</state>
<state id="ProfileUpdated">
<transition event="Exit" target="end"/>
</state>
<state id="DiscardedChanges">
<transition event="Exit" target="end"/>
</state>
<state id="end"/>
</scxml>

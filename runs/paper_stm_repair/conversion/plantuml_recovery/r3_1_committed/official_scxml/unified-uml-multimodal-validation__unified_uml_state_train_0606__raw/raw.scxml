<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ApplicationRunning"/>
</state>
<state id="ApplicationRunning">
<transition event="Add Recipe" target="AddingRecipe"/>
<transition event="Edit Recipe" target="EditingRecipe"/>
<transition event="Delete Recipe" target="DeletingRecipe"/>
<transition event="Search Recipes" target="SearchingRecipes"/>
<transition event="Exit" target="end"/>
</state>
<state id="AddingRecipe">
<transition event="Recipe Added" target="RecipeAdded"/>
</state>
<state id="RecipeAdded">
<transition event="Return to Application" target="ApplicationRunning"/>
</state>
<state id="EditingRecipe">
<transition event="Recipe Edited" target="RecipeEdited"/>
</state>
<state id="RecipeEdited">
<transition event="Return to Application" target="ApplicationRunning"/>
</state>
<state id="DeletingRecipe">
<transition event="Recipe Deleted" target="RecipeDeleted"/>
</state>
<state id="RecipeDeleted">
<transition event="Return to Application" target="ApplicationRunning"/>
</state>
<state id="SearchingRecipes">
<transition event="Search Results Displayed" target="SearchResultsDisplayed"/>
</state>
<state id="SearchResultsDisplayed">
<transition event="Return to Application" target="ApplicationRunning"/>
</state>
<state id="end"/>
</scxml>

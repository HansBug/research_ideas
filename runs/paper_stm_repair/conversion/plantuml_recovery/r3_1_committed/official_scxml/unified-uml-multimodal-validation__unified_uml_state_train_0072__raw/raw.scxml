<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InputtingLocations"/>
</state>
<state id="InputtingLocations">
<transition event="Input start and end points" target="ProcessingRequest"/>
</state>
<state id="ProcessingRequest">
<transition event="Process request" target="DisplayingOptions"/>
</state>
<state id="DisplayingOptions">
<transition event="Display options" target="SelectingOption"/>
<transition event="Save favorite options" target="SavingFavorites"/>
</state>
<state id="SelectingOption">
<transition event="Select option" target="BookingTrip"/>
</state>
<state id="SavingFavorites">
<transition event="Monitor trip" target="MonitoringTrip"/>
</state>
<state id="BookingTrip">
<transition event="Book trip" target="ProvidingUpdates"/>
</state>
<state id="ProvidingUpdates">
<transition event="Provide updates" target="end"/>
</state>
<state id="end"/>
<state id="MonitoringTrip">
<transition event="Send notifications" target="end"/>
</state>
</scxml>

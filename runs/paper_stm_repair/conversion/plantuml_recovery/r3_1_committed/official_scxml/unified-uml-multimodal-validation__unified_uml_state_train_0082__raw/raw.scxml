<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectingTask"/>
</state>
<state id="SelectingTask">
<transition target="CheckingAvailability"/>
</state>
<state id="CheckingAvailability">
<transition target="AssigningTask"/>
</state>
<state id="AssigningTask">
<transition target="UpdatingTaskList"/>
</state>
<state id="UpdatingTaskList">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

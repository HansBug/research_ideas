<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="Trigger to generate report" target="ProcessingData"/>
</state>
<state id="ProcessingData">
<transition event="Data processed successfully" target="FormattingReport"/>
<transition event="Error during processing" target="ErrorHandling"/>
</state>
<state id="FormattingReport">
<transition event="Report formatted successfully" target="GeneratingReport"/>
</state>
<state id="ErrorHandling">
<transition event="Error handled" target="end"/>
</state>
<state id="GeneratingReport">
<transition event="Report generated" target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectingRestaurant"/>
</state>
<state id="SelectingRestaurant">
<transition target="SelectingDishes"/>
</state>
<state id="SelectingDishes">
<transition target="PlacingOrder"/>
</state>
<state id="PlacingOrder">
<transition target="GeneratingShoppingList"/>
</state>
<state id="GeneratingShoppingList">
<transition target="SendingConfirmationEmail"/>
</state>
<state id="SendingConfirmationEmail">
<transition target="PrintingOrSavingList"/>
</state>
<state id="PrintingOrSavingList">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

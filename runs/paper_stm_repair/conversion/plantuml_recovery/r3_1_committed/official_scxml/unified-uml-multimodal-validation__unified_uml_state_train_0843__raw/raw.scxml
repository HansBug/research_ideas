<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="Add New User" target="AddingUser"/>
<transition event="Edit Existing User" target="EditingUser"/>
<transition event="Delete User" target="DeletingUser"/>
<transition event="View Profile" target="ViewingProfile"/>
<transition event="Logout" target="end"/>
</state>
<state id="AddingUser">
<transition event="Cancel" target="Idle"/>
<transition event="Add and View" target="ViewingProfile"/>
<transition event="Complete" target="end"/>
</state>
<state id="EditingUser">
<transition event="Cancel" target="Idle"/>
<transition event="Edit and View" target="ViewingProfile"/>
<transition event="Complete" target="end"/>
</state>
<state id="DeletingUser">
<transition event="Cancel" target="Idle"/>
<transition event="Delete" target="end"/>
</state>
<state id="ViewingProfile">
<transition event="Back" target="Idle"/>
<transition event="Edit" target="EditingUser"/>
<transition event="Delete" target="DeletingUser"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="CreateProject"/>
</state>
<state id="CreateProject">
<transition target="ManageProjects"/>
<transition target="end"/>
</state>
<state id="ManageProjects">
<transition target="AssignTasks"/>
<transition target="end"/>
</state>
<state id="AssignTasks">
<transition target="TrackProgress"/>
<transition target="end"/>
</state>
<state id="TrackProgress">
<transition target="SetReminders"/>
<transition target="end"/>
</state>
<state id="SetReminders">
<transition target="AccessDocuments"/>
<transition target="end"/>
</state>
<state id="AccessDocuments">
<transition target="ViewDashboard"/>
<transition target="end"/>
</state>
<state id="ViewDashboard">
<transition target="GenerateReports"/>
<transition target="end"/>
</state>
<state id="GenerateReports">
<transition target="end"/>
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

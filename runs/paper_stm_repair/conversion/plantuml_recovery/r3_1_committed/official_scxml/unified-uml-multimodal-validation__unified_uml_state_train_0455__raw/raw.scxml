<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="View Recommendations" target="ViewingRecommendations"/>
<transition event="Manage Family Members" target="ManagingFamilyMembers"/>
</state>
<state id="ViewingRecommendations">
<transition event="Return to Start" target="end"/>
<transition event="Manage Family Members" target="ManagingFamilyMembers"/>
</state>
<state id="ManagingFamilyMembers">
<transition event="Return to Start" target="end"/>
<transition event="View Recommendations" target="ViewingRecommendations"/>
</state>
<state id="end">
<transition target="EndState"/>
</state>
<state id="EndState"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DisplayVersionList"/>
</state>
<state id="DisplayVersionList">
<transition event="Cancel" target="end"/>
<transition event="Select Version" target="VersionSelected"/>
</state>
<state id="end"/>
<state id="VersionSelected">
<transition event="Switch Again" target="DisplayVersionList"/>
<transition event="Version Switched" target="end"/>
</state>
</scxml>

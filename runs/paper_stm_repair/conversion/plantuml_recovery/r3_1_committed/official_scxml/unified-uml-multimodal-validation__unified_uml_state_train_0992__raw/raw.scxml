<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="addProfile" target="AddingProfile"/>
<transition event="editProfile" target="EditingProfile"/>
<transition event="deleteProfile" target="DeletingProfile"/>
<transition event="viewProfile" target="ViewingProfile"/>
</state>
<state id="AddingProfile">
<transition event="complete" target="ProfileAdded"/>
</state>
<state id="ProfileAdded">
<transition target="end"/>
</state>
<state id="end"/>
<state id="EditingProfile">
<transition event="complete" target="ProfileUpdated"/>
</state>
<state id="ProfileUpdated">
<transition target="end"/>
</state>
<state id="DeletingProfile">
<transition event="complete" target="ProfileDeleted"/>
</state>
<state id="ProfileDeleted">
<transition target="end"/>
</state>
<state id="ViewingProfile">
<transition event="close" target="end"/>
</state>
</scxml>

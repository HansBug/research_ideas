<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="LanguageSelection"/>
</state>
<state id="LanguageSelection">
<transition target="TextInput"/>
</state>
<state id="TextInput">
<transition target="TranslationProcessing"/>
</state>
<state id="TranslationProcessing">
<transition target="TranslatedTextOutput"/>
</state>
<state id="TranslatedTextOutput">
<transition target="DetermineContext"/>
</state>
<state id="DetermineContext">
<transition target="3DAudioMapOutput"/>
<transition target="VisualMapOutput"/>
</state>
<state id="3DAudioMapOutput">
<transition target="AssistanceRequest"/>
</state>
<state id="VisualMapOutput">
<transition target="AssistanceRequest"/>
</state>
<state id="AssistanceRequest">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

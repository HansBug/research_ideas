<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SettingUpPreferences"/>
</state>
<state id="SettingUpPreferences">
<transition target="MonitoringDevices"/>
</state>
<state id="MonitoringDevices">
<transition target="end"/>
<transition target="ReceivingNotifications"/>
</state>
<state id="end"/>
<state id="ReceivingNotifications">
<transition target="end"/>
<transition target="ViewingDeviceStatus"/>
</state>
<state id="ViewingDeviceStatus">
<transition target="end"/>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="CreateTask"/>
</state>
<state id="CreateTask">
<transition target="ViewTask"/>
</state>
<state id="ViewTask">
<transition target="end"/>
<transition target="UpdateTask"/>
</state>
<state id="end"/>
<state id="UpdateTask">
<transition target="ViewTask"/>
</state>
</scxml>

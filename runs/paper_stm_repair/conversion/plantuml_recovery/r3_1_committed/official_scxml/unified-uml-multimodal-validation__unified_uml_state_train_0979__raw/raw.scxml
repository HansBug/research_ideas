<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="AppOpened"/>
</state>
<state id="AppOpened">
<transition event="Open App" target="DisplayReadingList"/>
</state>
<state id="DisplayReadingList">
<transition event="Select Book" target="ViewBookDetails"/>
</state>
<state id="ViewBookDetails">
<transition event="Press Recommendations Button" target="GenerateRecommendations"/>
</state>
<state id="GenerateRecommendations">
<transition event="Analyze and Generate" target="DisplayRecommendations"/>
</state>
<state id="DisplayRecommendations">
<transition event="Display Recommendations" target="end"/>
</state>
<state id="end"/>
</scxml>

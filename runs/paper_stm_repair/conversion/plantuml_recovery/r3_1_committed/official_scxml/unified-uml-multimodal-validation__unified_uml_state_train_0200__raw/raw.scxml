<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ReadyForQuery"/>
</state>
<state id="ReadyForQuery">
<transition event="User inputs query" target="ProcessingQuery"/>
</state>
<state id="ProcessingQuery">
<transition event="Search multiple sources" target="AggregatingResults"/>
</state>
<state id="AggregatingResults">
<transition event="Results ready" target="DisplayingResults"/>
</state>
<state id="DisplayingResults">
<transition event="Results displayed" target="end"/>
</state>
<state id="end"/>
</scxml>

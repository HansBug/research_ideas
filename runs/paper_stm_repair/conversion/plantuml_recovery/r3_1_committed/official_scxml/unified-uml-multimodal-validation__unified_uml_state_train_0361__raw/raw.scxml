<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UserInput"/>
</state>
<state id="UserInput">
<transition target="DataCollection"/>
</state>
<state id="DataCollection">
<transition target="RecommendationProcessing"/>
</state>
<state id="RecommendationProcessing">
<transition target="RecommendationDisplay"/>
</state>
<state id="RecommendationDisplay">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

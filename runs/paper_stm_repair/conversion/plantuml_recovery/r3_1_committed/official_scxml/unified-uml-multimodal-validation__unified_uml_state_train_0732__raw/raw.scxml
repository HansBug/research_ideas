<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InputPreferences"/>
</state>
<state id="InputPreferences">
<transition event="Submit preferences" target="AnalyzePreferencesHistory"/>
</state>
<state id="AnalyzePreferencesHistory">
<transition event="Process data" target="GenerateRecommendations"/>
</state>
<state id="GenerateRecommendations">
<transition event="Display recommendations" target="ViewRecommendations"/>
</state>
<state id="ViewRecommendations">
<transition event="Exit" target="end"/>
<transition event="Refine preferences or continue" target="InputPreferences"/>
<transition event="Share recommendations" target="ShareRecommendations"/>
</state>
<state id="end"/>
<state id="ShareRecommendations">
<transition event="Continue" target="ViewRecommendations"/>
<transition event="Exit" target="end"/>
</state>
</scxml>

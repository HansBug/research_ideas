<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="TaskList_View"/>
</state>
<state id="TaskList_View">
<transition event="Exit" target="end"/>
<transition event="Create New Task" target="CreateTask"/>
<transition event="View in Calendar" target="CalendarView"/>
</state>
<state id="end"/>
<state id="CreateTask">
<transition event="Save Task" target="TaskList_View"/>
<transition event="Cancel" target="TaskList_View"/>
</state>
<state id="CalendarView">
<transition event="Return to List" target="TaskList_View"/>
</state>
</scxml>

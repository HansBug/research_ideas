<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="HomeScreen"/>
</state>
<state id="HomeScreen">
<transition event="No action" target="HomeScreen"/>
<transition event="Button pressed" target="PostingContent"/>
</state>
<state id="PostingContent">
<transition event="Prepare content" target="ContentPreparation"/>
</state>
<state id="ContentPreparation">
<transition event="Review and confirm" target="PostingConfirmation"/>
</state>
<state id="PostingConfirmation">
<transition event="Post to social media" target="IntegrationComplete"/>
</state>
<state id="IntegrationComplete">
<transition event="Integration complete" target="end"/>
</state>
<state id="end"/>
</scxml>

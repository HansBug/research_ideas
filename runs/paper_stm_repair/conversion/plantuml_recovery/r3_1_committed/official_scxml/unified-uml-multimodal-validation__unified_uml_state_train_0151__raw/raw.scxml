<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectCity"/>
</state>
<state id="SelectCity">
<transition event="Add/Edit/Remove Places" target="AddEditRemovePlaces"/>
<transition event="Cancel" target="end"/>
</state>
<state id="AddEditRemovePlaces">
<transition event="Generate Suggestions" target="GenerateSuggestions"/>
<transition event="Review Itinerary" target="ReviewItinerary"/>
<transition event="Back to Select City" target="SelectCity"/>
</state>
<state id="GenerateSuggestions">
<transition event="Review Itinerary" target="ReviewItinerary"/>
</state>
<state id="ReviewItinerary">
<transition event="Share Itinerary" target="ShareItinerary"/>
</state>
<state id="ShareItinerary">
<transition event="End" target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DetectingState"/>
</state>
<state id="DetectingState">
<transition event="Frontend Collision or Rear-end Collision or Collision with Pedestrian detected" target="ActiveState"/>
</state>
<state id="ActiveState">
<state id="startActiveState">
<transition target="BrakeControlState"/>
<transition target="SteeringControlState"/>
<transition target="SensorControlState"/>
</state>
<state id="BrakeControlState">
<transition event="Signal Feedback Sent" target="InitialState"/>
</state>
<state id="SteeringControlState">
<transition event="Signal Feedback Sent" target="InitialState"/>
</state>
<state id="SensorControlState">
<transition event="Signal Feedback Sent" target="InitialState"/>
</state>
<state id="InitialState">
<transition event="No Collision detected" target="DetectingState"/>
</state>
</state>
</scxml>

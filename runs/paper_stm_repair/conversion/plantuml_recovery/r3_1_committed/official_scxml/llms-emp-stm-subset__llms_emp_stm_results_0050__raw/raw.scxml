<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="Power On" target="HumanDrivingMode"/>
</state>
<state id="end"/>
<state id="HumanDrivingMode">
<transition event="[front_distance &gt; 10]" target="AutonomousMode"/>
<transition event="Power Off" target="end"/>
</state>
<state id="AutonomousMode">
<transition event="human steering cmd" target="HumanDrivingMode"/>
<transition event="Power Off" target="end"/>
<state id="startAutonomousMode">
<transition target="SubState1"/>
</state>
<state id="SubState1">
<transition target="SubState2"/>
</state>
<state id="SubState2">
<transition target="SubState3"/>
</state>
<state id="SubState3">
<transition target="endAutonomousMode"/>
</state>
<state id="endAutonomousMode"/>
</state>
</scxml>

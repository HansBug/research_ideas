<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ContentCreation"/>
</state>
<state id="ContentCreation">
<transition target="ContentOrganization"/>
</state>
<state id="ContentOrganization">
<transition target="TaggingAndKeywording"/>
</state>
<state id="TaggingAndKeywording">
<transition target="ContentAnalysis"/>
</state>
<state id="ContentAnalysis">
<transition target="ContentAccess"/>
</state>
<state id="ContentAccess">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Initial_State"/>
</state>
<state id="Initial_State">
<transition event="Add Item" target="Add_Item"/>
<transition event="Manage Items" target="Manage_Items"/>
</state>
<state id="Add_Item">
<transition event="Return to Start" target="Initial_State"/>
<transition event="Proceed to Manage" target="Manage_Items"/>
</state>
<state id="Manage_Items">
<transition event="View Items" target="View_Items"/>
<transition event="Organize Items" target="Organize_Items"/>
<transition event="Remove Item" target="Remove_Item"/>
<transition event="Exit System" target="end"/>
</state>
<state id="View_Items">
<transition event="Organize Items" target="Organize_Items"/>
<transition event="Remove Item" target="Remove_Item"/>
<transition event="Return to Start" target="Initial_State"/>
</state>
<state id="Organize_Items">
<transition event="Continue Managing" target="Manage_Items"/>
<transition event="Return to Start" target="Initial_State"/>
</state>
<state id="Remove_Item">
<transition event="Continue Managing" target="Manage_Items"/>
<transition event="Return to Start" target="Initial_State"/>
</state>
<state id="end"/>
</scxml>

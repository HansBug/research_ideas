<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DisplayList"/>
</state>
<state id="DisplayList">
<transition event="Add Note/Comment" target="AddNote"/>
<transition event="Categorize Item" target="CategorizeItem"/>
<transition event="Navigate List" target="NavigateList"/>
<transition event="Exit" target="end"/>
</state>
<state id="AddNote">
<transition event="Note Added" target="UpdateList"/>
</state>
<state id="CategorizeItem">
<transition event="Categorized" target="UpdateList"/>
</state>
<state id="NavigateList">
<transition event="Navigation Complete" target="DisplayList"/>
</state>
<state id="UpdateList">
<transition event="List Updated" target="DisplayList"/>
</state>
<state id="end"/>
</scxml>

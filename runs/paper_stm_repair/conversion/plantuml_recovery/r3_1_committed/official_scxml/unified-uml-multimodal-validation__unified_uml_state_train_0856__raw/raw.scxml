<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="CreateCategory"/>
<transition target="SetGoal"/>
</state>
<state id="CreateCategory">
<transition target="AssignTimeRanges"/>
<transition target="end"/>
</state>
<state id="AssignTimeRanges">
<transition target="TrackTime"/>
</state>
<state id="TrackTime">
<transition target="SetAlerts"/>
<transition target="ViewAnalyzeData"/>
</state>
<state id="SetAlerts">
<transition target="ViewAnalyzeData"/>
</state>
<state id="ViewAnalyzeData">
<transition target="SwitchCategories"/>
<transition target="ExportData"/>
</state>
<state id="SwitchCategories">
<transition target="end"/>
</state>
<state id="end"/>
<state id="ExportData">
<transition target="end"/>
</state>
<state id="SetGoal">
<transition target="TrackTime"/>
</state>
</scxml>

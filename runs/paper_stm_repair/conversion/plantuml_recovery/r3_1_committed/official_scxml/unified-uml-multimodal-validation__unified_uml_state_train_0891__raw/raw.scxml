<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="PreferencesInput"/>
</state>
<state id="PreferencesInput">
<transition target="RecommendationsGenerated"/>
</state>
<state id="RecommendationsGenerated">
<transition target="RecommendationsFiltered"/>
</state>
<state id="RecommendationsFiltered">
<transition target="RecommendationsViewed"/>
</state>
<state id="RecommendationsViewed">
<transition target="end"/>
<transition target="RecommendationsShared"/>
</state>
<state id="end"/>
<state id="RecommendationsShared">
<transition target="end"/>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Default"/>
</state>
<state id="Default">
<transition event="Switch to Custom" target="Custom"/>
<transition target="end"/>
</state>
<state id="Custom">
<transition event="Switch to Default" target="Default"/>
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

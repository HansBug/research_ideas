<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ChooseMode"/>
</state>
<state id="ChooseMode">
<transition event="choose walking" target="Walking"/>
<transition event="choose cycling" target="Cycling"/>
<transition event="choose public transport" target="PublicTransport"/>
</state>
<state id="Walking">
<transition event="switch to cycling" target="Cycling"/>
<transition event="switch to public transport" target="PublicTransport"/>
<transition event="complete trip" target="end"/>
</state>
<state id="Cycling">
<transition event="switch to walking" target="Walking"/>
<transition event="switch to public transport" target="PublicTransport"/>
<transition event="complete trip" target="end"/>
</state>
<state id="PublicTransport">
<transition event="switch to walking" target="Walking"/>
<transition event="switch to cycling" target="Cycling"/>
<transition event="complete trip" target="end"/>
</state>
<state id="end"/>
</scxml>

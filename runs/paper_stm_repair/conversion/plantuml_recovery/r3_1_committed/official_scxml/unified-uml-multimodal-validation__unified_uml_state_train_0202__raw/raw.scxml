<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SystemAccess"/>
</state>
<state id="SystemAccess">
<transition event="Search/Filter Data" target="DataSearchFilter"/>
<transition event="Track Data" target="DataTracking"/>
<transition event="Revoke Access" target="AccessRevoked"/>
</state>
<state id="DataSearchFilter">
<transition event="View Data" target="DataView"/>
<transition event="Return" target="SystemAccess"/>
</state>
<state id="DataTracking">
<transition event="Revoke Access" target="AccessRevoked"/>
<transition event="Return" target="SystemAccess"/>
<transition event="Exit" target="end"/>
</state>
<state id="AccessRevoked">
<transition event="Continue" target="SystemAccess"/>
<transition event="Exit" target="end"/>
</state>
<state id="DataView">
<transition event="Track Data" target="DataTracking"/>
<transition event="Return" target="SystemAccess"/>
<transition event="Exit" target="end"/>
</state>
<state id="end"/>
</scxml>

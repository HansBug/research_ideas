<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="User starts customizing layout" target="CustomizingLayout"/>
</state>
<state id="CustomizingLayout">
<transition event="User switches between screens" target="SwitchingScreens"/>
</state>
<state id="SwitchingScreens">
<transition event="User accesses UI from project" target="AccessingUI"/>
</state>
<state id="AccessingUI">
<transition event="User exits" target="end"/>
</state>
<state id="end"/>
</scxml>

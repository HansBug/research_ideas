<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="CreateNewBudget"/>
</state>
<state id="CreateNewBudget">
<transition event="Add Income/Expenses" target="AddingIncomeExpenses"/>
</state>
<state id="AddingIncomeExpenses">
<transition event="Set Reminders" target="SettingReminders"/>
<transition event="Categorize Budget" target="CategorizingBudget"/>
<transition event="Manage Multiple Budgets" target="ManagingMultipleBudgets"/>
</state>
<state id="SettingReminders">
<transition target="end"/>
</state>
<state id="CategorizingBudget">
<transition target="end"/>
</state>
<state id="ManagingMultipleBudgets">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

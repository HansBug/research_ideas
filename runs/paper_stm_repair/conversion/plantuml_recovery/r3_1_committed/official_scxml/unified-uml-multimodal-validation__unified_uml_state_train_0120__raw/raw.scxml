<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UserInteraction"/>
</state>
<state id="UserInteraction">
<transition target="ExpenseTracking"/>
</state>
<state id="ExpenseTracking">
<transition target="ReceiptUpload"/>
<transition target="ReportGeneration"/>
<transition target="Integration"/>
</state>
<state id="ReceiptUpload">
<transition target="UserInteraction"/>
</state>
<state id="ReportGeneration">
<transition target="Integration"/>
</state>
<state id="Integration">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

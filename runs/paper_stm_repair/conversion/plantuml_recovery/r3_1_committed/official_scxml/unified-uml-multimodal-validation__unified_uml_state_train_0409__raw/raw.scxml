<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="CreatingTask"/>
</state>
<state id="CreatingTask">
<transition target="ManagingTask"/>
<transition target="end"/>
</state>
<state id="ManagingTask">
<transition target="ViewingProgress"/>
<transition target="end"/>
</state>
<state id="ViewingProgress">
<transition target="Searching"/>
<transition target="end"/>
</state>
<state id="Searching">
<transition target="SettingReminders"/>
<transition target="end"/>
</state>
<state id="SettingReminders">
<transition target="UpdatingAttachments"/>
<transition target="end"/>
</state>
<state id="UpdatingAttachments">
<transition target="Exporting"/>
<transition target="end"/>
</state>
<state id="Exporting">
<transition target="end"/>
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

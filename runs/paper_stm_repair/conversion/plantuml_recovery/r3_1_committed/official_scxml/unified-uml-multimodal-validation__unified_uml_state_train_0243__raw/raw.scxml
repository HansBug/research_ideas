<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="EnterPassword"/>
</state>
<state id="EnterPassword">
<transition event="Add/Delete/Search" target="end"/>
<transition event="Add" target="AddItem"/>
<transition event="Delete" target="DeleteItem"/>
<transition event="Search" target="SearchItem"/>
<transition target="end"/>
</state>
<state id="end"/>
<state id="AddItem">
<transition event="Return" target="EnterPassword"/>
</state>
<state id="DeleteItem">
<transition event="Return" target="EnterPassword"/>
</state>
<state id="SearchItem">
<transition event="Return" target="EnterPassword"/>
</state>
</scxml>

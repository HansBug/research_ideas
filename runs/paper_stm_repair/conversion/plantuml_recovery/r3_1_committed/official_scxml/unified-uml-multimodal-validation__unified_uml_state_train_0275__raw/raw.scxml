<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="User_Interacts"/>
</state>
<state id="User_Interacts">
<transition event="Add label" target="AddCustomLabel"/>
<transition event="Search for label" target="SearchForLabel"/>
</state>
<state id="AddCustomLabel">
<transition event="Label added" target="LabelAdded"/>
</state>
<state id="SearchForLabel">
<transition event="Label found" target="LabelFound"/>
</state>
<state id="LabelAdded">
<transition target="end"/>
</state>
<state id="LabelFound">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DiscoveringNewPeople"/>
</state>
<state id="DiscoveringNewPeople">
<transition target="JoiningGroups"/>
<transition target="ConnectingWithOthers"/>
<transition target="end"/>
</state>
<state id="JoiningGroups">
<transition target="SharingExperiences"/>
<transition target="DiscoveringNewPeople"/>
<transition target="end"/>
</state>
<state id="ConnectingWithOthers">
<transition target="SharingExperiences"/>
<transition target="DiscoveringNewPeople"/>
<transition target="end"/>
</state>
<state id="SharingExperiences">
<transition target="ConnectingWithOthers"/>
<transition target="JoiningGroups"/>
<transition target="end"/>
</state>
<state id="end">
<transition target="start"/>
</state>
</scxml>

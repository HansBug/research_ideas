<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="Create New Project" target="SingleProjectInstance"/>
</state>
<state id="SingleProjectInstance">
<transition event="Add Another Instance" target="MultipleProjectInstances"/>
</state>
<state id="MultipleProjectInstances">
<transition event="Close All Instances" target="end"/>
<transition event="Switch Between Instances" target="MultipleProjectInstances"/>
</state>
<state id="end"/>
</scxml>

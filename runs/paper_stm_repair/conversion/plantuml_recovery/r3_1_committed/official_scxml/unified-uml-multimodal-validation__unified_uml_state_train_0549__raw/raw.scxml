<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UserInteraction"/>
</state>
<state id="UserInteraction">
<transition target="PreferenceProcessing"/>
<transition target="AnalyticsAndInsights"/>
</state>
<state id="PreferenceProcessing">
<transition target="RecommendationGeneration"/>
</state>
<state id="RecommendationGeneration">
<transition target="RecommendationDisplay"/>
</state>
<state id="RecommendationDisplay">
<transition target="PurchaseOrSave"/>
</state>
<state id="PurchaseOrSave">
<transition target="end"/>
</state>
<state id="end"/>
<state id="AnalyticsAndInsights">
<transition target="UserInteraction"/>
</state>
</scxml>

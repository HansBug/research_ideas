<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="IdleState"/>
</state>
<state id="IdleState">
<transition event="Detecting user location" target="DetectingUserLocation"/>
</state>
<state id="DetectingUserLocation">
<transition event="User is at home" target="AnalyzingUserBehavior"/>
<transition event="User is traveling" target="CheckingTravelInformation"/>
</state>
<state id="AnalyzingUserBehavior">
<transition event="Analyzing user behavior" target="SendingNotification"/>
</state>
<state id="CheckingTravelInformation">
<transition event="Checking travel information" target="SendingNotification"/>
</state>
<state id="SendingNotification">
<transition event="Final state" target="end"/>
<transition event="View notifications" target="ViewingDashboard"/>
</state>
<state id="end"/>
<state id="ViewingDashboard">
<transition event="Return to idle" target="IdleState"/>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="NotLoggedIn"/>
</state>
<state id="NotLoggedIn">
<transition event="User logs in" target="LoggedIn"/>
</state>
<state id="LoggedIn">
<transition event="Start tracking habits" target="TrackingHabits"/>
</state>
<state id="TrackingHabits">
<transition event="System analyzes data" target="AnalyzingData"/>
<transition event="System requests more data" target="RequestingMoreData"/>
</state>
<state id="AnalyzingData">
<transition event="Provide insights and suggestions" target="TrackingHabits"/>
<transition event="User logs out" target="LoggingOut"/>
</state>
<state id="RequestingMoreData">
<transition event="User provides more data" target="TrackingHabits"/>
<transition event="User logs out" target="LoggingOut"/>
</state>
<state id="LoggingOut">
<transition event="Logout completes" target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ContactsList"/>
</state>
<state id="ContactsList">
<transition event="Search by name/email" target="SearchContacts"/>
<transition event="View contact info" target="ViewContactDetails"/>
<transition event="Add/Edit/Delete" target="ManageContacts"/>
<transition event="View history" target="ViewContactHistory"/>
<transition event="Integrate with calendar/reminders" target="IntegrateWithTools"/>
<transition target="end"/>
</state>
<state id="SearchContacts">
<transition event="Return to list" target="ContactsList"/>
</state>
<state id="ViewContactDetails">
<transition event="Return to list" target="ContactsList"/>
</state>
<state id="ManageContacts">
<transition event="Return to list" target="ContactsList"/>
</state>
<state id="ViewContactHistory">
<transition event="Return to list" target="ContactsList"/>
</state>
<state id="IntegrateWithTools">
<transition event="Return to list" target="ContactsList"/>
</state>
<state id="end"/>
</scxml>

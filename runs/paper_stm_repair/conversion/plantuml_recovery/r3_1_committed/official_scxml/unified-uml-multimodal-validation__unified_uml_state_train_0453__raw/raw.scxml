<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="Upload" target="Upload_Appointments"/>
<transition event="View" target="View_Calendar"/>
</state>
<state id="Upload_Appointments">
<transition event="Display" target="Display_Calendar"/>
</state>
<state id="View_Calendar"/>
<state id="Display_Calendar">
<transition event="Exit" target="end"/>
<transition event="Upload More" target="Upload_Appointments"/>
</state>
<state id="end"/>
</scxml>

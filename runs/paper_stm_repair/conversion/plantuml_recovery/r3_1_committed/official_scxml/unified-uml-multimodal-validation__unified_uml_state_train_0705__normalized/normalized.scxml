<state id="Reminder_Created_1f28e4">
<transition event="&quot;User activates reminder&quot;" target="Reminder_Activated_25ee89"/>
</state>
<state id="Reminder_Activated_25ee89">
<transition event="&quot;System activates timer&quot;" target="Waiting_for_Reminder_Time_b9edc5"/>
</state>
<state id="Waiting_for_Reminder_Time_b9edc5">

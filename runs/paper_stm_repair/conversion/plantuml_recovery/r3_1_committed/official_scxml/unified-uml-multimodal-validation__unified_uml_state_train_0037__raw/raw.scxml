<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ResourceAllocationRequest"/>
</state>
<state id="ResourceAllocationRequest">
<transition target="CheckResourceAvailability"/>
</state>
<state id="CheckResourceAvailability">
<transition event="Available" target="ResourceAllocation"/>
<transition event="Not Available" target="ResourceAllocationRejected"/>
</state>
<state id="ResourceAllocation">
<transition target="ResourceAllocationComplete"/>
<transition target="ResourceAllocationFailed"/>
<transition target="ResourceAllocationCancelled"/>
</state>
<state id="ResourceAllocationRejected">
<transition target="end"/>
</state>
<state id="ResourceAllocationComplete">
<transition target="end"/>
</state>
<state id="ResourceAllocationFailed">
<transition target="end"/>
</state>
<state id="ResourceAllocationCancelled">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="TurnOn"/>
</state>
<state id="choice3">
<transition target="ChargedFlash"/>
</state>
<state id="Junction3">
<transition event="Charged=true" target="Join2"/>
</state>
<state id="Join2">
<transition target="Fork2"/>
</state>
<state id="Fork2">
<transition target="Junction2"/>
<transition target="Flash"/>
</state>
<state id="Junction2">
<transition target="TakePicture"/>
</state>
<state id="Flash">
<transition target="Terminate"/>
</state>
<state id="Terminate"/>
<state id="TakePicture">
<transition target="WriteMemory"/>
</state>
<state id="TurnOn">
<state id="startTurnOn">
<transition target="ExecutionTime"/>
</state>
<state id="ExecutionTime">
<transition event="after 2s" target="fork1"/>
<transition event="after 1s" target="choice1"/>
<transition event="«GaStep»{prob=0.4}" target="choice2"/>
<transition event="after 2s" target="Junction3"/>
<transition event="after 2s" target="Junction1"/>
<transition event="after 2s" target="endTurnOff"/>
</state>
<state id="fork1">
<transition target="AutoFocus"/>
<transition target="DetLight"/>
<transition target="choice3"/>
</state>
</state>
<state id="AutoFocus">
<state id="startAutoFocus">
<transition target="ExecutionTime"/>
</state>
<state id="choice1">
<transition event="memFull=true" target="Junction3"/>
</state>
</state>
<state id="DetLight">
<state id="startDetLight">
<transition target="ExecutionTime"/>
</state>
<state id="choice2">
<transition target="Join2"/>
</state>
</state>
<state id="ChargedFlash">
<state id="startChargedFlash">
<transition target="ExecutionTime"/>
</state>
</state>
<state id="WriteMemory">
<state id="startWriteMemory">
<transition target="ExecutionTime"/>
</state>
<state id="Junction1">
<transition target="TurnOff"/>
</state>
</state>
<state id="TurnOff">
<state id="startTurnOff">
<transition target="ExecutionTime"/>
</state>
<state id="endTurnOff"/>
</state>
</scxml>

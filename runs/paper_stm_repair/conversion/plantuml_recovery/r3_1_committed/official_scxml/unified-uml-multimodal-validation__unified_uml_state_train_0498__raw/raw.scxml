<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="StartIconCreation"/>
</state>
<state id="StartIconCreation">
<transition event="User selects design options" target="SelectDesignOptions"/>
</state>
<state id="SelectDesignOptions">
<transition event="User customizes icon" target="CustomizeIcon"/>
</state>
<state id="CustomizeIcon">
<transition event="User saves the custom icon" target="SaveIcon"/>
</state>
<state id="SaveIcon">
<transition event="User shares the custom icon" target="ShareIcon"/>
<transition event="User exits without sharing" target="end"/>
</state>
<state id="ShareIcon">
<transition event="Process completes" target="end"/>
<transition event="User creates another custom icon" target="StartIconCreation"/>
</state>
<state id="end"/>
</scxml>

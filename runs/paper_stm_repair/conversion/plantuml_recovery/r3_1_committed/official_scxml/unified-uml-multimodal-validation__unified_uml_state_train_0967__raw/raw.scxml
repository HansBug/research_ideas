<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DisplayCompletedTasks"/>
<transition target="AddUpdateTask"/>
</state>
<state id="DisplayCompletedTasks">
<transition event="Add/Update Task" target="AddUpdateTask"/>
<transition event="Exit" target="end"/>
</state>
<state id="AddUpdateTask">
<transition event="View Completed Tasks" target="DisplayCompletedTasks"/>
<transition event="Exit" target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UserInteraction"/>
</state>
<state id="UserInteraction">
<transition target="RecipeStorage"/>
<transition target="RecipeSearch"/>
<transition target="RecipeSharing"/>
<transition target="PersonalizedRecommendations"/>
<transition target="RecipeCustomization"/>
<transition target="end"/>
</state>
<state id="RecipeStorage">
<transition target="UserInteraction"/>
</state>
<state id="RecipeSearch">
<transition target="UserInteraction"/>
</state>
<state id="RecipeSharing">
<transition target="UserInteraction"/>
</state>
<state id="PersonalizedRecommendations">
<transition target="UserInteraction"/>
</state>
<state id="RecipeCustomization">
<transition target="UserInteraction"/>
</state>
<state id="end"/>
</scxml>

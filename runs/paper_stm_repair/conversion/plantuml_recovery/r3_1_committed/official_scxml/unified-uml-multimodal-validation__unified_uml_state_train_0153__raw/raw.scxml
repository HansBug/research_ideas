<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectingPurpose"/>
</state>
<state id="SelectingPurpose">
<transition target="CreatingVirtualModel"/>
</state>
<state id="CreatingVirtualModel">
<transition target="UsingVirtualModel"/>
</state>
<state id="UsingVirtualModel">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InputCurrentLocation"/>
</state>
<state id="InputCurrentLocation">
<transition target="InputDestination"/>
</state>
<state id="InputDestination">
<transition target="ProcessingRoute"/>
</state>
<state id="ProcessingRoute">
<transition target="DisplayRouteOptions"/>
</state>
<state id="DisplayRouteOptions">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

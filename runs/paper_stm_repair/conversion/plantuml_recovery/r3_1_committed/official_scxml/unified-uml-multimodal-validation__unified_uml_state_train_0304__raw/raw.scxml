<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="AccountCreationStarted"/>
</state>
<state id="AccountCreationStarted">
<transition event="select default profile" target="DefaultProfileSelection"/>
</state>
<state id="DefaultProfileSelection">
<transition event="generate profile" target="ProfileGenerated"/>
</state>
<state id="ProfileGenerated">
<transition event="profile available" target="ProfileAvailable"/>
</state>
<state id="ProfileAvailable">
<transition event="customize profile" target="ProfileCustomization"/>
<transition event="update preferences" target="ProfileUpdated"/>
<transition event="logout" target="end"/>
</state>
<state id="ProfileCustomization">
<transition event="update profile" target="ProfileAvailable"/>
</state>
<state id="ProfileUpdated">
<transition event="update profile" target="ProfileAvailable"/>
</state>
<state id="end"/>
</scxml>

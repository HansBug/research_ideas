<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="AutonomousMode"/>
</state>
<state id="AutonomousMode">
<transition event="initial" target="InitialState"/>
<transition event="auto_finished=true" target="FinishState"/>
</state>
<state id="InitialState">
<transition event="high_way=true" target="HighwayMode"/>
<transition event="urban_way=true" target="UrbanMode"/>
</state>
<state id="HighwayMode">
<transition event="enter" target="enter_hwy"/>
<transition event="urban_way=true" target="UrbanMode"/>
<transition event="auto_finished=true" target="FinishState"/>
<state id="enter_hwy">
<transition event="dist_to_front&lt;25 &amp; extra_lane=true" target="cruise"/>
<transition event="dist_to_front&lt;25 &amp; extra_lane=true" target="lane_change"/>
</state>
<state id="cruise">
<transition event="dist_to_front&lt;25 &amp; extra_lane=true" target="lane_change"/>
<transition event="dist_to_exit&lt;2" target="FinishState"/>
</state>
<state id="lane_change">
<transition event="lane_change_completed" target="cruise"/>
<transition event="dist_to_exit&lt;2" target="exit_hwy"/>
</state>
<state id="FinishState"/>
<state id="exit_hwy"/>
</state>
<state id="UrbanMode">
<transition event="enter" target="enter_urban"/>
<transition event="high_way=true" target="HighwayMode"/>
<transition event="auto_finished=true" target="FinishState"/>
<state id="enter_urban">
<transition event="dist_to_front&lt;15 &amp; extra_lane=true" target="lane_change_urban"/>
<transition event="road_clear" target="straight"/>
<transition event="intersection=true" target="intersection"/>
</state>
<state id="lane_change_urban">
<transition event="lane_change_completed" target="straight"/>
<transition event="dist_to_exit&lt;0.7" target="exit_urban"/>
</state>
<state id="straight">
<transition event="intersection=true" target="intersection"/>
<transition event="dist_to_front&lt;15 &amp; extra_lane=true" target="lane_change_urban"/>
</state>
<state id="intersection"/>
<state id="exit_urban"/>
</state>
<state id="CollisionAvoidance">
<state id="startCollisionAvoidance">
<transition target="collision_avoidance_deactive"/>
</state>
<state id="collision_avoidance_deactive">
<transition event="pedestrian_detected | dist_to_rear&lt;5 &amp; vel&gt;30 | dist_to_front&lt;15 &amp; highway_mode | dist_to_front&lt;10 &amp; urban_mode" target="collision_avoidance_active"/>
</state>
<state id="collision_avoidance_active">
<transition event="front_inactive &amp; rear_inactive &amp; pedestrian_inactive" target="collision_avoidance_deactive"/>
</state>
</state>
</scxml>

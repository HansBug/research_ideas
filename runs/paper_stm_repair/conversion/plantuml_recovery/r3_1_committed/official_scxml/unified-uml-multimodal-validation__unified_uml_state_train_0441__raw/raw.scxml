<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ViewLatestVersion"/>
</state>
<state id="ViewLatestVersion">
<transition event="View Previous Versions" target="ViewPreviousVersions"/>
<transition event="Compare Versions" target="CompareVersions"/>
<transition event="Exit" target="end"/>
</state>
<state id="ViewPreviousVersions">
<transition event="Return to Latest Version" target="ViewLatestVersion"/>
<transition event="Exit" target="end"/>
</state>
<state id="CompareVersions">
<transition event="Return to Latest Version" target="ViewLatestVersion"/>
<transition event="Exit" target="end"/>
</state>
<state id="end"/>
</scxml>

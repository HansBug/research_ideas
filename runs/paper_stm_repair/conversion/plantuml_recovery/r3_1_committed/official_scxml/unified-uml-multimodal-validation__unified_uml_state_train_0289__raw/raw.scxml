<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="Add Profile Information" target="AddingProfileInformation"/>
<transition event="Edit Profile Information" target="EditingProfileInformation"/>
<transition event="Delete Profile Information" target="DeletingProfileInformation"/>
<transition event="Access Profile Information" target="AccessingProfileInformation"/>
</state>
<state id="AddingProfileInformation">
<transition event="Complete" target="end"/>
</state>
<state id="EditingProfileInformation">
<transition event="Complete" target="end"/>
</state>
<state id="DeletingProfileInformation">
<transition event="Complete" target="end"/>
</state>
<state id="AccessingProfileInformation">
<transition event="Complete" target="end"/>
</state>
<state id="end"/>
</scxml>

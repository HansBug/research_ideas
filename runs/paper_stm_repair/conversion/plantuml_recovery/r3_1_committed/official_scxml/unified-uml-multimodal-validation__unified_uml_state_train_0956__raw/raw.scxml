<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition event="Save Settings" target="Saving_Settings"/>
<transition event="Restore Settings" target="Restoring_Settings"/>
<transition event="Access Settings" target="Accessing_Settings"/>
<transition event="Manage Settings" target="Managing_Settings"/>
</state>
<state id="Saving_Settings">
<transition event="Settings Saved" target="Saving_Completed"/>
</state>
<state id="Saving_Completed">
<transition event="Return to Inactive" target="end"/>
</state>
<state id="end"/>
<state id="Restoring_Settings">
<transition event="Settings Restored" target="Restoring_Completed"/>
</state>
<state id="Restoring_Completed">
<transition event="Return to Inactive" target="end"/>
</state>
<state id="Accessing_Settings">
<transition event="Settings Accessed" target="Accessing_Completed"/>
</state>
<state id="Accessing_Completed">
<transition event="Return to Inactive" target="end"/>
</state>
<state id="Managing_Settings">
<transition event="Settings Managed" target="Managing_Completed"/>
</state>
<state id="Managing_Completed">
<transition event="Return to Inactive" target="end"/>
</state>
</scxml>

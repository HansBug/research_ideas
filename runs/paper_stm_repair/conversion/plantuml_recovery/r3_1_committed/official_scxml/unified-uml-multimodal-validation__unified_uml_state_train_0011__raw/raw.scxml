<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DataSelection"/>
</state>
<state id="DataSelection">
<transition target="QueryingDatabase"/>
<transition event="feature disabled" target="end"/>
</state>
<state id="QueryingDatabase">
<transition event="duplicates found" target="DuplicateRemoval"/>
<transition event="no duplicates" target="end"/>
</state>
<state id="DuplicateRemoval">
<transition target="UpdatingDatabase"/>
</state>
<state id="UpdatingDatabase">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="IdleState"/>
</state>
<state id="IdleState">
<transition event="User logs in" target="CollectingDataState"/>
</state>
<state id="CollectingDataState">
<transition event="Data collection complete" target="AnalyzingDataState"/>
</state>
<state id="AnalyzingDataState">
<transition event="Data analysis complete" target="GeneratingRecommendationsState"/>
</state>
<state id="GeneratingRecommendationsState">
<transition event="Recommendations generated" target="DisplayingRecommendationsState"/>
</state>
<state id="DisplayingRecommendationsState">
<transition event="User logs out" target="end"/>
<transition event="User requests history" target="ViewingHistoryState"/>
</state>
<state id="end"/>
<state id="ViewingHistoryState">
<transition event="Return to recommendations" target="DisplayingRecommendationsState"/>
</state>
</scxml>

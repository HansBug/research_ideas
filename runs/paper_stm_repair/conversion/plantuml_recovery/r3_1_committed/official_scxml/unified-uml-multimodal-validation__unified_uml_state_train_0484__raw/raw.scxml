<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="CreatingNewTask"/>
</state>
<state id="CreatingNewTask">
<transition target="AssigningCategoriesAndTags"/>
</state>
<state id="AssigningCategoriesAndTags">
<transition target="FilteringTasks"/>
<transition target="ViewingTasks"/>
</state>
<state id="FilteringTasks">
<transition target="ViewingTasks"/>
</state>
<state id="ViewingTasks">
<transition target="FilteringTasks"/>
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

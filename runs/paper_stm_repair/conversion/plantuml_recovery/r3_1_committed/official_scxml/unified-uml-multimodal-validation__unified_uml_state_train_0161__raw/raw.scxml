<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="create task" target="TaskCreation"/>
<transition event="exit" target="end"/>
</state>
<state id="TaskCreation">
<transition event="allocate resources" target="ResourceAllocation"/>
<transition event="assign task" target="TaskAssignment"/>
<transition event="cancel" target="Idle"/>
</state>
<state id="ResourceAllocation">
<transition event="assign task" target="TaskAssignment"/>
<transition event="cancel" target="Idle"/>
</state>
<state id="TaskAssignment">
<transition event="execute task" target="TaskExecution"/>
<transition event="cancel" target="Idle"/>
</state>
<state id="TaskExecution">
<transition event="complete task" target="TaskCompletion"/>
<transition event="continue execution" target="TaskExecution"/>
</state>
<state id="TaskCompletion">
<transition event="generate report" target="Reporting"/>
<transition event="done" target="Idle"/>
</state>
<state id="Reporting">
<transition event="return to idle" target="Idle"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="PumpControl"/>
</state>
<state id="PumpControl">
<transition event="Start Pump" target="PumpState"/>
<transition event="Monitor Water Flow" target="WaterState"/>
<transition event="Monitor Methane Flow" target="MethaneState"/>
</state>
<state id="PumpState"/>
<state id="WaterState"/>
<state id="MethaneState"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="Mission Start" target="TargetSearch"/>
</state>
<state id="TargetSearch">
<transition event="Enter Area 1" target="Area1"/>
<transition event="Enter Area 2" target="Area2"/>
<transition event="Enter Area 3" target="Area3"/>
<transition event="Interception Detected" target="FormationAdjustment"/>
<transition event="Task Assignment Received" target="Attack"/>
</state>
<state id="Area1">
<transition event="Exit Area 1" target="TargetSearch"/>
</state>
<state id="Area2">
<transition event="Exit Area 2" target="TargetSearch"/>
</state>
<state id="Area3">
<transition event="Exit Area 3" target="TargetSearch"/>
</state>
<state id="FormationAdjustment">
<transition event="Adjustment Complete" target="TargetSearch"/>
</state>
<state id="Attack">
<transition event="Attack Completed / Decrease UAV Count" target="Idle"/>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ViewingOrders"/>
<transition target="CreatingOrder"/>
</state>
<state id="ViewingOrders">
<transition target="CreatingOrder"/>
<transition target="end"/>
</state>
<state id="CreatingOrder">
<transition target="ManagingOrder"/>
</state>
<state id="end"/>
<state id="ManagingOrder">
<transition target="GeneratingInvoice"/>
</state>
<state id="GeneratingInvoice">
<transition target="SendingPaymentReminder"/>
</state>
<state id="SendingPaymentReminder">
<transition target="end"/>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="CalendarView"/>
</state>
<state id="CalendarView">
<transition event="Create Custom View" target="CustomViewCreation"/>
<transition event="Switch View" target="ViewSwitching"/>
<transition event="Exit" target="end"/>
</state>
<state id="CustomViewCreation">
<transition event="Display Custom View" target="CustomViewDisplay"/>
</state>
<state id="ViewSwitching">
<transition event="Return to Calendar" target="CalendarView"/>
<transition event="Return to Custom View" target="CustomViewDisplay"/>
</state>
<state id="CustomViewDisplay">
<transition event="Return to Calendar" target="CalendarView"/>
<transition event="Manage Events" target="EventManagement"/>
<transition event="Switch View" target="ViewSwitching"/>
<transition event="Exit" target="end"/>
</state>
<state id="EventManagement">
<transition event="Return to Custom View" target="CustomViewDisplay"/>
</state>
<state id="end"/>
</scxml>

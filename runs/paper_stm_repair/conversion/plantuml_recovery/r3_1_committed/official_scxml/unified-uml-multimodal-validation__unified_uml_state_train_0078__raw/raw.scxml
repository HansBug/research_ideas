<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="PlanningRoutine"/>
</state>
<state id="PlanningRoutine">
<transition target="SharingRoutine"/>
<transition target="ViewingOthersRoutines"/>
<transition target="ReceivingRecommendations"/>
<transition target="Collaborating"/>
</state>
<state id="SharingRoutine">
<transition target="end"/>
</state>
<state id="ViewingOthersRoutines">
<transition target="end"/>
</state>
<state id="ReceivingRecommendations">
<transition target="end"/>
</state>
<state id="Collaborating">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Browsing"/>
</state>
<state id="Browsing">
<transition event="User decides to input preferences" target="InputtingPreferences"/>
</state>
<state id="InputtingPreferences">
<transition event="System receives preferences" target="ProcessingPreferences"/>
</state>
<state id="ProcessingPreferences">
<transition event="System generates recommendations" target="DisplayingRecommendations"/>
</state>
<state id="DisplayingRecommendations">
<transition event="User receives recommendations" target="end"/>
</state>
<state id="end"/>
</scxml>

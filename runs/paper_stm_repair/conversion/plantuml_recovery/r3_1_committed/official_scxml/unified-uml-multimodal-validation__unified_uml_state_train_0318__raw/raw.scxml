<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="GalleryConfiguration"/>
</state>
<state id="GalleryConfiguration">
<transition target="ImageSelection"/>
<transition target="LayoutSettings"/>
<transition target="FilterApplication"/>
<transition target="ImageEditing"/>
<transition target="GallerySaving"/>
<transition target="GallerySharing"/>
</state>
<state id="ImageSelection">
<transition target="GalleryConfiguration"/>
</state>
<state id="LayoutSettings">
<transition target="GalleryConfiguration"/>
</state>
<state id="FilterApplication">
<transition target="GalleryConfiguration"/>
</state>
<state id="ImageEditing">
<transition target="GalleryConfiguration"/>
<transition target="GallerySaving"/>
<transition target="GallerySharing"/>
</state>
<state id="GallerySaving">
<transition target="end"/>
</state>
<state id="GallerySharing">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

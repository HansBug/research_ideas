<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="Shutdown" target="end"/>
<transition event="Create Task" target="TaskCreated"/>
</state>
<state id="end"/>
<state id="TaskCreated">
<transition event="Store Task" target="TaskStored"/>
</state>
<state id="TaskStored">
<transition event="View Task" target="TaskViewed"/>
<transition event="Manage Task" target="TaskManaged"/>
</state>
<state id="TaskViewed">
<transition event="Manage Task" target="TaskManaged"/>
</state>
<state id="TaskManaged">
<transition event="Complete Task" target="end"/>
<transition event="Mark Overdue" target="TaskOverdue"/>
</state>
<state id="TaskOverdue">
<transition event="Send Notification" target="NotificationSent"/>
</state>
<state id="NotificationSent">
<transition event="Receive Notification" target="end"/>
<transition event="Task Pending" target="TaskPending"/>
</state>
<state id="TaskPending">
<transition event="Complete Task" target="end"/>
<transition event="Mark Overdue" target="TaskOverdue"/>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="Create New Version" target="VersionCreated"/>
</state>
<state id="VersionCreated">
<transition event="Create Another Version" target="VersionCreated"/>
<transition event="Switch Version" target="VersionSwitched"/>
<transition event="Finalize Document" target="DocumentFinalized"/>
</state>
<state id="VersionSwitched">
<transition event="Create New Version" target="VersionCreated"/>
<transition event="Switch Version" target="VersionSwitched"/>
<transition event="Finalize Document" target="DocumentFinalized"/>
</state>
<state id="DocumentFinalized">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

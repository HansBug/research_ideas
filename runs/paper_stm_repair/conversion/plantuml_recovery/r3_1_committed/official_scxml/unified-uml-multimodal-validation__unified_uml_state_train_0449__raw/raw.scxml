<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition event="Search by keyword/title" target="SearchBook"/>
<transition event="Add new book" target="AddNewBook"/>
</state>
<state id="SearchBook">
<transition event="Display search results" target="DisplayResults"/>
<transition event="Cancel search" target="end"/>
</state>
<state id="DisplayResults">
<transition event="End search" target="end"/>
</state>
<state id="end"/>
<state id="AddNewBook">
<transition event="Enter book details" target="EnterBookDetails"/>
<transition event="Cancel adding" target="end"/>
</state>
<state id="EnterBookDetails">
<transition event="Save new book" target="SaveBook"/>
<transition event="Cancel adding" target="end"/>
</state>
<state id="SaveBook">
<transition event="Book added" target="end"/>
<transition event="Error saving" target="end"/>
</state>
</scxml>

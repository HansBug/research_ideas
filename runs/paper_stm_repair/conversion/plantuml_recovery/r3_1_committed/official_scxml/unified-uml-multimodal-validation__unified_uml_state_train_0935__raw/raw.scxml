<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DesktopAccess"/>
<transition target="TabletAccess"/>
<transition target="MobileAccess"/>
</state>
<state id="DesktopAccess">
<transition target="Customization"/>
</state>
<state id="TabletAccess">
<transition target="Customization"/>
</state>
<state id="MobileAccess">
<transition target="Customization"/>
</state>
<state id="Customization">
<transition target="Display"/>
</state>
<state id="Display">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

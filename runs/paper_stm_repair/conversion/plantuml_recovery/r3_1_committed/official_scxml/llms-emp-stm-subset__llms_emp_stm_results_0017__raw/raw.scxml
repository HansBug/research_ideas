<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="possible frontend collision detected" target="F"/>
</state>
<state id="end"/>
<state id="CA">
<state id="F">
<transition event="Collision avoided" target="end"/>
<transition event="Rear-end collision detected" target="R"/>
<transition event="Collision with pedestrian detected" target="P"/>
</state>
<state id="R">
<transition event="Collision avoided" target="end"/>
<transition event="Collision with pedestrian detected" target="P"/>
<transition event="Frontend collision detected" target="F"/>
</state>
<state id="P">
<transition event="Collision avoided" target="end"/>
<transition event="Frontend collision detected" target="F"/>
<transition event="Rear-end collision detected" target="R"/>
</state>
</state>
</scxml>

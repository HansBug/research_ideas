<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectingColumns"/>
</state>
<state id="SelectingColumns">
<transition target="ApplyingFilters"/>
</state>
<state id="ApplyingFilters">
<transition target="SortingData"/>
</state>
<state id="SortingData">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition target="SubmittingExpenseReport"/>
</state>
<state id="SubmittingExpenseReport">
<transition target="TrackingExpenses"/>
</state>
<state id="TrackingExpenses">
<transition target="ApprovingReport"/>
</state>
<state id="ApprovingReport">
<transition target="GeneratingInvoice"/>
</state>
<state id="GeneratingInvoice">
<transition target="ReimbursingUser"/>
</state>
<state id="ReimbursingUser">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
<transition target="FinalState"/>
<transition target="end"/>
</state>
<state id="InitialState">
<transition event="Create New Workspace" target="CreateWorkspace"/>
<transition event="View Workspaces" target="ViewWorkspaces"/>
</state>
<state id="initialState"/>
<state id="CreateWorkspace">
<transition event="Add workspace details" target="AddingWorkspace"/>
</state>
<state id="AddingWorkspace">
<transition event="Workspace created" target="WorkspaceAdded"/>
</state>
<state id="WorkspaceAdded">
<transition target="end"/>
</state>
<state id="end"/>
<state id="ViewWorkspaces">
<transition event="Display workspaces" target="ViewingWorkspaces"/>
</state>
<state id="ViewingWorkspaces">
<transition event="Switch to another workspace" target="SwitchWorkspace"/>
<transition event="Manage workspace" target="ManageWorkspace"/>
</state>
<state id="SwitchWorkspace">
<transition event="Switching to selected workspace" target="SwitchingWorkspace"/>
</state>
<state id="SwitchingWorkspace">
<transition target="end"/>
</state>
<state id="ManageWorkspace">
<transition event="Edit/Delete workspace" target="ManagingWorkspace"/>
</state>
<state id="ManagingWorkspace">
<transition target="end"/>
</state>
<state id="FinalState"/>
</scxml>

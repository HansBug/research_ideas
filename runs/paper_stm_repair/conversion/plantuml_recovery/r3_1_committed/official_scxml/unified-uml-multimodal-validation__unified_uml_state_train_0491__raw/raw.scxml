<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="VisualizingData"/>
</state>
<state id="VisualizingData">
<transition target="AnalyzingData"/>
</state>
<state id="AnalyzingData">
<transition target="ComparingData"/>
</state>
<state id="ComparingData">
<transition target="SharingExportingResults"/>
</state>
<state id="SharingExportingResults">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Browsing"/>
</state>
<state id="Browsing">
<transition event="Analyzing user behavior" target="Analyzing"/>
</state>
<state id="Analyzing">
<transition event="Displaying personalized recommendations" target="DisplayingRecommendations"/>
</state>
<state id="DisplayingRecommendations">
<transition event="User clicks on recommendation" target="ViewingDetails"/>
</state>
<state id="ViewingDetails">
<transition event="User rates product" target="Rating"/>
</state>
<state id="Rating">
<transition event="Displaying ratings summary" target="DisplayingSummary"/>
</state>
<state id="DisplayingSummary">
<transition event="Process completes" target="end"/>
<transition event="Continue browsing" target="Browsing"/>
</state>
<state id="end"/>
</scxml>

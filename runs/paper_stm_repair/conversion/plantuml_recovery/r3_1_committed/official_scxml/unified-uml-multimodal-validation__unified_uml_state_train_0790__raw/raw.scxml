<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectDataSources"/>
</state>
<state id="SelectDataSources">
<transition target="CreateSearchQuery"/>
</state>
<state id="CreateSearchQuery">
<transition target="ApplyFilters"/>
</state>
<state id="ApplyFilters">
<transition target="ExecuteSearch"/>
</state>
<state id="ExecuteSearch">
<transition target="ReviewResults"/>
</state>
<state id="ReviewResults">
<transition target="end"/>
<transition target="RefineSearch"/>
</state>
<state id="end"/>
<state id="RefineSearch">
<transition target="CreateSearchQuery"/>
</state>
</scxml>

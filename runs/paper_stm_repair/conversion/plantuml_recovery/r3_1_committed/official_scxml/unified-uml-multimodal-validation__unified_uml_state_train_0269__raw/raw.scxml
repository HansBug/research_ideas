<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="MonitoringResources"/>
</state>
<state id="MonitoringResources">
<transition target="AllocatingResources"/>
</state>
<state id="AllocatingResources">
<transition target="IdentifyingBottlenecks"/>
</state>
<state id="IdentifyingBottlenecks">
<transition target="PrioritizingRequests"/>
</state>
<state id="PrioritizingRequests">
<transition target="IntegratingFeatures"/>
</state>
<state id="IntegratingFeatures">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Ready"/>
</state>
<state id="Ready">
<transition event="Add Label" target="ProcessingLabelAddition"/>
</state>
<state id="ProcessingLabelAddition">
<transition event="Process" target="UpdatingItem"/>
</state>
<state id="UpdatingItem">
<transition event="Update" target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ViewingTasks"/>
<transition target="ImportingTasks"/>
</state>
<state id="ViewingTasks">
<transition event="Add Task" target="AddingTask"/>
<transition event="Update Task" target="UpdatingTask"/>
<transition event="Delete Task" target="DeletingTask"/>
<transition target="end"/>
</state>
<state id="ImportingTasks">
<transition event="Suggest Tasks" target="SuggestingTasks"/>
<transition event="Show Summary" target="ShowingSummary"/>
<transition target="end"/>
</state>
<state id="AddingTask">
<transition event="Suggest Tasks" target="SuggestingTasks"/>
<transition event="Show Summary" target="ShowingSummary"/>
</state>
<state id="UpdatingTask">
<transition event="Suggest Tasks" target="SuggestingTasks"/>
<transition event="Show Summary" target="ShowingSummary"/>
</state>
<state id="DeletingTask">
<transition event="Suggest Tasks" target="SuggestingTasks"/>
<transition event="Show Summary" target="ShowingSummary"/>
</state>
<state id="SuggestingTasks">
<transition event="Return to View" target="ViewingTasks"/>
<transition event="Return to Import" target="ImportingTasks"/>
</state>
<state id="ShowingSummary">
<transition event="Return to View" target="ViewingTasks"/>
<transition event="Return to Import" target="ImportingTasks"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="NotStarted"/>
</state>
<state id="NotStarted">
<transition event="Start creating learning path" target="SelectingTopics"/>
</state>
<state id="SelectingTopics">
<transition event="Select topics" target="ReviewingSuggestions"/>
</state>
<state id="ReviewingSuggestions">
<transition event="Accept suggestions" target="LearningPathCreated"/>
</state>
<state id="LearningPathCreated">
<transition event="Start learning" target="InLearning"/>
</state>
<state id="InLearning">
<transition event="Receive improvement suggestions" target="ReviewingSuggestions"/>
<transition event="Complete learning path" target="LearningPathCompleted"/>
</state>
<state id="LearningPathCompleted">
<transition event="End of learning path" target="end"/>
</state>
<state id="end"/>
</scxml>

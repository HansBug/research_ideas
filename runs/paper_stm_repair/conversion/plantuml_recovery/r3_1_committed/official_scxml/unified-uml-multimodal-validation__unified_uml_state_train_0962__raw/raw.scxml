<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UserLoggedIn"/>
</state>
<state id="UserLoggedIn">
<transition event="View Profile" target="ViewingProfile"/>
<transition event="Add Info" target="AddingProfileInfo"/>
<transition event="Edit Info" target="EditingProfileInfo"/>
<transition event="Delete Info" target="DeletingProfileInfo"/>
<transition event="Log Out" target="LoggingOut"/>
</state>
<state id="ViewingProfile">
<transition event="Back to Profile" target="UserLoggedIn"/>
</state>
<state id="AddingProfileInfo">
<transition event="Add Complete" target="ViewingProfile"/>
</state>
<state id="EditingProfileInfo">
<transition event="Edit Complete" target="ViewingProfile"/>
</state>
<state id="DeletingProfileInfo">
<transition event="Delete Complete" target="ViewingProfile"/>
</state>
<state id="LoggingOut">
<transition event="Logout Complete" target="end"/>
</state>
<state id="end"/>
</scxml>

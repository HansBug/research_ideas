<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="NotLoggedIn"/>
</state>
<state id="NotLoggedIn">
<transition event="Create New Profile" target="CreateProfile"/>
<transition event="Login" target="Login"/>
</state>
<state id="CreateProfile">
<transition event="Profile Created" target="ProfileCreated"/>
</state>
<state id="Login">
<transition event="Login Successful" target="LoggedIn"/>
</state>
<state id="ProfileCreated">
<transition event="Edit Profile" target="EditProfile"/>
<transition event="View Summary" target="ViewProfileSummary"/>
<transition event="Delete Profile" target="DeleteProfile"/>
<transition event="View Changes" target="ViewProfileChanges"/>
</state>
<state id="LoggedIn">
<transition event="View Profile" target="ViewProfile"/>
</state>
<state id="ViewProfile">
<transition event="Edit Profile" target="EditProfile"/>
<transition event="View Summary" target="ViewProfileSummary"/>
<transition event="Delete Profile" target="DeleteProfile"/>
</state>
<state id="EditProfile">
<transition event="Save Profile" target="SaveProfile"/>
<transition event="Cancel" target="CancelEdit"/>
</state>
<state id="SaveProfile">
<transition event="Profile Saved" target="ProfileCreated"/>
</state>
<state id="CancelEdit">
<transition event="Return to Profile" target="ProfileCreated"/>
</state>
<state id="ViewProfileSummary">
<transition event="Return to Profile" target="ProfileCreated"/>
</state>
<state id="DeleteProfile">
<transition event="Profile Deleted" target="NotLoggedIn"/>
</state>
<state id="ViewProfileChanges">
<transition event="Return to Profile" target="ProfileCreated"/>
</state>
</scxml>

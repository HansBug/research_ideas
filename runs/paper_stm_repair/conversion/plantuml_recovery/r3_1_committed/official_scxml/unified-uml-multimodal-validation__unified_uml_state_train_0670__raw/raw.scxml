<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="OrganizingResources"/>
</state>
<state id="OrganizingResources">
<transition event="Add Notes" target="AddingNotes"/>
<transition event="Search" target="SearchingResources"/>
<transition event="Share" target="SharingResources"/>
</state>
<state id="AddingNotes">
<transition event="Search" target="SearchingResources"/>
<transition event="Continue Organizing" target="OrganizingResources"/>
</state>
<state id="SearchingResources">
<transition event="View Results" target="ViewingResults"/>
</state>
<state id="SharingResources">
<transition target="end"/>
</state>
<state id="ViewingResults">
<transition event="Share" target="SharingResources"/>
<transition event="Search Again" target="SearchingResources"/>
</state>
<state id="end"/>
</scxml>

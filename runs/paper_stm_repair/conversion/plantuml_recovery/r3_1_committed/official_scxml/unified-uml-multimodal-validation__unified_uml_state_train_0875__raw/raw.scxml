<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="TaskSubmission"/>
</state>
<state id="TaskSubmission">
<transition event="Submit Task" target="TaskValidation"/>
<transition event="Cancel Task" target="end"/>
</state>
<state id="TaskValidation">
<transition event="Invalid Task" target="ErrorHandling"/>
<transition event="Valid Task" target="TaskAssignment"/>
</state>
<state id="ErrorHandling">
<transition event="Handle Error" target="end"/>
</state>
<state id="TaskAssignment">
<transition event="Assign Task" target="FeedbackGeneration"/>
</state>
<state id="FeedbackGeneration">
<transition event="Provide Feedback" target="TaskCompletion"/>
<transition event="Update or Cancel" target="TaskSubmission"/>
</state>
<state id="TaskCompletion">
<transition event="Complete Task" target="end"/>
</state>
<state id="end"/>
</scxml>

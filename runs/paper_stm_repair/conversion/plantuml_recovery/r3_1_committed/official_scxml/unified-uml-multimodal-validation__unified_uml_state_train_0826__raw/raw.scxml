<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SearchInitiated"/>
</state>
<state id="SearchInitiated">
<transition event="User initiates search" target="SearchProcessing"/>
</state>
<state id="SearchProcessing">
<transition event="User applies filters" target="FiltersApplied"/>
<transition event="No filters applied" target="TopFeaturesDisplayed"/>
</state>
<state id="FiltersApplied">
<transition event="System processes filters" target="ResultsFiltering"/>
</state>
<state id="TopFeaturesDisplayed">
<transition event="Search completed" target="end"/>
</state>
<state id="ResultsFiltering">
<transition event="Display filtered results" target="TopFeaturesDisplayed"/>
</state>
<state id="end"/>
</scxml>

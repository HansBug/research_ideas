<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="PoweredOff"/>
</state>
<state id="PoweredOff">
<transition event="start" target="Operate"/>
</state>
<state id="Operate">
<transition event="keyOff" target="PoweredOff"/>
<state id="startOperate">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="Accelerate Signal" target="AcceleratingOrCruising"/>
</state>
<state id="AcceleratingOrCruising">
<transition event="Brake Signal" target="Braking"/>
</state>
<state id="Braking">
<transition event="Stop Signal" target="Idle"/>
</state>
</state>
</scxml>

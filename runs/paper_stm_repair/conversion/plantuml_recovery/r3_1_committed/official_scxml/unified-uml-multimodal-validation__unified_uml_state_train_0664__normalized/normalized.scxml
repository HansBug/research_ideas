<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="Ready_to_Summarize_0938db">
<transition event="User inputs document" target="Processing_Document_bb63cc"/>
</state>
<state id="Processing_Document_bb63cc">
<transition event="Document exceeds 500 words" target="Document_Too_Long_5796be"/>
<transition event="Document within limit" target="Extracting_Main_Points_3f3194"/>
</state>
<state id="Document_Too_Long_5796be">
<transition event="Alert user and exit" target="end"/>
</state>
<state id="Extracting_Main_Points_3f3194">
<transition event="Quality check fails" target="Poor_Summary_Quality_bbc7fa"/>
<transition event="Quality check passes" target="Generating_Summary_095cc3"/>
</state>
<state id="Poor_Summary_Quality_bbc7fa">
<transition event="Suggest improvements and exit" target="end"/>
</state>
<state id="Generating_Summary_095cc3">
<transition event="Relevance check fails" target="Summary_Not_Relevant_b0849d"/>
<transition event="Relevance check passes" target="Providing_Feedback_0bef9c"/>
</state>
<state id="Summary_Not_Relevant_b0849d">
<transition event="Request more context and exit" target="end"/>
</state>
<state id="Providing_Feedback_0bef9c">
<transition event="User reviews summary" target="end"/>
<transition event="User requests re-analysis" target="Ready_to_Summarize_0938db"/>
</state>
<state id="start">
<transition target="Ready_to_Summarize_0938db"/>
</state>
<state id="end"/>
</scxml>

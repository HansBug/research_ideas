<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectingFields"/>
</state>
<state id="SelectingFields">
<transition event="Select fields to fill" target="GatheringData"/>
</state>
<state id="GatheringData">
<transition event="Gather required data" target="ValidatingData"/>
</state>
<state id="ValidatingData">
<transition event="Data validation successful" target="FillingForm"/>
<transition event="Data validation failed" target="GatheringData"/>
</state>
<state id="FillingForm">
<transition event="Form filled successfully" target="ReviewingData"/>
</state>
<state id="ReviewingData">
<transition event="Review and submit" target="end"/>
</state>
<state id="end"/>
</scxml>

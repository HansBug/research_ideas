<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UserAuthentication"/>
</state>
<state id="UserAuthentication">
<transition target="DatabaseAccess"/>
</state>
<state id="DatabaseAccess">
<transition target="DataManagement"/>
</state>
<state id="DataManagement">
<transition target="ConflictResolution"/>
</state>
<state id="ConflictResolution">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

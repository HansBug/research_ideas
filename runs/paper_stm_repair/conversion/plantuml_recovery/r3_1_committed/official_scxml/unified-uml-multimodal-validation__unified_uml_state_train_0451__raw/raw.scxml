<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="CreateListState"/>
</state>
<state id="CreateListState">
<transition event="Save" target="SavedListState"/>
<transition event="Cancel" target="end"/>
</state>
<state id="SavedListState">
<transition event="Access" target="AccessListState"/>
<transition event="Update" target="UpdateListState"/>
<transition event="Delete" target="DeleteListState"/>
</state>
<state id="end"/>
<state id="AccessListState">
<transition event="Update" target="UpdateListState"/>
<transition event="Delete" target="DeleteListState"/>
<transition event="Return" target="end"/>
</state>
<state id="UpdateListState">
<transition event="Save" target="SavedListState"/>
<transition event="Cancel" target="end"/>
</state>
<state id="DeleteListState">
<transition event="Delete" target="end"/>
</state>
</scxml>

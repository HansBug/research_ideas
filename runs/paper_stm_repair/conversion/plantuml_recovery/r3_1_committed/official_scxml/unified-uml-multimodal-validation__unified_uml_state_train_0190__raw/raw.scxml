<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="MonitoringState"/>
</state>
<state id="MonitoringState">
<transition event="Condition Not Met" target="MonitoringState"/>
<transition event="Condition Met" target="ConditionMetState"/>
<transition event="System Shutdown" target="end"/>
</state>
<state id="ConditionMetState">
<transition event="Send Notification" target="NotificationSentState"/>
</state>
<state id="NotificationSentState">
<transition event="Continue Monitoring" target="MonitoringState"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition event="Upload Document" target="UploadDocument"/>
<transition event="Manage Documents" target="ManageDocuments"/>
</state>
<state id="UploadDocument">
<transition event="Check File Type" target="CheckFileType"/>
</state>
<state id="ManageDocuments">
<transition event="View Document" target="ViewDocument"/>
<transition event="Edit Document" target="EditDocument"/>
<transition event="Delete Document" target="DeleteDocument"/>
<transition event="Move Document" target="MoveDocument"/>
</state>
<state id="CheckFileType">
<transition event="Check File Size" target="CheckFileSize"/>
</state>
<state id="CheckFileSize">
<transition event="Save Document" target="SaveDocument"/>
</state>
<state id="SaveDocument">
<transition event="Success" target="end"/>
</state>
<state id="end"/>
<state id="ViewDocument">
<transition event="Display Document" target="end"/>
</state>
<state id="EditDocument">
<transition event="Save Changes" target="SaveDocument"/>
<transition event="Cancel Edit" target="end"/>
</state>
<state id="DeleteDocument">
<transition event="Move to Trash" target="TrashDocument"/>
<transition event="Document Deleted" target="end"/>
</state>
<state id="MoveDocument">
<transition event="Change Folder" target="ChangeFolder"/>
</state>
<state id="TrashDocument">
<transition event="Document Deleted" target="end"/>
</state>
<state id="ChangeFolder">
<transition event="Document Moved" target="end"/>
</state>
<state id="SecurityCheck">
<transition event="Unauthorized" target="end"/>
<transition event="Authorized" target="UploadDocument"/>
</state>
</scxml>

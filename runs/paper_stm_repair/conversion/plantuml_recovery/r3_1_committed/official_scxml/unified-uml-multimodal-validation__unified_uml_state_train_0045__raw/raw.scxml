<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition target="DisplayTaskList"/>
</state>
<state id="DisplayTaskList">
<transition target="end"/>
<transition target="AddTaskInterface"/>
<transition target="DeleteTask"/>
<transition target="ViewProgress"/>
</state>
<state id="end"/>
<state id="AddTaskInterface">
<transition target="AddTaskWithDependencies"/>
</state>
<state id="AddTaskWithDependencies">
<transition target="UpdateTaskList"/>
<transition target="end"/>
</state>
<state id="UpdateTaskList">
<transition target="DisplayTaskList"/>
</state>
<state id="DeleteTask">
<transition target="RemoveTask"/>
<transition target="end"/>
</state>
<state id="RemoveTask">
<transition target="UpdateTaskList"/>
</state>
<state id="ViewProgress">
<transition target="DisplayProgressBar"/>
<transition target="end"/>
</state>
<state id="DisplayProgressBar">
<transition target="DisplayTaskList"/>
</state>
</scxml>

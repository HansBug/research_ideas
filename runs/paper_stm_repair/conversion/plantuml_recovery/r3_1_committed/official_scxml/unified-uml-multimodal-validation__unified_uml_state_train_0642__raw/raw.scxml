<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Monitoring"/>
</state>
<state id="Monitoring">
<transition event="Energy usage exceeds limit" target="ExceedingLimit"/>
<transition event="Generate detailed report" target="GeneratingReport"/>
<transition event="End process" target="end"/>
</state>
<state id="ExceedingLimit">
<transition event="Automatically adjust" target="AdjustingConsumption"/>
</state>
<state id="AdjustingConsumption">
<transition event="Back to monitoring" target="Monitoring"/>
</state>
<state id="GeneratingReport">
<transition event="Back to monitoring" target="Monitoring"/>
</state>
<state id="end"/>
</scxml>

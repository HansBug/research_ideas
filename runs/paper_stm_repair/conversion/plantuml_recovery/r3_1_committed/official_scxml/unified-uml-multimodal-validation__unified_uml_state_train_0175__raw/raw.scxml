<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="IdleState"/>
</state>
<state id="IdleState">
<transition event="User starts browsing/shopping" target="AnalysisState"/>
</state>
<state id="AnalysisState">
<transition event="Analyze user history" target="RecommendationState"/>
</state>
<state id="RecommendationState">
<transition event="Generate recommendations" target="PresentationState"/>
</state>
<state id="PresentationState">
<transition event="User decides to purchase" target="end"/>
<transition event="User continues browsing" target="RecommendationState"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ViewingProjects"/>
</state>
<state id="ViewingProjects">
<transition event="select project" target="SelectingProject"/>
</state>
<state id="SelectingProject">
<transition event="manage profiles" target="ManagingProfiles"/>
</state>
<state id="ManagingProfiles">
<transition event="edit profile" target="EditingProfile"/>
<transition event="delete profile" target="DeletingProfile"/>
<transition event="add profile" target="AddingProfile"/>
<transition event="switch project" target="SwitchingProjects"/>
<transition event="exit" target="end"/>
</state>
<state id="EditingProfile">
<transition event="save changes" target="SavingChanges"/>
</state>
<state id="SavingChanges">
<transition event="return to managing profiles" target="ManagingProfiles"/>
</state>
<state id="DeletingProfile">
<transition event="return to managing profiles" target="ManagingProfiles"/>
</state>
<state id="AddingProfile">
<transition event="return to managing profiles" target="ManagingProfiles"/>
</state>
<state id="SwitchingProjects">
<transition event="return to viewing projects" target="ViewingProjects"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectingLayoutAndContent"/>
</state>
<state id="SelectingLayoutAndContent">
<transition event="Apply changes" target="ApplyingChanges"/>
</state>
<state id="ApplyingChanges">
<transition event="View changes" target="ViewingCustomizedUI"/>
</state>
<state id="ViewingCustomizedUI">
<transition event="Change settings" target="SelectingLayoutAndContent"/>
<transition event="Exit" target="end"/>
</state>
<state id="end"/>
</scxml>

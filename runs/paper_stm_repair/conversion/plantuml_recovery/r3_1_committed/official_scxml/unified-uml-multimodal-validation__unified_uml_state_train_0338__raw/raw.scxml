<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition event="Analyze browsing history" target="AnalyzingBrowsingHistory"/>
</state>
<state id="AnalyzingBrowsingHistory">
<transition event="Identify relevant products" target="IdentifyingRelevantProducts"/>
</state>
<state id="IdentifyingRelevantProducts">
<transition event="Match products" target="MatchingProducts"/>
</state>
<state id="MatchingProducts">
<transition event="Provide product details" target="ProvidingProductDetails"/>
</state>
<state id="ProvidingProductDetails">
<transition event="Apply filters" target="ApplyingFilters"/>
</state>
<state id="ApplyingFilters">
<transition event="Display results" target="DisplayingResults"/>
</state>
<state id="DisplayingResults">
<transition event="Save products" target="SavingProducts"/>
</state>
<state id="SavingProducts">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

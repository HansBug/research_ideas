<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="RecordingEvent"/>
</state>
<state id="RecordingEvent">
<transition target="SavingEvent"/>
</state>
<state id="SavingEvent">
<transition target="ViewingTimeline"/>
</state>
<state id="ViewingTimeline">
<transition target="AnalyzingImpact"/>
</state>
<state id="AnalyzingImpact">
<transition target="SharingEvents"/>
</state>
<state id="SharingEvents">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Initial"/>
</state>
<state id="Initial">
<transition event="Complaint Received" target="ComplaintReceived"/>
</state>
<state id="ComplaintReceived">
<transition event="Start Resolution" target="ResolvingComplaint"/>
</state>
<state id="ResolvingComplaint">
<transition event="Resolution Completed" target="ComplaintResolved"/>
<transition event="Additional Resolution Steps" target="ResolvingComplaint"/>
</state>
<state id="ComplaintResolved">
<transition event="Resolution Finalized" target="end"/>
</state>
<state id="end"/>
</scxml>

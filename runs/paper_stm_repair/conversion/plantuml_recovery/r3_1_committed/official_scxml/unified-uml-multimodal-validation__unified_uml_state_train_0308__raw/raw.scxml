<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ViewShoppingCart"/>
</state>
<state id="ViewShoppingCart">
<transition event="Add Item" target="AddItemToCart"/>
<transition event="Remove Item" target="RemoveItemFromCart"/>
<transition event="Exit" target="end"/>
</state>
<state id="AddItemToCart">
<transition event="Return" target="ViewShoppingCart"/>
</state>
<state id="RemoveItemFromCart">
<transition event="Return" target="ViewShoppingCart"/>
</state>
<state id="end"/>
</scxml>

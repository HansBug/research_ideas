<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="Start Mission" target="Searching"/>
</state>
<state id="Searching">
<transition event="Intercepted" target="FormationAdjustment"/>
<transition event="Task Assignment Received" target="Attacking"/>
</state>
<state id="FormationAdjustment">
<transition event="Formation Adjusted" target="Searching"/>
</state>
<state id="Attacking">
<transition event="Attack Completed / UAV Count Decreased" target="Searching"/>
</state>
</scxml>

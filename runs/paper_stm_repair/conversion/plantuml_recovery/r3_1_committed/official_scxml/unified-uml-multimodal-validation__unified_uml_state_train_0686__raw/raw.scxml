<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="User inputs schedule/preferences" target="ProcessingSchedule"/>
<transition event="User requests productivity insights" target="ViewingInsights"/>
<transition event="System idle" target="end"/>
</state>
<state id="ProcessingSchedule">
<transition event="Analyze schedule/preferences" target="ProvidingTaskSuggestions"/>
<transition event="User requests productivity feedback" target="Feedback"/>
</state>
<state id="ViewingInsights">
<transition event="Insights displayed" target="Idle"/>
</state>
<state id="ProvidingTaskSuggestions">
<transition event="Task suggestions provided" target="Idle"/>
</state>
<state id="Feedback">
<transition event="Feedback provided" target="Idle"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="logout" target="end"/>
<transition event="create task" target="CreatingTask"/>
<transition event="set reminder" target="SettingReminder"/>
<transition event="view time management plan" target="ViewingPlan"/>
<transition event="access suggestions" target="ViewingSuggestions"/>
</state>
<state id="end"/>
<state id="CreatingTask">
<transition event="task created" target="Idle"/>
</state>
<state id="SettingReminder">
<transition event="reminder set" target="Idle"/>
</state>
<state id="ViewingPlan">
<transition event="plan reviewed" target="Idle"/>
</state>
<state id="ViewingSuggestions">
<transition event="suggestions reviewed" target="Idle"/>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DocumentUploaded"/>
</state>
<state id="DocumentUploaded">
<transition event="Delete" target="end"/>
<transition event="Edit" target="Editing"/>
<transition event="View" target="Viewing"/>
<transition event="Upload" target="UploadingNewVersion"/>
<transition event="Delete" target="end"/>
<transition event="Edit" target="Editing"/>
<transition event="View" target="Viewing"/>
<transition event="Upload" target="UploadingNewVersion"/>
</state>
<state id="end"/>
<state id="Editing">
<transition event="Save" target="DocumentUploaded"/>
<transition event="Cancel" target="end"/>
</state>
<state id="Viewing">
<transition event="Close" target="end"/>
</state>
<state id="UploadingNewVersion">
<transition event="Success" target="DocumentUploaded"/>
<transition event="Failure" target="end"/>
<transition event="Cancel" target="end"/>
<transition event="Success" target="DocumentUploaded"/>
<transition event="Failure" target="end"/>
</state>
</scxml>

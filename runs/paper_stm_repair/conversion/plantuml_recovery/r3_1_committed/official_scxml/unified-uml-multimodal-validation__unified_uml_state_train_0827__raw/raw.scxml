<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="TaskIdentification"/>
</state>
<state id="TaskIdentification">
<transition target="DependencyAnalysis"/>
</state>
<state id="DependencyAnalysis">
<transition target="ResourceAvailabilityCheck"/>
</state>
<state id="ResourceAvailabilityCheck">
<transition target="TaskAssignment"/>
</state>
<state id="TaskAssignment">
<transition target="TaskExecution"/>
</state>
<state id="TaskExecution">
<transition target="ProgressMonitoring"/>
</state>
<state id="ProgressMonitoring">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

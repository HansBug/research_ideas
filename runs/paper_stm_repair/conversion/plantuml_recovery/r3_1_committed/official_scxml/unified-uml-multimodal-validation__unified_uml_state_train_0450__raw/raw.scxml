<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="Add/Edit/Delete tasks" target="AddingEditingDeletingTasks"/>
</state>
<state id="AddingEditingDeletingTasks">
<transition event="View history" target="ViewingHistory"/>
<transition event="View status" target="ViewingStatus"/>
</state>
<state id="ViewingHistory">
<transition event="Check status" target="ViewingStatus"/>
</state>
<state id="ViewingStatus">
<transition event="Set reminders" target="SettingReminders"/>
<transition target="end"/>
</state>
<state id="SettingReminders">
<transition event="Receive notifications" target="ReceivingNotifications"/>
</state>
<state id="ReceivingNotifications">
<transition event="Check status" target="ViewingStatus"/>
<transition event="Add/Edit/Delete tasks" target="AddingEditingDeletingTasks"/>
</state>
<state id="end"/>
</scxml>

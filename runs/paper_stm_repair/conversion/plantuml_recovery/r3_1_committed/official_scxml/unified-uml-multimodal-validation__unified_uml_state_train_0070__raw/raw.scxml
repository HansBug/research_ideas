<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="LoggedIn"/>
</state>
<state id="LoggedIn">
<transition event="Click &quot;My Books&quot; tab" target="MyBooksList"/>
</state>
<state id="MyBooksList">
<transition event="Mark as read" target="MarkAsRead"/>
<transition event="Mark as unread" target="MarkAsUnread"/>
<transition event="Click &quot;Add Book&quot;" target="AddNewBook"/>
<transition event="View recommendations" target="ReceiveRecommendations"/>
<transition event="Logout" target="end"/>
</state>
<state id="MarkAsRead">
<transition event="Return to list" target="MyBooksList"/>
</state>
<state id="MarkAsUnread">
<transition event="Return to list" target="MyBooksList"/>
</state>
<state id="AddNewBook">
<transition event="Save book" target="MyBooksList"/>
</state>
<state id="ReceiveRecommendations">
<transition event="Return to list" target="MyBooksList"/>
</state>
<state id="end"/>
</scxml>

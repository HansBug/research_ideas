<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="CreateWorkspace"/>
</state>
<state id="CreateWorkspace">
<transition target="ManageWorkspaces"/>
</state>
<state id="ManageWorkspaces">
<transition target="SwitchWorkspaces"/>
</state>
<state id="SwitchWorkspaces">
<transition target="TrackUpdates"/>
</state>
<state id="TrackUpdates">
<transition target="AccessWorkspaces"/>
</state>
<state id="AccessWorkspaces">
<transition target="Collaborate"/>
</state>
<state id="Collaborate">
<transition target="CustomSettings"/>
</state>
<state id="CustomSettings">
<transition target="TrackChanges"/>
</state>
<state id="TrackChanges">
<transition target="SeeStatus"/>
</state>
<state id="SeeStatus">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

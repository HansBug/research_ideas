<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle_State"/>
</state>
<state id="Idle_State">
<transition event="User selects channel" target="Channel_Selected"/>
<transition target="end"/>
</state>
<state id="Channel_Selected">
<transition event="User updates content" target="Content_Updated"/>
</state>
<state id="Content_Updated">
<transition event="System updates all channels" target="Updating_Channels"/>
</state>
<state id="Updating_Channels">
<transition event="Updates complete" target="Idle_State"/>
<transition event="Update fails" target="Error_State"/>
</state>
<state id="Error_State">
<transition event="Error handled" target="Idle_State"/>
</state>
<state id="end"/>
</scxml>

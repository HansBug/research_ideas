<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="Receive cleanup request" target="ValidateCriteria"/>
</state>
<state id="ValidateCriteria">
<transition event="Criteria validated successfully" target="ProcessData"/>
<transition event="Criteria validation failed" target="ErrorState"/>
</state>
<state id="ProcessData">
<transition event="Data processing completed" target="CheckCompletion"/>
</state>
<state id="ErrorState">
<transition event="Send error notification" target="NotifyUser"/>
<transition event="Return to idle state" target="end"/>
</state>
<state id="CheckCompletion">
<transition event="Cleanup completed successfully" target="NotifyUser"/>
<transition event="Cleanup failed" target="ErrorState"/>
</state>
<state id="NotifyUser">
<transition event="Return to idle state" target="end"/>
</state>
<state id="end"/>
</scxml>

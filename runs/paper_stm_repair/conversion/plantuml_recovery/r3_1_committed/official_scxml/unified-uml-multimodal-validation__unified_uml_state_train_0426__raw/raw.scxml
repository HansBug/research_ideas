<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ViewOrders"/>
</state>
<state id="ViewOrders">
<transition target="end"/>
<transition target="ManageOrders"/>
</state>
<state id="end"/>
<state id="ManageOrders">
<transition target="ViewOrders"/>
<transition target="end"/>
</state>
</scxml>

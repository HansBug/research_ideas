<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Ready"/>
</state>
<state id="Ready">
<transition event="System Shutdown" target="end"/>
<transition event="View Address" target="ViewingAddress"/>
<transition event="Add New Address" target="AddingAddress"/>
<transition event="Update Address" target="UpdatingAddress"/>
<transition event="Search Address" target="SearchingAddress"/>
</state>
<state id="end"/>
<state id="ViewingAddress">
<transition event="Return to Ready" target="Ready"/>
</state>
<state id="AddingAddress">
<transition event="Return to Ready" target="Ready"/>
</state>
<state id="UpdatingAddress">
<transition event="Return to Ready" target="Ready"/>
</state>
<state id="SearchingAddress">
<transition event="Return to Ready" target="Ready"/>
</state>
</scxml>

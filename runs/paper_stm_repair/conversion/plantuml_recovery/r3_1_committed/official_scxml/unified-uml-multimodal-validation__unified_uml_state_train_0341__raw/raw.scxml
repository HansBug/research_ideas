<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Login"/>
</state>
<state id="Login">
<transition event="After valid login" target="ViewStock"/>
</state>
<state id="ViewStock">
<transition event="If stock is low" target="ReceiveAlert"/>
<transition event="If user sets reminder" target="SetReminder"/>
<transition event="If user analyzes inventory" target="AnalyzeInventory"/>
<transition event="Logout or exit" target="end"/>
</state>
<state id="ReceiveAlert">
<transition event="User sets reminder" target="SetReminder"/>
</state>
<state id="SetReminder">
<transition event="Reminder set" target="ViewStock"/>
</state>
<state id="AnalyzeInventory">
<transition event="Based on historical data" target="GetRecommendation"/>
</state>
<state id="GetRecommendation">
<transition event="Recommendations provided" target="ViewStock"/>
</state>
<state id="end"/>
</scxml>

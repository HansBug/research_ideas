<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="NoUserLoggedIn"/>
</state>
<state id="NoUserLoggedIn">
<transition event="Login" target="UserLoggedIn"/>
<transition target="end"/>
</state>
<state id="UserLoggedIn">
<transition event="Switch Profile" target="ProfileSelection"/>
<transition event="Logout" target="NoUserLoggedIn"/>
</state>
<state id="ProfileSelection">
<transition event="Select Profile" target="UserLoggedIn"/>
</state>
<state id="end"/>
</scxml>

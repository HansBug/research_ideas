<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ViewRecipes"/>
<transition target="SearchRecipes"/>
<transition target="AddRecipe"/>
</state>
<state id="ViewRecipes">
<transition target="EditRecipe"/>
<transition target="DeleteRecipe"/>
<transition target="OrganizeRecipes"/>
<transition target="AddRecipe"/>
<transition target="end"/>
</state>
<state id="SearchRecipes">
<transition target="ViewRecipes"/>
<transition target="end"/>
</state>
<state id="AddRecipe">
<transition target="ViewRecipes"/>
<transition target="OrganizeRecipes"/>
<transition target="end"/>
</state>
<state id="EditRecipe">
<transition target="ViewRecipes"/>
<transition target="OrganizeRecipes"/>
<transition target="end"/>
</state>
<state id="DeleteRecipe">
<transition target="ViewRecipes"/>
<transition target="OrganizeRecipes"/>
<transition target="end"/>
</state>
<state id="OrganizeRecipes">
<transition target="ViewRecipes"/>
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

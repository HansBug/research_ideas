<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ViewingCart"/>
</state>
<state id="ViewingCart">
<transition event="Exit" target="end"/>
<transition event="Add Item" target="AddingItems"/>
<transition event="Remove Item" target="RemovingItems"/>
<transition event="Update Item" target="UpdatingItems"/>
<transition event="Save Cart" target="SavingCart"/>
<transition event="Calculate Total" target="CalculatingTotal"/>
<transition event="Purchase Items" target="PurchasingItems"/>
</state>
<state id="end"/>
<state id="AddingItems">
<transition event="Item Added" target="ViewingCart"/>
</state>
<state id="RemovingItems">
<transition event="Item Removed" target="ViewingCart"/>
</state>
<state id="UpdatingItems">
<transition event="Item Updated" target="ViewingCart"/>
</state>
<state id="SavingCart">
<transition event="Cart Saved" target="end"/>
</state>
<state id="CalculatingTotal">
<transition event="Total Calculated" target="ViewingCart"/>
</state>
<state id="PurchasingItems">
<transition event="Purchase Complete" target="end"/>
</state>
</scxml>

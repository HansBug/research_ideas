<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Product_Display"/>
</state>
<state id="Product_Display">
<transition event="Exit" target="end"/>
<transition event="Customize" target="Customization_Options"/>
</state>
<state id="end"/>
<state id="Customization_Options">
<transition event="Add/Remove" target="Add_Remove_Items"/>
<transition event="Apply" target="Apply_Customization"/>
<transition event="Revert" target="Revert_Changes"/>
</state>
<state id="Add_Remove_Items">
<transition event="Back" target="Customization_Options"/>
</state>
<state id="Apply_Customization">
<transition event="Changes Applied" target="Product_Display"/>
</state>
<state id="Revert_Changes">
<transition event="Changes Reverted" target="Product_Display"/>
</state>
</scxml>

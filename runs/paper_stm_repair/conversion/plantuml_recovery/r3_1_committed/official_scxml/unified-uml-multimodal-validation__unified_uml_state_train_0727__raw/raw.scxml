<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DisplayMainMenu"/>
</state>
<state id="DisplayMainMenu">
<transition event="Search by name" target="SearchByName"/>
<transition event="Sort by quantity" target="SortByQuantity"/>
<transition event="Display inventory" target="DisplayInventoryList"/>
<transition event="Exit" target="end"/>
</state>
<state id="SearchByName">
<transition event="Perform search" target="DisplaySearchResults"/>
</state>
<state id="SortByQuantity">
<transition event="Sort items" target="DisplaySortedList"/>
</state>
<state id="DisplayInventoryList">
<transition event="Back to menu" target="DisplayMainMenu"/>
</state>
<state id="end"/>
<state id="DisplaySearchResults">
<transition event="Back to menu" target="DisplayMainMenu"/>
</state>
<state id="DisplaySortedList">
<transition event="Back to menu" target="DisplayMainMenu"/>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ViewOwnTasks"/>
</state>
<state id="ViewOwnTasks">
<transition event="Update own tasks" target="UpdateOwnTasks"/>
<transition event="View others' tasks" target="ViewOthersTasks"/>
</state>
<state id="UpdateOwnTasks">
<transition event="Return to view own tasks" target="ViewOwnTasks"/>
</state>
<state id="ViewOthersTasks">
<transition event="Coordinate tasks" target="CoordinateTasks"/>
<transition event="Receive updates" target="ReceiveUpdates"/>
</state>
<state id="CoordinateTasks">
<transition event="Continue viewing others' tasks" target="ViewOthersTasks"/>
<transition event="Update own tasks" target="UpdateOwnTasks"/>
</state>
<state id="ReceiveUpdates">
<transition event="Continue viewing others' tasks" target="ViewOthersTasks"/>
<transition event="Finish" target="end"/>
</state>
<state id="end"/>
</scxml>

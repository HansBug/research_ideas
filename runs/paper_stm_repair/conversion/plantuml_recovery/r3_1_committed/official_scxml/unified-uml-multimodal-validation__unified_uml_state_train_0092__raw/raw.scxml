<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="StartAutomation"/>
</state>
<state id="StartAutomation">
<transition target="PromptForInput"/>
</state>
<state id="PromptForInput">
<transition target="RetrieveTemplates"/>
</state>
<state id="RetrieveTemplates">
<transition target="FillData"/>
</state>
<state id="FillData">
<transition target="GenerateReport"/>
</state>
<state id="GenerateReport">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="User enters input" target="Generating"/>
<transition event="User manages responses" target="Managing"/>
<transition event="System shutdown" target="end"/>
</state>
<state id="Generating">
<transition event="Response created" target="Storing"/>
</state>
<state id="Storing">
<transition event="Response stored" target="Idle"/>
</state>
<state id="Managing">
<transition event="Response management complete" target="Idle"/>
</state>
<state id="end"/>
</scxml>

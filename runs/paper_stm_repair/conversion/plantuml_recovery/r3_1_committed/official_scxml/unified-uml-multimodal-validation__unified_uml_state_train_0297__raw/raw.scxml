<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition event="View Profile" target="ViewProfile"/>
<transition event="Add Profile" target="AddProfile"/>
</state>
<state id="ViewProfile">
<transition event="Edit Profile" target="EditProfile"/>
<transition event="Delete Profile" target="DeleteProfile"/>
<transition event="Customize Profile" target="CustomizeProfile"/>
<transition event="Back to Start" target="Start"/>
<transition event="Receive Notification" target="ReceiveNotification"/>
<transition event="Exit" target="end"/>
</state>
<state id="AddProfile">
<transition event="Back to Start" target="Start"/>
<transition event="View Added Profile" target="ViewProfile"/>
<transition event="Exit" target="end"/>
</state>
<state id="EditProfile">
<transition event="Back to Start" target="Start"/>
<transition event="View Edited Profile" target="ViewProfile"/>
<transition event="Exit" target="end"/>
</state>
<state id="DeleteProfile">
<transition event="Back to Start" target="Start"/>
<transition event="View Remaining Profiles" target="ViewProfile"/>
<transition event="Exit" target="end"/>
</state>
<state id="CustomizeProfile">
<transition event="Back to Start" target="Start"/>
<transition event="View Customized Profile" target="ViewProfile"/>
<transition event="Exit" target="end"/>
</state>
<state id="ReceiveNotification">
<transition event="Back to Start" target="Start"/>
<transition event="View Profile Again" target="ViewProfile"/>
<transition event="Exit" target="end"/>
</state>
<state id="end"/>
</scxml>

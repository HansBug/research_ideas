<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState"/>
<state id="initialState">
<transition event="User starts browsing" target="BrowsingProducts"/>
<transition event="User starts searching" target="SearchingProducts"/>
</state>
<state id="BrowsingProducts">
<transition event="User selects product" target="ViewProductDetails"/>
<transition event="User saves preferences" target="SavePreferences"/>
<state id="ViewProductDetails">
<transition event="System provides recommendations" target="ReceivingRecommendations"/>
<state id="ReceivingRecommendations">
<transition event="User selects recommended product" target="ViewProductDetails"/>
<transition event="User saves preferences" target="SavePreferences"/>
<transition event="Exit system" target="endReceivingRecommendations"/>
<state id="endReceivingRecommendations"/>
</state>
</state>
<state id="SavePreferences">
<transition event="Continue browsing" target="BrowsingProducts"/>
<transition event="Continue searching" target="SearchingProducts"/>
<transition event="Exit system" target="endSavePreferences"/>
<state id="endSavePreferences"/>
</state>
</state>
<state id="SearchingProducts">
<transition event="User selects product" target="ViewProductDetails"/>
<transition event="User saves preferences" target="SavePreferences"/>
</state>
</scxml>

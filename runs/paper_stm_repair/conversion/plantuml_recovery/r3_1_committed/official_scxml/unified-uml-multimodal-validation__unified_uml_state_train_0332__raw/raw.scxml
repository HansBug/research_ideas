<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="View Projects" target="ViewProjects"/>
<transition event="Search Projects" target="SearchProjects"/>
<transition event="Add New Project" target="AddProject"/>
<transition event="Edit/Delete Project" target="EditDeleteProject"/>
<transition event="Share Project" target="ShareProject"/>
<transition event="View History/Stats" target="ViewHistoryStats"/>
<transition target="end"/>
</state>
<state id="ViewProjects">
<transition event="Return to Idle" target="Idle"/>
<transition event="View Another Project" target="ViewProjects"/>
</state>
<state id="SearchProjects">
<transition event="Return to Idle" target="Idle"/>
<transition event="Search Again" target="SearchProjects"/>
</state>
<state id="AddProject">
<transition event="Return to Idle" target="Idle"/>
<transition event="Add Another Project" target="AddProject"/>
</state>
<state id="EditDeleteProject">
<transition event="Return to Idle" target="Idle"/>
<transition event="Edit/Delete Another Project" target="EditDeleteProject"/>
</state>
<state id="ShareProject">
<transition event="Return to Idle" target="Idle"/>
<transition event="Share Another Project" target="ShareProject"/>
</state>
<state id="ViewHistoryStats">
<transition event="Return to Idle" target="Idle"/>
<transition event="View Another Project's History" target="ViewHistoryStats"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="Create Task" target="CreatingTask"/>
<transition event="Exit" target="end"/>
</state>
<state id="CreatingTask">
<transition event="Edit Task" target="EditingTask"/>
<transition event="Delete Task" target="DeletingTask"/>
<transition event="Assign Task" target="AssigningTask"/>
</state>
<state id="EditingTask">
<transition event="Save Changes" target="CreatingTask"/>
<transition event="Delete Task" target="DeletingTask"/>
</state>
<state id="DeletingTask">
<transition event="Task Deleted" target="end"/>
</state>
<state id="AssigningTask">
<transition event="Task Assigned" target="TrackingProgress"/>
</state>
<state id="TrackingProgress">
<transition event="Task Completed" target="NotifyingCompletion"/>
</state>
<state id="NotifyingCompletion">
<transition event="Notification Sent" target="end"/>
</state>
<state id="end"/>
</scxml>

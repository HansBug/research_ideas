<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="State_c7332c"/>
<state id="start">
<transition target="ViewingProfile"/>
</state>
<state id="ViewingProfile">
<transition event="Edit Profile" target="EditingProfile"/>
<transition event="Delete Profile" target="DeletingProfile"/>
<transition event="Exit" target="end"/>
</state>
<state id="EditingProfile">
<transition event="Save Changes" target="ViewingProfile"/>
</state>
<state id="DeletingProfile">

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="Task_Created_7639ff">
<transition event="If assigned time slot" target="Task_Scheduled_f88a67"/>
<transition event="If not assigned time slot" target="Task_Unscheduled_a3e7fb"/>
</state>
<state id="Task_Scheduled_f88a67">
<transition event="If most important" target="Task_Prioritized_551771"/>
</state>
<state id="Task_Unscheduled_a3e7fb">
<transition event="If assigned time slot" target="Task_Scheduled_f88a67"/>
<transition event="If marked incomplete" target="Task_Incomplete_9ea4a3"/>
</state>
<state id="Task_Prioritized_551771">
<transition event="If started" target="Task_In_Progress_953c00"/>
<transition event="If rescheduled" target="Task_Scheduled_f88a67"/>
</state>
<state id="Task_In_Progress_953c00">
<transition event="If completed" target="Task_Completed_3ce609"/>
<transition event="If paused" target="Task_In_Progress_953c00"/>
</state>
<state id="Task_Incomplete_9ea4a3">
<transition target="end"/>
</state>
<state id="Task_Completed_3ce609">
<transition target="end"/>
</state>
<state id="start">
<transition target="Task_Created_7639ff"/>
</state>
<state id="end"/>
</scxml>

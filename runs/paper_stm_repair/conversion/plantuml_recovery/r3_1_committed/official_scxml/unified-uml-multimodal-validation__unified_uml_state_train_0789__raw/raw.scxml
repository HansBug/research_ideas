<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition target="CreateInventory"/>
</state>
<state id="CreateInventory">
<transition target="InventoryCreated"/>
</state>
<state id="InventoryCreated">
<transition target="AddRemoveItems"/>
<transition target="SearchItems"/>
<transition target="ViewAllItems"/>
<transition target="ViewByCategory"/>
<transition target="ExitSystem"/>
</state>
<state id="AddRemoveItems">
<transition target="InventoryCreated"/>
</state>
<state id="SearchItems">
<transition target="InventoryCreated"/>
</state>
<state id="ViewAllItems">
<transition target="InventoryCreated"/>
</state>
<state id="ViewByCategory">
<transition target="InventoryCreated"/>
</state>
<state id="ExitSystem">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

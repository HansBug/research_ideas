<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ConnectingToProjectManagementTool"/>
</state>
<state id="ConnectingToProjectManagementTool">
<transition target="GatheringTeamMemberData"/>
</state>
<state id="GatheringTeamMemberData">
<transition target="AnalyzingTasks"/>
</state>
<state id="AnalyzingTasks">
<transition target="AssigningTasks"/>
</state>
<state id="AssigningTasks">
<transition target="PrioritizingTasks"/>
</state>
<state id="PrioritizingTasks">
<transition target="DisplayingAssignedTasks"/>
</state>
<state id="DisplayingAssignedTasks">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

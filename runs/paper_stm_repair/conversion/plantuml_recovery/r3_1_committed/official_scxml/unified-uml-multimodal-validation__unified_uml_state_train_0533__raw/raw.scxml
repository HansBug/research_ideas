<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DisplaySearchInterface"/>
</state>
<state id="DisplaySearchInterface">
<transition event="Enter keyword/phrase and click Search" target="PerformSearch"/>
</state>
<state id="PerformSearch">
<transition event="Search completed" target="DisplayResults"/>
</state>
<state id="DisplayResults">
<transition event="View results or return to search" target="end"/>
<transition event="Sort by column header click" target="DisplayResults"/>
<transition event="Filter documents (all, matching, non-matching)" target="DisplayResults"/>
<transition event="View document details" target="DisplayResults"/>
<transition event="Exit" target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="LoggedIn"/>
</state>
<state id="LoggedIn">
<transition event="Logout" target="end"/>
<transition event="Start Tracking" target="TrackingAttendance"/>
<transition event="View Attendance" target="ViewingAttendance"/>
</state>
<state id="end"/>
<state id="TrackingAttendance">
<transition event="Stop Tracking" target="end"/>
<transition event="Continue Tracking" target="TrackingAttendance"/>
<transition event="Detect Away" target="AwayFromWorkspace"/>
</state>
<state id="ViewingAttendance">
<transition event="Back" target="LoggedIn"/>
</state>
<state id="AwayFromWorkspace">
<transition event="Notification Sent" target="LoggedIn"/>
</state>
</scxml>

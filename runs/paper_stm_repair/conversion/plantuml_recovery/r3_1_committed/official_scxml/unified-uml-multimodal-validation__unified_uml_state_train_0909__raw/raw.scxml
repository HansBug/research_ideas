<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="StartIntegration"/>
</state>
<state id="StartIntegration">
<transition event="Initiate Payment Integration" target="ConnectingPaymentService"/>
<transition event="Link Social Media Account" target="ConnectingSocialMedia"/>
<transition event="Connect to Marketplace" target="ConnectingMarketplace"/>
</state>
<state id="ConnectingPaymentService">
<transition event="Payment Service Connected" target="UsingIntegratedFeatures"/>
</state>
<state id="UsingIntegratedFeatures">
<transition event="End Integration" target="end"/>
</state>
<state id="ConnectingSocialMedia">
<transition event="Social Media Connected" target="UsingIntegratedFeatures"/>
</state>
<state id="ConnectingMarketplace">
<transition event="Marketplace Connected" target="UsingIntegratedFeatures"/>
</state>
<state id="end"/>
</scxml>

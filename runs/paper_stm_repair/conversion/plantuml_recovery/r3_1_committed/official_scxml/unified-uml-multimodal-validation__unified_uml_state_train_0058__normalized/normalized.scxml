<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="Ready_to_Upload_1dbb89">
<transition event="User uploads a file" target="Processing_File_9b7c10"/>
</state>
<state id="Processing_File_9b7c10">
<transition event="System processes the file" target="Recognizing_File_Type_541d1c"/>
</state>
<state id="Recognizing_File_Type_541d1c">
<transition event="System recognizes file type" target="Displaying_File_List_adb42b"/>
</state>
<state id="Displaying_File_List_adb42b">
<transition event="User selects file type" target="Displaying_File_369d4b"/>
</state>
<state id="Displaying_File_369d4b">
<transition event="File displayed and system returns to initial state" target="end"/>
</state>
<state id="start">
<transition target="Ready_to_Upload_1dbb89"/>
</state>
<state id="end"/>
</scxml>

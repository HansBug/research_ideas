<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="CourseOrTopicSelected"/>
</state>
<state id="CourseOrTopicSelected">
<transition target="LearningPathsSuggested"/>
</state>
<state id="LearningPathsSuggested">
<transition target="LearningPathSelected"/>
</state>
<state id="LearningPathSelected">
<transition target="LearningPathAdapted"/>
</state>
<state id="LearningPathAdapted">
<transition target="AdditionalResourcesProvided"/>
</state>
<state id="AdditionalResourcesProvided">
<transition target="LearningPathUpdated"/>
</state>
<state id="LearningPathUpdated">
<transition target="LearningPathAdapted"/>
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SearchPage"/>
</state>
<state id="SearchPage">
<transition event="Enter search query" target="ProcessingSearch"/>
</state>
<state id="ProcessingSearch">
<transition event="Display results" target="ShowResults"/>
</state>
<state id="ShowResults">
<transition event="Select result" target="SelectResult"/>
</state>
<state id="SelectResult">
<transition event="Save result" target="end"/>
<transition event="Search again" target="SearchPage"/>
</state>
<state id="end"/>
</scxml>

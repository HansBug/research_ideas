<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UploadProfile"/>
</state>
<state id="UploadProfile">
<transition target="ViewProfiles"/>
</state>
<state id="ViewProfiles">
<transition target="ManageProfiles"/>
<transition target="SwitchProfile"/>
<transition target="end"/>
</state>
<state id="ManageProfiles">
<transition target="ViewProfiles"/>
</state>
<state id="SwitchProfile">
<transition target="ViewProfiles"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UserTyping"/>
</state>
<state id="UserTyping">
<transition event="System triggers suggestions" target="SuggestionsShown"/>
<transition event="User stops typing" target="SearchResults"/>
</state>
<state id="SuggestionsShown">
<transition event="User selects suggestion" target="SearchResults"/>
<transition event="User continues typing" target="UserTyping"/>
</state>
<state id="SearchResults">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

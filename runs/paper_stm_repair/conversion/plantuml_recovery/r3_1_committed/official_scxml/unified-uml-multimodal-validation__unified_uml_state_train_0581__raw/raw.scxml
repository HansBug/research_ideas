<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ViewProfile"/>
<transition target="UpdateProfile"/>
<transition target="ResetPassword"/>
<transition target="ControlAccess"/>
<transition target="TrackChanges"/>
<transition target="ReportIssues"/>
<transition target="LogoutSecurely"/>
</state>
<state id="ViewProfile">
<transition target="end"/>
<transition target="UpdateProfile"/>
<transition target="ResetPassword"/>
<transition target="ControlAccess"/>
<transition target="TrackChanges"/>
<transition target="ReportIssues"/>
<transition target="LogoutSecurely"/>
</state>
<state id="UpdateProfile">
<transition target="end"/>
<transition target="ViewProfile"/>
<transition target="ResetPassword"/>
<transition target="ControlAccess"/>
<transition target="TrackChanges"/>
<transition target="ReportIssues"/>
<transition target="LogoutSecurely"/>
</state>
<state id="ResetPassword">
<transition target="end"/>
<transition target="ViewProfile"/>
<transition target="UpdateProfile"/>
<transition target="ControlAccess"/>
<transition target="TrackChanges"/>
<transition target="ReportIssues"/>
<transition target="LogoutSecurely"/>
</state>
<state id="ControlAccess">
<transition target="end"/>
<transition target="ViewProfile"/>
<transition target="UpdateProfile"/>
<transition target="ResetPassword"/>
<transition target="TrackChanges"/>
<transition target="ReportIssues"/>
<transition target="LogoutSecurely"/>
</state>
<state id="TrackChanges">
<transition target="end"/>
<transition target="ViewProfile"/>
<transition target="UpdateProfile"/>
<transition target="ResetPassword"/>
<transition target="ControlAccess"/>
<transition target="ReportIssues"/>
<transition target="LogoutSecurely"/>
</state>
<state id="ReportIssues">
<transition target="end"/>
<transition target="ViewProfile"/>
<transition target="UpdateProfile"/>
<transition target="ResetPassword"/>
<transition target="ControlAccess"/>
<transition target="TrackChanges"/>
<transition target="LogoutSecurely"/>
</state>
<state id="LogoutSecurely">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SearchNotInitiated"/>
</state>
<state id="SearchNotInitiated">
<transition event="User stops searching" target="end"/>
<transition event="User starts search" target="SearchInitiated"/>
</state>
<state id="end"/>
<state id="SearchInitiated">
<transition event="System begins analysis" target="QueryAnalysis"/>
</state>
<state id="QueryAnalysis">
<transition event="Results generated" target="ResultsGenerated"/>
</state>
<state id="ResultsGenerated">
<transition event="User selects result" target="end"/>
<transition event="User refines search" target="SearchInitiated"/>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="View Customer" target="ViewCustomerInformation"/>
<transition event="Add Customer" target="AddNewCustomer"/>
<transition event="Edit Customer" target="EditCustomer"/>
<transition event="Delete Customer" target="DeleteCustomer"/>
<transition event="Handle Multiple Records" target="HandleMultipleRecords"/>
</state>
<state id="ViewCustomerInformation">
<transition target="end"/>
</state>
<state id="AddNewCustomer">
<transition target="end"/>
</state>
<state id="EditCustomer">
<transition target="end"/>
</state>
<state id="DeleteCustomer">
<transition target="end"/>
</state>
<state id="HandleMultipleRecords">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

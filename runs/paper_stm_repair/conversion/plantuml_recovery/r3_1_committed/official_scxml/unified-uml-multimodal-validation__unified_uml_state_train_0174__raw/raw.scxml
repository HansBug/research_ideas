<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ViewActivities"/>
</state>
<state id="ViewActivities">
<transition event="Filter" target="FilterActivities"/>
<transition event="Search" target="SearchActivities"/>
<transition event="View Details" target="ViewDetails"/>
<transition event="Exit" target="end"/>
<transition event="Generate Report" target="GenerateReport"/>
<transition event="No Results" target="NoResults"/>
</state>
<state id="FilterActivities">
<transition event="Filter Results" target="ViewActivities"/>
<transition event="Exit" target="end"/>
</state>
<state id="SearchActivities">
<transition event="Search Results" target="ViewActivities"/>
<transition event="Exit" target="end"/>
</state>
<state id="ViewDetails">
<transition event="Back to List" target="ViewActivities"/>
<transition event="Exit" target="end"/>
</state>
<state id="end"/>
<state id="GenerateReport">
<transition event="Show Trends" target="ShowTrends"/>
<transition event="Exit" target="end"/>
</state>
<state id="ShowTrends">
<transition event="Exit" target="end"/>
<transition event="Back to List" target="ViewActivities"/>
</state>
<state id="NoResults">
<transition event="Exit" target="end"/>
</state>
</scxml>

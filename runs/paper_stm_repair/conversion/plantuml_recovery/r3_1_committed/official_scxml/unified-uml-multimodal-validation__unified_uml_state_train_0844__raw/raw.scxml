<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DisplayTaskList"/>
</state>
<state id="DisplayTaskList">
<transition event="Search by keyword/description" target="SearchTasks"/>
<transition event="Sort by priority/due date" target="SortTasks"/>
<transition event="View completed tasks" target="ViewCompleted"/>
<transition event="View incomplete tasks" target="ViewIncomplete"/>
<transition event="Add task to list" target="AddTask"/>
<transition event="Remove task from list" target="RemoveTask"/>
<transition event="Exit" target="end"/>
</state>
<state id="SearchTasks">
<transition event="Return to display" target="DisplayTaskList"/>
</state>
<state id="SortTasks">
<transition event="Return to display" target="DisplayTaskList"/>
</state>
<state id="ViewCompleted">
<transition event="Return to display" target="DisplayTaskList"/>
</state>
<state id="ViewIncomplete">
<transition event="Return to display" target="DisplayTaskList"/>
</state>
<state id="AddTask">
<transition event="Return to display" target="DisplayTaskList"/>
</state>
<state id="RemoveTask">
<transition event="Return to display" target="DisplayTaskList"/>
</state>
<state id="end"/>
</scxml>

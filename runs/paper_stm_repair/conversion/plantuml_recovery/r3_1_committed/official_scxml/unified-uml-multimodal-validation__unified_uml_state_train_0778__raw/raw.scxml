<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="View Profile" target="ViewingProfile"/>
<transition event="Search/Filter" target="SearchingFiltering"/>
<transition event="Edit Profile" target="EditingProfile"/>
</state>
<state id="ViewingProfile">
<transition event="Edit" target="EditingProfile"/>
<transition event="Search/Filter" target="SearchingFiltering"/>
</state>
<state id="SearchingFiltering">
<transition event="View" target="ViewingProfile"/>
<transition event="Cancel" target="end"/>
<transition event="Error" target="ErrorHandling"/>
</state>
<state id="EditingProfile">
<transition event="Save Changes" target="UpdatingProfile"/>
<transition event="Cancel" target="end"/>
<transition event="Error" target="ErrorHandling"/>
</state>
<state id="UpdatingProfile">
<transition event="Success" target="Completion"/>
<transition event="Error" target="ErrorHandling"/>
</state>
<state id="end"/>
<state id="ErrorHandling">
<transition event="Exit" target="end"/>
<transition event="Retry" target="EditingProfile"/>
<transition event="Retry" target="SearchingFiltering"/>
</state>
<state id="Completion">
<transition event="Return" target="end"/>
</state>
</scxml>

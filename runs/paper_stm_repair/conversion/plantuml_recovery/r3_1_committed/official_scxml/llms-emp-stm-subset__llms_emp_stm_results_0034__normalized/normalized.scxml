<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="startTrainStateMachine_c2fe6e" version="1.0">
<state id="TrainStateMachine_c2fe6e">
<state id="startTrainStateMachine_c2fe6e">
<transition target="DoorsClosing"/>
</state>
<state id="DoorsClosing">
<transition event="Closed/SendDeparted" target="InMotion"/>
</state>
<state id="InMotion">
<transition event="Arrived/Stop, Send Arrived" target="Stopping"/>
<transition event="Obstacle Detected" target="EmergencyStopping"/>
<transition target="Accelerating"/>
<transition target="Cruising"/>
</state>
<state id="Stopping"/>
<state id="EmergencyStopping">
<transition event="Obstacle Cleared" target="endTrainStateMachine_c2fe6e"/>
</state>
<state id="endTrainStateMachine_c2fe6e"/>
<state id="Accelerating">
<transition event="Reached Cruising/Cruise" target="Cruising"/>
<transition event="Approached/Decelerate" target="Approaching"/>
</state>
<state id="Cruising">
<transition event="Approached/Decelerate" target="Approaching"/>
</state>
<state id="Approaching">
<transition target="InMotion"/>
<transition event="Ready to Stop" target="Stopping"/>
<transition event="Destination Missed" target="endTrainStateMachine_c2fe6e"/>
</state>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="Idle_State_62e7c6">
<transition event="On User Request" target="Tracking_Inventory_6bb0d7"/>
</state>
<state id="Tracking_Inventory_6bb0d7">
<transition target="Collecting_Product_Data_edd57e"/>
</state>
<state id="Collecting_Product_Data_edd57e">
<transition target="Calculating_Total_Stock_14047f"/>
</state>
<state id="Calculating_Total_Stock_14047f">
<transition target="Analyzing_Inventory_dafa4d"/>
</state>
<state id="Analyzing_Inventory_dafa4d">
<transition event="On Completion" target="Idle_State_62e7c6"/>
<transition event="On Decision Needed" target="Making_Inventory_Decisions_cc6fc6"/>
</state>
<state id="Making_Inventory_Decisions_cc6fc6">
<transition event="On Decision Made" target="Idle_State_62e7c6"/>
</state>
<state id="start">
<transition target="Idle_State_62e7c6"/>
</state>
</scxml>

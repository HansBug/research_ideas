<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition event="Begin creating learning path" target="CreatingLearningPath"/>
</state>
<state id="CreatingLearningPath">
<transition event="Learning path created" target="AccessingContent"/>
</state>
<state id="AccessingContent">
<transition event="Accessing more content" target="AccessingContent"/>
<transition event="Request recommendations" target="ReceivingRecommendations"/>
</state>
<state id="ReceivingRecommendations">
<transition event="Receiving more recommendations" target="ReceivingRecommendations"/>
<transition event="Track progress" target="TrackingProgress"/>
</state>
<state id="TrackingProgress">
<transition event="Continue tracking" target="TrackingProgress"/>
<transition event="Switch learning path" target="CreatingLearningPath"/>
<transition event="Exit" target="end"/>
</state>
<state id="end"/>
</scxml>

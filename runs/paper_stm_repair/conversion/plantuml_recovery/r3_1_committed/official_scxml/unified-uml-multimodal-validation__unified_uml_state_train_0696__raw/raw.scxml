<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ApplicationStart"/>
</state>
<state id="ApplicationStart">
<transition event="Add Expense" target="AddingExpense"/>
<transition event="Edit Expense" target="EditingExpense"/>
<transition event="View/Search Expenses" target="ViewingExpenses"/>
<transition event="Exit" target="end"/>
</state>
<state id="AddingExpense">
<transition event="Save" target="ExpenseSaved"/>
<transition event="Cancel" target="ApplicationStart"/>
</state>
<state id="EditingExpense">
<transition event="Update" target="ExpenseUpdated"/>
<transition event="Cancel" target="ApplicationStart"/>
</state>
<state id="ViewingExpenses">
<transition event="Generate Report" target="GeneratingReport"/>
<transition event="Receive Reminder" target="ReceivingReminder"/>
<transition event="Return to Start" target="ApplicationStart"/>
</state>
<state id="ExpenseSaved"/>
<state id="ExpenseUpdated"/>
<state id="GeneratingReport">
<transition event="Generate" target="ReportGenerated"/>
<transition event="Cancel" target="ViewingExpenses"/>
</state>
<state id="ReceivingReminder">
<transition event="Acknowledge" target="ReminderAcknowledged"/>
<transition event="Dismiss" target="ViewingExpenses"/>
</state>
<state id="ReportGenerated"/>
<state id="ReminderAcknowledged"/>
<state id="end"/>
</scxml>

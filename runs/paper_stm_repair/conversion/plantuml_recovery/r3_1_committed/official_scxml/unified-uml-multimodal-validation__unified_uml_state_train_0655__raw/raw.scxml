<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SearchQueryReceived"/>
</state>
<state id="SearchQueryReceived">
<transition event="Process query" target="ProcessingSearch"/>
</state>
<state id="ProcessingSearch">
<transition event="Analyze sentiment" target="SentimentAnalysis"/>
<transition event="Error or cancel" target="end"/>
</state>
<state id="SentimentAnalysis">
<transition event="Generate summary" target="GeneratingSummary"/>
<transition event="Error or cancel" target="end"/>
</state>
<state id="GeneratingSummary">
<transition event="Apply filters" target="FilteringResults"/>
<transition event="Error or cancel" target="end"/>
</state>
<state id="FilteringResults">
<transition event="Display results" target="DisplayingResults"/>
<transition event="Error or cancel" target="end"/>
</state>
<state id="DisplayingResults">
<transition event="Return to initial state" target="end"/>
<transition event="Error or cancel" target="end"/>
</state>
<state id="end"/>
</scxml>

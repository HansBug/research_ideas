<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="User starts" target="CreateProfile"/>
</state>
<state id="CreateProfile">
<transition event="Profile created" target="ProfileCreated"/>
<transition event="User logs in" target="Login"/>
</state>
<state id="ProfileCreated"/>
<state id="Login">
<transition event="Profile loaded" target="ProfileLoaded"/>
</state>
<state id="ProfileLoaded">
<transition event="View profile" target="ProfileViewed"/>
</state>
<state id="ProfileViewed">
<transition event="Update profile" target="ProfileUpdated"/>
<transition event="Delete profile" target="ProfileDeleted"/>
<transition event="Manage settings" target="ProfileSettings"/>
<transition event="Search users" target="SearchResults"/>
</state>
<state id="ProfileUpdated">
<transition event="Profile updated" target="ProfileViewed"/>
</state>
<state id="ProfileDeleted">
<transition event="Profile deleted" target="end"/>
</state>
<state id="ProfileSettings">
<transition event="Settings updated" target="ProfileViewed"/>
</state>
<state id="SearchResults">
<transition event="Return to profile" target="ProfileViewed"/>
<transition event="View other profile" target="ViewOtherProfile"/>
</state>
<state id="ViewOtherProfile"/>
<state id="end"/>
</scxml>

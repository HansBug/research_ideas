<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SearchInitiated"/>
</state>
<state id="SearchInitiated">
<transition event="Process search query" target="ProcessingSearch"/>
<transition event="Cancel" target="end"/>
</state>
<state id="ProcessingSearch">
<transition event="Display results" target="DisplayingResults"/>
<transition event="Error" target="end"/>
</state>
<state id="DisplayingResults">
<transition event="Filter results" target="FilteringResults"/>
<transition event="Save results" target="SavingResults"/>
<transition event="Fetch external data" target="FetchingExternalData"/>
<transition event="Exit" target="end"/>
</state>
<state id="FilteringResults">
<transition event="Update display" target="DisplayingResults"/>
</state>
<state id="SavingResults">
<transition event="Complete" target="end"/>
</state>
<state id="FetchingExternalData">
<transition event="Combine results" target="CombiningResults"/>
</state>
<state id="CombiningResults">
<transition event="Update results" target="DisplayingResults"/>
<transition event="Provide feedback" target="ProvidingFeedback"/>
</state>
<state id="ProvidingFeedback">
<transition event="Complete" target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ViewContacts"/>
</state>
<state id="ViewContacts">
<transition target="SearchContact"/>
<transition target="AddContact"/>
<transition target="ViewContacts"/>
<transition target="end"/>
</state>
<state id="SearchContact">
<transition target="ViewContacts"/>
<transition target="UpdateContact"/>
</state>
<state id="AddContact">
<transition target="AddContact"/>
<transition target="ViewContacts"/>
</state>
<state id="UpdateContact">
<transition target="ViewContacts"/>
</state>
<state id="end"/>
</scxml>

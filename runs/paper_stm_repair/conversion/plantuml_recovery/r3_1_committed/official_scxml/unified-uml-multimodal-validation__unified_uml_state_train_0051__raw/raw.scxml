<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="TaskCreated"/>
</state>
<state id="TaskCreated">
<transition event="Mark In Progress" target="InProgress"/>
<transition event="Mark On Hold" target="OnHold"/>
<transition event="Cancel Task" target="Cancelled"/>
</state>
<state id="InProgress">
<transition event="Approaching Due Date" target="NearDueDate"/>
<transition event="Pass Due Date" target="Overdue"/>
<transition event="Complete Task" target="Completed"/>
</state>
<state id="OnHold">
<transition event="Resume Task" target="InProgress"/>
<transition event="Cancel Task" target="Cancelled"/>
</state>
<state id="Cancelled">
<transition target="end"/>
</state>
<state id="NearDueDate">
<transition event="Pass Due Date" target="Overdue"/>
<transition event="Complete Task" target="Completed"/>
</state>
<state id="Overdue">
<transition event="Complete Task" target="Completed"/>
<transition event="Cancel Task" target="Cancelled"/>
</state>
<state id="Completed">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

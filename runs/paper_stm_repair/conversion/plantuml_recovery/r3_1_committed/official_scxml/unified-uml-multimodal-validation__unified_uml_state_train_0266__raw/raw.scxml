<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Access_Experience_Manager"/>
</state>
<state id="Access_Experience_Manager">
<transition target="Select_Predefined_Scene"/>
<transition target="Add_Custom_Content"/>
</state>
<state id="Select_Predefined_Scene">
<transition target="Choose_Game_Activity"/>
<transition target="Access_Experience_Manager"/>
</state>
<state id="Add_Custom_Content">
<transition target="Access_Experience_Manager"/>
<transition target="Customize_Settings"/>
</state>
<state id="Choose_Game_Activity">
<transition target="Customize_Settings"/>
</state>
<state id="Customize_Settings">
<transition target="Add_Custom_Content"/>
<transition target="Finalize_Experience"/>
</state>
<state id="Finalize_Experience">
<transition target="Share_Experience"/>
</state>
<state id="Share_Experience">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="TurnOn"/>
</state>
<state id="TurnOn">
<transition target="fork1"/>
</state>
<state id="fork1">
<transition target="AutoFocus"/>
<transition target="DetLight"/>
<transition target="choice3"/>
</state>
<state id="AutoFocus">
<transition event="[memFull=true]" target="choice1"/>
</state>
<state id="DetLight">
<transition event="«GaStep»{prob=0.4}" target="choice2"/>
</state>
<state id="choice1"/>
<state id="choice2">
<transition event="[sunny=true]" target="Join2"/>
</state>
<state id="choice3">
<transition target="ChargedFlash"/>
<transition target="Junction3"/>
</state>
<state id="ChargedFlash">
<transition event="[Charged=true]" target="Junction3"/>
</state>
<state id="Junction3">
<transition target="Join2"/>
</state>
<state id="Join2">
<transition target="Join1"/>
<transition target="Fork2"/>
</state>
<state id="Join1">
<transition target="Junction2"/>
</state>
<state id="Junction2">
<transition target="TakePicture"/>
</state>
<state id="TakePicture">
<transition target="WriteMemory"/>
</state>
<state id="WriteMemory">
<transition target="Junction1"/>
</state>
<state id="Junction1">
<transition target="TurnOff"/>
</state>
<state id="TurnOff">
<transition target="end"/>
</state>
<state id="end"/>
<state id="Fork2">
<transition target="Junction2"/>
<transition target="Flash"/>
</state>
<state id="Flash">
<transition target="Terminate"/>
</state>
<state id="Terminate">
<transition target="end"/>
</state>
</scxml>

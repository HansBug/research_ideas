<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="PoweredOn"/>
</state>
<state id="PoweredOn">
<transition event="start" target="Operate"/>
<transition event="keyOff" target="end"/>
</state>
<state id="Operate">
<transition event="user idle" target="Idle"/>
<transition event="user accelerate or cruise" target="AcceleratingCruising"/>
<transition event="user brake" target="Braking"/>
</state>
<state id="Idle">
<transition event="user action" target="Operate"/>
</state>
<state id="AcceleratingCruising">
<transition event="user action" target="Operate"/>
</state>
<state id="Braking">
<transition event="user action" target="Operate"/>
</state>
<state id="end"/>
</scxml>

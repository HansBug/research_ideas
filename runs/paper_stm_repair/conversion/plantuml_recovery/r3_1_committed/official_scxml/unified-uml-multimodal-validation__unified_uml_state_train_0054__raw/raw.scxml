<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="IdleState"/>
</state>
<state id="IdleState">
<transition event="User starts setting prices" target="SettingPrices"/>
<transition event="User wants to track prices" target="TrackingPrices"/>
<transition event="System displays prices to customers" target="DisplayingPrices"/>
</state>
<state id="SettingPrices">
<transition event="User adjusts prices based on factors" target="AdjustingPrices"/>
<transition event="Prices are ready to display" target="DisplayingPrices"/>
<transition event="User finishes setting prices" target="IdleState"/>
</state>
<state id="TrackingPrices">
<transition event="User views price comparisons" target="DisplayingPrices"/>
<transition event="User finishes tracking prices" target="IdleState"/>
</state>
<state id="DisplayingPrices">
<transition event="Prices displayed to customers" target="end"/>
<transition event="Display process completes" target="IdleState"/>
</state>
<state id="AdjustingPrices">
<transition event="System provides price recommendations" target="ReceivingRecommendations"/>
<transition event="Updated prices are displayed" target="DisplayingPrices"/>
<transition event="Price adjustment complete" target="IdleState"/>
</state>
<state id="ReceivingRecommendations">
<transition event="User implements recommendations" target="AdjustingPrices"/>
<transition event="User reviews recommendations" target="IdleState"/>
</state>
<state id="end">
<transition target="IdleState"/>
</state>
</scxml>

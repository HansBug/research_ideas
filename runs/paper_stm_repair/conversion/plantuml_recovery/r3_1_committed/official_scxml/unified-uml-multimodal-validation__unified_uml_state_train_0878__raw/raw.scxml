<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="NotLoggedIn"/>
</state>
<state id="NotLoggedIn">
<transition event="User attempts to login" target="Login"/>
<transition event="User creates new profile" target="ProfileCreation"/>
</state>
<state id="Login">
<transition event="Authentication successful" target="LoggedIn"/>
</state>
<state id="ProfileCreation">
<transition event="Profile creation failed" target="end"/>
<transition event="Profile creation successful" target="NotLoggedIn"/>
</state>
<state id="LoggedIn">
<transition event="View profile" target="ViewProfile"/>
<transition event="Edit profile" target="EditProfile"/>
<transition event="Track progress" target="TrackProgress"/>
<transition event="Logout" target="Logout"/>
</state>
<state id="ViewProfile"/>
<state id="EditProfile">
<transition event="Save changes" target="ViewProfile"/>
</state>
<state id="TrackProgress">
<transition event="View progress" target="ViewProfile"/>
</state>
<state id="Logout">
<transition event="Logout successful" target="end"/>
</state>
<state id="end"/>
</scxml>

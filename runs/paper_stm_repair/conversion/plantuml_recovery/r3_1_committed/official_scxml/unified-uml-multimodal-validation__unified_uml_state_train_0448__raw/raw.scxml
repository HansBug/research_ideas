<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition target="AnalyzingData"/>
</state>
<state id="AnalyzingData">
<transition target="GeneratingSuggestions"/>
</state>
<state id="GeneratingSuggestions">
<transition target="ViewingSuggestions"/>
</state>
<state id="ViewingSuggestions">
<transition target="SavingFavorites"/>
</state>
<state id="SavingFavorites">
<transition target="ContinuingBrowsing"/>
</state>
<state id="ContinuingBrowsing">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

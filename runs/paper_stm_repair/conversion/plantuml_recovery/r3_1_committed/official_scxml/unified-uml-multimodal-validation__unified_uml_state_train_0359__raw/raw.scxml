<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition event="User starts creating/managing tasks" target="CreateOrManageTasks"/>
</state>
<state id="CreateOrManageTasks">
<transition event="User accesses web interface" target="ViewAISuggestions"/>
<transition event="User continues managing tasks" target="ManageTasks"/>
</state>
<state id="ViewAISuggestions">
<transition event="User applies suggestions" target="ManageTasks"/>
</state>
<state id="ManageTasks">
<transition event="User completes task management" target="end"/>
<transition event="User exits" target="end"/>
</state>
<state id="end"/>
</scxml>

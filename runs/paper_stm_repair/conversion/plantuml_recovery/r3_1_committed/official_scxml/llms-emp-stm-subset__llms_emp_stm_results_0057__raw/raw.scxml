<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="startFC" version="1.0">
<state id="start">
<transition event="Possible collision detected" target="CA"/>
</state>
<state id="CA">
<state id="FC">
<state id="startFC">
<transition target="FCIdle"/>
</state>
<state id="FCIdle">
<transition event="Frontend collision detected" target="FCActive"/>
</state>
<state id="FCActive">
<transition event="Collision avoided" target="FCIdle"/>
</state>
</state>
<state id="RC">
<state id="startRC">
<transition target="RCIdle"/>
</state>
<state id="RCIdle">
<transition event="Rear-end collision detected" target="RCActive"/>
</state>
<state id="RCActive">
<transition event="Collision avoided" target="RCIdle"/>
</state>
</state>
<state id="PC">
<state id="startPC">
<transition target="PCIdle"/>
</state>
<state id="PCIdle">
<transition event="Pedestrian collision detected" target="PCActive"/>
</state>
<state id="PCActive">
<transition event="Collision avoided" target="PCIdle"/>
</state>
</state>
</state>
</scxml>

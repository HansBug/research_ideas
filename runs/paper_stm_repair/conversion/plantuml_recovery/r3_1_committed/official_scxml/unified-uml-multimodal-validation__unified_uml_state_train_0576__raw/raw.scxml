<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="CreatingProfile"/>
</state>
<state id="CreatingProfile">
<transition target="ManagingAttributes"/>
<transition target="end"/>
</state>
<state id="ManagingAttributes">
<transition target="LinkingProfiles"/>
<transition target="end"/>
</state>
<state id="LinkingProfiles">
<transition target="QueryingProfiles"/>
<transition target="end"/>
</state>
<state id="QueryingProfiles">
<transition target="UpdatingProfile"/>
<transition target="end"/>
</state>
<state id="UpdatingProfile">
<transition target="RemovingProfile"/>
<transition target="end"/>
</state>
<state id="RemovingProfile">
<transition target="end"/>
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

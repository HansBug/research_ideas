<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SetupPreferences"/>
</state>
<state id="SetupPreferences">
<transition target="ProvideNotifications"/>
</state>
<state id="ProvideNotifications">
<transition target="ViewNotifications"/>
<transition target="Dashboard"/>
</state>
<state id="ViewNotifications">
<transition target="end"/>
</state>
<state id="Dashboard">
<transition target="ManagePreferences"/>
<transition target="ViewNotifications"/>
</state>
<state id="end"/>
<state id="ManagePreferences">
<transition target="ProvideNotifications"/>
<transition target="end"/>
</state>
</scxml>

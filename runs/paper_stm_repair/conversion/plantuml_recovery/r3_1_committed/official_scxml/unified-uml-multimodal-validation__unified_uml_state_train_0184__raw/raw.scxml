<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="MonitoringMarketConditions"/>
</state>
<state id="MonitoringMarketConditions">
<transition event="MarketConditionsChange" target="NotificationSent"/>
</state>
<state id="NotificationSent">
<transition event="UserAdjustsPrice" target="AdjustingPrice"/>
<transition event="NoAdjustment" target="end"/>
</state>
<state id="AdjustingPrice">
<transition event="PriceAdjustmentComplete" target="PriceUpdated"/>
</state>
<state id="PriceUpdated">
<transition event="MarketConditionsChange" target="MonitoringMarketConditions"/>
</state>
<state id="end"/>
</scxml>

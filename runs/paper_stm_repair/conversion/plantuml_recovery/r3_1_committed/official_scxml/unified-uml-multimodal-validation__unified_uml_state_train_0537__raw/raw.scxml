<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition target="ProfileSelection"/>
</state>
<state id="ProfileSelection">
<transition target="Login"/>
<transition target="end"/>
</state>
<state id="Login">
<transition target="AttendanceTracking"/>
<transition target="ReportGeneration"/>
<transition target="end"/>
</state>
<state id="AttendanceTracking">
<transition target="ReportGeneration"/>
<transition target="ProfileSelection"/>
</state>
<state id="ReportGeneration">
<transition target="DataExport"/>
<transition target="ProfileSelection"/>
</state>
<state id="DataExport">
<transition target="end"/>
<transition target="ProfileSelection"/>
</state>
<state id="end"/>
</scxml>

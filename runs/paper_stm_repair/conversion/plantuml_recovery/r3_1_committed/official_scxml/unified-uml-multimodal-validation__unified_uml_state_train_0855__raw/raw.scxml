<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="StartCustomSearchEngine"/>
</state>
<state id="StartCustomSearchEngine">
<transition event="Add/Remove/Edit Criteria" target="AddRemoveEditCriteria"/>
<transition event="Cancel" target="end"/>
</state>
<state id="AddRemoveEditCriteria">
<transition event="Save" target="SaveCustomSearchEngine"/>
<transition event="Exit" target="end"/>
</state>
<state id="SaveCustomSearchEngine">
<transition event="Apply" target="ApplySearchEngine"/>
<transition event="Exit" target="end"/>
</state>
<state id="ApplySearchEngine">
<transition event="Display" target="DisplaySearchEngine"/>
<transition event="Exit" target="end"/>
</state>
<state id="DisplaySearchEngine">
<transition event="Feedback" target="ProvideFeedback"/>
<transition event="Exit" target="end"/>
</state>
<state id="ProvideFeedback">
<transition event="Access" target="AccessMultipleEngines"/>
<transition event="Exit" target="end"/>
</state>
<state id="AccessMultipleEngines">
<transition event="Handle" target="HandleMultipleEngines"/>
<transition event="Exit" target="end"/>
</state>
<state id="HandleMultipleEngines">
<transition target="end"/>
<transition event="Exit" target="end"/>
</state>
<state id="end"/>
</scxml>

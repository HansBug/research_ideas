<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="User starts filling a form" target="FormBeingFilled"/>
</state>
<state id="FormBeingFilled">
<transition event="User requests auto-fill" target="AutoFillInProgress"/>
<transition event="User saves filled information" target="SavingFilledInformation"/>
</state>
<state id="AutoFillInProgress">
<transition event="Auto-fill completes" target="FormBeingFilled"/>
</state>
<state id="SavingFilledInformation">
<transition event="Information saved" target="FormCompleted"/>
</state>
<state id="FormCompleted">
<transition event="Form submission completed" target="end"/>
<transition event="User requests save" target="SavingFilledInformation"/>
</state>
<state id="end"/>
</scxml>

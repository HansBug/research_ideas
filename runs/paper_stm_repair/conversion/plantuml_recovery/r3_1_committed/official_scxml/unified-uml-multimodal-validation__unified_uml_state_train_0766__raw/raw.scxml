<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Initial_State"/>
</state>
<state id="Initial_State">
<transition target="Setting_Tasks"/>
<transition target="Receiving_Reminders"/>
<transition target="Tracking_Time"/>
<transition target="Accessing_Resources"/>
<transition target="Receiving_Workflow_Suggestions"/>
</state>
<state id="Setting_Tasks">
<transition target="Receiving_Reminders"/>
<transition target="Tracking_Time"/>
<transition target="Accessing_Resources"/>
<transition target="Receiving_Workflow_Suggestions"/>
<transition target="end"/>
</state>
<state id="Receiving_Reminders">
<transition target="Setting_Tasks"/>
<transition target="Tracking_Time"/>
<transition target="Accessing_Resources"/>
<transition target="Receiving_Workflow_Suggestions"/>
<transition target="end"/>
</state>
<state id="Tracking_Time">
<transition target="Setting_Tasks"/>
<transition target="Receiving_Reminders"/>
<transition target="Accessing_Resources"/>
<transition target="Receiving_Workflow_Suggestions"/>
<transition target="end"/>
</state>
<state id="Accessing_Resources">
<transition target="Setting_Tasks"/>
<transition target="Receiving_Reminders"/>
<transition target="Tracking_Time"/>
<transition target="Receiving_Workflow_Suggestions"/>
<transition target="end"/>
</state>
<state id="Receiving_Workflow_Suggestions">
<transition target="Setting_Tasks"/>
<transition target="Receiving_Reminders"/>
<transition target="Tracking_Time"/>
<transition target="Accessing_Resources"/>
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

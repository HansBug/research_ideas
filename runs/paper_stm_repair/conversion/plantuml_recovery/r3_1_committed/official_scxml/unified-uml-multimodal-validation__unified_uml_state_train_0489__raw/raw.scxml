<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="AnalyzingEmotionalState"/>
</state>
<state id="AnalyzingEmotionalState">
<transition target="CuratingEmotions"/>
</state>
<state id="CuratingEmotions">
<transition target="BrowsingEmotions"/>
</state>
<state id="BrowsingEmotions">
<transition target="SelectingEmotion"/>
</state>
<state id="SelectingEmotion">
<transition target="DisplayingEmotion"/>
</state>
<state id="DisplayingEmotion">
<transition target="InteractingWithEmotion"/>
</state>
<state id="InteractingWithEmotion">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

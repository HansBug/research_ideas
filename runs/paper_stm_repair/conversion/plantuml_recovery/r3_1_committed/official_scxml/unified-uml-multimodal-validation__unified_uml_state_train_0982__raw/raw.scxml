<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="Task Created" target="TaskCreated"/>
</state>
<state id="TaskCreated">
<transition event="Start Editing" target="TaskBeingEdited"/>
</state>
<state id="TaskBeingEdited">
<transition event="Changes Made" target="SynchronizingChanges"/>
<transition event="Editing Complete" target="TaskCompleted"/>
</state>
<state id="SynchronizingChanges">
<transition event="Synchronization Complete" target="TaskBeingEdited"/>
</state>
<state id="TaskCompleted">
<transition event="Task Completed" target="end"/>
</state>
<state id="end"/>
</scxml>

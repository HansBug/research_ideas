<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="TaskCreation"/>
</state>
<state id="TaskCreation">
<transition event="Assign Task" target="TaskAssignment"/>
</state>
<state id="TaskAssignment">
<transition event="Start Working" target="TaskInProgress"/>
</state>
<state id="TaskInProgress">
<transition event="Complete Task" target="TaskCompletion"/>
</state>
<state id="TaskCompletion">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

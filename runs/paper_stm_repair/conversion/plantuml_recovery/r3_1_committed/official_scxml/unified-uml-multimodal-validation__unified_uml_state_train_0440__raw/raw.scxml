<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SettingUpPricingTier"/>
</state>
<state id="SettingUpPricingTier">
<transition event="Time period selected" target="SelectingTimePeriod"/>
</state>
<state id="SelectingTimePeriod">
<transition event="Pricing tier activated" target="ActivatingPricingTier"/>
</state>
<state id="ActivatingPricingTier">
<transition event="Monitor time period" target="MonitoringTimePeriod"/>
</state>
<state id="MonitoringTimePeriod">
<transition event="Time period ends soon" target="SendingNotifications"/>
</state>
<state id="SendingNotifications">
<transition event="Pricing tier changes" target="ChangingPricingTier"/>
</state>
<state id="ChangingPricingTier">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="TaskCreated"/>
</state>
<state id="TaskCreated">
<transition event="Assign and Schedule" target="Scheduled"/>
<transition event="Cancel" target="Cancelled"/>
</state>
<state id="Scheduled">
<transition event="Start Work" target="InProgress"/>
<transition event="Due Date Approaches" target="ReminderSent"/>
<transition event="Cancel" target="Cancelled"/>
</state>
<state id="Cancelled">
<transition target="end"/>
</state>
<state id="InProgress">
<transition event="Finish Task" target="Completed"/>
<transition event="Time Passes" target="Overdue"/>
<transition event="Cancel" target="Cancelled"/>
</state>
<state id="ReminderSent">
<transition event="Start Work" target="InProgress"/>
<transition event="Time Passes" target="Overdue"/>
<transition event="Cancel" target="Cancelled"/>
<transition event="Complete Task" target="Completed"/>
<transition event="Cancel" target="Cancelled"/>
</state>
<state id="Overdue">
<transition event="Complete Task" target="Completed"/>
<transition event="Cancel" target="Cancelled"/>
</state>
<state id="Completed">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="OffState"/>
</state>
<state id="OffState">
<transition event="start" target="OperateState"/>
</state>
<state id="OperateState">
<transition event="No Action" target="IdleState"/>
<transition event="Accelerate" target="AcceleratingState"/>
<transition event="Cruise" target="CruisingState"/>
<transition event="Brake" target="BrakingState"/>
<transition event="keyOff" target="OffState"/>
</state>
<state id="IdleState">
<transition event="Accelerate" target="AcceleratingState"/>
<transition event="Brake" target="BrakingState"/>
</state>
<state id="AcceleratingState">
<transition event="Reach Speed" target="CruisingState"/>
<transition event="Brake" target="BrakingState"/>
</state>
<state id="CruisingState">
<transition event="Brake" target="BrakingState"/>
</state>
<state id="BrakingState">
<transition event="Stop" target="IdleState"/>
</state>
</scxml>

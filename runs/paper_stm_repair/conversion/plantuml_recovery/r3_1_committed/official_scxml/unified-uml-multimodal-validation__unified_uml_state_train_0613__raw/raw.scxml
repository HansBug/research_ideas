<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="Add/Remove/Sell" target="UpdatingInventory"/>
<transition event="View Inventory" target="ViewingInventory"/>
<transition event="Shutdown" target="end"/>
</state>
<state id="UpdatingInventory">
<transition event="Update Complete" target="Idle"/>
</state>
<state id="ViewingInventory">
<transition event="Done Viewing" target="Idle"/>
</state>
<state id="end"/>
</scxml>

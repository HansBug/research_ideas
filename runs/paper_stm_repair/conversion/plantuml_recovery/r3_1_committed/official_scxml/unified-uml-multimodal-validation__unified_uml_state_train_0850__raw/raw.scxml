<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="BookSelection"/>
</state>
<state id="BookSelection">
<transition target="AnalyzingPreferences"/>
</state>
<state id="AnalyzingPreferences">
<transition target="ProvidingRecommendations"/>
</state>
<state id="ProvidingRecommendations">
<transition target="end"/>
<transition target="BookSelection"/>
</state>
<state id="end"/>
<state id="ReadingLog">
<transition target="ProvidingRecommendations"/>
<state id="startReadingLog">
<transition target="ReadingLog"/>
</state>
</state>
<state id="BookOfTheMonth">
<transition target="ProvidingRecommendations"/>
<state id="startBookOfTheMonth">
<transition target="BookOfTheMonth"/>
</state>
</state>
</scxml>

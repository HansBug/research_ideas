<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="TaskAssigned"/>
</state>
<state id="TaskAssigned">
<transition event="Scheduled Time Arrives" target="ReminderSent"/>
</state>
<state id="ReminderSent">
<transition event="Task Completed" target="TaskCompleted"/>
</state>
<state id="TaskCompleted">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

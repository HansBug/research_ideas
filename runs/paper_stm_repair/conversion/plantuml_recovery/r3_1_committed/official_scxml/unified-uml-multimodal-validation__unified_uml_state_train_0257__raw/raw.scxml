<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectingProduct"/>
</state>
<state id="SelectingProduct">
<transition target="EnteringProductDetails"/>
</state>
<state id="EnteringProductDetails">
<transition target="ChoosingAction"/>
</state>
<state id="ChoosingAction">
<transition target="SubmittingSuggestion"/>
</state>
<state id="SubmittingSuggestion">
<transition target="ReviewingSuggestion"/>
</state>
<state id="ReviewingSuggestion">
<transition target="RespondingToSuggestion"/>
</state>
<state id="RespondingToSuggestion">
<transition target="ViewingStatus"/>
</state>
<state id="ViewingStatus">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

</state>
<state id="Delete">
<transition target="Idle"/>
</state>
<state id="Update">
<transition target="Idle"/>
</state>
<state id="ViewVersion">
<transition target="Idle"/>
</state>
<state id="ViewChanges">
<transition target="Idle"/>
</state>

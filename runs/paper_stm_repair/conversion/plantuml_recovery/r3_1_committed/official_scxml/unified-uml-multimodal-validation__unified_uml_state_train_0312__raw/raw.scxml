<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectList"/>
</state>
<state id="SelectList">
<transition target="ListSelected"/>
</state>
<state id="ListSelected">
<transition target="AddDocument"/>
<transition target="SwitchLists"/>
</state>
<state id="AddDocument">
<transition target="DocumentAdded"/>
</state>
<state id="DocumentAdded">
<transition target="SuggestDocuments"/>
<transition target="SearchRetrieve"/>
</state>
<state id="SuggestDocuments"/>
<state id="SearchRetrieve">
<transition target="end"/>
</state>
<state id="SwitchLists">
<transition target="SelectList"/>
</state>
<state id="end"/>
</scxml>

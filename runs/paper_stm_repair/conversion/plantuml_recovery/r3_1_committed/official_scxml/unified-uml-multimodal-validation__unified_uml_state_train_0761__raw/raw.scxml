<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Access_Settings"/>
</state>
<state id="Access_Settings">
<transition event="View preferences" target="View_Preferences"/>
<transition event="Modify preferences" target="Modify_Preferences"/>
</state>
<state id="View_Preferences">
<transition event="Modify preferences" target="Modify_Preferences"/>
<transition event="Exit" target="end"/>
<transition event="Sync preferences" target="Sync_Preferences"/>
</state>
<state id="Modify_Preferences">
<transition event="Save changes" target="View_Preferences"/>
<transition event="Cancel" target="Access_Settings"/>
<transition event="Exit" target="end"/>
</state>
<state id="end"/>
<state id="Sync_Preferences">
<transition event="Exit" target="end"/>
</state>
</scxml>

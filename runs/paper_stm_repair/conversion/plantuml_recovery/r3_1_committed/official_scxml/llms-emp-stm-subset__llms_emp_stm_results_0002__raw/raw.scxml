<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="PumpControl"/>
</state>
<state id="PumpControl">
<state id="startPumpControl">
<transition target="PumpState"/>
</state>
<state id="PumpState">
<transition event="Water Control" target="WaterState"/>
<transition event="Methane Control" target="MethaneState"/>
</state>
<state id="WaterState">
<transition event="Switch to Pump" target="PumpState"/>
</state>
<state id="MethaneState">
<transition event="Switch to Pump" target="PumpState"/>
</state>
</state>
</scxml>

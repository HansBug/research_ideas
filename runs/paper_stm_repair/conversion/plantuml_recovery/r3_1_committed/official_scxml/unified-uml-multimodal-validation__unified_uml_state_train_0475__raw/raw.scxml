<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Away_from_Home"/>
</state>
<state id="Away_from_Home">
<transition event="View/Control devices" target="Viewing_Controlling_Devices"/>
<transition event="Receive notifications" target="Receiving_Notifications"/>
<transition event="Set reminders/schedules" target="Setting_Reminders"/>
</state>
<state id="Viewing_Controlling_Devices">
<transition event="Return home" target="Returning_Home"/>
</state>
<state id="Receiving_Notifications">
<transition event="Return home" target="Returning_Home"/>
</state>
<state id="Setting_Reminders">
<transition event="Return home" target="Returning_Home"/>
</state>
<state id="Returning_Home">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

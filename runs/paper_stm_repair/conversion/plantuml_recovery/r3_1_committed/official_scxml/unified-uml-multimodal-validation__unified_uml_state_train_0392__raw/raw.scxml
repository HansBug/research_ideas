<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="MonitoringInventory"/>
</state>
<state id="MonitoringInventory">
<transition event="on item added/removed" target="UpdatingInventory"/>
<transition event="on request" target="GeneratingReport"/>
<transition event="on item click" target="ViewingDetails"/>
<transition event="on search" target="SearchingItems"/>
<transition event="when stock low" target="AlertingLowStock"/>
<transition target="end"/>
</state>
<state id="UpdatingInventory">
<transition event="after update" target="MonitoringInventory"/>
</state>
<state id="GeneratingReport">
<transition event="after generation" target="MonitoringInventory"/>
</state>
<state id="ViewingDetails">
<transition event="after viewing" target="MonitoringInventory"/>
</state>
<state id="SearchingItems">
<transition event="after search" target="MonitoringInventory"/>
</state>
<state id="AlertingLowStock">
<transition event="after alert" target="MonitoringInventory"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="TaskSubmitted"/>
</state>
<state id="TaskSubmitted">
<transition event="Evaluate availability" target="EvaluatingAvailability"/>
</state>
<state id="EvaluatingAvailability">
<transition event="Check skillset" target="CheckingSkillset"/>
</state>
<state id="CheckingSkillset">
<transition event="Review past work" target="ReviewingPastWork"/>
</state>
<state id="ReviewingPastWork">
<transition event="Assign task" target="AssigningTask"/>
</state>
<state id="AssigningTask">
<transition event="Update availability" target="UpdatingAvailability"/>
</state>
<state id="UpdatingAvailability">
<transition target="TaskAssigned"/>
</state>
<state id="TaskAssigned">
<transition event="Return to initial state" target="end"/>
</state>
<state id="end"/>
</scxml>

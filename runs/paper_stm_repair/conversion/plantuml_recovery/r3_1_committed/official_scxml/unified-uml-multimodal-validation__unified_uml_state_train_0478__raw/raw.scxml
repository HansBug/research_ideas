<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="Set Reminder" target="SettingReminder"/>
<transition event="Manage Reminders" target="ManagingReminders"/>
</state>
<state id="SettingReminder">
<transition event="Input reminder details" target="CheckingTimeAvailability"/>
</state>
<state id="ManagingReminders">
<transition event="View reminders" target="ViewingReminders"/>
<transition event="Edit reminder" target="EditingReminder"/>
<transition event="Delete reminder" target="DeletingReminder"/>
</state>
<state id="CheckingTimeAvailability">
<transition event="Time is available" target="AddingToCalendar"/>
<transition event="Time conflict detected" target="AlertConflict"/>
</state>
<state id="AddingToCalendar">
<transition event="Reminder added to calendar" target="end"/>
</state>
<state id="AlertConflict"/>
<state id="ViewingReminders">
<transition event="View completed" target="end"/>
</state>
<state id="EditingReminder">
<transition event="Edit completed" target="end"/>
</state>
<state id="DeletingReminder">
<transition event="Delete completed" target="end"/>
</state>
<state id="end"/>
</scxml>

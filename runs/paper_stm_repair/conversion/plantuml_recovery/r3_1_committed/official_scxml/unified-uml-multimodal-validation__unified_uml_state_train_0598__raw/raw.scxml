<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="User starts managing zones" target="ManageZones"/>
<transition event="User starts managing scenes" target="ManageScenes"/>
<transition event="System monitors devices" target="MonitorDevices"/>
<transition event="User triggers a scene" target="TriggerScene"/>
</state>
<state id="ManageZones">
<transition event="User finishes managing zones" target="end"/>
<transition event="User creates a new zone" target="CreateZone"/>
<transition event="User edits an existing zone" target="EditZone"/>
<transition event="User deletes a zone" target="DeleteZone"/>
</state>
<state id="ManageScenes">
<transition event="User finishes managing scenes" target="end"/>
<transition event="User creates a new scene" target="CreateScene"/>
<transition event="User edits an existing scene" target="EditScene"/>
<transition event="User deletes a scene" target="DeleteScene"/>
</state>
<state id="end"/>
<state id="CreateZone">
<transition event="Zone creation completed" target="end"/>
</state>
<state id="EditZone">
<transition event="Zone editing completed" target="end"/>
</state>
<state id="DeleteZone">
<transition event="Zone deletion completed" target="end"/>
</state>
<state id="CreateScene">
<transition event="Scene creation completed" target="end"/>
</state>
<state id="EditScene">
<transition event="Scene editing completed" target="end"/>
</state>
<state id="DeleteScene">
<transition event="Scene deletion completed" target="end"/>
</state>
<state id="MonitorDevices">
<transition event="Monitoring completes" target="end"/>
</state>
<state id="TriggerScene">
<transition event="Scene becomes active" target="ActiveScene"/>
</state>
<state id="ActiveScene">
<transition event="Scene stops" target="end"/>
</state>
</scxml>

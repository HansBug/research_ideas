<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition target="InputLearningGoals"/>
</state>
<state id="InputLearningGoals">
<transition target="TrackProgress"/>
</state>
<state id="TrackProgress">
<transition target="ViewRecommendedResources"/>
</state>
<state id="ViewRecommendedResources">
<transition target="CustomizeLearningPath"/>
</state>
<state id="CustomizeLearningPath">
<transition target="ViewLearningPath"/>
</state>
<state id="ViewLearningPath">
<transition target="End"/>
</state>
<state id="End">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

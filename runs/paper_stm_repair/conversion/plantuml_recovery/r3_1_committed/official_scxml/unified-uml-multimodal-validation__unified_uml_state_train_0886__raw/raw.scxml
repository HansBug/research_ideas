<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="MonitoringNotifications"/>
</state>
<state id="MonitoringNotifications">
<transition event="Notification level reaches threshold" target="SendingNotification"/>
<transition target="end"/>
</state>
<state id="SendingNotification">
<transition event="User clicks &quot;View Notifications&quot;" target="ViewingNotifications"/>
<transition event="User clicks &quot;Clear Notifications&quot;" target="ClearingNotifications"/>
<transition event="User clicks &quot;Notification Settings&quot;" target="UpdatingNotificationSettings"/>
</state>
<state id="ViewingNotifications">
<transition event="View notifications completed" target="MonitoringNotifications"/>
</state>
<state id="ClearingNotifications">
<transition event="Clear notifications completed" target="MonitoringNotifications"/>
</state>
<state id="UpdatingNotificationSettings">
<transition event="Update settings completed" target="MonitoringNotifications"/>
</state>
<state id="end"/>
</scxml>

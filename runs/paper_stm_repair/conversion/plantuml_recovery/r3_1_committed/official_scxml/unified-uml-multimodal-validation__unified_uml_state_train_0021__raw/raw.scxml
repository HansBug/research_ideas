<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DisplayingDocument"/>
</state>
<state id="DisplayingDocument">
<transition event="User requests history" target="ViewingHistory"/>
</state>
<state id="ViewingHistory">
<transition event="Display timeline" target="DisplayingTimeline"/>
</state>
<state id="DisplayingTimeline">
<transition event="User filters changes" target="FilteringChanges"/>
</state>
<state id="FilteringChanges">
<transition event="Display detailed changes" target="DisplayingDetails"/>
</state>
<state id="DisplayingDetails">
<transition event="Return to initial state" target="end"/>
</state>
<state id="end"/>
</scxml>

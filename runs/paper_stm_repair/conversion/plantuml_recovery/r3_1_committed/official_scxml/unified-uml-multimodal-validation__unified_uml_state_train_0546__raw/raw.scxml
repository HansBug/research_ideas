<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="TrackingAttendance"/>
</state>
<state id="TrackingAttendance">
<transition target="AnalyzingData"/>
</state>
<state id="AnalyzingData">
<transition target="ProvidingFeedback"/>
</state>
<state id="ProvidingFeedback">
<transition target="GeneratingReports"/>
</state>
<state id="GeneratingReports">
<transition target="SendingAlerts"/>
</state>
<state id="SendingAlerts">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

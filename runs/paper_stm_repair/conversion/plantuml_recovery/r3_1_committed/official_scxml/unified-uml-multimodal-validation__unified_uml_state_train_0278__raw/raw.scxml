<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DisplayingExpenses"/>
</state>
<state id="DisplayingExpenses">
<transition event="Add New Expense" target="AddingExpense"/>
<transition event="Edit Expense" target="EditingExpense"/>
<transition event="Delete Expense" target="DeletingExpense"/>
<transition event="Categorize Expense" target="CategorizingExpense"/>
<transition event="Search Expenses" target="SearchingExpenses"/>
<transition event="Sort Expenses" target="SortingExpenses"/>
<transition event="Export to CSV" target="ExportingToCSV"/>
<transition event="Exit Feature" target="end"/>
</state>
<state id="AddingExpense">
<transition event="Return" target="DisplayingExpenses"/>
</state>
<state id="EditingExpense">
<transition event="Return" target="DisplayingExpenses"/>
</state>
<state id="DeletingExpense">
<transition event="Return" target="DisplayingExpenses"/>
</state>
<state id="CategorizingExpense">
<transition event="Return" target="DisplayingExpenses"/>
</state>
<state id="SearchingExpenses">
<transition event="Return" target="DisplayingExpenses"/>
</state>
<state id="SortingExpenses">
<transition event="Return" target="DisplayingExpenses"/>
</state>
<state id="ExportingToCSV">
<transition event="Return" target="DisplayingExpenses"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UserInput"/>
</state>
<state id="UserInput">
<transition target="AnalyzeInput"/>
</state>
<state id="AnalyzeInput">
<transition target="SuggestTimeSlot"/>
</state>
<state id="SuggestTimeSlot">
<transition target="UserReview"/>
</state>
<state id="UserReview">
<transition event="Accept" target="end"/>
<transition event="Reject" target="end"/>
<transition event="Reject" target="UserInput"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="TaskDetection"/>
</state>
<state id="TaskDetection">
<transition target="CriteriaApplication"/>
</state>
<state id="CriteriaApplication">
<transition target="TaskPrioritization"/>
</state>
<state id="TaskPrioritization">
<transition target="TaskDisplay"/>
</state>
<state id="TaskDisplay">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

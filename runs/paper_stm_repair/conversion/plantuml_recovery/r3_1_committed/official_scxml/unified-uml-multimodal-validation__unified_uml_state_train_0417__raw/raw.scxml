<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="Submit Ticket" target="Submitted"/>
</state>
<state id="Submitted">
<transition event="Assign Support Rep" target="Assigned"/>
</state>
<state id="Assigned">
<transition event="Start Work" target="InProgress"/>
</state>
<state id="InProgress">
<transition event="Resolve Issue" target="Resolved"/>
</state>
<state id="Resolved">
<transition event="Close Ticket" target="Closed"/>
</state>
<state id="Closed">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

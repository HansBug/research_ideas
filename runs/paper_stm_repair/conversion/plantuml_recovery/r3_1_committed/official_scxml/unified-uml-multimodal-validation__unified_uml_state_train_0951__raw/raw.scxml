<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InputDietaryNeeds"/>
</state>
<state id="InputDietaryNeeds">
<transition target="GenerateMealPlan"/>
</state>
<state id="GenerateMealPlan">
<transition target="SuggestMealPlan"/>
</state>
<state id="SuggestMealPlan">
<transition target="TrackProgress"/>
<transition target="AdjustMealPlan"/>
</state>
<state id="TrackProgress">
<transition target="end"/>
<transition target="SuggestAdjustments"/>
</state>
<state id="end"/>
<state id="AdjustMealPlan">
<transition target="GenerateMealPlan"/>
</state>
<state id="SuggestAdjustments">
<transition target="AdjustMealPlan"/>
</state>
</scxml>

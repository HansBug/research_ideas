<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectingTaskType"/>
</state>
<state id="SelectingTaskType">
<transition target="SettingDueDateAndTime"/>
</state>
<state id="SettingDueDateAndTime">
<transition target="AddingNotesOrAttachments"/>
</state>
<state id="AddingNotesOrAttachments">
<transition target="TaskScheduled"/>
</state>
<state id="TaskScheduled">
<transition target="ViewingScheduledTasks"/>
<transition target="ManagingTasks"/>
<transition target="SendingRemindersOrNotifications"/>
</state>
<state id="ViewingScheduledTasks">
<transition target="ManagingTasks"/>
<transition target="end"/>
</state>
<state id="ManagingTasks">
<transition target="end"/>
</state>
<state id="end"/>
<state id="SendingRemindersOrNotifications">
<transition target="end"/>
</state>
</scxml>

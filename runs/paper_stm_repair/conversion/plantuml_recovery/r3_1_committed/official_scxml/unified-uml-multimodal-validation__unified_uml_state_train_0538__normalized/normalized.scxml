<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="Initial_State_e146ff">
<transition event="User starts creating a budget" target="Create_Budget_3cf89e"/>
</state>
<state id="Create_Budget_3cf89e">
<transition event="User starts tracking expenses" target="Track_Expenses_14bf78"/>
<transition event="User views budget summary" target="View_Budget_Summary_08b6ce"/>
</state>
<state id="Track_Expenses_14bf78">
<transition event="Expense added exceeds budget" target="Update_Budget_0fb775"/>
<transition event="Expense added" target="Check_Goals_1fef02"/>
</state>
<state id="View_Budget_Summary_08b6ce">
<transition event="User exits" target="end"/>
</state>
<state id="Update_Budget_0fb775">
<transition event="Budget updated" target="View_Budget_Summary_08b6ce"/>
</state>
<state id="Check_Goals_1fef02">
<transition event="Goals met" target="end"/>
<transition event="Goals not met" target="Send_Alert_1ef22b"/>
</state>
<state id="Send_Alert_1ef22b">
<transition event="User updates budget" target="Update_Budget_0fb775"/>
</state>
<state id="Final_State_3474cc"/>
<state id="start">
<transition target="Initial_State_e146ff"/>
</state>
<state id="end">
<transition target="Final_State_3474cc"/>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SystemIdle"/>
</state>
<state id="SystemIdle">
<transition event="User accesses profile" target="ProfileAccess"/>
<transition target="end"/>
</state>
<state id="ProfileAccess">
<transition event="User updates profile" target="ProfileUpdate"/>
<transition event="Exit profile management" target="SystemIdle"/>
</state>
<state id="ProfileUpdate">
<transition event="Continue accessing profile" target="ProfileAccess"/>
<transition event="Save updated profile" target="SecureStorage"/>
</state>
<state id="SecureStorage">
<transition event="Return to idle" target="SystemIdle"/>
</state>
<state id="end"/>
</scxml>

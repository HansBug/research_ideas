<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DashboardInput"/>
</state>
<state id="DashboardInput">
<transition target="TaskCategorization"/>
</state>
<state id="TaskCategorization">
<transition target="TimeSlotAssignment"/>
</state>
<state id="TimeSlotAssignment">
<transition target="ReminderNotification"/>
</state>
<state id="ReminderNotification">
<transition target="CalendarView"/>
</state>
<state id="CalendarView">
<transition target="ProgressSummary"/>
</state>
<state id="ProgressSummary">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

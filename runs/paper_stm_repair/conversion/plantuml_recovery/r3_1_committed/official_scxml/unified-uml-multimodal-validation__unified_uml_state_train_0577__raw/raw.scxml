<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Initial"/>
</state>
<state id="Initial">
<transition event="Add Indicator" target="IndicatorCreated"/>
</state>
<state id="IndicatorCreated">
<transition event="Time Changes" target="TimeUpdating"/>
<transition event="Add Custom Text" target="CustomTextAdded"/>
<transition event="Remove Indicator" target="IndicatorRemoved"/>
</state>
<state id="TimeUpdating">
<transition event="Auto Update" target="TimeUpdating"/>
<transition event="Remove Indicator" target="IndicatorRemoved"/>
</state>
<state id="CustomTextAdded">
<transition event="Time Changes" target="TimeUpdating"/>
<transition event="Remove Indicator" target="IndicatorRemoved"/>
</state>
<state id="IndicatorRemoved">
<transition event="Final State" target="end"/>
</state>
<state id="end"/>
</scxml>

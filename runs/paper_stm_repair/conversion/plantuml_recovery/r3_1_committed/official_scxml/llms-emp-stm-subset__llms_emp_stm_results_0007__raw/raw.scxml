<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="end"/>
<state id="InitialState">
<state id="startInitialState">
<transition target="DetectionState"/>
</state>
<state id="DetectionState">
<transition event="Frontend Collision Detected" target="BrakingControl"/>
<transition event="Rear-End Collision Detected" target="SteeringControl"/>
<transition event="Collision With Pedestrian Detected" target="AlertSystem"/>
</state>
<state id="BrakingControl">
<state id="startBrakingControl">
<transition target="ActivateABS"/>
</state>
<state id="ActivateABS">
<transition event="Immediate Action Required" target="ApplyBrakes"/>
</state>
<state id="ApplyBrakes">
<transition event="Collision Avoided" target="endBrakingControl"/>
</state>
<state id="endBrakingControl"/>
</state>
<state id="SteeringControl">
<state id="startSteeringControl">
<transition target="ActivateESC"/>
</state>
<state id="ActivateESC">
<transition event="Collision Imminent" target="SteerAway"/>
</state>
<state id="SteerAway">
<transition event="Hazard Passed" target="endSteeringControl"/>
</state>
<state id="endSteeringControl"/>
</state>
<state id="AlertSystem">
<state id="startAlertSystem">
<transition target="SendAlert"/>
</state>
<state id="SendAlert">
<transition target="SoundAlarm"/>
</state>
<state id="SoundAlarm">
<transition event="Obstacle Cleared" target="endAlertSystem"/>
</state>
<state id="endAlertSystem"/>
</state>
</state>
<state id="CollisionAvoidance">
<transition event="No Collision Risk" target="end"/>
</state>
</scxml>

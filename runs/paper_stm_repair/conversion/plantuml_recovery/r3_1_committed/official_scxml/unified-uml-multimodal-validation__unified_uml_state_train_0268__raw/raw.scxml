<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectSongs"/>
</state>
<state id="SelectSongs">
<transition target="PlayLoop"/>
<transition target="PlaySpecific"/>
</state>
<state id="PlayLoop">
<transition target="end"/>
</state>
<state id="PlaySpecific">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectScenarioTemplate"/>
</state>
<state id="SelectScenarioTemplate">
<transition target="CustomizeParameters"/>
</state>
<state id="CustomizeParameters">
<transition target="SelectActions"/>
</state>
<state id="SelectActions">
<transition target="ViewScenario"/>
</state>
<state id="ViewScenario">
<transition target="SaveScenario"/>
<transition target="ModifyScenario"/>
</state>
<state id="SaveScenario">
<transition target="end"/>
</state>
<state id="ModifyScenario">
<transition target="SelectScenarioTemplate"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Login"/>
</state>
<state id="Login">
<transition target="Dashboard"/>
</state>
<state id="Dashboard">
<transition target="Budgeting"/>
<transition target="ExpenseTracking"/>
<transition target="BillPayments"/>
<transition target="MobileApp"/>
<transition target="UserProfile"/>
<transition target="Logout"/>
</state>
<state id="Budgeting">
<transition target="Dashboard"/>
</state>
<state id="ExpenseTracking">
<transition target="Dashboard"/>
</state>
<state id="BillPayments">
<transition target="Payment"/>
</state>
<state id="MobileApp">
<transition target="TrackExpenses"/>
<transition target="PayBills"/>
<transition target="ViewStatements"/>
<transition target="Logout"/>
</state>
<state id="UserProfile">
<transition target="SetBudgets"/>
<transition target="ViewFinancialStatements"/>
</state>
<state id="Payment">
<transition target="Dashboard"/>
</state>
<state id="TrackExpenses">
<transition target="MobileApp"/>
</state>
<state id="PayBills">
<transition target="MobileApp"/>
</state>
<state id="ViewStatements">
<transition target="MobileApp"/>
</state>
<state id="SetBudgets">
<transition target="UserProfile"/>
</state>
<state id="ViewFinancialStatements">
<transition target="UserProfile"/>
</state>
<state id="Logout">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

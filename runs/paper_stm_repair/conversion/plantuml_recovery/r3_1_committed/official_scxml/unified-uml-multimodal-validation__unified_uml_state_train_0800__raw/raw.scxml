<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ViewInstalledApplications"/>
</state>
<state id="ViewInstalledApplications">
<transition target="end"/>
<transition target="AddApplication"/>
<transition target="ViewApplicationDetails"/>
</state>
<state id="end"/>
<state id="AddApplication">
<transition target="ViewInstalledApplications"/>
</state>
<state id="ViewApplicationDetails">
<transition target="DeleteApplication"/>
</state>
<state id="DeleteApplication">
<transition target="ViewInstalledApplications"/>
</state>
</scxml>

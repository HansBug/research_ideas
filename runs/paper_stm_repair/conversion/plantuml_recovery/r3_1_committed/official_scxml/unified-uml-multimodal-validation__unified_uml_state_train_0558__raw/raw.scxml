<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UploadFiles"/>
</state>
<state id="UploadFiles">
<transition event="Upload files" target="ProcessFiles"/>
</state>
<state id="ProcessFiles">
<transition event="Process content" target="AssignTags"/>
</state>
<state id="AssignTags">
<transition event="Assign tags" target="AnalyzeReport"/>
</state>
<state id="AnalyzeReport">
<transition event="Analyze and report" target="end"/>
</state>
<state id="end"/>
</scxml>

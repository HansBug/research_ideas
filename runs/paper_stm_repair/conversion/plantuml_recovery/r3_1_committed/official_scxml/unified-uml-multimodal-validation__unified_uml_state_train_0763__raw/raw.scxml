<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectingDocuments"/>
</state>
<state id="SelectingDocuments">
<transition event="User selects documents" target="EditingDocuments"/>
</state>
<state id="EditingDocuments">
<transition event="User edits and applies changes" target="UpdatingDocuments"/>
</state>
<state id="UpdatingDocuments">
<transition event="System updates all documents" target="end"/>
</state>
<state id="end"/>
</scxml>

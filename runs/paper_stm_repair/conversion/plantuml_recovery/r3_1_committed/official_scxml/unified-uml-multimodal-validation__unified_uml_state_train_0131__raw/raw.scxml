<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="AddTaskOrProject"/>
<transition target="end"/>
</state>
<state id="AddTaskOrProject">
<transition target="ViewProjectTimeline"/>
<transition target="end"/>
</state>
<state id="ViewProjectTimeline">
<transition target="FilterTimeline"/>
<transition target="ExportData"/>
<transition target="VisualizeTimeline"/>
</state>
<state id="end"/>
<state id="FilterTimeline">
<transition target="ViewProjectTimeline"/>
</state>
<state id="ExportData">
<transition target="end"/>
</state>
<state id="VisualizeTimeline">
<transition target="ViewProjectTimeline"/>
<transition target="end"/>
</state>
</scxml>

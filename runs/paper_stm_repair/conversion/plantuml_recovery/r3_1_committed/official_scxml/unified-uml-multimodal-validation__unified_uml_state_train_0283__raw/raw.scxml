<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DisplayProductList"/>
</state>
<state id="DisplayProductList">
<transition target="SelectProduct"/>
</state>
<state id="SelectProduct">
<transition target="RetrieveInteractionHistory"/>
</state>
<state id="RetrieveInteractionHistory">
<transition target="DisplayInteractionHistory"/>
</state>
<state id="DisplayInteractionHistory">
<transition target="end"/>
<transition target="SortByDate"/>
<transition target="SortByDescription"/>
</state>
<state id="end"/>
<state id="SortByDate">
<transition target="DisplayInteractionHistory"/>
</state>
<state id="SortByDescription">
<transition target="DisplayInteractionHistory"/>
</state>
</scxml>

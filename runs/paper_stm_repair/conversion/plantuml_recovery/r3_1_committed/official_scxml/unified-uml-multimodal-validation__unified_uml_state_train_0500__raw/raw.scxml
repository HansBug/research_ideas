<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="on text input" target="Text_Input"/>
</state>
<state id="Text_Input">
<transition event="on processing" target="Translation_Processing"/>
</state>
<state id="Translation_Processing">
<transition event="on quality check" target="Quality_Check"/>
</state>
<state id="Quality_Check">
<transition event="if passed" target="end"/>
</state>
<state id="end"/>
</scxml>

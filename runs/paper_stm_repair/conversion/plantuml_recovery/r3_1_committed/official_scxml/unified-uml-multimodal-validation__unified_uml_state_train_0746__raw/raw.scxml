<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="NotStarted"/>
</state>
<state id="NotStarted">
<transition event="Start Task" target="InProgress"/>
<transition event="Cancel Task" target="Cancelled"/>
<state id="startNotStarted">
<transition target="NotStarted"/>
</state>
<state id="InProgress">
<transition event="Pause Task" target="OnHold"/>
<transition event="Complete Task" target="Completed"/>
<transition event="Cancel Task" target="Cancelled"/>
<state id="OnHold">
<transition event="Resume Task" target="InProgress"/>
<transition event="Reset Task" target="NotStarted"/>
<transition event="Cancel Task" target="Cancelled"/>
</state>
<state id="Completed">
<transition event="Task Completed" target="endCompleted"/>
<state id="endCompleted"/>
</state>
</state>
<state id="Cancelled">
<transition event="Task Cancelled" target="endCancelled"/>
<state id="endCancelled"/>
</state>
</state>
</scxml>

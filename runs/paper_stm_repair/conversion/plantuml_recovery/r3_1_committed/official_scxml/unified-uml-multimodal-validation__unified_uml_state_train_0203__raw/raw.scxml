<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Monitoring"/>
</state>
<state id="Monitoring">
<transition event="on entry detected" target="EntryDetected"/>
<transition event="on user forgets to enter" target="ReminderNotification"/>
<transition target="end"/>
</state>
<state id="EntryDetected">
<transition event="on suspicious device detected" target="SuspiciousDeviceDetected"/>
<transition event="on no suspicious device" target="Monitoring"/>
</state>
<state id="ReminderNotification">
<transition event="on reset requested" target="ResetEntryTimes"/>
</state>
<state id="SuspiciousDeviceDetected">
<transition event="on device removed" target="Monitoring"/>
</state>
<state id="ResetEntryTimes">
<transition event="on reset completed" target="Monitoring"/>
</state>
<state id="end"/>
</scxml>

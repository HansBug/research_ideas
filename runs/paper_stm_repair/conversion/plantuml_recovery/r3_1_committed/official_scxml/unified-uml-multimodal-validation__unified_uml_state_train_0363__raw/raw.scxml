<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InputPreferences"/>
</state>
<state id="InputPreferences">
<transition target="ProcessingRecommendations"/>
</state>
<state id="ProcessingRecommendations">
<transition target="DisplayRecommendations"/>
</state>
<state id="DisplayRecommendations">
<transition target="SelectProduct"/>
</state>
<state id="SelectProduct">
<transition target="end"/>
<transition target="InputPreferences"/>
</state>
<state id="end"/>
</scxml>

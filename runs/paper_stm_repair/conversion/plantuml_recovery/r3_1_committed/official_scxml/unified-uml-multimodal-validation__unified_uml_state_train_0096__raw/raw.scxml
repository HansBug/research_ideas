<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DeviceDiscovery"/>
</state>
<state id="DeviceDiscovery">
<transition event="Devices discovered" target="DeviceManagement"/>
</state>
<state id="DeviceManagement">
<transition event="Access granted" target="RemoteAccess"/>
</state>
<state id="RemoteAccess">
<transition event="Events tracked" target="EventTracking"/>
</state>
<state id="EventTracking">
<transition event="Data analyzed" target="DataAnalytics"/>
</state>
<state id="DataAnalytics">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

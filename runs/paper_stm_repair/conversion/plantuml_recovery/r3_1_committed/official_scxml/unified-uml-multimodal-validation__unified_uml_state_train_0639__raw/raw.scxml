<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Unregistered"/>
</state>
<state id="Unregistered">
<transition event="Create Account" target="Registered"/>
</state>
<state id="Registered">
<transition target="end"/>
<transition event="View Account Info" target="AccountInfoView"/>
<transition event="Change Username" target="ChangingUsername"/>
<transition event="Change Password" target="ChangingPassword"/>
<transition event="Login" target="LoggedIn"/>
</state>
<state id="end"/>
<state id="AccountInfoView">
<transition target="end"/>
<transition event="Change Username" target="ChangingUsername"/>
<transition event="Change Password" target="ChangingPassword"/>
</state>
<state id="ChangingUsername">
<transition event="Update Username" target="UpdatingUsername"/>
</state>
<state id="ChangingPassword">
<transition event="Update Password" target="UpdatingPassword"/>
</state>
<state id="UpdatingUsername">
<transition event="Return to Info View" target="AccountInfoView"/>
</state>
<state id="UpdatingPassword">
<transition event="Return to Info View" target="AccountInfoView"/>
</state>
<state id="LoggedIn">
<transition event="View Info" target="AccountInfoView"/>
<transition event="Change Username" target="ChangingUsername"/>
<transition event="Change Password" target="ChangingPassword"/>
<transition event="Logout" target="Registered"/>
</state>
</scxml>

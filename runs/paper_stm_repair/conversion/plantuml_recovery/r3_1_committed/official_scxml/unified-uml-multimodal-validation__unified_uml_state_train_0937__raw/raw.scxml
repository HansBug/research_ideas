<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UserSelectsActivity"/>
</state>
<state id="UserSelectsActivity">
<transition target="AnalyzeBehaviorPreferences"/>
</state>
<state id="AnalyzeBehaviorPreferences">
<transition target="ProcessNLPML"/>
</state>
<state id="ProcessNLPML">
<transition target="GenerateRecommendations"/>
</state>
<state id="GenerateRecommendations">
<transition target="PresentRecommendations"/>
</state>
<state id="PresentRecommendations">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

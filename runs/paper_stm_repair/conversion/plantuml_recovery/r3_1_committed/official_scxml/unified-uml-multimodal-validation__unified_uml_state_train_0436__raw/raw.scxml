<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Initial"/>
</state>
<state id="Initial">
<transition event="configure preferences" target="SettingPreferences"/>
</state>
<state id="SettingPreferences">
<transition event="start monitoring" target="MonitoringEvents"/>
</state>
<state id="MonitoringEvents">
<transition event="detect event" target="CheckingCriteria"/>
<transition event="stop monitoring" target="end"/>
</state>
<state id="CheckingCriteria">
<transition event="criteria met" target="SendingNotification"/>
</state>
<state id="SendingNotification">
<transition event="log notification" target="LoggingNotification"/>
</state>
<state id="LoggingNotification">
<transition event="continue monitoring" target="MonitoringEvents"/>
</state>
<state id="end"/>
</scxml>

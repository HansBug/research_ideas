<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="AlertSettingsSetup"/>
</state>
<state id="AlertSettingsSetup">
<transition event="Configure Alert Settings" target="AlertConfigurationCompleted"/>
</state>
<state id="AlertConfigurationCompleted">
<transition event="Enter Monitoring" target="AlertMonitoringState"/>
<transition event="Exit" target="end"/>
</state>
<state id="AlertMonitoringState">
<transition event="Event Occurs" target="AlertTriggered"/>
<transition event="Modify Settings" target="AlertSettingsModification"/>
</state>
<state id="AlertTriggered">
<transition event="Alert Displayed" target="AlertMonitoringState"/>
</state>
<state id="AlertSettingsModification">
<transition event="Update Settings" target="AlertConfigurationCompleted"/>
</state>
<state id="end"/>
</scxml>

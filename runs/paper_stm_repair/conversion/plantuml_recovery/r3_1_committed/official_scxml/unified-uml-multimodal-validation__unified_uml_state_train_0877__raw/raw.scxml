<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SearchCriteriaEntry"/>
</state>
<state id="SearchCriteriaEntry">
<transition event="Enter search criteria" target="SearchProcessing"/>
</state>
<state id="SearchProcessing">
<transition event="Display matching courses" target="SearchResultsDisplay"/>
</state>
<state id="SearchResultsDisplay">
<transition event="Select course" target="CourseDetailsDisplay"/>
<transition event="Exit" target="end"/>
</state>
<state id="CourseDetailsDisplay">
<transition event="Back to search results" target="SearchResultsDisplay"/>
<transition event="Exit" target="end"/>
</state>
<state id="end"/>
</scxml>

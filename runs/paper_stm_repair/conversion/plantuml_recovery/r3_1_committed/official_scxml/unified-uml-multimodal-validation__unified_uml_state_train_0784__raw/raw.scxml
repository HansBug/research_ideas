<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="StartConfiguration"/>
</state>
<state id="StartConfiguration">
<transition event="Start" target="GenerateCombinations"/>
</state>
<state id="GenerateCombinations">
<transition event="Generate" target="EvaluateCombinations"/>
</state>
<state id="EvaluateCombinations">
<transition event="Evaluate" target="GenerateReport"/>
</state>
<state id="GenerateReport">
<transition event="Complete" target="end"/>
</state>
<state id="end"/>
</scxml>

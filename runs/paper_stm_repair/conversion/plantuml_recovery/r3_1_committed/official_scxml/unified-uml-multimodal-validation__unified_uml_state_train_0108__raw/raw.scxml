<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectingTasks"/>
</state>
<state id="SelectingTasks">
<transition target="AssigningTasks"/>
<transition target="AddingNewTasks"/>
</state>
<state id="AssigningTasks">
<transition target="ViewingTasks"/>
<transition target="AddingNewTasks"/>
</state>
<state id="AddingNewTasks">
<transition target="ViewingTasks"/>
</state>
<state id="ViewingTasks">
<transition target="UpdatingTasks"/>
<transition target="DeletingTasks"/>
<transition target="AddingNewTasks"/>
<transition target="end"/>
</state>
<state id="UpdatingTasks">
<transition target="ViewingTasks"/>
</state>
<state id="DeletingTasks">
<transition target="ViewingTasks"/>
</state>
<state id="end"/>
</scxml>

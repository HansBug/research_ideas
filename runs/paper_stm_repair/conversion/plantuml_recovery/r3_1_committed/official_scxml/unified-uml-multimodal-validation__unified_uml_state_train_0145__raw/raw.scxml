<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="MainInterface"/>
</state>
<state id="MainInterface">
<transition event="Add New Category" target="AddCategory"/>
<transition event="View Expenses" target="ViewExpenseList"/>
<transition event="Search by Category" target="SearchExpenses"/>
<transition event="View Financial Metrics" target="FinancialMetrics"/>
<transition event="Set Reminders" target="SetReminders"/>
<transition event="Exit" target="end"/>
</state>
<state id="AddCategory">
<transition event="Return to Main Interface" target="MainInterface"/>
<transition event="Exit" target="end"/>
</state>
<state id="ViewExpenseList">
<transition event="Return to Main Interface" target="MainInterface"/>
<transition event="Exit" target="end"/>
</state>
<state id="SearchExpenses">
<transition event="Return to Main Interface" target="MainInterface"/>
<transition event="Exit" target="end"/>
</state>
<state id="FinancialMetrics">
<transition event="Return to Main Interface" target="MainInterface"/>
<transition event="Exit" target="end"/>
</state>
<state id="SetReminders">
<transition event="Return to Main Interface" target="MainInterface"/>
<transition event="Exit" target="end"/>
</state>
<state id="end"/>
</scxml>

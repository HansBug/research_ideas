<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="CreateNewTravelPlan"/>
</state>
<state id="CreateNewTravelPlan">
<transition target="AddDestinations"/>
<transition target="AddActivities"/>
<transition target="AddAccommodations"/>
<transition target="SetPreferences"/>
<transition target="ReceiveRecommendations"/>
</state>
<state id="AddDestinations">
<transition target="EditDestinations"/>
<transition target="DeleteDestinations"/>
</state>
<state id="AddActivities">
<transition target="EditActivities"/>
<transition target="DeleteActivities"/>
</state>
<state id="AddAccommodations">
<transition target="EditAccommodations"/>
<transition target="DeleteAccommodations"/>
</state>
<state id="SetPreferences">
<transition target="UpdatePreferences"/>
</state>
<state id="ReceiveRecommendations">
<transition target="AcceptRecommendations"/>
<transition target="IgnoreRecommendations"/>
</state>
<state id="EditDestinations"/>
<state id="DeleteDestinations"/>
<state id="EditActivities"/>
<state id="DeleteActivities"/>
<state id="EditAccommodations"/>
<state id="DeleteAccommodations"/>
<state id="UpdatePreferences"/>
<state id="AcceptRecommendations">
<transition target="UpdatePlan"/>
</state>
<state id="IgnoreRecommendations"/>
<state id="UpdatePlan">
<transition target="ViewPlan"/>
<transition target="SharePlan"/>
<transition target="end"/>
</state>
<state id="ViewPlan">
<transition target="EditPlan"/>
<transition target="DeletePlan"/>
<transition target="SharePlan"/>
<transition target="ViewBookingHistory"/>
</state>
<state id="SharePlan">
<transition target="end"/>
</state>
<state id="end"/>
<state id="EditPlan"/>
<state id="DeletePlan"/>
<state id="ViewBookingHistory">
<transition target="end"/>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DisplayingReadingList"/>
</state>
<state id="DisplayingReadingList">
<transition event="Search" target="SearchingForBooks"/>
<transition event="Filter" target="FilteringResults"/>
<transition event="Exit" target="end"/>
</state>
<state id="SearchingForBooks">
<transition target="DisplayingSearchResults"/>
</state>
<state id="FilteringResults">
<transition target="DisplayingFilteredResults"/>
</state>
<state id="DisplayingSearchResults">
<transition event="Return" target="DisplayingReadingList"/>
</state>
<state id="DisplayingFilteredResults">
<transition event="Return" target="DisplayingReadingList"/>
</state>
<state id="end"/>
</scxml>

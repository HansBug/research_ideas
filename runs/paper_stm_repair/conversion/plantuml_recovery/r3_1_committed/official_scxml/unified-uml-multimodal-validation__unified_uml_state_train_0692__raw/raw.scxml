<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="NotLoggedIn"/>
</state>
<state id="NotLoggedIn">
<transition event="logout" target="end"/>
<transition event="login" target="LoggedIn"/>
</state>
<state id="end"/>
<state id="LoggedIn">
<transition event="view profile" target="ProfileView"/>
</state>
<state id="ProfileView">
<transition event="edit profile" target="ProfileEditing"/>
<transition event="upload media" target="MediaUpload"/>
<transition event="logout" target="end"/>
</state>
<state id="ProfileEditing">
<transition event="save changes" target="ProfileView"/>
<transition event="cancel editing" target="ProfileView"/>
</state>
<state id="MediaUpload">
<transition event="upload done" target="ProfileView"/>
</state>
</scxml>

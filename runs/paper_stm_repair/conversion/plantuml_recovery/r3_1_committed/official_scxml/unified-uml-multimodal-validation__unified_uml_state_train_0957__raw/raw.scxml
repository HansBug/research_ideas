<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="System_Opened"/>
</state>
<state id="System_Opened">
<transition target="Product_Selected"/>
</state>
<state id="Product_Selected">
<transition target="Updates_Viewed"/>
</state>
<state id="Updates_Viewed">
<transition target="Filtering_Sorting_Applied"/>
<transition target="end"/>
</state>
<state id="Filtering_Sorting_Applied">
<transition target="Updates_Viewed"/>
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

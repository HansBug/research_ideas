<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ProductCatalog"/>
</state>
<state id="ProductCatalog">
<transition event="Set preferences" target="PreferencesInput"/>
<transition event="Browse products" target="ProductBrowsing"/>
</state>
<state id="PreferencesInput">
<transition event="Preferences set" target="ProductCatalog"/>
</state>
<state id="ProductBrowsing">
<transition event="View details" target="ProductDetails"/>
<transition event="Purchase" target="Purchase"/>
</state>
<state id="ProductDetails">
<transition event="Purchase" target="Purchase"/>
<transition event="Back to browsing" target="ProductBrowsing"/>
</state>
<state id="Purchase">
<transition event="Exit" target="end"/>
</state>
<state id="end"/>
</scxml>

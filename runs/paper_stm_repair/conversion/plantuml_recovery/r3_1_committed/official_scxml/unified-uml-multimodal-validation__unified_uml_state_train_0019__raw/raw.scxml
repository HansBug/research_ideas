<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DisplayTaskList"/>
</state>
<state id="DisplayTaskList">
<transition event="Filter" target="FilterTasks"/>
<transition event="Sort" target="SortTasks"/>
<transition event="Delete" target="DeleteTask"/>
<transition event="End" target="end"/>
</state>
<state id="FilterTasks">
<transition event="Apply Filter" target="FilterTasks"/>
<transition event="Done Filtering" target="DisplayTaskList"/>
</state>
<state id="SortTasks">
<transition event="Apply Sort" target="SortTasks"/>
<transition event="Done Sorting" target="DisplayTaskList"/>
</state>
<state id="DeleteTask">
<transition event="Delete Task" target="DeleteTask"/>
<transition event="Done Deleting" target="DisplayTaskList"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Page_Loaded"/>
</state>
<state id="Page_Loaded">
<transition event="select content type" target="Content_Type_Selected"/>
<transition event="exit" target="end"/>
</state>
<state id="Content_Type_Selected">
<transition event="display content" target="Content_Displayed"/>
<transition event="cancel selection" target="Page_Loaded"/>
</state>
<state id="Content_Displayed">
<transition event="select different content type" target="Content_Type_Selected"/>
<transition event="exit" target="end"/>
</state>
<state id="end"/>
</scxml>

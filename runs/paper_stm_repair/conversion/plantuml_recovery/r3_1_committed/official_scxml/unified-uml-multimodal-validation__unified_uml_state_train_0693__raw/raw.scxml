<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="Task available" target="TaskAvailable"/>
</state>
<state id="TaskAvailable">
<transition target="CheckAvailability"/>
</state>
<state id="CheckAvailability">
<transition event="Available" target="CheckSkillset"/>
<transition event="Not available" target="Idle"/>
</state>
<state id="CheckSkillset">
<transition event="Skilled" target="AssignTask"/>
<transition event="Not skilled" target="Idle"/>
</state>
<state id="AssignTask">
<transition target="UpdateAvailability"/>
</state>
<state id="UpdateAvailability">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

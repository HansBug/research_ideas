<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="LoggedOut"/>
</state>
<state id="LoggedOut">
<transition event="Login" target="LoggedIn"/>
<transition event="Logout" target="end"/>
</state>
<state id="LoggedIn">
<transition event="Enter Building/Area" target="TrackingTime"/>
<transition event="Check Calendar" target="CalendarIntegration"/>
</state>
<state id="TrackingTime">
<transition event="Logout" target="LoggedOut"/>
</state>
<state id="CalendarIntegration">
<transition event="Return to System" target="LoggedIn"/>
</state>
<state id="end"/>
</scxml>

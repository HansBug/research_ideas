<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition event="Upload calendar events" target="UploadEvents"/>
<transition event="No action" target="end"/>
</state>
<state id="UploadEvents">
<transition event="Manage events (create, edit, delete)" target="ManageEvents"/>
</state>
<state id="ManageEvents">
<transition event="Add notes or reminders" target="AddNotes"/>
</state>
<state id="AddNotes">
<transition event="View entire calendar" target="ViewCalendar"/>
</state>
<state id="ViewCalendar">
<transition event="End" target="end"/>
</state>
<state id="end"/>
</scxml>

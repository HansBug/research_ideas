<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="AccountCreation"/>
</state>
<state id="AccountCreation">
<transition target="AccountSettingsManagement"/>
</state>
<state id="AccountSettingsManagement">
<transition target="PostAddition"/>
<transition target="ViewPastPosts"/>
</state>
<state id="PostAddition">
<transition target="PostSaved"/>
</state>
<state id="ViewPastPosts">
<transition target="end"/>
<transition target="PostAddition"/>
</state>
<state id="PostSaved">
<transition target="ViewPastPosts"/>
<transition target="PostAddition"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectingTime"/>
<transition target="ViewingTime"/>
</state>
<state id="SelectingTime">
<transition target="end"/>
<transition target="SavingPreferences"/>
<transition target="DisplayingTime"/>
</state>
<state id="end"/>
<state id="SavingPreferences">
<transition target="end"/>
</state>
<state id="DisplayingTime">
<transition target="end"/>
</state>
<state id="ViewingTime">
<transition target="end"/>
</state>
</scxml>

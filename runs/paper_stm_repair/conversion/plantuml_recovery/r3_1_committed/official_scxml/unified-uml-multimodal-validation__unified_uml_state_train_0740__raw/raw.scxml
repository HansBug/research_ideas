<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="LoggedOut"/>
</state>
<state id="LoggedOut">
<transition event="Login" target="ViewingProfile"/>
</state>
<state id="ViewingProfile">
<transition event="Create Profile" target="CreatingProfile"/>
<transition event="Edit Contact" target="EditingContact"/>
<transition event="Edit Preferences" target="EditingPreferences"/>
<transition event="Edit Security" target="EditingSecurity"/>
<transition event="Delete Profile" target="DeletingProfile"/>
<transition event="Logout" target="end"/>
</state>
<state id="CreatingProfile">
<transition event="Save" target="ViewingProfile"/>
<transition event="Cancel" target="ViewingProfile"/>
</state>
<state id="EditingContact">
<transition event="Save" target="ViewingProfile"/>
<transition event="Cancel" target="ViewingProfile"/>
</state>
<state id="EditingPreferences">
<transition event="Save" target="ViewingProfile"/>
<transition event="Cancel" target="ViewingProfile"/>
</state>
<state id="EditingSecurity">
<transition event="Save" target="ViewingProfile"/>
<transition event="Cancel" target="ViewingProfile"/>
</state>
<state id="DeletingProfile">
<transition event="Confirm" target="end"/>
<transition event="Cancel" target="ViewingProfile"/>
</state>
<state id="end"/>
</scxml>

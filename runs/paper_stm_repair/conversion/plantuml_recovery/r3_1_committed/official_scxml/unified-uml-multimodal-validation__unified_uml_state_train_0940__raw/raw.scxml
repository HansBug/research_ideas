<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="Login" target="ProfileLoaded"/>
<transition target="end"/>
</state>
<state id="ProfileLoaded">
<transition event="Update Profile" target="ProfileUpdate"/>
<transition event="Change Detected" target="NotificationSent"/>
<transition event="Logout" target="Idle"/>
</state>
<state id="ProfileUpdate">
<transition event="Update Complete" target="ProfileLoaded"/>
</state>
<state id="NotificationSent">
<transition event="Notification Acknowledged" target="ProfileLoaded"/>
</state>
<state id="end"/>
</scxml>

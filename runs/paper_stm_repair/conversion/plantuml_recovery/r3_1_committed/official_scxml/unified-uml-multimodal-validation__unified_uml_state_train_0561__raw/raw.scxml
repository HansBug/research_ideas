<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
<transition event="Exit System" target="end"/>
</state>
<state id="InitialState">
<transition event="View Profile" target="ViewProfile"/>
<transition event="Update Profile" target="UpdateProfile"/>
<transition event="Add Contact" target="AddContact"/>
<transition event="Delete Profile" target="DeleteProfile"/>
</state>
<state id="ViewProfile">
<transition event="Return to Initial" target="end"/>
</state>
<state id="end"/>
<state id="UpdateProfile">
<transition event="Validate Update" target="ValidateUpdate"/>
</state>
<state id="ValidateUpdate">
<transition event="Success" target="end"/>
<transition event="Invalid Input" target="UpdateError"/>
</state>
<state id="UpdateError">
<transition event="Error Handling" target="end"/>
</state>
<state id="AddContact">
<transition event="Validate Contact" target="ValidateContact"/>
</state>
<state id="ValidateContact">
<transition event="Success" target="end"/>
<transition event="Invalid Input" target="ContactError"/>
</state>
<state id="ContactError">
<transition event="Error Handling" target="end"/>
</state>
<state id="DeleteProfile">
<transition event="Profile Deleted" target="end"/>
</state>
</scxml>

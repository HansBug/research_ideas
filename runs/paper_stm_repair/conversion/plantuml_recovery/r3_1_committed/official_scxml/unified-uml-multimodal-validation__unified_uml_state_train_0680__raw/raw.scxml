<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UserInput"/>
</state>
<state id="UserInput">
<transition target="WorkflowCreation"/>
</state>
<state id="WorkflowCreation">
<transition target="TaskSuggestions"/>
<transition target="Automation"/>
<transition target="Delegation"/>
</state>
<state id="TaskSuggestions">
<transition target="Notifications"/>
<transition target="OptimizationSuggestions"/>
</state>
<state id="Automation">
<transition target="Notifications"/>
<transition target="OptimizationSuggestions"/>
</state>
<state id="Delegation">
<transition target="Notifications"/>
<transition target="OptimizationSuggestions"/>
</state>
<state id="Notifications">
<transition target="end"/>
</state>
<state id="OptimizationSuggestions">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition target="SearchProducts"/>
</state>
<state id="SearchProducts">
<transition target="DisplayResults"/>
</state>
<state id="DisplayResults">
<transition target="SortResults"/>
</state>
<state id="SortResults">
<transition target="DisplayFavorites"/>
</state>
<state id="DisplayFavorites">
<transition target="AddFavorite"/>
</state>
<state id="AddFavorite">
<transition target="RemoveFavorite"/>
</state>
<state id="RemoveFavorite">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

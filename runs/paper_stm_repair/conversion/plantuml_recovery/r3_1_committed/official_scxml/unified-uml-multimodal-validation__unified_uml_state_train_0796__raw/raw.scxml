<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UploadContent"/>
<transition target="ViewContent"/>
<transition target="SetReminder"/>
<transition target="DownloadContent"/>
</state>
<state id="UploadContent">
<transition event="After upload" target="ViewContent"/>
<transition event="After upload" target="DownloadContent"/>
</state>
<state id="ViewContent">
<transition event="After viewing" target="SetReminder"/>
<transition event="After viewing" target="DownloadContent"/>
</state>
<state id="DownloadContent">
<transition event="After download" target="end"/>
</state>
<state id="SetReminder">
<transition event="After setting reminder" target="DownloadContent"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="Create New Document" target="Start"/>
</state>
<state id="Start">
<transition event="Enter Font Size (8-24 points)" target="Adjust_Font_Size"/>
<transition event="Choose Color Scheme" target="Select_Color_Scheme"/>
</state>
<state id="Adjust_Font_Size">
<transition event="Continue to Color Scheme" target="Select_Color_Scheme"/>
<transition event="Finalize Settings" target="Finalize_Settings"/>
</state>
<state id="Select_Color_Scheme">
<transition event="Confirm Changes" target="Finalize_Settings"/>
</state>
<state id="Finalize_Settings">
<transition event="Document Created with Custom Settings" target="end"/>
</state>
<state id="end"/>
</scxml>

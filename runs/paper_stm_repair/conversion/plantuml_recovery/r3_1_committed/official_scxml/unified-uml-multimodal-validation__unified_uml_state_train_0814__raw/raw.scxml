<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Logged_Out"/>
<transition event="System reset" target="end"/>
</state>
<state id="Logged_Out">
<transition event="User logs in" target="Login"/>
</state>
<state id="Login">
<transition event="Profile loaded successfully" target="Profile_Loaded"/>
</state>
<state id="Profile_Loaded">
<transition event="View profile information" target="View_Profile"/>
<transition event="Edit profile information" target="Edit_Profile"/>
<transition event="Delete profile" target="Delete_Profile"/>
<transition event="User logs out" target="Logout"/>
</state>
<state id="View_Profile">
<transition event="Return to profile view" target="Profile_Loaded"/>
</state>
<state id="Edit_Profile">
<transition event="Save changes" target="Save_Changes"/>
<transition event="Cancel editing" target="Cancel_Edit"/>
</state>
<state id="Save_Changes">
<transition event="Changes saved successfully" target="Profile_Loaded"/>
</state>
<state id="Cancel_Edit">
<transition event="Editing canceled" target="Profile_Loaded"/>
</state>
<state id="Delete_Profile">
<transition event="Profile deleted" target="Profile_Deleted"/>
</state>
<state id="Profile_Deleted">
<transition event="System returns to logged out state" target="end"/>
</state>
<state id="end"/>
<state id="Logout">
<transition event="Profile information removed from system" target="end"/>
</state>
</scxml>

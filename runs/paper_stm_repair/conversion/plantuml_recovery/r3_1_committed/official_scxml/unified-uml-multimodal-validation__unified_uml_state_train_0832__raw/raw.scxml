<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Access_Quick_View"/>
</state>
<state id="Access_Quick_View">
<transition event="View product/service list" target="View_Product_Service_List"/>
<transition event="Access customer information" target="Access_Customer_Info"/>
</state>
<state id="View_Product_Service_List">
<transition event="Compare features and pricing" target="Compare_Features_Pricing"/>
<transition event="Switch context" target="Switch_Context"/>
<transition event="Exit" target="end"/>
</state>
<state id="Access_Customer_Info">
<transition event="Return to product/service list" target="View_Product_Service_List"/>
<transition event="Switch context" target="Switch_Context"/>
<transition event="Exit" target="end"/>
</state>
<state id="Compare_Features_Pricing">
<transition event="Return to list" target="View_Product_Service_List"/>
<transition event="Switch context" target="Switch_Context"/>
<transition event="Exit" target="end"/>
</state>
<state id="Switch_Context">
<transition event="Switch to product/service list" target="View_Product_Service_List"/>
<transition event="Switch to customer info" target="Access_Customer_Info"/>
<transition event="Return to Quick View" target="Access_Quick_View"/>
<transition event="Exit" target="end"/>
</state>
<state id="end"/>
</scxml>

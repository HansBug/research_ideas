<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="Brake Signal Received" target="BrakingState"/>
<transition event="Signal Transmission Fails" target="OperationalState"/>
</state>
<state id="BrakingState">
<transition event="Entering Clamping State" target="ClampingState"/>
<transition event="Signal Feedback Sent" target="InitialState"/>
</state>
<state id="OperationalState">
<transition event="Signal Feedback Sent" target="InitialState"/>
</state>
<state id="ClampingState"/>
</scxml>

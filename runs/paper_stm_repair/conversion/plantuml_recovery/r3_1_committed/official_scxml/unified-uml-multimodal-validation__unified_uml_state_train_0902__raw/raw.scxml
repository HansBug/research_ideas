<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="&quot;Setup Preferences&quot;" target="SettingUpPreferences"/>
<transition event="&quot;Manage Notifications&quot;" target="ManagingNotifications"/>
</state>
<state id="SettingUpPreferences">
<transition event="&quot;Adjust Settings&quot;" target="AdjustingSettings"/>
<transition event="&quot;Trigger Notifications&quot;" target="TriggeringNotifications"/>
</state>
<state id="ManagingNotifications">
<transition event="&quot;Adjust Settings&quot;" target="AdjustingSettings"/>
<transition event="&quot;Stop Notifications&quot;" target="StoppingNotifications"/>
</state>
<state id="AdjustingSettings">
<transition event="&quot;Save Preferences&quot;" target="SavingPreferences"/>
<transition event="&quot;Discard Changes&quot;" target="DiscardingChanges"/>
</state>
<state id="TriggeringNotifications">
<transition event="&quot;Send Notification&quot;" target="NotifyingUser"/>
<transition event="&quot;Pause Notifications&quot;" target="PausingNotifications"/>
</state>
<state id="StoppingNotifications">
<transition event="&quot;Stop Notifications&quot;" target="end"/>
</state>
<state id="SavingPreferences">
<transition event="&quot;Preferences Saved&quot;" target="end"/>
</state>
<state id="DiscardingChanges">
<transition event="&quot;Changes Discarded&quot;" target="end"/>
</state>
<state id="NotifyingUser">
<transition event="&quot;Notification Complete&quot;" target="end"/>
</state>
<state id="PausingNotifications">
<transition event="&quot;Resume Notifications&quot;" target="ResumingNotifications"/>
<transition event="&quot;Stop Notifications&quot;" target="end"/>
</state>
<state id="end"/>
<state id="ResumingNotifications">
<transition event="&quot;Resume Notifications&quot;" target="NotifyingUser"/>
</state>
</scxml>

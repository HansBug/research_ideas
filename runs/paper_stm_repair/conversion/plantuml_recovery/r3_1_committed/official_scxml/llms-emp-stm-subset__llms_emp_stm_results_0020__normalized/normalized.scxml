<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="HumanDrivingMode"/>
</state>
<state id="HumanDrivingMode">
<transition event="front_distance &gt; 10" target="AutonomousMode"/>
<transition event="Power Off" target="end"/>
</state>
<state id="end"/>
<state id="AutonomousMode">
<transition event="Power Off" target="end"/>
<state id="startAutonomousMode">
<transition target="AutoInitialState"/>
</state>
<state id="AutoInitialState">
<transition event="Signal Transmission Succeeds" target="AutoOperationalState"/>
</state>
<state id="AutoOperationalState">
<transition event="Mission Completed" target="AutoFinalState"/>
<transition event="human steering cmd, brake pressed" target="HumanDrivingMode"/>
</state>
<state id="AutoFinalState">
<transition event="human steering cmd, brake pressed" target="HumanDrivingMode"/>
</state>
</state>
</scxml>

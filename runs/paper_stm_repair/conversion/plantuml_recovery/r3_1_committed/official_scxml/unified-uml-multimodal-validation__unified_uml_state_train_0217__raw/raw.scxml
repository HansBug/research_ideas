<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InputPreferencesAndGoals"/>
</state>
<state id="InputPreferencesAndGoals">
<transition event="Process preferences" target="SystemGeneratesLearningPlan"/>
</state>
<state id="SystemGeneratesLearningPlan">
<transition event="Generate plan" target="UserNavigatesLearningPath"/>
</state>
<state id="UserNavigatesLearningPath">
<transition event="Complete learning path" target="end"/>
</state>
<state id="end"/>
</scxml>

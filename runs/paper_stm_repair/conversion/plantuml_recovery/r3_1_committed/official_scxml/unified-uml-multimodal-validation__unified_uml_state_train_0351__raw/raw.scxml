<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="Load Content List" target="ContentListState"/>
</state>
<state id="ContentListState">
<transition event="Initiate Search" target="SearchState"/>
<transition event="Add New Item" target="AddItemState"/>
<transition event="Remove Item" target="RemoveItemState"/>
<transition event="Rearrange Items" target="RearrangeItemState"/>
<transition event="Enable VoiceOver" target="VoiceOverState"/>
<transition event="Enable High Contrast" target="HighContrastState"/>
<transition event="Enable Keyboard Navigation" target="KeyboardNavState"/>
<transition event="Enable Keywords" target="AccessibilityKeywordsState"/>
<transition event="Exit Feature" target="end"/>
</state>
<state id="SearchState">
<transition event="Apply Search Filters" target="FilteredListState"/>
</state>
<state id="FilteredListState">
<transition event="Clear Search" target="ContentListState"/>
</state>
<state id="AddItemState">
<transition event="Item Added" target="ContentListState"/>
</state>
<state id="RemoveItemState">
<transition event="Item Removed" target="ContentListState"/>
</state>
<state id="RearrangeItemState">
<transition event="Items Rearranged" target="ContentListState"/>
</state>
<state id="VoiceOverState">
<transition event="Disable VoiceOver" target="ContentListState"/>
</state>
<state id="HighContrastState">
<transition event="Disable High Contrast" target="ContentListState"/>
</state>
<state id="KeyboardNavState">
<transition event="Disable Keyboard Navigation" target="ContentListState"/>
</state>
<state id="AccessibilityKeywordsState">
<transition event="Disable Keywords" target="ContentListState"/>
</state>
<state id="end"/>
</scxml>

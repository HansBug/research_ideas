<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Login"/>
</state>
<state id="Login">
<transition target="AccessShareFeature"/>
</state>
<state id="AccessShareFeature">
<transition target="CreatePost"/>
</state>
<state id="CreatePost">
<transition target="AddMedia"/>
<transition target="end"/>
</state>
<state id="AddMedia">
<transition target="SetPrivacy"/>
<transition target="end"/>
</state>
<state id="SetPrivacy">
<transition target="AddTags"/>
<transition target="end"/>
</state>
<state id="AddTags">
<transition target="SharePost"/>
<transition target="end"/>
</state>
<state id="SharePost">
<transition target="ViewPost"/>
<transition target="end"/>
</state>
<state id="ViewPost">
<transition target="ViewFriendsPosts"/>
<transition target="end"/>
</state>
<state id="ViewFriendsPosts">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

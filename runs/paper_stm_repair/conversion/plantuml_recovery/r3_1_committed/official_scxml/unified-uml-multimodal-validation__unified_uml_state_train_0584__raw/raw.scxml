<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InputPreferences"/>
</state>
<state id="InputPreferences">
<transition event="After preferences input" target="GenerateMealIdeas"/>
<transition event="If invalid input" target="InputPreferences"/>
</state>
<state id="GenerateMealIdeas">
<transition event="After meal ideas generated" target="SelectMeals"/>
</state>
<state id="SelectMeals">
<transition event="After meals selected" target="GenerateMealPlan"/>
</state>
<state id="GenerateMealPlan">
<transition event="After meal plan generated" target="ViewMealPlan"/>
<transition event="If changes needed" target="SelectMeals"/>
</state>
<state id="ViewMealPlan">
<transition event="After meal plan viewed" target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="&quot;Enter Task Management&quot;" target="TaskList"/>
</state>
<state id="TaskList">
<transition event="&quot;Add Task&quot;" target="AddTask"/>
<transition event="&quot;Edit Task&quot;" target="EditTask"/>
<transition event="&quot;Delete Task&quot;" target="DeleteTask"/>
<transition event="&quot;Set Reminder&quot;" target="SetReminder"/>
<transition event="&quot;Search Task&quot;" target="SearchTask"/>
<transition event="&quot;Exit Task Management&quot;" target="end"/>
</state>
<state id="AddTask">
<transition event="&quot;Task Added&quot;" target="TaskList"/>
</state>
<state id="EditTask">
<transition event="&quot;Task Edited&quot;" target="TaskList"/>
</state>
<state id="DeleteTask">
<transition event="&quot;Task Deleted&quot;" target="TaskList"/>
</state>
<state id="SetReminder">
<transition event="&quot;Reminder Set&quot;" target="TaskList"/>
</state>
<state id="SearchTask">
<transition event="&quot;Search Complete&quot;" target="TaskList"/>
</state>
<state id="end"/>
</scxml>

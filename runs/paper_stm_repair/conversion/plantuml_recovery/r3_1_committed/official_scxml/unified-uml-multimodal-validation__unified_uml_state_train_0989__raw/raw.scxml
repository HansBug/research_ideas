<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="Open App" target="DisplayMetrics"/>
</state>
<state id="DisplayMetrics">
<transition event="Close App" target="end"/>
<transition event="Share Metrics" target="Sharing"/>
</state>
<state id="end"/>
<state id="Sharing">
<transition event="Complete Sharing" target="end"/>
</state>
</scxml>

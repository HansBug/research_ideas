<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DisplayList"/>
</state>
<state id="DisplayList">
<transition event="Search or Filter" target="SearchFilter"/>
<transition event="Sort by Release Date" target="SortReleaseDate"/>
<transition event="Add Song" target="AddSong"/>
<transition event="Remove Song" target="RemoveSong"/>
<transition event="Save List" target="SaveList"/>
<transition event="Exit" target="end"/>
</state>
<state id="SearchFilter">
<transition event="Apply Search/Filter" target="DisplayList"/>
</state>
<state id="SortReleaseDate">
<transition event="Apply Sort" target="DisplayList"/>
</state>
<state id="AddSong">
<transition event="Add Song" target="DisplayList"/>
</state>
<state id="RemoveSong">
<transition event="Remove Song" target="DisplayList"/>
</state>
<state id="SaveList">
<transition event="Save to File" target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="NoPriceSet"/>
</state>
<state id="NoPriceSet">
<transition event="Set Price" target="PriceSet"/>
</state>
<state id="PriceSet">
<transition event="Final State" target="end"/>
<transition event="New Transaction" target="PriceSet"/>
<transition event="Remove Price" target="NoPriceSet"/>
<transition event="Update Price" target="PriceSet"/>
</state>
<state id="end"/>
</scxml>

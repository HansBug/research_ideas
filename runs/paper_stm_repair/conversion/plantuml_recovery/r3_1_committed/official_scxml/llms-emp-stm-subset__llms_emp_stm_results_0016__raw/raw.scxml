<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="Start Mission" target="SearchMission"/>
</state>
<state id="SearchMission">
<transition event="Interception Detected" target="FormationAdjust"/>
<transition event="Task Assignment Received" target="AttackState"/>
<state id="startSearchMission">
<transition target="Area1"/>
</state>
<state id="Area1">
<transition event="Finished Area1" target="Area2"/>
</state>
<state id="Area2">
<transition event="Finished Area2" target="Area3"/>
</state>
<state id="Area3">
<transition event="Finished Area3" target="endSearchMission"/>
</state>
<state id="endSearchMission"/>
</state>
<state id="FormationAdjust">
<state id="startFormationAdjust">
<transition target="AdjustingFormation"/>
</state>
<state id="AdjustingFormation">
<transition event="Finish Adjusting" target="SearchMission"/>
</state>
</state>
<state id="AttackState">
<state id="startAttackState">
<transition target="Attacking"/>
</state>
<state id="Attacking">
<transition event="Attack Finished / Decrease UAV swarm count" target="SearchMission"/>
</state>
</state>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="User selects to customize notifications" target="CustomizingNotifications"/>
</state>
<state id="CustomizingNotifications">
<transition event="User saves the custom notification profile" target="SavingProfile"/>
<transition event="User decides to manage existing notification profiles" target="ManagingNotifications"/>
</state>
<state id="SavingProfile">
<transition event="User continues customizing" target="CustomizingNotifications"/>
<transition event="User switches to manage profiles" target="ManagingNotifications"/>
<transition event="User exits after saving" target="end"/>
</state>
<state id="ManagingNotifications">
<transition event="User switches to a different profile" target="SwitchingProfile"/>
<transition event="User deletes a profile" target="DeletingProfile"/>
<transition event="User exits after managing" target="end"/>
</state>
<state id="end">
<transition target="FinalState"/>
</state>
<state id="SwitchingProfile">
<transition event="Returns to managing profiles" target="ManagingNotifications"/>
</state>
<state id="DeletingProfile">
<transition event="Returns to managing profiles" target="ManagingNotifications"/>
</state>
<state id="FinalState"/>
</scxml>

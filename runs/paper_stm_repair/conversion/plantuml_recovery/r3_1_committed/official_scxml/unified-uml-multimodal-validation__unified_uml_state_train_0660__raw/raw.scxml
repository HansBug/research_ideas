<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition event="User creates a map" target="MapCreation"/>
</state>
<state id="MapCreation">
<transition event="User sets timer" target="TimerSetup"/>
<transition event="User adds notes" target="NoteAddition"/>
<transition event="User views map" target="MapViewing"/>
</state>
<state id="TimerSetup">
<transition event="Timer starts" target="TimerActive"/>
</state>
<state id="NoteAddition"/>
<state id="MapViewing">
<transition event="Map saved" target="MapSaved"/>
<transition event="Map accessed later" target="MapAccess"/>
<transition event="User exits" target="Exit"/>
</state>
<state id="TimerActive">
<transition event="Timer triggers action" target="ActionTriggered"/>
</state>
<state id="ActionTriggered">
<transition event="Return to view map" target="MapViewing"/>
</state>
<state id="MapSaved">
<transition event="Access saved map" target="MapAccess"/>
</state>
<state id="MapAccess">
<transition event="View accessed map" target="MapViewing"/>
</state>
<state id="Exit">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ProductSelection"/>
<transition target="CartManagement"/>
<transition target="OrderHistory"/>
<transition target="UserProfile"/>
<transition target="PaymentMethod"/>
</state>
<state id="ProductSelection">
<transition event="Add to Cart" target="CartManagement"/>
<transition event="Exit" target="end"/>
</state>
<state id="CartManagement">
<transition event="Proceed to Checkout" target="PaymentMethod"/>
<transition event="Cancel" target="end"/>
</state>
<state id="OrderHistory">
<transition event="View History" target="end"/>
<transition target="end"/>
</state>
<state id="UserProfile">
<transition event="View/Edit Profile" target="end"/>
</state>
<state id="PaymentMethod">
<transition event="Payment Confirmed" target="OrderHistory"/>
<transition event="Payment Canceled" target="end"/>
</state>
<state id="end"/>
</scxml>

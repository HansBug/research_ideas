<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InputPreferences"/>
</state>
<state id="InputPreferences">
<transition target="GenerateMealPlan"/>
</state>
<state id="GenerateMealPlan">
<transition target="ViewTrackProgress"/>
</state>
<state id="ViewTrackProgress">
<transition target="AdjustMealPlan"/>
<transition target="end"/>
</state>
<state id="AdjustMealPlan">
<transition target="ProvideSubstitutions"/>
<transition target="end"/>
</state>
<state id="end"/>
<state id="ProvideSubstitutions">
<transition target="ViewTrackProgress"/>
</state>
</scxml>

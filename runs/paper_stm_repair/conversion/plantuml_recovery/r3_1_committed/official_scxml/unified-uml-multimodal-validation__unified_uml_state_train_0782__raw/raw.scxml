<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="on select version" target="VersionSelection"/>
<transition event="on manage files" target="FileManagement"/>
<transition event="on error" target="RestoreVersion"/>
<transition target="end"/>
</state>
<state id="VersionSelection">
<transition event="on version selected" target="SwitchingVersion"/>
</state>
<state id="FileManagement">
<transition event="on done" target="Idle"/>
</state>
<state id="RestoreVersion">
<transition event="on restore success" target="Idle"/>
</state>
<state id="SwitchingVersion">
<transition event="on success" target="Idle"/>
<transition event="on error" target="RestoreVersion"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="AnalyzingUserSchedule"/>
</state>
<state id="AnalyzingUserSchedule">
<transition target="IdentifyingTaskDependencies"/>
</state>
<state id="IdentifyingTaskDependencies">
<transition target="DeterminingTaskDurations"/>
</state>
<state id="DeterminingTaskDurations">
<transition target="CheckingUserPreferences"/>
</state>
<state id="CheckingUserPreferences">
<transition target="AdjustingTaskTimes"/>
</state>
<state id="AdjustingTaskTimes">
<transition target="GeneratingTimeSlots"/>
</state>
<state id="GeneratingTimeSlots">
<transition target="ProvidingTaskList"/>
</state>
<state id="ProvidingTaskList">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

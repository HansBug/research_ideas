<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SearchingState"/>
</state>
<state id="SearchingState">
<transition event="Intercepted" target="FormationAdjustmentState"/>
<transition event="Task Assignment Received" target="AttackState"/>
<transition event="Mission Completed" target="end"/>
</state>
<state id="FormationAdjustmentState"/>
<state id="AttackState">
<transition event="Attack Completed" target="SearchingState"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="App_Running"/>
</state>
<state id="App_Running">
<transition event="User triggers language switch" target="Language_Selection"/>
<transition target="end"/>
</state>
<state id="Language_Selection">
<transition event="Language selected" target="Language_Updated"/>
</state>
<state id="Language_Updated">
<transition event="UI updated" target="App_Running"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UserInputsTitles"/>
</state>
<state id="UserInputsTitles">
<transition target="AnalyzeViewingHistory"/>
</state>

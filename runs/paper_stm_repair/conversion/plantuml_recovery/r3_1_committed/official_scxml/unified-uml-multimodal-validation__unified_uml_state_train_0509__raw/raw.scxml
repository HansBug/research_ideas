<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ViewingNotesAndBookmarks"/>
</state>
<state id="ViewingNotesAndBookmarks">
<transition event="Add" target="AddingNoteBookmark"/>
<transition event="Delete" target="DeletingNoteBookmark"/>
<transition event="Organize" target="OrganizingNotesBookmarks"/>
<transition event="Exit" target="end"/>
</state>
<state id="AddingNoteBookmark">
<transition event="Complete" target="ViewingNotesAndBookmarks"/>
</state>
<state id="DeletingNoteBookmark">
<transition event="Complete" target="ViewingNotesAndBookmarks"/>
</state>
<state id="OrganizingNotesBookmarks">
<transition event="Complete" target="ViewingNotesAndBookmarks"/>
</state>
<state id="end"/>
</scxml>

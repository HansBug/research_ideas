<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectingTimeRange"/>
</state>
<state id="SelectingTimeRange">
<transition target="GeneratingReport"/>
</state>
<state id="GeneratingReport">
<transition target="CustomizingReport"/>
</state>
<state id="CustomizingReport">
<transition target="DisplayingReport"/>
</state>
<state id="DisplayingReport">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

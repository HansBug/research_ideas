<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SelectMealType"/>
</state>
<state id="SelectMealType">
<transition target="SuggestIngredients"/>
</state>
<state id="SuggestIngredients">
<transition target="AddAdditionalItems"/>
</state>
<state id="AddAdditionalItems">
<transition target="SaveOrPrintPlan"/>
</state>
<state id="SaveOrPrintPlan">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

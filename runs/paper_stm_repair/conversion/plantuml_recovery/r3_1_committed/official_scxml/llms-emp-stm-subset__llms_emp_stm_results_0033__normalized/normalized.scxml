<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="startPumpControlSystem_002066" version="1.0">
<state id="PumpControlSystem_002066">
<state id="startPumpControlSystem_002066">
<transition target="PumpControl"/>
</state>
<state id="PumpControl">
<transition event="Activate Pump" target="PumpState"/>
<transition event="Monitor Water Flow" target="WaterState"/>
<transition event="Monitor Methane Flow" target="MethaneState"/>
</state>
<state id="PumpState">
<transition event="Pump Deactivated" target="PumpControl"/>
</state>
<state id="WaterState">
<transition event="Water Flow Stabilized" target="PumpControl"/>
</state>
<state id="MethaneState">
<transition event="Methane Flow Stabilized" target="PumpControl"/>
</state>
</state>
</scxml>

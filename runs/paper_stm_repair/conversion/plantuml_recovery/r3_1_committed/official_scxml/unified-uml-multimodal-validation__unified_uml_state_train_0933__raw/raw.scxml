<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Ready"/>
</state>
<state id="Ready">
<transition event="Start Learning Preferences" target="LearningPreferences"/>
</state>
<state id="LearningPreferences">
<transition event="Preferences Learned" target="PerformingTasks"/>
</state>
<state id="PerformingTasks">
<transition event="Need Reminder" target="ProvidingReminders"/>
<transition event="Understand Command" target="UnderstandingCommands"/>
<transition event="Control Device" target="ControllingDevices"/>
<transition event="Tasks Completed" target="end"/>
</state>
<state id="ProvidingReminders">
<transition event="Reminder Provided" target="PerformingTasks"/>
</state>
<state id="UnderstandingCommands">
<transition event="Command Understood" target="PerformingTasks"/>
<transition event="Command Not Understandable" target="Ready"/>
</state>
<state id="ControllingDevices">
<transition event="Device Controlled" target="PerformingTasks"/>
<transition event="Device Control Failed" target="Ready"/>
</state>
<state id="end"/>
</scxml>

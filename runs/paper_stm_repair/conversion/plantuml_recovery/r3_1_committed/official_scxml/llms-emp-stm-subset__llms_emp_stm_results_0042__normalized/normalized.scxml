<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="keyOff" target="Off"/>
</state>
<state id="Off">
<transition event="start" target="Operate"/>
</state>
<state id="Operate">
<transition event="keyOff" target="Off"/>
<state id="startOperate">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="accelerate" target="AcceleratingOrCruising"/>
</state>
<state id="AcceleratingOrCruising">
<transition event="stop" target="Idle"/>
<transition event="brake" target="Braking"/>
</state>
<state id="Braking">
<transition event="stop" target="Idle"/>
<transition event="accelerate" target="AcceleratingOrCruising"/>
</state>
</state>
</scxml>

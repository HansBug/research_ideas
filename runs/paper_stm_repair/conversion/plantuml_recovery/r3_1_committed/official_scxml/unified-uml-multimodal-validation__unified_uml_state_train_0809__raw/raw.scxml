<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="Start Customizing Dashboard" target="DashboardCreation"/>
</state>
<state id="DashboardCreation">
<transition event="Add/Remove Content" target="ContentCustomization"/>
</state>
<state id="ContentCustomization">
<transition event="Apply Filters/Sort" target="FilteringSorting"/>
</state>
<state id="FilteringSorting">
<transition event="Save/Export Content" target="ContentManagement"/>
</state>
<state id="ContentManagement">
<transition event="Finish Customization" target="end"/>
</state>
<state id="end"/>
</scxml>

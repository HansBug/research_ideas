<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Start"/>
</state>
<state id="Start">
<transition event="Display Main Menu" target="DisplayMainMenu"/>
</state>
<state id="DisplayMainMenu">
<transition event="Search for Books" target="SearchBooks"/>
<transition event="Add New Book" target="AddNewBook"/>
<transition event="Mark Book as Read/Return" target="MarkBookStatus"/>
<transition event="View Notes and Tags" target="ViewNotes"/>
</state>
<state id="SearchBooks">
<transition event="Enter Search Criteria" target="EnterSearchCriteria"/>
</state>
<state id="AddNewBook">
<transition event="Enter Book Details" target="EnterBookDetails"/>
</state>
<state id="MarkBookStatus">
<transition event="Select Book" target="SelectBook"/>
</state>
<state id="ViewNotes">
<transition event="Select Book to View" target="SelectBookToView"/>
</state>
<state id="EnterSearchCriteria">
<transition event="Display Search Results" target="DisplaySearchResults"/>
</state>
<state id="DisplaySearchResults">
<transition event="End" target="end"/>
</state>
<state id="end"/>
<state id="EnterBookDetails">
<transition event="Add to Catalog" target="AddToCatalog"/>
</state>
<state id="AddToCatalog">
<transition event="End" target="end"/>
</state>
<state id="SelectBook">
<transition event="Update Status" target="UpdateStatus"/>
</state>
<state id="UpdateStatus">
<transition event="End" target="end"/>
</state>
<state id="SelectBookToView">
<transition event="Display Notes and Tags" target="DisplayNotesAndTags"/>
</state>
<state id="DisplayNotesAndTags">
<transition event="End" target="end"/>
</state>
</scxml>

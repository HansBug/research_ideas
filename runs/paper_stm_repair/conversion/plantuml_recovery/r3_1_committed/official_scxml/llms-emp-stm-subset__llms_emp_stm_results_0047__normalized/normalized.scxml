<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="startFrontend" version="1.0">
<state id="end"/>
<state id="Frontend">
<transition event="Collision Avoided" target="end"/>
<state id="startFrontend">
<transition target="Idle"/>
</state>
<state id="Idle">
<transition event="Collision Detected" target="Braking"/>
<transition event="Collision Detected" target="Braking"/>
<transition event="Collision Detected" target="Braking"/>
</state>
<state id="Braking">
<transition event="Brake Applied" target="Clamping"/>
<transition event="Brake Applied" target="Clamping"/>
<transition event="Brake Applied" target="Clamping"/>
</state>
<state id="Clamping">
<transition event="Collision Avoided" target="Idle"/>
<transition event="Collision Avoided" target="Idle"/>
<transition event="Collision Avoided" target="Idle"/>
</state>
</state>
<state id="RearEnd">
<transition event="Collision Avoided" target="end"/>
<state id="startRearEnd">
<transition target="Idle"/>
</state>
</state>
<state id="Pedestrian">
<transition event="Collision Avoided" target="end"/>
<state id="startPedestrian">
<transition target="Idle"/>
</state>
</state>
</scxml>

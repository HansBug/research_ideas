<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DeviceConnection"/>
</state>
<state id="DeviceConnection">
<transition target="DeviceControl"/>
<transition target="end"/>
</state>
<state id="DeviceControl">
<transition target="Notifications"/>
<transition target="Settings"/>
<transition target="end"/>
</state>
<state id="Notifications">
<transition target="DeviceControl"/>
</state>
<state id="Settings">
<transition target="DeviceControl"/>
</state>
<state id="end"/>
</scxml>

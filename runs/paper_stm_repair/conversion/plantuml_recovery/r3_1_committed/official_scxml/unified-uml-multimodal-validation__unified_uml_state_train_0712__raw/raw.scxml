<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ResourceAllocationRequest"/>
</state>
<state id="ResourceAllocationRequest">
<transition target="ResourceAvailabilityCheck"/>
</state>
<state id="ResourceAvailabilityCheck">
<transition event="Resources Available?" target="ResourceAllocation"/>
<transition event="Resources Unavailable" target="ResourceReallocation"/>
</state>
<state id="ResourceAllocation">
<transition target="TaskExecution"/>
</state>
<state id="ResourceReallocation">
<transition target="TaskExecution"/>
</state>
<state id="TaskExecution">
<transition event="Task Requirements Change" target="ResourceAdjustment"/>
<transition event="Task Completion" target="end"/>
</state>
<state id="ResourceAdjustment">
<transition target="TaskExecution"/>
</state>
<state id="end"/>
</scxml>

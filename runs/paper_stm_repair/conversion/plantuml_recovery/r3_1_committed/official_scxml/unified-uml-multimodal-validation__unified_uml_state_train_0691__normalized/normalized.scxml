<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="finalState_ccb03c"/>
<state id="start">
<transition target="InitialState"/>
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="Start Search" target="searchingBooks"/>
<transition event="Access Favorites" target="managingFavorites"/>
</state>
<state id="initialState"/>
<state id="searchingBooks">
<transition event="Add to Favorites" target="addingFavorites"/>
<transition event="Add Tags/Description" target="addingTagsDescriptions"/>
<transition event="Exit Search" target="end"/>
</state>
<state id="managingFavorites">
<transition event="Add New Book" target="addingFavorites"/>
<transition event="Edit Tags/Descriptions" target="editingTagsDescriptions"/>
<transition event="Exit Favorites" target="end"/>
</state>
<state id="addingFavorites">
<transition event="Save Favorites" target="end"/>
</state>
<state id="addingTagsDescriptions">
<transition event="Save Tags/Descriptions" target="end"/>
</state>
<state id="editingTagsDescriptions">
<transition event="Save Edits" target="end"/>
</state>
<state id="finalState"/>
<state id="end">
<transition target="finalState_ccb03c"/>
</state>
</scxml>

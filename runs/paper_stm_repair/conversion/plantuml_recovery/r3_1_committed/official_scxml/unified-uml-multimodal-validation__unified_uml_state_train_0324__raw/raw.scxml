<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Created"/>
</state>
<state id="Created">
<transition event="Order starts being processed" target="Processing"/>
</state>
<state id="Processing">
<transition event="Order is shipped" target="Shipped"/>
</state>
<state id="Shipped">
<transition event="Order is delivered" target="Delivered"/>
</state>
<state id="Delivered">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

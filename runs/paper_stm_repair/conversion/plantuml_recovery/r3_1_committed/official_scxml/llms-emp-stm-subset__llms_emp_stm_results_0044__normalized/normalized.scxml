<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DoorsClosing"/>
</state>
<state id="DoorsClosing">
<transition event="Closed/SendDeparted" target="InMotion"/>
</state>
<state id="Stopping">
<transition target="end"/>
</state>
<state id="EmergencyStopping">
<transition target="end"/>
</state>
<state id="end"/>
<state id="InMotion">
<transition event="Arrived/Stop, Send Arrived" target="Stopping"/>
<transition event="Obstacle Detected" target="EmergencyStopping"/>
<state id="Accelerating">
<transition event="Reached Cruising/Cruise" target="Cruising"/>
<transition event="Approached/Decelerate" target="Approaching"/>
</state>
<state id="Cruising">
<transition event="Approached/Decelerate" target="Approaching"/>
</state>
<state id="Approaching"/>
</state>
</scxml>

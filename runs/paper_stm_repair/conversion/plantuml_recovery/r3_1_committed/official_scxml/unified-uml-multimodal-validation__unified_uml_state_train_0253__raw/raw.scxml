<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ActivityRunning"/>
</state>
<state id="ActivityRunning">
<transition event="Pause" target="ActivityPaused"/>
</state>
<state id="ActivityPaused">
<transition event="Resume" target="ActivityRunning"/>
<transition event="Finish" target="end"/>
</state>
<state id="end"/>
</scxml>

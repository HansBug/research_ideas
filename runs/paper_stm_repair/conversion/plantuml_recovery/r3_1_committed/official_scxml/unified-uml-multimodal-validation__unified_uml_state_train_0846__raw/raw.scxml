<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="Task_Initiated"/>
</state>
<state id="Task_Initiated">
<transition target="Check_Resource_Availability"/>
</state>
<state id="Check_Resource_Availability">
<transition event="Resource Available" target="Resource_Allocated"/>
<transition event="Resource Not Available" target="Resource_Not_Available"/>
</state>
<state id="Resource_Allocated">
<transition target="end"/>
</state>
<state id="Resource_Not_Available">
<transition target="User_Notified"/>
</state>
<state id="end"/>
<state id="User_Notified">
<transition target="Allocate_Alternative_Resource"/>
</state>
<state id="Allocate_Alternative_Resource">
<transition target="end"/>
</state>
</scxml>

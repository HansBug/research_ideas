<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="Translation_Request_Received_3e6872">
<transition event="&quot;Receive translation request&quot;" target="Language_Detection_2bc541"/>
</state>
<state id="Language_Detection_2bc541">
<transition event="&quot;Detect language&quot;" target="Text_Translation_01279f"/>
<transition event="&quot;[Language is unsupported]&quot;" target="Unsupported_Language_e8052c"/>
</state>
<state id="Text_Translation_01279f">
<transition event="&quot;Translate text&quot;" target="Data_Integration_b03aae"/>
</state>
<state id="Unsupported_Language_e8052c">
<transition event="&quot;Send error response&quot;" target="Translation_Response_Sent_7def64"/>
</state>
<state id="Translation_Response_Sent_7def64">
<transition event="&quot;Send response&quot;" target="end"/>
</state>
<state id="Data_Integration_b03aae">
<transition event="&quot;[Data integration successful]&quot;" target="Translation_with_Data_Integration_2bbf5b"/>
<transition event="&quot;[Data integration failed]&quot;" target="Data_Integration_Failed_3df8be"/>
</state>
<state id="Translation_with_Data_Integration_2bbf5b">
<transition event="&quot;Prepare response with integrated data&quot;" target="Translation_Response_Sent_7def64"/>
</state>
<state id="Data_Integration_Failed_3df8be">
<transition event="&quot;Send error response&quot;" target="Translation_Response_Sent_7def64"/>
</state>
<state id="start">
<transition target="Translation_Request_Received_3e6872"/>
</state>
<state id="end"/>
</scxml>

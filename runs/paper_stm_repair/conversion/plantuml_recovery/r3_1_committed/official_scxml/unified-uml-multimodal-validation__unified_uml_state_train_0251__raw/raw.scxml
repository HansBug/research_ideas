<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UploadDocument"/>
</state>
<state id="UploadDocument">
<transition target="ConvertToPDF"/>
</state>
<state id="ConvertToPDF">
<transition event="Success" target="SavePDF"/>
<transition event="Failure" target="ErrorHandling"/>
</state>
<state id="SavePDF">
<transition target="ViewPDF"/>
</state>
<state id="ErrorHandling">
<transition target="UploadDocument"/>
</state>
<state id="ViewPDF">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ItemAdded"/>
</state>
<state id="ItemAdded">
<transition target="LocationSpecified"/>
<transition target="ViewItemsByLocation"/>
</state>
<state id="LocationSpecified">
<transition target="ViewItemsByLocation"/>
<transition target="MoveItem"/>
<transition target="DeleteItem"/>
</state>
<state id="ViewItemsByLocation">
<transition target="MoveItem"/>
<transition target="ViewLocationHistory"/>
<transition target="LocationSpecified"/>
</state>
<state id="MoveItem">
<transition target="LocationSpecified"/>
<transition target="DeleteItem"/>
</state>
<state id="DeleteItem">
<transition target="end"/>
</state>
<state id="ViewLocationHistory">
<transition target="MoveItem"/>
<transition target="ViewItemsByLocation"/>
</state>
<state id="end"/>
</scxml>

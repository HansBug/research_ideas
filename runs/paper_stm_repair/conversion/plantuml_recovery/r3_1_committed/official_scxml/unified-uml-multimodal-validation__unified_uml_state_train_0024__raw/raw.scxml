<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="SearchingNotes"/>
</state>
<state id="SearchingNotes">
<transition event="View in Table" target="ViewingNotesInTable"/>
<transition event="View in Tree" target="ViewingNotesInTree"/>
</state>
<state id="ViewingNotesInTable">
<transition event="Filter" target="FilteringNotes"/>
<transition event="Export" target="ExportingNotes"/>
<transition event="Share" target="SharingNotes"/>
<transition event="Track Progress" target="TrackingProgress"/>
</state>
<state id="ViewingNotesInTree">
<transition event="Filter" target="FilteringNotes"/>
<transition event="Export" target="ExportingNotes"/>
<transition event="Share" target="SharingNotes"/>
<transition event="Track Progress" target="TrackingProgress"/>
</state>
<state id="FilteringNotes">
<transition event="View in Table" target="ViewingNotesInTable"/>
<transition event="View in Tree" target="ViewingNotesInTree"/>
</state>
<state id="ExportingNotes">
<transition target="end"/>
</state>
<state id="SharingNotes">
<transition target="end"/>
</state>
<state id="TrackingProgress">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="MainMenu"/>
</state>
<state id="MainMenu">
<transition event="Add Income/Expense" target="AddTransaction"/>
<transition event="Track Savings/Investments" target="TrackSavings"/>
<transition event="Set Financial Goals/Reminders" target="SetGoals"/>
<transition event="View/Download Reports" target="ViewReports"/>
<transition event="Transfer Money" target="TransferMoney"/>
<transition event="Receive Notifications" target="Notifications"/>
</state>
<state id="AddTransaction">
<transition event="Return to Main Menu" target="MainMenu"/>
</state>
<state id="TrackSavings">
<transition event="Return to Main Menu" target="MainMenu"/>
</state>
<state id="SetGoals">
<transition event="Return to Main Menu" target="MainMenu"/>
</state>
<state id="ViewReports">
<transition event="Return to Main Menu" target="MainMenu"/>
</state>
<state id="TransferMoney">
<transition event="Return to Main Menu" target="MainMenu"/>
</state>
<state id="Notifications">
<transition event="Return to Main Menu" target="MainMenu"/>
</state>
<state id="end">
<transition target="start"/>
</state>
</scxml>

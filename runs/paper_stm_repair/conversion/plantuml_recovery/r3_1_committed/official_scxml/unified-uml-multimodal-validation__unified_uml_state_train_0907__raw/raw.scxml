<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="A">
<transition event="processing starts" target="B"/>
<transition event="cancel order" target="E"/>
</state>
<state id="B">
<transition event="shipping starts" target="C"/>
<transition event="cancel order" target="E"/>
</state>
<state id="C">
<transition event="delivered" target="D"/>
<transition event="cancel order" target="E"/>
</state>
<state id="D">
<transition event="order completed" target="end"/>
</state>
<state id="E">
<transition event="order canceled" target="end"/>
</state>
<state id="start">
<transition target="A"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="ViewSocialMediaProfiles"/>
</state>
<state id="ViewSocialMediaProfiles">
<transition event="Update Profile" target="UpdateProfileInformation"/>
<transition event="Post" target="PostUpdatesAndPhotos"/>
<transition event="List Profiles" target="ListAllProfiles"/>
<transition target="end"/>
</state>
<state id="UpdateProfileInformation">
<transition target="ViewSocialMediaProfiles"/>
</state>
<state id="PostUpdatesAndPhotos">
<transition target="ViewSocialMediaProfiles"/>
</state>
<state id="ListAllProfiles">
<transition target="ViewSocialMediaProfiles"/>
</state>
<state id="end"/>
</scxml>

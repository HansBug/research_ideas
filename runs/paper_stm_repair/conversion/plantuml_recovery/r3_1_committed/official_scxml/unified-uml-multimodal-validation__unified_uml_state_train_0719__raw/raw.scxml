<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition event="User initiates review" target="ReviewStarted"/>
</state>
<state id="ReviewStarted">
<transition event="Review starts" target="ViewCurrentList"/>
</state>
<state id="ViewCurrentList">
<transition event="User decides to reorder" target="ReorderTasks"/>
<transition event="User proceeds without changes" target="end"/>
</state>
<state id="ReorderTasks">
<transition event="Reordering completed" target="FinalizeReorder"/>
</state>
<state id="FinalizeReorder">
<transition event="Reordering finalized" target="end"/>
</state>
<state id="end"/>
</scxml>

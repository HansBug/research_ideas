<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="UserInteraction"/>
</state>
<state id="UserInteraction">
<transition event="on search/browse" target="AnalyzingData"/>
</state>
<state id="AnalyzingData">
<transition target="DisplayingRecommendations"/>
</state>
<state id="DisplayingRecommendations">
<transition event="on exit" target="end"/>
<transition event="on save" target="SavingRecommendations"/>
</state>
<state id="end"/>
<state id="SavingRecommendations">
<transition target="end"/>
</state>
</scxml>

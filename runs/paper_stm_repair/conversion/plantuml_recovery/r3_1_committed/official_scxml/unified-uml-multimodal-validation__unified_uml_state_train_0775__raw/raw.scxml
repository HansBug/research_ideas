<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="TaskListLoading"/>
</state>
<state id="TaskListLoading">
<transition event="onTaskListLoaded" target="TaskListReady"/>
</state>
<state id="TaskListReady">
<transition event="onViewTask" target="TaskViewing"/>
<transition event="onExit" target="end"/>
</state>
<state id="TaskViewing">
<transition event="onBackToList" target="TaskListReady"/>
<transition event="onExit" target="end"/>
</state>
<state id="end"/>
</scxml>

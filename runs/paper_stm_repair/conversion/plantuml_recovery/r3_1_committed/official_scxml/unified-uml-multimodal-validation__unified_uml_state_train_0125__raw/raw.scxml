<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="DisplayingPackageList"/>
<transition target="SearchingPackages"/>
</state>
<state id="DisplayingPackageList">
<transition event="Search Packages" target="SearchingPackages"/>
<transition event="Install Package" target="InstallingPackage"/>
<transition event="View Details" target="ViewingPackageDetails"/>
<transition event="Manage Versions" target="ManagingPackageVersions"/>
<transition event="Exit SPM" target="end"/>
</state>
<state id="SearchingPackages">
<transition event="Install Package" target="InstallingPackage"/>
<transition event="View Details" target="ViewingPackageDetails"/>
<transition event="Manage Versions" target="ManagingPackageVersions"/>
<transition event="Back to List" target="DisplayingPackageList"/>
</state>
<state id="InstallingPackage">
<transition event="Installation Complete" target="end"/>
<transition event="Back to List" target="DisplayingPackageList"/>
</state>
<state id="ViewingPackageDetails">
<transition event="Close Details" target="end"/>
<transition event="Back to List" target="DisplayingPackageList"/>
</state>
<state id="ManagingPackageVersions">
<transition event="Version Management Complete" target="end"/>
<transition event="Back to List" target="DisplayingPackageList"/>
</state>
<state id="end"/>
<state id="UninstallingPackage">
<transition event="Uninstallation Complete" target="end"/>
<transition event="Back to List" target="DisplayingPackageList"/>
</state>
</scxml>

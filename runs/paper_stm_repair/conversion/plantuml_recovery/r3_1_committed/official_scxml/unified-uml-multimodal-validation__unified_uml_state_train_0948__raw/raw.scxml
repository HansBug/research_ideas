<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="StartApp"/>
</state>
<state id="StartApp">
<transition target="DisplayOutfitSuggestions"/>
</state>
<state id="DisplayOutfitSuggestions">
<transition event="Filter by color/occasion/season" target="FilterSuggestions"/>
<transition event="Add new item" target="AddNewItem"/>
<transition event="Receive new piece recommendations" target="ReceiveRecommendations"/>
<transition event="Exit" target="end"/>
</state>
<state id="FilterSuggestions">
<transition event="Return to suggestions" target="DisplayOutfitSuggestions"/>
</state>
<state id="AddNewItem">
<transition event="Return to suggestions" target="DisplayOutfitSuggestions"/>
</state>
<state id="ReceiveRecommendations">
<transition event="Return to suggestions" target="DisplayOutfitSuggestions"/>
</state>
<state id="end"/>
</scxml>

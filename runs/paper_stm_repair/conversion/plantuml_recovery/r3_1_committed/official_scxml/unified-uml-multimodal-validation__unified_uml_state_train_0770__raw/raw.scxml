<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="TaskCreation"/>
</state>
<state id="TaskCreation">
<transition target="TaskAssignment"/>
</state>
<state id="TaskAssignment">
<transition target="DeadlineSetting"/>
</state>
<state id="DeadlineSetting">
<transition target="TaskTracking"/>
</state>
<state id="TaskTracking">
<transition event="when task is assigned or deadline due" target="Notification"/>
<transition event="when task is completed" target="end"/>
</state>
<state id="Notification">
<transition target="TaskTracking"/>
</state>
<state id="end"/>
</scxml>

<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="RequestAPICredentials"/>
</state>
<state id="RequestAPICredentials">
<transition target="ProvideJSONPayload"/>
</state>
<state id="ProvideJSONPayload">
<transition target="FetchData"/>
</state>
<state id="FetchData">
<transition target="ReturnData"/>
</state>
<state id="ReturnData">
<transition target="VisualizeData"/>
</state>
<state id="VisualizeData">
<transition target="end"/>
<transition target="RequestAPICredentials"/>
</state>
<state id="end"/>
</scxml>

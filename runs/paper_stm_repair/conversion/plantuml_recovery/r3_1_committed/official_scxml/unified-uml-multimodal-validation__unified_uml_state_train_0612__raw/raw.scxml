<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="InitialState"/>
</state>
<state id="InitialState">
<transition event="Start Process" target="ProcessRunning"/>
</state>
<state id="ProcessRunning">
<transition event="Complete Successfully" target="ProcessCompleted"/>
<transition event="Error Occurs" target="ProcessError"/>
</state>
<state id="ProcessCompleted">
<transition event="End Process" target="end"/>
</state>
<state id="ProcessError">
<transition event="Undo Process" target="ProcessUndo"/>
</state>
<state id="ProcessUndo">
<transition event="Correct Error" target="ProcessCorrected"/>
</state>
<state id="ProcessCorrected">
<transition event="Resume Process" target="ProcessRunning"/>
</state>
<state id="end"/>
</scxml>

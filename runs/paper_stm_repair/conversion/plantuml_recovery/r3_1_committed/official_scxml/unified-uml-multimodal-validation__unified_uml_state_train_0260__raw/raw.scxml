<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="MainMenu"/>
</state>
<state id="MainMenu">
<transition event="View All Contacts" target="ViewAllContacts"/>
<transition event="Search Contacts" target="SearchContacts"/>
<transition event="Access Social Media" target="AccessSocialMedia"/>
</state>
<state id="ViewAllContacts">
<transition event="Edit Contact" target="EditContact"/>
<transition event="Delete Contact" target="DeleteContact"/>
<transition event="Bulk Delete Contacts" target="BulkDeleteContacts"/>
<transition event="Exit" target="end"/>
</state>
<state id="SearchContacts">
<transition event="View Contact Details" target="ViewContactDetails"/>
<transition event="Exit" target="end"/>
</state>
<state id="AccessSocialMedia">
<transition event="Exit" target="end"/>
</state>
<state id="EditContact">
<transition event="Save Changes" target="ViewContactDetails"/>
<transition event="Exit" target="end"/>
</state>
<state id="DeleteContact">
<transition event="Return to All Contacts" target="ViewAllContacts"/>
<transition event="Return to Contact Details" target="ViewContactDetails"/>
<transition event="Exit" target="end"/>
</state>
<state id="BulkDeleteContacts">
<transition event="Return to All Contacts" target="ViewAllContacts"/>
<transition event="Exit" target="end"/>
</state>
<state id="end"/>
<state id="ViewContactDetails">
<transition event="Edit Contact" target="EditContact"/>
<transition event="Delete Contact" target="DeleteContact"/>
<transition event="Exit" target="end"/>
</state>
</scxml>

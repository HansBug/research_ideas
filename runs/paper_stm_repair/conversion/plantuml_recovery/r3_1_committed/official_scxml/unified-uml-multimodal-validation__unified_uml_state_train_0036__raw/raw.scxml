<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="NoProfileActive"/>
</state>
<state id="NoProfileActive">
<transition event="Create Profile" target="ProfileCreated"/>
<transition event="End" target="end"/>
</state>
<state id="ProfileCreated">
<transition event="Activate Profile" target="ProfileActive"/>
<transition event="Manage Profiles" target="ProfileManagement"/>
</state>
<state id="ProfileActive">
<transition event="Save Information" target="InformationSaved"/>
<transition event="Retrieve Information" target="InformationRetrieved"/>
<transition event="Deactivate Profile" target="NoProfileActive"/>
</state>
<state id="ProfileManagement">
<transition event="Edit Profile" target="ProfileEdited"/>
<transition event="Delete Profile" target="ProfileDeleted"/>
<transition event="Share Profile" target="ProfileShared"/>
</state>
<state id="InformationSaved">
<transition event="Return to Profile" target="ProfileActive"/>
</state>
<state id="InformationRetrieved">
<transition event="Return to Profile" target="ProfileActive"/>
</state>
<state id="ProfileEdited">
<transition event="Return to Management" target="ProfileManagement"/>
</state>
<state id="ProfileDeleted">
<transition event="Return to Management" target="ProfileManagement"/>
<transition event="No Profiles Left" target="NoProfileActive"/>
</state>
<state id="ProfileShared">
<transition event="Return to Management" target="ProfileManagement"/>
<transition event="End" target="end"/>
</state>
<state id="end"/>
</scxml>

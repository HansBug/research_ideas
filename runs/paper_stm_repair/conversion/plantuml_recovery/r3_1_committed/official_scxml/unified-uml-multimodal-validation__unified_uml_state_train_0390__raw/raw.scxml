<?xml version="1.0" encoding="UTF-8"?><scxml xmlns="http://www.w3.org/2005/07/scxml" initial="start" version="1.0">
<state id="start">
<transition target="CreateVersion"/>
</state>
<state id="CreateVersion">
<transition event="Switch" target="SwitchVersion"/>
<transition event="View History" target="ViewHistory"/>
</state>
<state id="SwitchVersion">
<transition target="end"/>
</state>
<state id="ViewHistory">
<transition target="end"/>
</state>
<state id="end"/>
</scxml>

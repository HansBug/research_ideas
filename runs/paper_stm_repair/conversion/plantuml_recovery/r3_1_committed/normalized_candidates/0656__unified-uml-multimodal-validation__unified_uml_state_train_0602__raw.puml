@startuml
[*] --> "Ready to Assist"
"Ready to Assist" --> "Setting Reminders" : Set reminders
"Setting Reminders" --> "Sending Notifications" : Reminder set
"Sending Notifications" --> "Task Completed" : Notification sent
"Task Completed" --> [*] : Task completed
"Ready to Assist" --> "Suggesting Tasks" : Suggest tasks
"Suggesting Tasks" --> "Task Completed" : Task accepted
"Suggesting Tasks" --> "Ready to Assist" : Task rejected
@enduml

@startuml
[*] --> Idle_State

Idle_State -> Retrieving_Weather_Data : User selects location
Retrieving_Weather_Data -> Displaying_Weather_Data : Data retrieved
Displaying_Weather_Data -> Saving_Forecast : User saves forecast
Saving_Forecast --> [*] : Forecast saved

Displaying_Weather_Data -> Idle_State : User returns to map
Retrieving_Weather_Data -> Error_State : Data retrieval fails
Error_State --> Idle_State : Error handled

Idle_State --> [*]
@enduml

@startuml
[*] --> "Translation Request Received"

"Translation Request Received" --> "Language Detection" : "Receive translation request"

"Language Detection" --> "Text Translation" : "Detect language"

"Language Detection" --> "Unsupported Language" : "[Language is unsupported]"

"Unsupported Language" --> "Translation Response Sent" : "Send error response"

"Text Translation" --> "Data Integration" : "Translate text"

"Data Integration" --> "Translation with Data Integration" : "[Data integration successful]"

"Data Integration" --> "Data Integration Failed" : "[Data integration failed]"

"Data Integration Failed" --> "Translation Response Sent" : "Send error response"

"Translation with Data Integration" --> "Translation Response Sent" : "Prepare response with integrated data"

"Translation Response Sent" --> [*] : "Send response"
@enduml

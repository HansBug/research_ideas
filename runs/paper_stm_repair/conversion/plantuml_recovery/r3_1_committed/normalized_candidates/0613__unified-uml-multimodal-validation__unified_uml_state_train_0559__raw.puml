@startuml
[*] --> "Task Created"
"Task Created" --> "Task Scheduled" : If assigned time slot
"Task Created" --> "Task Unscheduled" : If not assigned time slot
"Task Scheduled" --> "Task Prioritized" : If most important
"Task Prioritized" --> "Task In Progress" : If started
"Task Prioritized" --> "Task Scheduled" : If rescheduled
"Task Unscheduled" --> "Task Scheduled" : If assigned time slot
"Task Unscheduled" --> "Task Incomplete" : If marked incomplete
"Task In Progress" --> "Task Completed" : If completed
"Task In Progress" --> "Task In Progress" : If paused
"Task Completed" --> [*]
"Task Incomplete" --> [*]
@enduml

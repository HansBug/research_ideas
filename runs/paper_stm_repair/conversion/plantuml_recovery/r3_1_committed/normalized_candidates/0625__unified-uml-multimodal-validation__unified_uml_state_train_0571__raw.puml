@startuml
[*] --> "Package Added"
"Package Added" --> "Reminder Set" : Set Reminder
"Package Added" --> "Tracking Started" : Start Tracking
"Package Added" --> "Package Delivered" : Mark as Delivered
"Package Added" --> "Status Updated" : Update Status
"Package Added" --> [*] : Exit

"Reminder Set" --> "Reminder Active" : Reminder Activated
"Reminder Active" --> "Package Added" : Reminder Time Reached

"Tracking Started" --> "Status Updated" : Status Changed
"Tracking Started" --> "Tracking Started" : Status Not Changed

"Status Updated" --> "Package Delivered" : Status is Delivered
"Status Updated" --> "Tracking Started" : Status Updated

"Package Delivered" --> [*] : Exit
"Package Delivered" --> "Package Added" : Add New Package

"Package Added" --> "Package Added" : Add Notes/Comments
@enduml

@startuml
[*] -> InputPreferences
InputPreferences -> GenerateMealIdeas : After preferences input
GenerateMealIdeas -> SelectMeals : After meal ideas generated
SelectMeals -> GenerateMealPlan : After meals selected
GenerateMealPlan -> ViewMealPlan : After meal plan generated
ViewMealPlan -> [*] : After meal plan viewed
GenerateMealPlan -> SelectMeals : If changes needed
InputPreferences -> InputPreferences : If invalid input
@enduml

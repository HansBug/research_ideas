@startuml
[*] --> "Initialized with Resource List"
"Initialized with Resource List" -> "Resource Selected" : Select Resource
"Initialized with Resource List" -> "Resource Switcher Closed" : Close Switcher
"Resource Selected" -> "Switching to Resource" : Prepare to Switch
"Switching to Resource" -> "Resource Active" : Switch Completed
"Resource Active" -> "Resource Selected" : Select Another Resource
"Resource Active" -> "Resource Switcher Closed" : Close Switcher
"Resource Switcher Closed" --> [*]
@enduml

@startuml
[*] --> TurnOn
state TurnOn {
  [*] --> ExecutionTime
  ExecutionTime --> fork1 : after 2s
}

fork1 --> AutoFocus
fork1 --> DetLight

state AutoFocus {
  [*] --> ExecutionTime
  ExecutionTime --> choice1 : after 1s
}

state DetLight {
  [*] --> ExecutionTime
  ExecutionTime --> choice2 : <<GaStep>>{prob=0.4}
}

fork1 --> choice3

choice1 --> Junction3 : memFull=true
choice3 --> ChargedFlash

state ChargedFlash {
  [*] --> ExecutionTime
  ExecutionTime --> Junction3 : after 2s
}

Junction3 --> Join2 : Charged=true

choice2 --> Join2
Join2 --> Fork2

Fork2 --> Junction2
Fork2 --> Flash

Flash --> Terminate

Junction2 --> TakePicture
TakePicture --> WriteMemory

state WriteMemory {
  [*] --> ExecutionTime
  ExecutionTime --> Junction1 : after 2s
}

Junction1 --> TurnOff

state TurnOff {
  [*] --> ExecutionTime
  ExecutionTime --> [*] : after 2s
}
@enduml

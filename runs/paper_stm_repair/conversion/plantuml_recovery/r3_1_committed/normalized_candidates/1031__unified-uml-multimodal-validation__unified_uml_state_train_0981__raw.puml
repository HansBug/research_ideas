@startuml
[*] --> "Ready for Input"
"Ready for Input" --> "Source Language Selected" : select source language
"Source Language Selected" --> "Target Language Selected" : select target language
"Target Language Selected" --> "Text Input Received" : input text
"Text Input Received" --> "Translation Processing" : process translation
"Translation Processing" --> "Translation Result Displayed" : display result
"Translation Result Displayed" --> [*] : return to ready
@enduml

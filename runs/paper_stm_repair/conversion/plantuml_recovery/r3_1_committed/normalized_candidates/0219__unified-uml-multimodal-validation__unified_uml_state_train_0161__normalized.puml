@startuml
[*] --> Idle

Idle --> TaskCreation : create task
TaskCreation --> ResourceAllocation : allocate resources
TaskCreation --> TaskAssignment : assign task
TaskCreation --> Idle : cancel

ResourceAllocation --> TaskAssignment : assign task
ResourceAllocation --> Idle : cancel

TaskAssignment --> TaskExecution : execute task
TaskAssignment --> Idle : cancel

TaskExecution --> TaskCompletion : complete task
TaskExecution --> TaskExecution : continue execution

TaskCompletion --> Reporting : generate report
TaskCompletion --> Idle : done

Reporting --> Idle : return to idle

Idle --> [*] : exit
@enduml

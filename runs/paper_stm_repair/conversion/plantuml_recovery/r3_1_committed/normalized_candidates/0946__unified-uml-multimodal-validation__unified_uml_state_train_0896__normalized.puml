@startuml
[*] --> IdleState
IdleState --> ProjectCreation : Create New Project
ProjectCreation --> TaskAssignment : Assign Tasks
TaskAssignment --> TaskExecution : Start Task Execution
TaskExecution --> TaskCompletion : Complete Task
TaskCompletion --> ExportingTasks : Export Tasks
ExportingTasks --> [*] : Finish
IdleState --> ExportingTasks : Export Existing Tasks
TaskExecution --> TaskExecution : Continue Execution
@enduml

@startuml
[*] --> "Viewing Tasks"
"Viewing Tasks" --> "Adding Task" : Add Task
"Adding Task" --> "Viewing Tasks" : Task Added
"Viewing Tasks" --> "Deleting Task" : Delete Task
"Deleting Task" --> "Viewing Tasks" : Task Deleted
"Viewing Tasks" --> "Editing Task" : Edit Task
"Editing Task" --> "Viewing Tasks" : Task Edited
"Viewing Tasks" --> "Filtering/Sorting Tasks" : Filter/Sort
"Filtering/Sorting Tasks" --> "Viewing Tasks" : Filtered/Sorted
"Viewing Tasks" --> [*] : Exit
@enduml

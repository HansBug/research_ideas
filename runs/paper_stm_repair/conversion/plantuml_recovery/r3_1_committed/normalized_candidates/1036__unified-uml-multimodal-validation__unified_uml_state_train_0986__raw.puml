@startuml
[*] --> "Meeting Request Form"
"Meeting Request Form" --> "Meeting Request Sent"
"Meeting Request Sent" --> "Waiting for Participant Response"
"Waiting for Participant Response" --> "Meeting Confirmed"
"Waiting for Participant Response" --> "Meeting Declined"
"Meeting Confirmed" --> "Meeting Request Sent" : "Reminder Sent"
"Meeting Confirmed" --> [*] : "Meeting Completed"
"Meeting Declined" --> [*] : "Meeting Cancelled"
@enduml

@startuml
[*] --> NoSortingApplied
NoSortingApplied --> SingleCriterionSelected : Select single criterion
SingleCriterionSelected --> MultipleCriteriaSelected : Select additional criterion
MultipleCriteriaSelected --> ResultsDisplayed : Apply sorting
ResultsDisplayed --> [*] : Reset sorting
NoSortingApplied --> ResultsDisplayed : Apply no sorting
@enduml

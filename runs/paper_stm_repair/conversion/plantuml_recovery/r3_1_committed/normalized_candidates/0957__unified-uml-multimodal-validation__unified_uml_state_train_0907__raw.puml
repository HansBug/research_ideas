@startuml
state "Order Placed" as A
state "Order Processing" as B
state "Order Shipped" as C
state "Order Delivered" as D
state "Order Canceled" as E

[*] --> A

A --> B : processing starts
A --> E : cancel order

B --> C : shipping starts
B --> E : cancel order

C --> D : delivered
C --> E : cancel order

D --> [*] : order completed
E --> [*] : order canceled
@enduml

@startuml
[*] --> "Meeting Scheduling Initiated"
"Meeting Scheduling Initiated" --> "Meeting Details Set" : "User sets meeting details"
"Meeting Details Set" --> "Meeting Scheduled for Week 1" : "Schedule first meeting"
"Meeting Scheduled for Week 1" --> "Check Next Week" : "Check if next week needs scheduling"
"Check Next Week" --> "Meeting Scheduled for Week {n}" : "Schedule meeting for week {n}"
"Meeting Scheduled for Week {n}" --> "Check Next Week" : "Check if more weeks to schedule"
"Check Next Week" --> [*] : "All meetings scheduled"
@enduml

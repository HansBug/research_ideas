@startuml
state "Upload Initiated" as Upload_Initiated_2f3d32
state "File Size Check" as File_Size_Check_fc1d4a
state "File Upload in Progress" as File_Upload_in_Progress_063524
state "File Uploaded" as File_Uploaded_54da68

@startuml
[*] --> "Task Created"
"Task Created" --> "Task Scheduled"
"Task Scheduled" --> "Waiting for Execution Time"
"Waiting for Execution Time" --> "Task Execution"
"Task Execution" --> "Rescheduling Task"
"Rescheduling Task" --> "Task Scheduled" : recurring
"Rescheduling Task" --> [*] : stopped
@enduml

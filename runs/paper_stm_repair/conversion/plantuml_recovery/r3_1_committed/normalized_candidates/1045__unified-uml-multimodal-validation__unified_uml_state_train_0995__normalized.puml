@startuml
state "Ready for Selection" as Ready_for_Selection_fdf28e
state "Items Selected" as Items_Selected_b8a8d8
state "Items Moved" as Items_Moved_a04a59
[*] --> Ready_for_Selection_fdf28e

Ready_for_Selection_fdf28e --> Items_Selected_b8a8d8 : Select items
Items_Selected_b8a8d8 --> Items_Moved_a04a59 : Move items
Items_Moved_a04a59 --> [*] : Operation Complete

Items_Selected_b8a8d8 --> Ready_for_Selection_fdf28e : Cancel or No selection
@enduml

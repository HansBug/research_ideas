@startuml
[*] --> InitialState

state InitialState {
    [*] --> CheckNext7Days
}

state CheckNext7Days {
    when tasks are due in next 7 days
    --> Suggest7DaysTasks
}

state Suggest7DaysTasks {
    when tasks are suggested
    --> CheckNext14Days
}

state CheckNext14Days {
    when tasks are due in next 14 days
    --> Suggest14DaysTasks
}

state Suggest14DaysTasks {
    when tasks are suggested
    --> CheckNext30Days
}

state CheckNext30Days {
    when tasks are due in next 30 days
    --> Suggest30DaysTasks
}

state Suggest30DaysTasks {
    when tasks are suggested
    --> FinalState
}

state FinalState {
    [*]
}

CheckNext7Days --> CheckNext14Days
CheckNext14Days --> CheckNext30Days
CheckNext30Days --> FinalState

Suggest7DaysTasks --> CheckNext14Days
Suggest14DaysTasks --> CheckNext30Days
Suggest30DaysTasks --> FinalState

CheckNext7Days --> FinalState
CheckNext14Days --> FinalState
CheckNext30Days --> FinalState
@enduml

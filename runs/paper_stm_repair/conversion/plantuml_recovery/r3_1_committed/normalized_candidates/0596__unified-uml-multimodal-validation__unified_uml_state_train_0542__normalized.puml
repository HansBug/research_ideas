@startuml
[*] --> TaskListEmpty
TaskListEmpty --> TaskListView : View Task List
TaskListView --> [*] : Exit

TaskListView --> AddTaskState : Add New Task
AddTaskState --> TaskListView : Return

TaskListView --> EditTaskState : Edit Task
EditTaskState --> TaskListView : Return

TaskListView --> DeleteTaskState : Delete Task
DeleteTaskState --> TaskListView : Return

TaskListView --> ViewTaskState : View Task Details
ViewTaskState --> TaskListView : Return

TaskListView --> SearchTaskState : Search Tasks
SearchTaskState --> TaskListView : Return

TaskListView --> FilterTaskState : Filter Tasks
FilterTaskState --> TaskListView : Return

TaskListView --> AssignTaskState : Assign Task
AssignTaskState --> TaskListView : Return
@enduml

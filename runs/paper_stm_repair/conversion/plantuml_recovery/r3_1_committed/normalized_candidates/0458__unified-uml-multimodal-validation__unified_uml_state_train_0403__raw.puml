@startuml
[*] -> "Checklist Created" : Create Checklist
"Checklist Created" -> "Task Added to Checklist" : Add Task/Project
"Task Added to Checklist" -> "Task Completed" : Mark Task as Completed
"Task Completed" -> "Notification Sent" : Send Email/SMS
"Notification Sent" -> [*] : Update Checklist
"Task Added to Checklist" -> "Project Completed" : Mark Project as Completed
"Project Completed" -> [*] : Update Checklist
@enduml

@startuml
[*] --> InitialState

InitialState -> AddingProfile : addProfile
AddingProfile -> ProfileAdded : complete
ProfileAdded --> [*]

InitialState -> EditingProfile : editProfile
EditingProfile -> ProfileUpdated : complete
ProfileUpdated --> [*]

InitialState -> DeletingProfile : deleteProfile
DeletingProfile -> ProfileDeleted : complete
ProfileDeleted --> [*]

InitialState -> ViewingProfile : viewProfile
ViewingProfile -> [*] : close

@enduml

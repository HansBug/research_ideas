@startuml
[*] --> InitialState
InitialState -> [*] : Shutdown

InitialState -> TaskCreated : Create Task
TaskCreated -> TaskStored : Store Task
TaskStored -> TaskViewed : View Task
TaskStored -> TaskManaged : Manage Task
TaskViewed -> TaskManaged : Manage Task
TaskManaged -> [*] : Complete Task
TaskManaged -> TaskOverdue : Mark Overdue
TaskOverdue -> NotificationSent : Send Notification
NotificationSent -> [*] : Receive Notification
NotificationSent -> TaskPending : Task Pending
TaskPending -> [*] : Complete Task
TaskPending -> TaskOverdue : Mark Overdue
@enduml

@startuml
[*] --> Idle
Idle --> DataCreation : Create Data
Idle --> DataEditing : Edit Data
Idle --> DataDeletion : Delete Data
DataCreation --> DataValidation : Validate
DataEditing --> DataValidation : Validate
DataDeletion --> DataValidation : Validate
DataValidation --> DataSynchronization : Synchronize
DataValidation --> Idle : Validation Failed
DataSynchronization --> Idle : Synchronization Complete
Idle --> [*] : Exit
@enduml

@startuml
[*] --> AccountCreationStarted
AccountCreationStarted --> DefaultProfileSelection : select default profile
DefaultProfileSelection --> ProfileGenerated : generate profile
ProfileGenerated --> ProfileAvailable : profile available
ProfileAvailable --> ProfileCustomization : customize profile
ProfileCustomization --> ProfileAvailable : update profile
ProfileAvailable --> ProfileUpdated : update preferences
ProfileUpdated --> ProfileAvailable : update profile
ProfileAvailable --> [*] : logout
@enduml

@startuml
[*] --> "Task Created"
"Task Created" --> "Task Assigned" : assign
"Task Created" --> [*] : delete
"Task Assigned" --> "Task In Progress" : start
"Task Assigned" --> "Task Completed" : complete
"Task Assigned" --> [*] : delete
"Task In Progress" --> "Task Edited" : edit
"Task In Progress" --> "Task Completed" : complete
"Task Edited" --> "Task In Progress" : continue
"Task Edited" --> "Task Completed" : complete
"Task Completed" --> [*] : finalize
@enduml

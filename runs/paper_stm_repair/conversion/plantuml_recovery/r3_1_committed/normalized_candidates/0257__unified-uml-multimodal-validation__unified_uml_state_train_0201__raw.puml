@startuml
[*] --> "Task Assignment Initiated"
"Task Assignment Initiated" --> "Task Assigned" : User assigns task
"Task Assigned" --> "Evaluate Task Assignment" : System evaluates best suited user
"Evaluate Task Assignment" --> "Task Automatically Assigned" : System assigns task
"Task Automatically Assigned" --> "Task In Progress" : Task is in progress
"Task Automatically Assigned" --> "Task Completed" : Task is completed
"Task In Progress" --> "Task Completed" : Task completed
"Task In Progress" --> "Task Assigned" : Reassign task
"Task Completed" --> [*]
@enduml

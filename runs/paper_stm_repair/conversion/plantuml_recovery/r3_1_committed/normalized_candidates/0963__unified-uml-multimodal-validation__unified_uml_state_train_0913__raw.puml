@startuml
[*] --> "Task Created"
"Task Created" --> "Task Assigned"
"Task Assigned" --> "Task Scheduled"
"Task Scheduled" --> "Task Active"
"Task Active" --> "Task Completed"
"Task Active" --> "Task Canceled"
"Task Completed" --> [*]
"Task Canceled" --> [*]
"Task Scheduled" --> "Task Assigned" : Recurring Task
"Task Active" --> "Task Scheduled" : Reschedule
@enduml

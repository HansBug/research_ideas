@startuml
[*] --> SelectPaymentOption
SelectPaymentOption --> EnterPaymentDetails : Payment option selected
EnterPaymentDetails --> ProcessPayment : Payment details entered
ProcessPayment --> PaymentSuccess : Payment processed successfully
ProcessPayment --> PaymentFailure : Payment processing failed
PaymentSuccess --> [*] : Payment completed
PaymentFailure --> EnterPaymentDetails : Retry payment
PaymentFailure --> [*] : Cancel payment
SelectPaymentOption --> [*] : Cancel payment
EnterPaymentDetails --> SelectPaymentOption : Change payment method
@enduml

@startuml
[*] --> InitialState

state InitialState {
    [*] --> CreateOrder
}

state CreateOrder {
    CreateOrder --> OrderCreated : "Create Order"
    CreateOrder --> OrderEdited : "Edit Order"
    CreateOrder --> OrderDeleted : "Delete Order"
}

state OrderCreated {
    OrderCreated --> OrderTracking : "Track Order"
    OrderCreated --> PaymentProcessing : "Process Payment"
    OrderCreated --> OrderDelivered : "Mark as Delivered"
}

state OrderEdited {
    OrderEdited --> OrderCreated : "Save Changes"
    OrderEdited --> OrderDeleted : "Delete Order"
}

state OrderTracking {
    OrderTracking --> PaymentProcessing : "Process Payment"
    OrderTracking --> OrderDelivered : "Mark as Delivered"
}

state PaymentProcessing {
    PaymentProcessing --> OrderDelivered : "Payment Completed"
}

state OrderDelivered {
    OrderDelivered --> [*] : "Final State"
}

state OrderDeleted {
    OrderDeleted --> [*] : "Final State"
}

[*] <-- OrderDelivered
[*] <-- OrderDeleted
@enduml

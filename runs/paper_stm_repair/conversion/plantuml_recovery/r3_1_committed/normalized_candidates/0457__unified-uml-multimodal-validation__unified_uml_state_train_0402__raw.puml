@startuml
[*] --> "No Playlists"
[*] --> "Existing Playlists"

"No Playlists" --> "Creating New Playlist" : Create New Playlist
"Creating New Playlist" --> "Adding Songs" : Add Songs
"Adding Songs" --> "Finalizing Playlist" : Finalize
"Finalizing Playlist" --> [*]

"Existing Playlists" --> "Creating New Playlist" : Create New Playlist
"Existing Playlists" --> "Adding Songs" : Add Songs
"Existing Playlists" --> "Removing Songs" : Remove Songs
"Existing Playlists" --> "Reordering Songs" : Reorder Songs
"Removing Songs" --> "Existing Playlists" : Continue
"Reordering Songs" --> "Existing Playlists" : Continue
"Adding Songs" --> "Existing Playlists" : Continue
@enduml

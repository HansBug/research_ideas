@startuml
[*] --> InitialState

 initialState : Initial State

 initialState --> BrowsingProducts : User starts browsing
 initialState --> SearchingProducts : User starts searching

 state BrowsingProducts {
   BrowsingProducts --> ViewProductDetails : User selects product
   BrowsingProducts --> SavePreferences : User saves preferences
 }

 state SearchingProducts {
   SearchingProducts --> ViewProductDetails : User selects product
   SearchingProducts --> SavePreferences : User saves preferences
 }

 state ViewProductDetails {
   ViewProductDetails --> ReceivingRecommendations : System provides recommendations
 }

 state SavePreferences {
   SavePreferences --> BrowsingProducts : Continue browsing
   SavePreferences --> SearchingProducts : Continue searching
   SavePreferences --> [*] : Exit system
 }

 state ReceivingRecommendations {
   ReceivingRecommendations --> ViewProductDetails : User selects recommended product
   ReceivingRecommendations --> SavePreferences : User saves preferences
   ReceivingRecommendations --> [*] : Exit system
 }

 ' normalization-commented dependency-like arrow: [*] <.. ReceivingRecommendations
 ' normalization-commented dependency-like arrow: [*] <.. SavePreferences
 ' normalization-commented dependency-like arrow: [*] <.. ViewProductDetails
 ' normalization-commented dependency-like arrow: [*] <.. BrowsingProducts
 ' normalization-commented dependency-like arrow: [*] <.. SearchingProducts
@enduml

[*] --> "No Versions Available"
"Version Created" --> "Version Modified" : Modify
"Version Created" --> "No Versions Available" : Delete
"Version Created" --> "Changes Tracked" : Track Changes
"Version Modified" --> "No Versions Available" : Delete

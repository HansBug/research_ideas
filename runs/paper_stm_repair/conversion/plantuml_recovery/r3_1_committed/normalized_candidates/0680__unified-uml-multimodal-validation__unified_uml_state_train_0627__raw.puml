@startuml
[*] --> "Task Created"
"Task Created" --> "Task Assigned" : assign task
"Task Created" --> "Task Tracked" : track status
"Task Created" --> "Task Viewed" : view task
"Task Assigned" --> "Task Tracked" : track status
"Task Tracked" --> "Task Completed" : complete task
"Task Tracked" --> "Task Overdue" : task overdue
"Task Viewed" --> "Task Viewed" : view list
"Task Viewed" --> "Task Viewed" : view calendar
"Task Completed" --> [*] : task completed
"Task Overdue" --> [*] : task overdue
@enduml

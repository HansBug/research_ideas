def int hbrg = 0;

state ElevatorController {
    ! * -> F1 :: Reset;

    [*] -> F1;

    state F1;
    state F2;
    state F3;

    state MU2;
    state MU3;
    state MD1;
    state MD2;

    F1 -> MU2 :: PS2;
    F1 -> MU3 :: PS3;

    F2 -> MU3 :: PS3;
    F2 -> MD1 :: PS1;

    F3 -> MD1 :: PS1;
    F3 -> MD2 :: PS2;

    MU2 -> F2 :: S2;
    MU3 -> F3 :: S3;
    MD1 -> F1 :: S1;
    MD2 -> F2 :: S2;
}
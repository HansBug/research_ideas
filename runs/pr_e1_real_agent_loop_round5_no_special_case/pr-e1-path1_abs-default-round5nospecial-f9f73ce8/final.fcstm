def float slp = 0.0;
def int k1 = 0;
def int k2 = 0;
def int n = 0;

state ABS_Supervisor {
    [*] -> Increase;

    state Increase {
        enter {
            k1 = 1;
            k2 = 0;
            n = 0;
        }
    }

    state Hold {
        enter {
            k1 = 0;
            k2 = 0;
            n = 0;
        }
    }

    state Decrease {
        enter {
            k1 = 0;
            k2 = 1;
            n = 500;
        }
    }

    Increase -> Hold : if [slp <= 0.01];
    Hold -> Increase : if [slp > 0.01];
    Hold -> Decrease : if [slp < -0.01];
    Decrease -> Hold : if [slp >= -0.01];
}
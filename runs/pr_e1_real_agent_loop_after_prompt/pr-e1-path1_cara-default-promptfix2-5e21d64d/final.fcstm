def int pump_mode = 0;
def float pump_speed = 0.0;
def float target_bp = 0.0;
def float measured_bp = 0.0;
def int algorithm_active = 0;
def int pump_fault = 0;

state CARA {
    ! * -> Manual : if [CA_backManual > 0 || CB_backManual > 0 || CP_backManual > 0 || CC_backManual > 0];

    [*] -> Mode_Control_Algorithm;

    state Mode_Control_Algorithm {
        [*] -> Manual;

        state Manual {
            enter { pump_mode = 0; }
            during { /* pump speed controlled by caregiver switch */ }
        }

        state Autocontrol {
            enter { pump_mode = 1; algorithm_active = 1; }
            during { 
                if [pump_fault == 0] {
                    /* control pump_speed based on measured_bp */
                    pump_speed = max(0.0, target_bp - measured_bp); 
                }
            }
            exit { algorithm_active = 0; }

            state Ask_StartAC {
                [*] -> Setpoint;

                state Setpoint {
                    during { /* caregiver may modify target_bp */ }
                    Setpoint -> AutocontrolInit :: StartAC;
                }

                state AutocontrolInit {
                    enter { algorithm_active = 1; }
                }
            }
        }
    }

    state PumpFaultHandling {
        enter { /* activate pump alarm */ }
        during { /* wait for caregiver to clear fault */ }
        exit { pump_fault = 0; algorithm_active = 0; }
    }
}